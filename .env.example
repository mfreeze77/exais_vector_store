SVS_ENV=local
SVS_PRODUCT_VERSION=0.9.8-production-candidate
SVS_DEV_MODE=true
SVS_DEV_TENANT_ID=ten_dev
SVS_DEV_BUSINESS_INSTANCE_ID=biz_dev
SVS_DEV_USER_ID=usr_dev
SVS_DEV_GROUPS=grp_admin,grp_eng,admins,engineering
SVS_DEV_ROLES=owner,admin
SVS_DEV_MAX_SECURITY_LEVEL=5

# The official postgres image creates POSTGRES_USER as a superuser. Keep that
# role for init/migrations only. The app connects as POSTGRES_APP_USER, which is
# explicitly NOSUPERUSER/NOBYPASSRLS so FORCE RLS is actually enforced.
POSTGRES_USER=svs_owner
POSTGRES_PASSWORD=svs_owner_dev_password
POSTGRES_DB=svs
POSTGRES_APP_USER=svs_app
POSTGRES_APP_PASSWORD=svs_app_dev_password
DATABASE_URL=postgresql+psycopg://svs_app:svs_app_dev_password@postgres:5432/svs
DATABASE_URL_SYNC=postgresql://svs_owner:svs_owner_dev_password@localhost:5432/svs
DATABASE_URL_MIGRATIONS=postgresql://svs_owner:svs_owner_dev_password@localhost:5432/svs

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=svs_
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_PREFIX=svs_
OPENSEARCH_VERIFY_CERTS=true

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=svs_minio
S3_SECRET_ACCESS_KEY=svs_minio_password
S3_BUCKET=exai-vector-store-local
S3_REGION=us-east-1

DEFAULT_EMBEDDING_PROVIDER=hash_mock
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
MODEL_GATEWAY_URL=http://model-gateway:8081

TEI_ENDPOINT_URL=
INFINITY_ENDPOINT_URL=
RUNPOD_EMBEDDING_ENDPOINT_URL=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# External PDF -> Markdown parser. Raw PDF uploads call RunPod Marker and then
# ingest the returned Markdown as pdf_markdown_external_v1. MARKER_MODE must
# remain remote; ExAIS does not run Marker inside the API or worker containers.
# MARKER_* is preferred; if omitted, the Marker client can fall back to
# RUNPOD_API_KEY and RUNPOD_ENDPOINT_ID for local proof compatibility.
MARKER_RUNPOD_API_KEY=
MARKER_RUNPOD_ENDPOINT_ID=
MARKER_MODE=remote
MARKER_TIMEOUT_SEC=1800
MARKER_POLL_INTERVAL_SEC=3
MARKER_MAX_ATTEMPTS=2
MARKER_RETRY_BACKOFF_SEC=5

SVS_API_KEY_PEPPER=change-me-in-prod
SVS_ALLOWED_CORS_ORIGINS=http://localhost:13080,http://localhost:18080
SVS_VERSION=0.9.8-production-candidate
SVS_REGISTRY_PREFIX=localhost:5000/expertaiservices
SVS_RELEASE_CHANNEL=dev
SVS_CELL_ENV_FILE=.release/cells/local/.env.cell
SVS_API_PORT=18080
SVS_MODEL_GATEWAY_PORT=18081
SVS_ADMIN_UI_PORT=13080
SVS_INSTANCE_AGENT_PORT=18090
SVS_POSTGRES_PORT=15432
SVS_REDIS_PORT=16379
SVS_QDRANT_HTTP_PORT=16333
SVS_QDRANT_GRPC_PORT=16334
SVS_MINIO_PORT=19000
SVS_MINIO_CONSOLE_PORT=19001
SVS_INSTANCE_MANIFEST=/app/instances/dev/instance.yaml

# v0.9.7 production-wave controls
SVS_SPARSE_BACKEND=postgres_fts
SVS_DENSE_BACKEND=qdrant
SVS_INDEX_STRICT=true
# Optional external index generation suffix for blue/green reindex cutovers.
# Empty preserves existing Qdrant/OpenSearch physical names.
SVS_INDEX_VERSION=
SVS_INGEST_INLINE_MAX_BYTES=262144
SVS_DEFAULT_RATE_LIMIT_PER_MINUTE=120
SVS_ADMIN_RATE_LIMIT_PER_MINUTE=30
SVS_VECTOR_STORE_FILE_ADD_RATE_LIMIT_PER_MINUTE=300
SVS_LOCAL_OBJECT_STORE_PATH=.svs-object-store
SVS_OBJECT_STORE_STRICT=false
SVS_IDEMPOTENCY_TTL_HOURS=24
VOYAGE_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=

# Operator-approved public HTML acquisition for source packages such as Topeka
# Municipal Code. Use the Decodo API Playground token value after "Basic";
# do not include "Authorization:" or commit a real token.
DECODO_API_TOKEN=
DECODO_API_ENDPOINT=https://scraper-api.decodo.com/v2/scrape
# Leave optional acquisition knobs blank unless a target needs them. The Topeka
# Municipal Code route was first proven with Decodo's minimal universal request.
DECODO_PROXY_POOL=
DECODO_HEADLESS=
DECODO_GEO=
DECODO_LOCALE=
DECODO_DEVICE_TYPE=
DECODO_TARGET=universal


# Production guardrails:
# - In any non-local SVS_ENV, SVS_DEV_MODE must be false.
# - In any non-local SVS_ENV, SVS_API_KEY_PEPPER must not be change-me-in-prod.
# - Runtime DATABASE_URL must use a NOSUPERUSER/NOBYPASSRLS role such as svs_app.
