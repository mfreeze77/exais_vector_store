# Production reference example. cell-up.py resolves references at launch; never put real secret values here.
# Secret-bearing values must be references such as:
# - sops://configs/cell-secrets.example.sops.yaml#POSTGRES_PASSWORD
# - age://configs/cell-secrets.example.sops.yaml#POSTGRES_PASSWORD
# - vault://kv/exais/customer-001#POSTGRES_PASSWORD
# - envref://POSTGRES_PASSWORD
SVS_ENV=prod
SVS_PRODUCT_VERSION=0.9.8-production-candidate
SVS_VERSION=0.9.8-production-candidate
SVS_REGISTRY_PREFIX=docker.io/expertaiservices
SVS_RELEASE_CHANNEL=prod
SVS_CELL_ENV_FILE=/opt/exais/vector-store/.env.cell
SVS_PUBLIC_API_BASE=https://api.expertaiservices.com
SVS_DEV_MODE=false
SVS_DEV_TENANT_ID=
SVS_DEV_BUSINESS_INSTANCE_ID=
SVS_DEV_USER_ID=
SVS_DEV_GROUPS=
SVS_DEV_ROLES=
SVS_DEV_MAX_SECURITY_LEVEL=0

# Owner role is for migrations only. Runtime DATABASE_URL must use POSTGRES_APP_USER.
POSTGRES_USER=svs_owner
POSTGRES_PASSWORD=sops://configs/cell-secrets.example.sops.yaml#POSTGRES_PASSWORD
POSTGRES_DB=svs
POSTGRES_APP_USER=svs_app
POSTGRES_APP_PASSWORD=sops://configs/cell-secrets.example.sops.yaml#POSTGRES_APP_PASSWORD
DATABASE_URL=sops://configs/cell-secrets.example.sops.yaml#DATABASE_URL
DATABASE_URL_SYNC=sops://configs/cell-secrets.example.sops.yaml#DATABASE_URL_SYNC
DATABASE_URL_MIGRATIONS=sops://configs/cell-secrets.example.sops.yaml#DATABASE_URL_MIGRATIONS

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=svs_
SVS_DENSE_BACKEND=qdrant

# Mini cells can keep Postgres FTS. Standard/large cells can set opensearch.
SVS_SPARSE_BACKEND=postgres_fts
OPENSEARCH_URL=https://opensearch.expertaiservices.internal:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=sops://configs/cell-secrets.example.sops.yaml#OPENSEARCH_PASSWORD
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_INDEX_PREFIX=svs_

S3_ENDPOINT_URL=https://object-storage.expertaiservices.internal
S3_ACCESS_KEY_ID=sops://configs/cell-secrets.example.sops.yaml#S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=sops://configs/cell-secrets.example.sops.yaml#S3_SECRET_ACCESS_KEY
S3_BUCKET=exai-vector-store-prod
S3_REGION=us-east-1
SVS_OBJECT_STORE_STRICT=true
SVS_LOCAL_OBJECT_STORE_PATH=/var/lib/svs/object-store

DEFAULT_EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=envref://OPENAI_API_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
MODEL_GATEWAY_URL=http://model-gateway:8081
TEI_ENDPOINT_URL=
INFINITY_ENDPOINT_URL=
RUNPOD_EMBEDDING_ENDPOINT_URL=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
VOYAGE_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=

# External PDF -> Markdown parser. Raw PDF uploads call RunPod Marker and then
# ingest the returned Markdown as pdf_markdown_external_v1. Store real values in
# the customer/cell secret source; do not commit them.
# MARKER_* is preferred; if omitted, the Marker client can fall back to
# RUNPOD_API_KEY and RUNPOD_ENDPOINT_ID for local proof compatibility.
MARKER_RUNPOD_API_KEY=sops://configs/cell-secrets.example.sops.yaml#MARKER_RUNPOD_API_KEY
MARKER_RUNPOD_ENDPOINT_ID=envref://MARKER_RUNPOD_ENDPOINT_ID
MARKER_MODE=remote
MARKER_TIMEOUT_SEC=1800
MARKER_POLL_INTERVAL_SEC=3
MARKER_MAX_ATTEMPTS=2
MARKER_RETRY_BACKOFF_SEC=5

SVS_API_KEY_PEPPER=age://configs/cell-secrets.example.sops.yaml#SVS_API_KEY_PEPPER
SVS_ALLOWED_CORS_ORIGINS=https://admin.expertaiservices.com,https://api.expertaiservices.com
SVS_INDEX_STRICT=true
SVS_BIND_IP=127.0.0.1
# Optional external index generation suffix for blue/green reindex cutovers.
# Leave empty unless intentionally building/searching an alternate generation.
SVS_INDEX_VERSION=
SVS_INGEST_INLINE_MAX_BYTES=262144
SVS_DEFAULT_RATE_LIMIT_PER_MINUTE=120
SVS_ADMIN_RATE_LIMIT_PER_MINUTE=30
SVS_VECTOR_STORE_FILE_ADD_RATE_LIMIT_PER_MINUTE=300
SVS_IDEMPOTENCY_TTL_HOURS=24
SVS_REQUEST_BODY_LIMIT_BYTES=52428800
SVS_REINDEX_BATCH_SIZE=1000

# Public host ports for the compose cell. Keep them unique per VPS host.
SVS_API_PORT=18080
SVS_MODEL_GATEWAY_PORT=18081
SVS_ADMIN_UI_PORT=13080
SVS_INSTANCE_AGENT_PORT=18090
SVS_POSTGRES_PORT=15432
SVS_REDIS_PORT=16379
SVS_QDRANT_HTTP_PORT=16333
SVS_QDRANT_GRPC_PORT=16334
SVS_MINIO_PORT=19000
SVS_MINIO_CONSOLE_PORT=19001
