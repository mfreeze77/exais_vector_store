{
  "schema_version": 1,
  "id": "expertaiservices-tickets-v1",
  "description": "Filename-judged live retrieval quality set for the Expert AI Services ticket corpus.",
  "expected_store_name": "expertaiservices",
  "minimum_completed_files": 118,
  "required_candidate_id": "default_auto",
  "promotion_min_score_delta": 0.01,
  "metric_k": 5,
  "request_top_k": 10,
  "thresholds": {
    "min_hit_at_5": 0.95,
    "min_top1_accuracy": 0.75,
    "min_mrr": 0.8,
    "min_ndcg_at_5": 0.85,
    "min_support_at_10": 0.95,
    "min_citation_complete_rate": 1.0,
    "min_mean_unique_files_at_10": 3.0,
    "max_error_rate": 0.0,
    "max_latency_ms_p95": 500.0
  },
  "candidates": [
    {
      "id": "default_auto",
      "rewrite_query": false,
      "ranking_options": {
        "ranker": "auto",
        "score_threshold": 0.0
      }
    },
    {
      "id": "default_auto_rewrite",
      "rewrite_query": true,
      "ranking_options": {
        "ranker": "auto",
        "score_threshold": 0.0
      }
    },
    {
      "id": "no_rerank",
      "rewrite_query": false,
      "ranking_options": {
        "ranker": "none",
        "score_threshold": 0.0
      }
    },
    {
      "id": "dense_only_auto",
      "rewrite_query": false,
      "ranking_options": {
        "ranker": "auto",
        "score_threshold": 0.0,
        "hybrid_search": {
          "embedding_weight": 1.0,
          "text_weight": 0.0
        }
      }
    },
    {
      "id": "sparse_only_auto",
      "rewrite_query": false,
      "ranking_options": {
        "ranker": "auto",
        "score_threshold": 0.0,
        "hybrid_search": {
          "embedding_weight": 0.0,
          "text_weight": 1.0
        }
      }
    }
  ],
  "cases": [
    {
      "id": "real_embedding_fail_closed",
      "query": "How does the system fail closed when a real embedding provider returns a hash mock fallback?",
      "expected_filenames": ["WAVE-011-real-embedding-provider-gate.md"],
      "support_terms": ["hash_mock", "fail closed"]
    },
    {
      "id": "marker_warmup_retry",
      "query": "How is RunPod Marker PDF ingestion protected against cold-start warm-up failures and retries?",
      "expected_filenames": ["WAVE-010-runpod-marker-pdf-ingestion.md"],
      "support_terms": ["warm-up", "bounded retry"]
    },
    {
      "id": "idempotent_reindex_replay",
      "query": "What proof shows forced reindex uses stable IDs and does not duplicate dense or sparse entries?",
      "expected_filenames": ["WAVE-032-idempotent-reindexing-proof.md"],
      "support_terms": ["stable", "duplicate"]
    },
    {
      "id": "profile_rerank",
      "query": "Which retrieval change applies profile-driven reranking after dense and sparse RRF fusion?",
      "expected_filenames": ["WAVE-021-profile-driven-rerank-retrieval.md"],
      "support_terms": ["post-fusion", "rerank"]
    },
    {
      "id": "mmr_diversity",
      "query": "How does lexical MMR reduce near-duplicate chunks after reranking?",
      "expected_filenames": ["WAVE-052-rerank-diversity-mmr.md"],
      "support_terms": ["MMR", "near-duplicate"]
    },
    {
      "id": "neighbor_context",
