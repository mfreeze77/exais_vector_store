{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "query",
    "expected_chunk_ids"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "expected_chunk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_chunk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  }
}