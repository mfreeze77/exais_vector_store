{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:3.30.320","page_type":"section"},"citation":"3.30.320","citation_url":"https://topeka.municipal.codes/TMC/3.30.320","content_hash":"0a631ef80df879af4597a4dc57b20f2265952701e49f948a508178fb5493898b","heading":"Exceptions.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:3.30.320:section","source_url":"https://topeka.municipal.codes/TMC/3.30.320","text":"TMC 3.30.310 shall not apply to the following:\n(a) Property purchased and/or leased as part of a project financed by the issuance of industrial revenue bonds by the City. This exception shall not preclude keeping appropriate records of such transactions and including the involved properties in the City’s real estate inventory.\n(b) Easements and rights-of-way acquired for public improvement projects. (Ord. 20236 § 2, 1-7-20.)","type":"section","workbench_component_id":"1cb7f003-aa14-5619-af86-36f3a983c5b5"},{"attributes":{"block_kind":"paragraph"},"citation":"3.30.320","citation_url":"https://topeka.municipal.codes/TMC/3.30.320","content_hash":"f4f82a82044f713383cea23c9bef14fdd216333099b402dce4b2a20cec1ca9da","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:3.30.320:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:3.30.320:block:0","source_url":"https://topeka.municipal.codes/TMC/3.30.320","text":"TMC 3.30.310 shall not apply to the following:","type":"paragraph","workbench_component_id":"283cdbd7-21da-5fe2-8bce-09b93d74f589"},{"attributes":{"block_kind":"paragraph"},"citation":"3.30.320","citation_url":"https://topeka.municipal.codes/TMC/3.30.320","content_hash":"265ff9d96be5ff161a5c2bd832aca61b5a729df3df4ca408a950d41390ee6d59","heading