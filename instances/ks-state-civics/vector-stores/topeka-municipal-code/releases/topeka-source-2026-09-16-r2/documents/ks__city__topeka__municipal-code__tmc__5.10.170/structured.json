{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.10.170","page_type":"section"},"citation":"5.10.170","citation_url":"https://topeka.municipal.codes/TMC/5.10.170","content_hash":"af1d4316d3f5640fe22c6afe7948b0de8474b50fb349f6045152025412fe6467","heading":"Mobile home park.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.10.170:section","source_url":"https://topeka.municipal.codes/TMC/5.10.170","text":"(a) The annual license fee for a mobile home park shall be as prescribed by the City’s fee schedule.\n(b) The full amount of the mobile home park license fee shall be required regardless of the time of the year in which the application is made, and the licensee shall only be authorized to operate under the license for the remainder of the period to July 1st following the date on which the license is issued. (Ord. 20631 § 21, 1-13-26.)\nCross References: Mobile home park license, TMC 5.100.010 et seq.","type":"section","workbench_component_id":"37e6b626-0864-5817-9f0a-8cd3b7beb96e"},{"attributes":{"block_kind":"paragraph"},"citation":"5.10.170","citation_url":"https://topeka.municipal.codes/TMC/5.10.170","content_hash":"c14d386126280c2af2744cc4e563e1785a77d4d409e0f7f5c52ef70335005392","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.10.170:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.10.170:block:0","source_url":"https://topeka.municipal.codes/TMC/5.10.170","text":"(a) The annual license fee for a mobile home park shall be as prescribed by the City’s fee schedule.","type":"paragraph","workbench_component_id":"8e4c6fb3-4b31-5ea0-8f3d-c10fc1f56fcb"},{"attributes":{"block_kind":"paragraph"},"citation":"5.10.170","citation_url":"