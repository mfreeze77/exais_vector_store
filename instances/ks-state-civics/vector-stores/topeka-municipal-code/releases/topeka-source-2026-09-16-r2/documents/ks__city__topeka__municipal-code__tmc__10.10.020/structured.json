{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.10.020","page_type":"section"},"citation":"10.10.020","citation_url":"https://topeka.municipal.codes/TMC/10.10.020","content_hash":"d09ddd425b036cca48e18e1654c0ad5dcd27400c7aa0d6852da93074e5dbc46d","heading":"Duties of Traffic Engineer.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.10.020:section","source_url":"https://topeka.municipal.codes/TMC/10.10.020","text":"It shall be the general duty of the Traffic Engineer to:\n(a) Conduct engineering investigations of traffic conditions;\n(b) Conduct engineering analyses of traffic accidents and devise remedial measures therefor;\n(c) Determine the installation, proper operation and maintenance of traffic control devices;\n(d) Cooperate with other City officials, including the Transportation Operations Superintendent, in the development of ways and means to improve traffic and parking conditions; and\n(e) Carry out the additional powers and duties imposed by this title and other ordinances of the City. (Ord. 17620 § 3, 12-12-00. Code 1981 § 43-19. Code 1995 § 142-37.)","type":"section","workbench_component_id":"480f8bc5-4eb0-58e4-8b23-f11f93e7302a"},{"attributes":{"block_kind":"paragraph"},"citation":"10.10.020","citation_url":"https://topeka.municipal.codes/TMC/10.10.020","content_hash":"3a7afec2e7bd855f1a1d40de970db887ac09c67ab352ca59cacb18d7b8a3ea87","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.10.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.10.020:block:0","source_url":"https://topeka.municipal.codes/TMC/10.10.020","text":"It shall be the general duty of the Traffic Engineer to:","type":"paragraph","workbench_co