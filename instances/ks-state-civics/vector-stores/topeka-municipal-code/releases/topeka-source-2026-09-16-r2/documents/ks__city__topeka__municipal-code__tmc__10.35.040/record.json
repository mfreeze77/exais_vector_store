        "locator": {
          "block_index": 12,
          "component_id": "81b02d83-d904-52e6-8e06-b3c296d7c1d4",
          "convention": "utf8_char_offset",
          "end": 1622,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.35.040:block:12",
          "start": 1573
        },
        "quote": "Cross References: Municipal Judge, TMC 2.20.060 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.35.040:block:12#text",
