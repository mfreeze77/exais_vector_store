{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.75.040","page_type":"section"},"citation":"5.75.040","citation_url":"https://topeka.municipal.codes/TMC/5.75.040","content_hash":"f12850f180133ef30e1d2af00cc815a372b0cef7f6b69f6651dc0985302f96f7","heading":"Keeping duplicate inventory.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.040:section","source_url":"https://topeka.municipal.codes/TMC/5.75.040","text":"Permittees under this chapter shall keep available at the place of sale a duplicate copy of the inventory submitted with the application and shall present such duplicate inventory to inspecting officials upon request. (Code 1981 § 37-20. Code 1995 § 30-144.)","type":"section","workbench_component_id":"b59136d5-ca00-5e31-b875-970482cd484b"},{"attributes":{"block_kind":"paragraph"},"citation":"5.75.040","citation_url":"https://topeka.municipal.codes/TMC/5.75.040","content_hash":"f12850f180133ef30e1d2af00cc815a372b0cef7f6b69f6651dc0985302f96f7","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.040:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.040:block:0","source_url":"https://topeka.municipal.codes/TMC/5.75.040","text":"Permittees under this chapter shall keep available at the place of sale a duplicate copy of the inventory submitted with the application and shall present such duplicate inventory to inspecting officials upon request. (Code 1981 § 37-20. Code 1995 § 30-144.)","type":"paragraph","workbench_component_id":"6778fc79-a55c-5c69-85a4-070b64521f96"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.040:section","schema":"exais.jurisdiction.structured_content.v1"}