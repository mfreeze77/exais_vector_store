          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.65.125:block:2",
          "start": 327
        },
        "quote": "(b) Be of material with similar appearance to the manufactured home or masonry material;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.65.125:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
