          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.65.125:block:3",
          "start": 416
        },
        "quote": "(c) Be weather-resistant material for skirting and shall not be scrap metal or polyurethane scrap material;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.65.125:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 14.65.125 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "9fef5c9d-7a3b-57ab-98d2-4854c37f8c40",
          "convention": "utf8_char_offset",
          "end": 717,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.65.125:block:4",
          "start": 524
        },
        "quote": "(d) Be skirted in such a way as not to allow access to the underside of the manufactured home for storage and/or trash accumulation but access only for repair purposes to the manufactured home.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.65.125:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
