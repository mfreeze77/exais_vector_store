          "start": 220
        },
        "quote": "(a) Be completely around the structure from the base of the manufactured home to the ground level beneath;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.65.125:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
