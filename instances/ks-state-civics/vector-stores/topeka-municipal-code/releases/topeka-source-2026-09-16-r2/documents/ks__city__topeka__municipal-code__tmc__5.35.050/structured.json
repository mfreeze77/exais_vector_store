{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.35.050","page_type":"section"},"citation":"5.35.050","citation_url":"https://topeka.municipal.codes/TMC/5.35.050","content_hash":"d587e80928ce7c6f6b911137c57eb7baad1842e1f7ebabbd1bd240047da3ce3d","heading":"Application.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.35.050:section","source_url":"https://topeka.municipal.codes/TMC/5.35.050","text":"No license certificate shall be issued under this article until the person applying for such license shall file with the City Clerk an application stating:\n(a) The number of cars to be operated by such person;\n(b) The full name of the applicant and the drivers to be in charge of the operation of each car and their places of residence; and\n(c) That the applicant has deposited with the City Clerk a policy or certificate of liability insurance in the sum provided in this article for each vehicle for which a license is sought. (Code 1981 § 46-103. Code 1995 § 154-167.)\nCross References: City Clerk, TMC 2.20.010 .","type":"section","workbench_component_id":"aaf0e024-c02f-5d0a-ba3d-349c4b6fc105"},{"attributes":{"block_kind":"paragraph"},"citation":"5.35.050","citation_url":"https://topeka.municipal.codes/TMC/5.35.050","content_hash":"3840848d19bb241996bf7d1835271d1c154b7de69e26e0f6502d9fa3b476c60c","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.35.050:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.35.050:block:0","source_url":"https://topeka.municipal.codes/TMC/5.35.050","text":"No license certificate shall be issued under this article until the person applying for such license shall file with the City Clerk an application stating: