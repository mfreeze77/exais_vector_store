        "quote": "Whenever used in this chapter, the following definitions shall apply:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.50.010:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
