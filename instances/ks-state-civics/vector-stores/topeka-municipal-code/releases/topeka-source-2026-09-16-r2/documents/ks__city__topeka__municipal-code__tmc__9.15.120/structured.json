{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:9.15.120","page_type":"section"},"citation":"9.15.120","citation_url":"https://topeka.municipal.codes/TMC/9.15.120","content_hash":"edc712364185195c3150bb851475d1daa37ae9ca976e05b8c27ec98bc98e16c3","heading":"Premises to be open to public and police.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.120:section","source_url":"https://topeka.municipal.codes/TMC/9.15.120","text":"The premises of a licensee shall be open to the public at all times during business hours and to the police at all times when the operator of the business or his agent is on the premises, except that a premises licensed as a club by the State Director of Alcoholic Beverage Control shall be open to the police and not to the public. (Code 1981 § 5-22. Code 1995 § 10-53.)\nCross References: Police Department, TMC 2.20.090 .\nState Law References: Similar provisions, K.S.A. 41-2704 .","type":"section","workbench_component_id":"6b48e31a-b5b6-59fc-b59d-2fdf6d0a4b32"},{"attributes":{"block_kind":"paragraph"},"citation":"9.15.120","citation_url":"https://topeka.municipal.codes/TMC/9.15.120","content_hash":"0761ab94e1e216d3591eef8cc2c3343c3d3ec79567b0059d43d3b4f096f0783d","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.120:block:0","source_url":"https://topeka.municipal.codes/TMC/9.15.120","text":"The premises of a licensee shall be open to the public at all times during business hours and to the police at all times when the operator of the business or his agent is on the premises, except that a premises licensed as a club by the State Director of Alcoholic Beverage Control shall be open to the police and not to the public. (Code 1981 § 5-22. Code 1995 § 10-53.)","type":"paragraph","workbench_component_id":"66d7f061-f07a-5960-a4a2-9ad17ec8e37b"},{"attributes":{"block_kind":"paragraph"},"citation":"9.15.120","citation_url":"https://topeka.municipal.codes/TMC/9.15.120","content_hash":"b3690706389bc36b62ec0c62b3dea31a6dd0c29e5778164c15b68f9d4f0aa5e3","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.120:block:1","source_url":"https://topeka.municipal.codes/TMC/9.15.120","text":"Cross References: Police Department, TMC 2.20.090 .","type":"paragraph","workbench_component_id":"7124153c-66c5-5f6a-a5fe-0b859e3a640b"},{"attributes":{"block_kind":"paragraph"},"citation":"9.15.120","citation_url":"https://topeka.municipal.codes/TMC/9.15.120","content_hash":"a0f7042e752ad57d74c1463bbe1e8b7d63932b91024bfb8b533ab7d957b7abb8","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.120:block:2","source_url":"https://topeka.municipal.codes/TMC/9.15.120","text":"State Law References: Similar provisions, K.S.A. 41-2704 .","type":"paragraph","workbench_component_id":"6c7d833c-3c11-5118-9fdc-7ff404b485e1"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.120:section","schema":"exais.jurisdiction.structured_content.v1"}