          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.30.020:block:4",
          "start": 868
        },
        "quote": "(d) Any noxious or malodorous gas, flammable liquids or substances capable of creating a public nuisance.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.30.020:block:4#text",
        "unavailable_reason": null
