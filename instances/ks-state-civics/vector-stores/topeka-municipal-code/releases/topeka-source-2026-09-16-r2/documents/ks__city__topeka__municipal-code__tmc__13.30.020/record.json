        "quote": "It shall be unlawful for any person to discharge or cause to be discharged, directly or indirectly, any of the following described waters or wastes into any public storm sewer:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.30.020:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
