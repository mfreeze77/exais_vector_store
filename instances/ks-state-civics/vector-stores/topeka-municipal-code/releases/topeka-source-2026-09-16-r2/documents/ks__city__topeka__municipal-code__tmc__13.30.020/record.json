        "label": "TMC 13.30.020 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "e8fa0230-b507-57d3-9009-822975548686",
          "convention": "utf8_char_offset",
          "end": 331,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.30.020:block:1",
          "start": 177
        },
        "quote": "(a) Any material that would be normally discharged into the sanitary sewer, such as human or animal feces, urine, garbage or pretreated industrial wastes.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.30.020:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.30.020 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "b91b5e79-4140-5b1d-b959-ba34c00e145e",
          "convention": "utf8_char_offset",
          "end": 618,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.30.020:block:2",
          "start": 332
        },
        "quote": "(b) Any ashes, cinders, sand, mud, straw, shavings, metal, glass, rags, feathers, tar, plastic, wood, manure, leaves, grass clippings, construction material, sediment, oil, motor fluids, or any other solid viscous substance capable of causing obstruction to the flow in the storm sewer.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.30.020:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.30.020 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "1eda9741-0293-5bda-a77e-24900235c95e",
          "convention": "utf8_char_offset",
          "end": 867,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.30.020:block:3",
          "start": 619
        },
        "quote": "(c) Any waters or wastes containing household hazardous waste or any other toxic or poisonous substance in sufficient quantity to injure or interfere with any biological life in the receiving waters, or cause a violation of water quality standards.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.30.020:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.30.020 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "81f9e137-cba8-5683-bf34-f7639223ce44",
