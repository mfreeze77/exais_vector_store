{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.30.120","page_type":"section"},"citation":"14.30.120","citation_url":"https://topeka.municipal.codes/TMC/14.30.120","content_hash":"04c52a4991102792987ce592efe001ba9e1e73c438e1d9f7f2b9a54d8da55b4d","heading":"Removal of wires interfering with Fire Department.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.30.120:section","source_url":"https://topeka.municipal.codes/TMC/14.30.120","text":"The Development Services Director shall have the power to at once cause the removal of all wires or turning off of all electrical currents, where such wires or currents shall interfere with the work of the Fire Department during the progress of a fire. (Ord. 19072 § 12, 4-15-08. Code 1981 § 10-171. Code 1995 § 26-371.)\nCross References: Fire Department, TMC 2.20.030 .","type":"section","workbench_component_id":"ddfb1b0b-8999-5154-9183-c99eaed55495"},{"attributes":{"block_kind":"paragraph"},"citation":"14.30.120","citation_url":"https://topeka.municipal.codes/TMC/14.30.120","content_hash":"29dcda5630e1007dcf60c43fe1585890ba89e353cf1b11abc5e549033fe6f0e2","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.30.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.30.120:block:0","source_url":"https://topeka.municipal.codes/TMC/14.30.120","text":"The Development Services Director shall have the power to at once cause the removal of all wires or turning off of all electrical currents, where such wires or currents shall interfere with the work of the Fire Department during the progress of a fire. (Ord. 19072 § 12, 4-15-08. Code 1981 § 10-171. Code 1995 § 26-371.)","type":"paragraph","workbench_comp