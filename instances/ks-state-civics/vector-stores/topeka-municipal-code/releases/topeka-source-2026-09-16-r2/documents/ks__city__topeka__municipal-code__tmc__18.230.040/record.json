    "references": [
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.230.040 block 0",
        "locator": {
          "block_index": 0,
          "component_id": "c873ac7b-7765-5058-8ebf-4c5084a879c0",
