        "quote": "The following words, terms and phrases, when used in this chapter, shall have the meanings ascribed to them in this section, except where the context clearly indicates a different meaning:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.25.010:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.25.010 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "224433ea-2b36-5c60-b437-d03f8e271091",
          "convention": "utf8_char_offset",
          "end": 493,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.25.010:block:1",
          "start": 189
        },
        "quote": "“Ambulance” means a vehicle for hire, including helicopters and airplanes, equipped or used for the transportation of wounded, injured, sick, invalid or deceased persons. The term “ambulance” shall not include vehicles used for the purpose of transporting deceased persons for funeral or burial purposes.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.25.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.25.010 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "07f91744-a12b-528c-bacb-5bab408bd47f",
          "convention": "utf8_char_offset",
          "end": 643,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.25.010:block:2",
          "start": 494
        },
        "quote": "“Applicant” means any person who shall have filed a written application for a franchise under this chapter as provided in Article II of this chapter.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.25.010:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.25.010 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "6aadc941-eeb9-5a0e-a42a-d4b34dedf8ad",
          "convention": "utf8_char_offset",
          "end": 872,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.25.010:block:3",
          "start": 644
        },
        "quote": "“Franchise” means the nonexclusive authorization granted under this chapter to use the streets and alleys of the City to operate an ambulance service within the corporate limits of the City, as now existing or hereafter altered.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.25.010:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.25.010 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "e7969dd2-6704-58c0-89ee-550fbef59fe1",
          "convention": "utf8_char_offset",
          "end": 965,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.25.010:block:4",
          "start": 873
        },
        "quote": "“Grantee” means any person to whom a franchise is granted by the Council under this chapter.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.25.010:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.25.010 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "5dbf0400-a935-5ae1-8cd7-7d8301fb500d",
          "convention": "utf8_char_offset",
          "end": 1079,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.25.010:block:5",
          "start": 966
        },
        "quote": "“Person” means an individual, firm, partnership, corporation, joint venture, or any other association of persons.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.25.010:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.25.010 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "fe612b69-b97f-5316-aec3-89a83a425c37",
          "convention": "utf8_char_offset",
          "end": 1326,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.25.010:block:6",
          "start": 1080
        },
        "quote": "“Surrender” means the voluntary relinquishment of the rights and duties conferred by an awarded and accepted franchise for the unexpired term of such franchise by action of the grantee pursuant to the conditions stated in the franchise agreement.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.25.010:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.25.010 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "1b6e2c9f-329f-53d0-98e3-d62b031491e8",
          "convention": "utf8_char_offset",
          "end": 1600,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.25.010:block:7",
          "start": 1327
        },
        "quote": "“Termination” means the involuntary withdrawal of the rights and duties conferred by an awarded and accepted franchise for the unexpired term of such franchise by action of the Council pursuant to the authority reserved in the franchise agreement. (Ord. 20557 § 1, 4-8-25.)",
