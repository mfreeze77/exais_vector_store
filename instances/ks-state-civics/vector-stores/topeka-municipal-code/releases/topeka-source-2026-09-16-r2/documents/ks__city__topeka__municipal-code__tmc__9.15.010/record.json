          "block_index": 1,
          "component_id": "d1398f2f-147f-5279-a06b-c454fb1f0299",
          "convention": "utf8_char_offset",
          "end": 331,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.010:block:1",
          "start": 198
        },
        "quote": "(a) “Beer” means beer as defined by K.S.A. 41-102 and amendments thereto, but containing not more than six percent alcohol by volume.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.010 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "d92e6301-a872-53a6-aa65-09f719b109ba",
          "convention": "utf8_char_offset",
          "end": 642,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.010:block:2",
          "start": 332
        },
        "quote": "(b) “Cereal malt beverage” means any fermented but undistilled liquor brewed or made from malt or from a mixture of malt or malt substitute or any flavored malt beverage, as defined in K.S.A. 41-2729 and amendments thereto, but does not include any such liquor which is more than 3.2 percent alcohol by weight.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.010:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.010 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "7ce48804-181f-555f-845a-25b36bc2d5a9",
          "convention": "utf8_char_offset",
          "end": 1008,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.010:block:3",
          "start": 643
        },
        "quote": "(c) “Common consumption area” or “CCA” means a defined indoor or outdoor area not otherwise subject to a license issued pursuant to the Kansas Liquor Control Act or the Club and Drinking Establishment Act where the possession and consumption of alcoholic liquor or cereal malt beverage is allowed pursuant to a common consumption area permit issued by the Director.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.010:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.010 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "fa9431a5-b24c-5ae3-b93a-887e0900e03c",
          "convention": "utf8_char_offset",
          "end": 1109,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.010:block:4",
          "start": 1009
        },
        "quote": "(d) “Director” means the Director of Alcoholic Beverage Control of the Kansas Department of Revenue.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.010:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.010 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "f02efa01-fd08-5510-9b39-9fa04a0bf2b6",
          "convention": "utf8_char_offset",
          "end": 1357,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.010:block:5",
          "start": 1110
        },
        "quote": "(e) “Off-premises retailer” means a person who is licensed under the Kansas Cereal Malt Beverage Act and who sells or offers for sale any cereal malt beverage or beer in original and unopened containers that is not for consumption on the premises.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.010:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
