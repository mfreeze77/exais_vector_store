{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.55.400","page_type":"section"},"citation":"14.55.400","citation_url":"https://topeka.municipal.codes/TMC/14.55.400","content_hash":"8e22774c64928b35412e6816883b38521be6fd670f2bfaa2d0c9c5e749133204","heading":"Automatic fire sprinkler systems.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.400:section","source_url":"https://topeka.municipal.codes/TMC/14.55.400","text":"Section R313, AUTOMATIC FIRE SPRINKLER SYSTEMS, is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nAUTOMATIC FIRE SPRINKLER SYSTEMS\nR313.1 Townhouse automatic fire sprinkler systems design. An automatic residential fire sprinkler system installed in townhouses shall be designed and installed in accordance with NFPA 13R or NFPA 13 and the currently adopted edition of the Uniform Plumbing Code.\nR313.2 One- and two-family dwellings automatic fire system design. An automatic residential fire sprinkler system installed in one- and two-family dwellings shall be designed and installed in accordance with NFPA 13D and the currently adopted edition of the Uniform Plumbing Code.\n(Ord. 19727 § 37, 4-24-12.)","type":"section","workbench_component_id":"5fa7e3ac-9b47-529f-8a0f-45aa4399be14"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.400","citation_url":"https://topeka.municipal.codes/TMC/14.55.400","content_hash":"a4e3ed7f68bc14697b05eac78766d35501f7a74cc3a24fa9898a1ba14620ff2c","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.400:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.400:block:0","source_url":"https://topeka.municipal.codes/TMC/14.55.400","