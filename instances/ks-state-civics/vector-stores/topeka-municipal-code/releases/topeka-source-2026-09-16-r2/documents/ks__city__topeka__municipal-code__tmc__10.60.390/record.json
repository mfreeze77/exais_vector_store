          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.60.390:block:1",
          "start": 188
        },
        "quote": "(1) Parking garages/monthly: $40.00 and $120.00 per month.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.60.390:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 10.60.390 block 2",
        "locator": {
          "block_index": 2,
