          "convention": "utf8_char_offset",
          "end": 300,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.60.390:block:2",
          "start": 247
        },
        "quote": "(2) Parking garages/hourly: $0.50 and $3.00 per hour.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.60.390:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
