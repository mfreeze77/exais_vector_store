t_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:17","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xi) Hospitals, medical centers, morgues, mortuaries, autopsy facilities, clinics, or nursing and convalescent homes.","type":"paragraph","workbench_component_id":"27e5adc6-2c27-5296-b1b0-e917601819b7"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"b674fccc4d7a0c7047c25b1462e7d124789f89399c556e4ea9972b28a3bf423a","heading":null,"ordinal":18,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:18","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xii) Ice machines.","type":"paragraph","workbench_component_id":"7024f204-9009-5ecf-a6a9-02a66db0a580"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"c39497f6289128847ccceab59445533d7c96614bcb59084c101efac1f5c081f2","heading":null,"ordinal":19,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:19","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xiii) Irrigation systems.","type":"paragraph","workbench_component_id":"ff04a931-673c-527d-89fa-e8b0745cbf44"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"37bf230980227c15365a16c5d63f56cf002eb6dbdec0bff552dd2fa9bfe98d0b","heading":null,"ordinal":20,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:20","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xiv) Laundries.","type":"paragraph","workbench_component_id":"8f83fa67-9bd7-5d76-b6e6-0b30517db85d"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"19ccfc07d5de036ed4b82841d37c86757ea9f25e5ebe8af28580244fe27d6523","heading":null,"ordinal":21,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:21","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xv) Metal cleaning, metal plating, processing or fabricating plants.","type":"paragraph","workbench_component_id":"03fe0400-8a82-56cf-bba0-d0b8044094b4"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"fe3e25fa79b1863052ac74d1442b60f960f03db8499ec15798e3468566b6eddb","heading":null,"ordinal":22,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:22","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xvi) Nursing and convalescent homes designed for acute care.","type":"paragraph","workbench_component_id":"c24df9bd-8315-5cdc-baf4-86b828e37bf8"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"26607755ea2e368903ac6ac08f5f5521b872ccf65308240dc0d4247b33ff0323","heading":null,"ordinal":23,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:23","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xvii) Oil and gas production, storage or transmission facilities.","type":"paragraph","workbench_component_id":"d5f1dc61-c754-5c74-abfa-596b256d7fe2"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"4e382c0c59dd0e787600d77c8f13f9791f19624f69e8287c5da7b031d2da3467","heading":null,"ordinal":24,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:24","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xviii) Packing or food processing plants.","type":"paragraph","workbench_component_id":"b58eb2f2-7373-5758-a33c-74b3c91a3d4b"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"a0fe109e1caed1944f0f763fd0a551afd58f155e1f66cbb68162f5b03518af69","heading":null,"ordinal":25,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:25","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xix) Paper and paper products plants.","type":"paragraph","workbench_component_id":"b26d913d-38ab-5364-96fe-705bd26afe06"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"bdab6a04b3ec626a7bb4027e9f72949e0f7b2c62b862a9b67d5d18e92171bda2","heading":null,"ordinal":26,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:26","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xx) Power plants.","type":"paragraph","workbench_component_id":"6e937d46-d9f0-5bda-834e-d0661dbb4c54"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"7c29a4de36bee398d42998046d1f4381580b801069f0d3165c9a7700d9257776","heading":null,"ordinal":27,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:27","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xxi) Radioactive materials plants or handling facilities.","type":"paragraph","workbench_component_id":"91ef00e2-1335-5755-b4ee-c3883ab98ec3"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"5cd1d343ebdc24ec7b444cd2ca1d286a25a78b16cd4577db2c8ec4f1c65de934","heading":null,"ordinal":28,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:28","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xxii) Restricted or classified facilities.","type":"paragraph","workbench_component_id":"22aa543a-7ed0-5300-82cd-3263138823a0"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"e1e6ae3f8016a572c16356342cfe2e0d70019e5a4c5902e04730e8beac85df2c","heading":null,"ordinal":29,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:29","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xxiii) Rubber manufacturing plants.","type":"paragraph","workbench_component_id":"9ae31e72-f675-5378-b5a2-8a8b672d4cce"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"46686fdf871f3967531857c48f26cbe6f0a472798162fbd6828fb151186648c6","heading":null,"ordinal":30,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:30","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xxiv) Sand, gravel or asphalt plants.","type":"paragraph","workbench_component_id":"21836f28-7fd9-51af-8a37-c6472ec50e8d"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"294714db013a760c2845e28a95681dc90e3c70acd30023d024b587e7b14eca76","heading":null,"ordinal":31,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:31","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xxv) Schools or colleges.","type":"paragraph","workbench_component_id":"5402e9bc-0f88-5f01-a935-71526a246fc9"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"1960824d79d2d75c1b097e88e544805140c043bf9cba5398ba9ac6d7c322b57a","heading":null,"ordinal":32,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:32","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xxvi) Sewage and storm drainage facilities and reclaimed water systems.","type":"paragraph","workbench_component_id":"3b193940-f196-5fc1-b2b4-a80cde8efba3"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"48a2ad044d1b0de457c82aebdd16c2930f7471f27a875cb3e98f7630d7fbcca5","heading":null,"ordinal":33,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:33","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xxvii) Solar heating systems.","type":"paragraph","workbench_component_id":"d9cae512-56fc-52b2-a9c2-2195c59f87ca"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"49e9140d53a464941e51b5904a917a7c7e2fb34615d88eab304f9c1f6cee4635","heading":null,"ordinal":34,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:34","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xxviii) Temporary nonemergency service: fire hydrants, air valves, blow-offs and other outlets.","type":"paragraph","workbench_component_id":"6bf4b55a-3a75-5a25-af12-aa442ee81547"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"400ea57f091aab4ec1d2995612c02935c5a17739dde2b21bbe99532b9fba5f69","heading":null,"ordinal":35,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:35","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xxix) Veterinary facilities.","type":"paragraph","workbench_component_id":"e1cb8526-5e5b-5c88-9b86-092734949657"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"8f37aea8ad4239bc27d6cc6841ec76fb4b3a5b84a89b0ee925c39bc542546072","heading":null,"ordinal":36,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:36","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(xxx) Waterfront marinas.","type":"paragraph","workbench_component_id":"103a33da-ec77-5121-a7ae-5558093e089d"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"54609e20a5b35d4f754eb41d9eaa4224fa13eafa94ce12247957823bf11b8776","heading":null,"ordinal":37,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:37","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(b) Approved devices or assemblies shall be installed at all fixtures and equipment where backflow or backsiphonage may occur and where a minimum air-gap between the potable water outlet and the fixture or equipment flood level rim cannot be maintained. Backflow and backsiphonage devices or assemblies of all types shall be in an accessible location to allow for proper testing.","type":"paragraph","workbench_component_id":"02b4d8cd-2d75-5552-b785-7b9dc38a189a"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"fcfdfe2e1742d0d79e0d99974fa4c84b621d6330bcd58317d598f0e0fd9c4059","heading":null,"ordinal":38,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:38","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"Access and clearance shall be provided for the required testing, maintenance and repair. Access and clearance shall require a minimum of one foot between the lowest portion of the assembly and grade, floor or platform. Backflow and Cross Connection Enforcement Official approval is required before backflow devices or assemblies are installed at an elevation of six feet or more above the grade, floor or platform.","type":"paragraph","workbench_component_id":"d51eaa2b-c1a6-508c-b066-6577768dc3c9"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"5613a8ca5a8d8ebef10193a350021176a8ad5c2f7e140736da85ade5aacdd789","heading":null,"ordinal":39,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:39","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"Connection to the potable water piping and initial installation of all backflow prevention devices or assemblies shall be made by a Topeka licensed plumber employed by a Topeka licensed plumbing contractor.","type":"paragraph","workbench_component_id":"c21ce8c6-ab90-5a64-b196-7bd2c372559f"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"e94b5687e96a02c2902a3ebee8725bbb6ae22a024dc53a78141de55cb43c1683","heading":null,"ordinal":40,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:40","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(c) Replacement of an existing device or assembly may be made by licensed and certified backflow tester/technicians employed in the trade or craft for which the backflow device or assembly was installed (i.e., lawn irrigation, fire suppression, ice machine installation, etc.).","type":"paragraph","workbench_component_id":"bada348f-0c9d-5c7d-9e70-409c3b5e8623"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"37eb16159ed01598bf6538a86046860b66c8a65e9e396de682089459d51a0059","heading":null,"ordinal":41,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:41","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"Certified backflow/tester technicians shall maintain, repair and test devices or assemblies.","type":"paragraph","workbench_component_id":"2465bd22-e5aa-5c2c-a598-32eeac7c473e"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"e941551bb2467bd457e7bd9bced43c499892eb35495c6b73ee6aa0b7adafebf0","heading":null,"ordinal":42,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:42","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(d) Cross connection control fees for backflow preventers and lawn irrigation systems connected to the potable water supply system of the City outside the City limits shall be established by the Backflow and Cross Connection Enforcement Official, as approved by the City Manager, and maintained in a schedule of fees and charges. The Backflow and Cross Connection Enforcement Official shall determine such fees for residential and commercial installations and replacements, based on the cost of service provided and an additional charge equal to the percentage difference between inside-City and outside-City water rates.","type":"paragraph","workbench_component_id":"09768610-5e86-5488-8bae-f7a7e8dca82b"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"a51dc7fb97efbdfb404ade2e7d7c6cdce0aab9a68e1c7ef372aad7bd1adf7231","heading":null,"ordinal":43,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:43","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(e) It shall be unlawful for any person to knowingly make connection to the potable water supply system of the City for the categories of premises in this section without an approved assembly or approved device.","type":"paragraph","workbench_component_id":"49fcf85e-fb9f-5651-ad0e-382a6b97613b"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"567841569dbdf816442c3f8bf3e036a91a7df309dd0f4c2020940aa27439baa8","heading":null,"ordinal":44,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:44","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(1) Penalty. Any person violating this section may be punished by:","type":"paragraph","workbench_component_id":"9fed55e4-af08-590e-ab14-8e1347e39bd9"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"92d1dc272f3bc62f9cd29b0316d2e76822eb640acd68d9117e8caa7120e4765b","heading":null,"ordinal":45,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:45","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(i) Fine of not more than $499.00; and/or","type":"paragraph","workbench_component_id":"913e31fe-91a9-56c7-991a-5c77a6d7435d"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"cc7bde3a327d1c9e8b18174d8f261fe1540e18208506c59acf64daf63f3f6cad","heading":null,"ordinal":46,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:46","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"(ii) Imprisonment in jail for not more than 179 days. (Ord. 20196 § 6, 7-23-19.)","type":"paragraph","workbench_component_id":"775874e2-c748-59bb-a195-1b6075964937"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.540","citation_url":"https://topeka.municipal.codes/TMC/14.35.540","content_hash":"8e9d34517feefcb37df468e4f7a0e150f9ff9194624ec4b0091df5b279e2bb50","heading":null,"ordinal":47,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:block:47","source_url":"https://topeka.municipal.codes/TMC/14.35.540","text":"Cross References: Public Works Department, TMC 2.20.100 .","type":"paragraph","workbench_component_id":"7df13e0b-e500-570a-8e5a-2aa76729d284"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.540:section","schema":"exais.jurisdiction.structured_content.v1"}