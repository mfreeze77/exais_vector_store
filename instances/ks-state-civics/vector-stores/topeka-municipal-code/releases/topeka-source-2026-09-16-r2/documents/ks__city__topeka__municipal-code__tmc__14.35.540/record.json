          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.35.540:block:34",
          "start": 2477
        },
        "quote": "(xxviii) Temporary nonemergency service: fire hydrants, air valves, blow-offs and other outlets.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.35.540:block:34#text",
