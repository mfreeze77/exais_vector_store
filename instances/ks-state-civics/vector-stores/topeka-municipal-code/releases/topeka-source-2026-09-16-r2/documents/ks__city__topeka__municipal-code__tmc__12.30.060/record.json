        "quote": "(a) Information Required. The information provided to the Director at the time of registration, except for persons holding a valid franchise with the City, shall include, but not be limited to:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.30.060:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
