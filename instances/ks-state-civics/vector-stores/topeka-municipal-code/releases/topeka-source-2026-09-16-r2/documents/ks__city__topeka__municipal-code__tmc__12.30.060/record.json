          "start": 2161
        },
        "quote": "(5) Such other information as the City may require.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.30.060:block:10#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
