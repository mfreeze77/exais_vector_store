          "convention": "utf8_char_offset",
          "end": 354,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.30.060:block:1",
          "start": 194
        },
        "quote": "(1) Each registrant’s name, Kansas One-Call registration certificate number, address, email address if applicable, telephone number(s), and facsimile number(s).",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.30.060:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
