{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.75.050","page_type":"section"},"citation":"5.75.050","citation_url":"https://topeka.municipal.codes/TMC/5.75.050","content_hash":"de7d412a89f2c851225b20681e94c6c736775c1aebc9b0865696cac91f0903ab","heading":"Adherence to inventory.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.050:section","source_url":"https://topeka.municipal.codes/TMC/5.75.050","text":"Permittees under this chapter shall adhere to inventory, and make no additions whatsoever during the period of the permitted sale to the stock of goods set forth in the inventory attached to the application for a permit. (Code 1981 § 37-21. Code 1995 § 30-145.)","type":"section","workbench_component_id":"d08965ef-c3f6-5183-b01c-79a3f5e8622d"},{"attributes":{"block_kind":"paragraph"},"citation":"5.75.050","citation_url":"https://topeka.municipal.codes/TMC/5.75.050","content_hash":"de7d412a89f2c851225b20681e94c6c736775c1aebc9b0865696cac91f0903ab","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.050:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.050:block:0","source_url":"https://topeka.municipal.codes/TMC/5.75.050","text":"Permittees under this chapter shall adhere to inventory, and make no additions whatsoever during the period of the permitted sale to the stock of goods set forth in the inventory attached to the application for a permit. (Code 1981 § 37-21. Code 1995 § 30-145.)","type":"paragraph","workbench_component_id":"5fec66c6-72c2-5653-8a55-3639eea3bc92"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.050:section","schema":"exais.jurisdiction.structured_content.v1"}