          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.25.120:block:1",
          "start": 138
        },
        "quote": "(a) Where terms are not defined in this code and are defined in other codes, such terms shall have the meanings ascribed to them in those codes.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.25.120:block:1#text",
        "unavailable_reason": null
