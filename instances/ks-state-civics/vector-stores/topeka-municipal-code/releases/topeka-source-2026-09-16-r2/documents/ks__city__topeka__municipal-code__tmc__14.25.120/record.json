          "start": 283
        },
        "quote": "Any reference to the following codes in the IEBC will be deleted and replaced with the following codes:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.25.120:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
