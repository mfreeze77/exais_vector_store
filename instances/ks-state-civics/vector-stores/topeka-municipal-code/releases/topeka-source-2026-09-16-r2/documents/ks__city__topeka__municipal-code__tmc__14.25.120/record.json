        "locator": {
          "block_index": 3,
          "component_id": "c0c8544b-a9b7-5f0f-a1e2-a72792ce0029",
          "convention": "utf8_char_offset",
          "end": 505,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.25.120:block:3",
          "start": 387
        },
        "quote": "• International Property Maintenance Code is replaced with the property maintenance code, adopted in Chapter 8.60 TMC.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.25.120:block:3#text",
        "unavailable_reason": null
      },
      {
