{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.60.430","page_type":"section"},"citation":"10.60.430","citation_url":"https://topeka.municipal.codes/TMC/10.60.430","content_hash":"732406435a7a2d28c22887ef981b1efafddb2d10e98d51d12ec0e52ac3bea127","heading":"Application.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.430:section","source_url":"https://topeka.municipal.codes/TMC/10.60.430","text":"Applications for obtaining the benefits of TMC 10.60.420 shall be processed in the following manner:\n(a) Application shall be made in writing to the Traffic Engineer or Transportation Operations Superintendent.\n(b) The Traffic Engineer shall cause such application to be investigated and determine the necessity for the proposed loading zone as set forth in the application. (Ord. 17707 § 16, 7-31-01; Ord. 17635 § 16, 1-9-01. Code 1981 § 43-478. Code 1995 § 142-477.)\nCross References: Traffic Engineer, TMC 10.10.010 ; Transportation Operations Division, TMC 10.10.060 .","type":"section","workbench_component_id":"6743e6e4-19c2-5459-99ed-0e2bbee08ece"},{"attributes":{"block_kind":"paragraph"},"citation":"10.60.430","citation_url":"https://topeka.municipal.codes/TMC/10.60.430","content_hash":"aa394f9e0d5c5b6f3f1158e37ea2bd57cf4f85b544a03055dae02dba9b0c6caf","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.430:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.430:block:0","source_url":"https://topeka.municipal.codes/TMC/10.60.430","text":"Applications for obtaining the benefits of TMC 10.60.420 shall be processed in the following manner:","type":"paragraph","workbench_component_id":"112b96a8-780c-529c-ba3e-17a3ee11474e"},{"at