{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:8.80.060","page_type":"section"},"citation":"8.80.060","citation_url":"https://topeka.municipal.codes/TMC/8.80.060","content_hash":"89a5202d65c622ba500c4632b09f924ba1fc6470b996671135a524da8f096cac","heading":"Effect upon insurance policies.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.80.060:section","source_url":"https://topeka.municipal.codes/TMC/8.80.060","text":"This chapter shall not make the City a party to any insurance contract, nor is the insurer liable to any party for any amount in excess of the proceeds otherwise payable under its insurance policy. (Ord. 17226 § 100, 1-27-98. Code 1995 § 2-366.)\nState Law References: Similar provisions, K.S.A. 40-3908 .","type":"section","workbench_component_id":"1246c8a7-2a0f-5018-a147-32d4fdd35480"},{"attributes":{"block_kind":"paragraph"},"citation":"8.80.060","citation_url":"https://topeka.municipal.codes/TMC/8.80.060","content_hash":"0a18c5051fbdc44da34e76c385f1293ab00a9314780066d947d4c573617cf53d","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:8.80.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.80.060:block:0","source_url":"https://topeka.municipal.codes/TMC/8.80.060","text":"This chapter shall not make the City a party to any insurance contract, nor is the insurer liable to any party for any amount in excess of the proceeds otherwise payable under its insurance policy. (Ord. 17226 § 100, 1-27-98. Code 1995 § 2-366.)","type":"paragraph","workbench_component_id":"550637be-cdf9-59d4-aa07-07a16b126f71"},{"attributes":{"block_kind":"paragraph"},"citation":"8.80.060","citation_url":"https://topeka.municipal.codes/TMC/8.80.0