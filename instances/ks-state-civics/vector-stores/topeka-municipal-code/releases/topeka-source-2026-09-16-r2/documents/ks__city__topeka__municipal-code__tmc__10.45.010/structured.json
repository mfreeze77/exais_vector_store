{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.45.010","page_type":"section"},"citation":"10.45.010","citation_url":"https://topeka.municipal.codes/TMC/10.45.010","content_hash":"3bff828e5b345e213b6ddab22074cc46da9a0f8886f02e84464ce4bca11c8a88","heading":"Purpose.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.45.010:section","source_url":"https://topeka.municipal.codes/TMC/10.45.010","text":"The Council declares it to be necessary to exercise the City’s police power pursuant to K.S.A. 8-2002(a)(3) and establish procedures and regulations relating to funeral processions on the streets and highways of the City. (Code 1981 § 46-131. Code 1995 § 154-191.)","type":"section","workbench_component_id":"8819de0c-182d-531d-883e-b0a97e704727"},{"attributes":{"block_kind":"paragraph"},"citation":"10.45.010","citation_url":"https://topeka.municipal.codes/TMC/10.45.010","content_hash":"3bff828e5b345e213b6ddab22074cc46da9a0f8886f02e84464ce4bca11c8a88","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.45.010:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.45.010:block:0","source_url":"https://topeka.municipal.codes/TMC/10.45.010","text":"The Council declares it to be necessary to exercise the City’s police power pursuant to K.S.A. 8-2002(a)(3) and establish procedures and regulations relating to funeral processions on the streets and highways of the City. (Code 1981 § 46-131. Code 1995 § 154-191.)","type":"paragraph","workbench_component_id":"0497a906-dffe-54ad-90ba-5696f5f2af9c"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:10.45.010:section","schema":"exais.jurisdiction.structured_content.v1"}