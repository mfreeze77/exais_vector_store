          "convention": "utf8_char_offset",
          "end": 449,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:a2-30:block:1",
          "start": 296
        },
        "quote": "(b) Rules and journal. The governing body shall determine its own rules and order of business and shall provide for keeping a journal of its proceedings.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:a2-30:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
