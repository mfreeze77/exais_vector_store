          "start": 1414
        },
        "quote": "(3) Redeveloping vacant and underutilized properties through appropriately scaled in-fill development; and",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.185.020:block:6#text",
        "unavailable_reason": null
