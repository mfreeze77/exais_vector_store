{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.75.080","page_type":"section"},"citation":"10.75.080","citation_url":"https://topeka.municipal.codes/TMC/10.75.080","content_hash":"0fae5b3a5b66bd6bf9b7bb847ef1771dcebdb7719c6305b337f680a08292b7e1","heading":"Weight-bearing axles.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.080:section","source_url":"https://topeka.municipal.codes/TMC/10.75.080","text":"Any axle located within seven feet of any adjacent axle shall be a weight-bearing axle and shall at all times carry its proportionate part of the load permitted on such axles. (Code 1981 § 43-675. Code 1995 § 142-743.)","type":"section","workbench_component_id":"0404b308-0f5d-570f-a115-5ad89316450c"},{"attributes":{"block_kind":"paragraph"},"citation":"10.75.080","citation_url":"https://topeka.municipal.codes/TMC/10.75.080","content_hash":"0fae5b3a5b66bd6bf9b7bb847ef1771dcebdb7719c6305b337f680a08292b7e1","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.080:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.080:block:0","source_url":"https://topeka.municipal.codes/TMC/10.75.080","text":"Any axle located within seven feet of any adjacent axle shall be a weight-bearing axle and shall at all times carry its proportionate part of the load permitted on such axles. (Code 1981 § 43-675. Code 1995 § 142-743.)","type":"paragraph","workbench_component_id":"b407b06b-9d5f-50e1-87e4-93ffa29ea3fb"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.080:section","schema":"exais.jurisdiction.structured_content.v1"}