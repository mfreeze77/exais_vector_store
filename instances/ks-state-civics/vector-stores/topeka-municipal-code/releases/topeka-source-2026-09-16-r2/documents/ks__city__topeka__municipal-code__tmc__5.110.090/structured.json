{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.110.090","page_type":"section"},"citation":"5.110.090","citation_url":"https://topeka.municipal.codes/TMC/5.110.090","content_hash":"1cd5e8e59aae0cd89513a4a64d8261e975a582b29a684447b966b2d5aa49467d","heading":"Term of loan.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.110.090:section","source_url":"https://topeka.municipal.codes/TMC/5.110.090","text":"The term of any loan made under the provisions of this chapter shall be one month. Loans may be extended or renewed by the payment of the charges provided in this chapter monthly. (Code 1981 § 38-58. Code 1995 § 114-94.)\nState Law References: Similar provisions, K.S.A. 16-719 .","type":"section","workbench_component_id":"75826c60-389a-5516-bd52-873e706be266"},{"attributes":{"block_kind":"paragraph"},"citation":"5.110.090","citation_url":"https://topeka.municipal.codes/TMC/5.110.090","content_hash":"65f0621dae77883de66bb84c7e030aee1100e9f25114b30f3983d1aabfcc48e1","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.110.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.110.090:block:0","source_url":"https://topeka.municipal.codes/TMC/5.110.090","text":"The term of any loan made under the provisions of this chapter shall be one month. Loans may be extended or renewed by the payment of the charges provided in this chapter monthly. (Code 1981 § 38-58. Code 1995 § 114-94.)","type":"paragraph","workbench_component_id":"5b95f076-0046-59a9-b620-bd5a411c85d4"},{"attributes":{"block_kind":"paragraph"},"citation":"5.110.090","citation_url":"https://topeka.municipal.codes/TMC/5.110.090","content_hash":"cda1fa70da0f4715648b882df0c5ed582565e