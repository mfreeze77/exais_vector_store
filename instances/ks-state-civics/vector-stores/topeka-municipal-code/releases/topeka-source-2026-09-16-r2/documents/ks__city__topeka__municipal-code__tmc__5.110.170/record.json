        },
        "quote": "No license or any renewal thereof shall be granted under this article to:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.110.170 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "75867266-9953-5fc8-97c8-694ee308fb2c",
          "convention": "utf8_char_offset",
          "end": 131,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.110.170:block:1",
          "start": 74
        },
        "quote": "(a) Any person who is not a citizen of the United States;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.110.170 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "68678f20-0616-516d-97a3-2394f5a152f8",
          "convention": "utf8_char_offset",
          "end": 265,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.110.170:block:2",
          "start": 132
        },
        "quote": "(b) Any person who has not been an actual resident of the State for at least two years immediately preceding the date of application;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.110.170 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "a68dc8c6-25ff-5193-8aae-925930cc3d37",
          "convention": "utf8_char_offset",
          "end": 591,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.110.170:block:3",
          "start": 266
        },
        "quote": "(c) Any person who has been convicted of or has pleaded guilty to a felony under the laws of this State, or any other state or of the United States, or who shall have forfeited his bond to appear in court to answer charges for any such offense within the 10 years immediately prior to such person’s application for a license;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.110.170 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "1dbedd72-61fa-56ef-93f0-3e52d3fc3c4d",
          "convention": "utf8_char_offset",
          "end": 684,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.110.170:block:4",
          "start": 592
        },
        "quote": "(d) Any person who has had a license revoked for cause under the provisions of this chapter;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.110.170 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "311d77cc-4d95-5df8-b4a9-2bbd6ad5c60a",
          "convention": "utf8_char_offset",
          "end": 744,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.110.170:block:5",
          "start": 685
        },
        "quote": "(e) Any natural person who is not at least 21 years of age;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.110.170 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "6fad309b-be1b-5cf7-af06-6824e42c068b",
          "convention": "utf8_char_offset",
          "end": 908,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.110.170:block:6",
          "start": 745
        },
        "quote": "(f) Any person who at the time of application for renewal of any license issued under this article would not be eligible for such license upon a first application;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.110.170 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "7db5c532-431b-5ea0-88e6-2b784d14314f",
          "convention": "utf8_char_offset",
          "end": 1111,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.110.170:block:7",
          "start": 909
        },
        "quote": "(g) Any person who does not own the premises for which a license is sought, unless the person has a written lease therefor for at least three-fourths of the period for which the license is to be issued;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.110.170 block 8",
        "locator": {
          "block_index": 8,
          "component_id": "b3ea1c61-55f7-523a-ae7d-148c9bc1cf5d",
          "convention": "utf8_char_offset",
          "end": 1274,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.110.170:block:8",
          "start": 1112
        },
        "quote": "(h) Any person whose spouse would be ineligible to receive a license under this article for any reason other than the age, citizenship and residence requirements;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.110.170 block 9",
        "locator": {
          "block_index": 9,
          "component_id": "2767ae8b-98fc-5dcc-9b4e-adb0a051e3c4",
          "convention": "utf8_char_offset",
          "end": 1383,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.110.170:block:9",
          "start": 1275
        },
        "quote": "(i) Any partnership, unless all of the partners shall be eligible to receive a license as an individual; and",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:9#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.110.170 block 10",
        "locator": {
          "block_index": 10,
          "component_id": "fa4119c7-3eaa-5412-abcb-79611e6ce0d3",
          "convention": "utf8_char_offset",
          "end": 1643,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.110.170:block:10",
          "start": 1384
        },
        "quote": "(j) Any association or corporation, if any officer, manager, director or stockholder would be ineligible to receive a license as an individual for any reason other than the age, citizenship and residence requirements. (Code 1981 § 38-76. Code 1995 § 114-124.)",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.170:block:10#text",
        "unavailable_reason": null
      },
