        "quote": "(a) Each NCD shall meet all of the following criteria:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.270.030:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
