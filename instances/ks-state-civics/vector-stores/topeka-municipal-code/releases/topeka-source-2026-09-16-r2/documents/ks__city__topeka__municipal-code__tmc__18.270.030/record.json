          "start": 517
        },
        "quote": "(5) The area must be predominantly platted for a minimum of 40 years prior to the adoption of the district.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.270.030:block:5#text",
        "unavailable_reason": null
