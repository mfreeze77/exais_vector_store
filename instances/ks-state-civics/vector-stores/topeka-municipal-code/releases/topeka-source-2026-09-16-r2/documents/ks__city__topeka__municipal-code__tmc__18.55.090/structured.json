{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:18.55.090","page_type":"section"},"citation":"18.55.090","citation_url":"https://topeka.municipal.codes/TMC/18.55.090","content_hash":"861a8d3af99ba7412cfe565fd1591ec883137502138a82e63481b885df3733df","heading":"“I” definitions.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.090:section","source_url":"https://topeka.municipal.codes/TMC/18.55.090","text":"“Improvement” means any building, structure, place, work of art, or other object constituting a physical betterment of real property, or any part of such betterment.\n“Industrial park” is a special or exclusive type of planned industrial area designed and equipped to accommodate a community of industries, providing them with all necessary facilities and services in attractive surroundings among compatible neighbors.\n“Institution” means a building occupied by a nonprofit corporation or nonprofit establishment dedicated for public service.\n“Intensity” means the degree to which land is used.\n“Intersecting street” means any street, public way or court which joins another at an angle, whether or not it crosses the other. (Ord. 19370 § 103, 3-23-10. Code 1995 Appx. C, Art. XXXV.)","type":"section","workbench_component_id":"dc5b1cbb-85d0-565a-9e15-dc634107815e"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.090","citation_url":"https://topeka.municipal.codes/TMC/18.55.090","content_hash":"1a00c8a875c2038ebbfaa1be9097f07b30879968cfff925f3b96384bb4952535","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.090:block:0","source_url":"https://topeka.municipal.cod