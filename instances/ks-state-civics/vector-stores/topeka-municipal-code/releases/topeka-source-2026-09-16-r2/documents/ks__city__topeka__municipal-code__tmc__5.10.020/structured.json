ion":"5.10.020","citation_url":"https://topeka.municipal.codes/TMC/5.10.020","content_hash":"1f35374763df6ea4397bc1ba2128cacc29c7765ffdc8d418f132d040700a12ff","heading":null,"ordinal":18,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.10.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.10.020:block:18","source_url":"https://topeka.municipal.codes/TMC/5.10.020","text":"(vii)","type":"paragraph","workbench_component_id":"36543d01-186e-5066-a2fd-c1b00983d1bf"},{"attributes":{"block_kind":"paragraph"},"citation":"5.10.020","citation_url":"https://topeka.municipal.codes/TMC/5.10.020","content_hash":"8a58d90ead3cc95056bc5f156e2dd3a64346cab46a7a958788a77190ae520310","heading":null,"ordinal":19,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.10.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.10.020:block:19","source_url":"https://topeka.municipal.codes/TMC/5.10.020","text":"For 501 or more barrel daily capacity","type":"paragraph","workbench_component_id":"dc56912a-e512-5ea5-a359-8a1d7ed1dcb7"},{"attributes":{"block_kind":"paragraph"},"citation":"5.10.020","citation_url":"https://topeka.municipal.codes/TMC/5.10.020","content_hash":"68bb3faf0da372cf25ddb28cbf5d49e1ca09e71b3a968c37052c59a0ba50e7b9","heading":null,"ordinal":20,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.10.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.10.020:block:20","source_url":"https://topeka.municipal.codes/TMC/5.10.020","text":"Provided, that the words “daily capacity” as used in this section shall mean the average daily barrel production for the previous 12 months of manufacturing operations; provided further, that if no such basis for comparison exists, the manufacturing licensee shall pay in advance for operation during the first term of the license