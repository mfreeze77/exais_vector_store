        "locator": {
          "block_index": 1,
          "component_id": "5a01085c-4dc4-5afa-b002-155948907af3",
          "convention": "utf8_char_offset",
          "end": 965,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.30.190:block:1",
          "start": 563
        },
        "quote": "If the Director becomes aware of an emergency regarding a registrant’s equipment, the Director will attempt to contact the local representative of each registrant affected, or potentially affected, by the emergency. In any event, the Director may take whatever action deemed necessary to respond to the emergency, the cost of which shall be borne by the registrant whose equipment caused the emergency.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.30.190:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
