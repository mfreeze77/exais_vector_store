{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.30.020","page_type":"section"},"citation":"5.30.020","citation_url":"https://topeka.municipal.codes/TMC/5.30.020","content_hash":"db626e7f782b561a113b7a164254e317b29580c9ffbb030fbe5241b6ecc0eeb6","heading":"Prohibited devices.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.30.020:section","source_url":"https://topeka.municipal.codes/TMC/5.30.020","text":"It shall be unlawful for an operator or proprietor to permit any automatic amusement device to be installed, operated or maintained in a place of business, which device:\n(a) Has been designated by the Federal government or any department thereof as a gaming device and for which a Federal gaming device license is required; or\n(b) Has been designated by the laws of the State as a gambling device. (Code 1981 § 7-17. Code 1995 § 14-27.)\nState Law References: Unlawful possession of a gambling device, K.S.A. 21-6408 .","type":"section","workbench_component_id":"c5c68d72-fddf-597b-84b5-2ec5695af9bf"},{"attributes":{"block_kind":"paragraph"},"citation":"5.30.020","citation_url":"https://topeka.municipal.codes/TMC/5.30.020","content_hash":"ceb53ad78d0048873c202ce80be1ff1b3dc2dc1db49becd5938fca9e1f1ba488","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.30.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.30.020:block:0","source_url":"https://topeka.municipal.codes/TMC/5.30.020","text":"It shall be unlawful for an operator or proprietor to permit any automatic amusement device to be installed, operated or maintained in a place of business, which device:","type":"paragraph","workbench_component_id":"668fff71-914c-5e96-b6bf-e9d40fb8