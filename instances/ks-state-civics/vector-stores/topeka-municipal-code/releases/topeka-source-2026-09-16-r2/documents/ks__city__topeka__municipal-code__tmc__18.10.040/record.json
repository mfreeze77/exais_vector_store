        "quote": "The following types of signs are prohibited, except where specifically permitted by this chapter:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.040:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.10.040 block 1",
        "locator": {
          "block_index": 1,
