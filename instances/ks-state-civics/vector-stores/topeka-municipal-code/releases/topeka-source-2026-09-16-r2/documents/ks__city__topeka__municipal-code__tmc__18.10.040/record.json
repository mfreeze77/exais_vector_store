          "start": 1126
        },
        "quote": "(f) Any sign containing flashing, strobing, or chasing lights.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.040:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.10.040 block 9",
        "locator": {
          "block_index": 9,
