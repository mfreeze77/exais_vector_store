          "start": 696
        },
        "quote": "(1) May be confused with or construed as a traffic control sign, signal or device, or the light of an emergency vehicle; or",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.040:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.10.040 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "e270f4af-d2a0-55be-baf7-94cf745650d7",
          "convention": "utf8_char_offset",
          "end": 890,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.040:block:6",
          "start": 820
        },
        "quote": "(2) Obscures the view of any traffic or street sign, signal or device.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.040:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.10.040 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "db75a67c-80ec-57f0-9cc7-2642ba89d90c",
          "convention": "utf8_char_offset",
