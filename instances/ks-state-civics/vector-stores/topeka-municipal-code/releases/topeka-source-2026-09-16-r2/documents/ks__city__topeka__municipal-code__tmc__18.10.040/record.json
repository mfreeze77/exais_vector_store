          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.040:block:7",
          "start": 891
        },
        "quote": "(e) Portable message center signs, except when incorporated in a portable pedestrian sign allowed in accordance with the standards for incidental signs in TMC 18.10.130 and except where permitted as a temporary sign in TMC 18.10.170 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.040:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
