          "start": 587
        },
        "quote": "(d) Any sign which, by reason of its size, location, movement, content, coloring, or manner of illumination:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.040:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.10.040 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "e835ff5a-ab90-561c-a20c-f89b53c0aedc",
          "convention": "utf8_char_offset",
