          "convention": "utf8_char_offset",
          "end": 372,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.20.300:block:1",
          "start": 232
        },
        "quote": "(b) The Director may develop BMPs in individual wastewater discharge permits to implement local limits and the requirements of this section.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.300:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.20.300 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "03000976-5dcc-5c39-bce4-7cd25334bb04",
          "convention": "utf8_char_offset",
          "end": 783,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.20.300:block:2",
          "start": 373
        },
        "quote": "(c) No person shall discharge wastewater containing concentrations which will violate conditions found in this chapter or wastewaters which will violate the conditions established by the definitions of pass-through and interference. The Utilities Director reserves the right to define numerical discharge permit limits as outlined in this chapter for any parameters as may be needed to protect the POTW system.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.300:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.20.300 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "d6232b70-e93f-5950-a863-e408b55c2217",
          "convention": "utf8_char_offset",
          "end": 829,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.20.300:block:3",
          "start": 784
        },
        "quote": "(d) No person shall discharge any wastewater:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.300:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.20.300 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "81a36830-94ac-555f-9b5f-87a93218556a",
          "convention": "utf8_char_offset",
          "end": 1147,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.20.300:block:4",
          "start": 830
        },
        "quote": "(1) Having an average daily temperature higher than 140 degrees Fahrenheit that will inhibit biological activity in the treatment plant resulting in interference, but in no case wastewater which causes the temperature at the introduction into the treatment plant to exceed 104 degrees Fahrenheit (40 degrees Celsius).",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.300:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.20.300 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "5dd24d05-bdfa-57b8-8884-497f45f58712",
          "convention": "utf8_char_offset",
          "end": 1199,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.20.300:block:5",
          "start": 1148
        },
        "quote": "(2) Having a pH lower than 5.5 or higher than 10.8.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.300:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.20.300 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "8d62f073-5899-50a5-9924-530ad84f3b02",
          "convention": "utf8_char_offset",
          "end": 1494,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.20.300:block:6",
          "start": 1200
        },
        "quote": "(3) Having any water or waste containing fats, wax, grease or oils excluding soy or vegetable oil, whether emulsified or not, in excess of 100 mg/l or containing substances which may solidify or become viscous at temperatures between 32 and 150 degrees Fahrenheit (zero and 65 degrees Celsius).",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.300:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.20.300 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "a786dada-26f1-5444-9efc-ab83f886b178",
          "convention": "utf8_char_offset",
          "end": 1599,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.20.300:block:7",
          "start": 1495
        },
        "quote": "(4) Having any water or waste containing soy or vegetable oil, emulsified or not, in excess of 150 mg/l.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.300:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.20.300 block 8",
        "locator": {
          "block_index": 8,
          "component_id": "605a1a55-6a0d-5428-accc-88c9dbe9ba79",
          "convention": "utf8_char_offset",
