          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.185.080:block:6",
          "start": 689
        },
        "quote": "(5) All other uses not specified shall be consistent with Chapter 18.240 TMC.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.185.080:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.185.080 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "7a0aa672-1e79-5c4c-ba2e-3a6ba20deabf",
          "convention": "utf8_char_offset",
