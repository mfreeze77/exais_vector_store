          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.185.080:block:5",
          "start": 616
        },
        "quote": "(4) Retail and office uses: one space per 300 square feet of floor area.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.185.080:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
