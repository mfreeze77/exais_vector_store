          "component_id": "4c3dde4a-f8c1-5b02-a095-76f003accdc4",
          "convention": "utf8_char_offset",
          "end": 582,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.255.070:block:2",
          "start": 406
        },
        "quote": "(2) The owners of record of at least 75 percent of the properties within the local historic district provide written consent to the denomination of the local historic district.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.255.070:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
