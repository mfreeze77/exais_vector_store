          "start": 195
        },
        "quote": "(1) A local historic landmark or building, structure, site, or object within a district has no historic, architectural, archaeological, cultural importance or value to the viability of the historic district; or",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.255.070:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.255.070 block 2",
