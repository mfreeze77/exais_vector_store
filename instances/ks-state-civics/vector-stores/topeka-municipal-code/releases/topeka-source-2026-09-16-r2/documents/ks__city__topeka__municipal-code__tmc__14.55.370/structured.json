{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.55.370","page_type":"section"},"citation":"14.55.370","citation_url":"https://topeka.municipal.codes/TMC/14.55.370","content_hash":"2db1b1052124dee598c6038d0f2e8081dbd1fa890555748f6628b77e9413c249","heading":"Riser height.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.370:section","source_url":"https://topeka.municipal.codes/TMC/14.55.370","text":"Section R311.7.5.1, Riser height, is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nThe maximum riser height shall be 7 3/4 inches (196 mm); the minimum riser height shall be not less than 4 inches (102 mm). The riser shall be measured vertically between leading edges of the adjacent treads. The greatest riser height within any flight of stairs shall not exceed the smallest by more than 3/8 inch (9.5 mm).\n(Ord. 20467 § 20, 12-5-23.)","type":"section","workbench_component_id":"77f290e1-be71-520d-aa67-13a42c97d54b"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.370","citation_url":"https://topeka.municipal.codes/TMC/14.55.370","content_hash":"7c091973df29fbe1a18148778729f4c448ba5000c34c667fe9b0d8614eb5bef6","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.370:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.370:block:0","source_url":"https://topeka.municipal.codes/TMC/14.55.370","text":"Section R311.7.5.1, Riser height, is hereby deleted in its entirety and the following provisions shall be substituted therefor:","type":"paragraph","workbench_component_id":"51551fd1-351e-5742-9aa5-1024dc3fdc25"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.370","cita