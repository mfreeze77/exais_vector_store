{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:9.15.070","page_type":"section"},"citation":"9.15.070","citation_url":"https://topeka.municipal.codes/TMC/9.15.070","content_hash":"f917f38ff5b82a4318b56433bbbb2797fa1545275d5e8a1fe323fff823cab1ab","heading":"Hours of delivery.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.070:section","source_url":"https://topeka.municipal.codes/TMC/9.15.070","text":"It shall be unlawful for any wholesaler or distributor to sell or deliver any cereal malt beverages to any licensee within the City:\n(a) Before 6:00 a.m. or after 12:00 midnight Monday through Saturday;\n(b) Before 12:00 noon or after 8:00 p.m. on Sunday;\n(c) On any election day during the hours the polls are open; or\n(d) On Easter, Memorial Day, Independence Day, Labor Day, Thanksgiving Day or Christmas Day. (Ord. 18642 § 1, 5-16-06; Ord. 18523 § 1, 10-11-05. Code 1981 § 5-38(b). Code 1995 § 10-37.)","type":"section","workbench_component_id":"c5b1b4b4-57e4-5fbc-b058-cda411d7924f"},{"attributes":{"block_kind":"paragraph"},"citation":"9.15.070","citation_url":"https://topeka.municipal.codes/TMC/9.15.070","content_hash":"e31a6349ef49da54968cca017e66913d559660f7cff85ad3ce2add65d2fec3fb","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.070:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.070:block:0","source_url":"https://topeka.municipal.codes/TMC/9.15.070","text":"It shall be unlawful for any wholesaler or distributor to sell or deliver any cereal malt beverages to any licensee within the City:","type":"paragraph","workbench_component_id":"6eb5896e-b1b2-5fdd-ab91-a2dfe2cc98ba"},{"attributes":{"block_kind":"paragraph"},"c