          "start": 1041
        },
        "quote": "(2) One hundred dollars per violation for a second violation within a continuous 12-month period of the first violation.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.15.140:block:3#text",
        "unavailable_reason": null
      },
