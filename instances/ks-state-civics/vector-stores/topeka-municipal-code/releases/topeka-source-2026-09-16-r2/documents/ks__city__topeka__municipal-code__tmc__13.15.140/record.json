          "start": 986
        },
        "quote": "(1) Fifty dollars per violation for a first violation.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.15.140:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.15.140 block 3",
