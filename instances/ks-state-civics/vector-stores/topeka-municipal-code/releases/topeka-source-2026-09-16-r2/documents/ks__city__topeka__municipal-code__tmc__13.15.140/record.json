          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.15.140:block:1",
          "start": 741
        },
        "quote": "(a) The following administrative monetary penalties shall apply to violations of the provisions relating to construction activity, erosion and sediment control and stormwater management practices in Chapters 13.20 , 13.25 , 13.30 and 13.35 TMC:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.15.140:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.15.140 block 2",
        "locator": {
          "block_index": 2,
