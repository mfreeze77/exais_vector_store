          "start": 139
        },
        "quote": "Fire hose threads used in connection with standpipe systems shall be approved and shall be compatible with fire department hose threads.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.40.130:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
