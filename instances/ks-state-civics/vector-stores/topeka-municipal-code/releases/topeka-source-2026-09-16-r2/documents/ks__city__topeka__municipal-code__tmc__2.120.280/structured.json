{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:2.120.280","page_type":"section"},"citation":"2.120.280","citation_url":"https://topeka.municipal.codes/TMC/2.120.280","content_hash":"a407de1a3ca20206b156f88f635116ea3c2fccc93c8219bc360ebb9a2a38fef1","heading":"Contents of appeal.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.120.280:section","source_url":"https://topeka.municipal.codes/TMC/2.120.280","text":"Each appeal under TMC 2.120.270 shall contain the following:\n(a) A brief and concise statement of the facts surrounding the complaint.\n(b) The ordinance, regulation or policy the employee feels has been violated.\n(c) The date of the incident causing the grievance and the date the employee conferred with the supervisor.\n(d) A list of persons the employee intends to call as witnesses.\n(e) A list of any documents or written evidence the employee intends to use to substantiate the grievance.\n(f) The remedial action requested by the employee. (Ord. 20206 §§ 28, 86, 9-10-19.)","type":"section","workbench_component_id":"cf71ea21-c1c3-5212-80f8-abcff914b2e1"},{"attributes":{"block_kind":"paragraph"},"citation":"2.120.280","citation_url":"https://topeka.municipal.codes/TMC/2.120.280","content_hash":"9a40b718282537e8b64c04960fa83b9bbc109e23b30ec336767188501acfd759","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:2.120.280:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.120.280:block:0","source_url":"https://topeka.municipal.codes/TMC/2.120.280","text":"Each appeal under TMC 2.120.270 shall contain the following:","type":"paragraph","workbench_component_id":"c2fdbed4-67cd-5a61-924b-d219c339c83f"},{"attributes":{"block_kind":"paragraph"},"citation":"2.120.280","citation_url":"https://topeka.municipal.codes/TMC/2.120.280","content_hash":"3e346e21279de91bf20ea2ddabcd4c798d5f768737137c9fd072a1f55741d55d","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:2.120.280:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.120.280:block:1","source_url":"https://topeka.municipal.codes/TMC/2.120.280","text":"(a) A brief and concise statement of the facts surrounding the complaint.","type":"paragraph","workbench_component_id":"48db1a12-000e-5b78-9ffa-6e84b9b427ea"},{"attributes":{"block_kind":"paragraph"},"citation":"2.120.280","citation_url":"https://topeka.municipal.codes/TMC/2.120.280","content_hash":"bbca259078427ff2a675aaffa4e41f29c744ea2a962fe54d0c3e4711cc377a8a","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:2.120.280:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.120.280:block:2","source_url":"https://topeka.municipal.codes/TMC/2.120.280","text":"(b) The ordinance, regulation or policy the employee feels has been violated.","type":"paragraph","workbench_component_id":"0dd3437b-9b83-5b51-828f-6ba153a110a4"},{"attributes":{"block_kind":"paragraph"},"citation":"2.120.280","citation_url":"https://topeka.municipal.codes/TMC/2.120.280","content_hash":"bf29d930ef75e76bb80db9f53006a142254ee64300716bfaa035ceab539e2a53","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:2.120.280:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.120.280:block:3","source_url":"https://topeka.municipal.codes/TMC/2.120.280","text":"(c) The date of the incident causing the grievance and the date the employee conferred with the supervisor.","type":"paragraph","workbench_component_id":"834b71e3-9577-5302-b77b-c70bbd433652"},{"a