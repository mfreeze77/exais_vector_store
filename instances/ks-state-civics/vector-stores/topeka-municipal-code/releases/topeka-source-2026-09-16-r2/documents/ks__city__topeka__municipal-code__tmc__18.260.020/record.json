          "start": 968
        },
        "quote": "(b) Purpose. The purpose of these site plan regulations is to provide for a review of individual project site plans addressing:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.260.020:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
