,"citation":"18.55.200","citation_url":"https://topeka.municipal.codes/TMC/18.55.200","content_hash":"a01c4fb74449e37335bb59b8c370ab364dafb759081c62cc71b0a4c631701dc8","heading":null,"ordinal":10,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.200:block:10","source_url":"https://topeka.municipal.codes/TMC/18.55.200","text":"(4) A sole-source emitter with an average output of one kilowatt or less if used for amateur purposes;","type":"paragraph","workbench_component_id":"b94acfed-a4aa-57aa-9b5b-279298acce90"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.200","citation_url":"https://topeka.municipal.codes/TMC/18.55.200","content_hash":"9f59f37f1c675db1a26a3465298b66e7e3ff339d3498ceba0c668badf0a48f3f","heading":null,"ordinal":11,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.200:block:11","source_url":"https://topeka.municipal.codes/TMC/18.55.200","text":"(5) Marketed consumer products, such as microwave ovens, citizens band radios, and remote control toys; and","type":"paragraph","workbench_component_id":"22b46115-8791-5e21-a98d-a3f11279b597"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.200","citation_url":"https://topeka.municipal.codes/TMC/18.55.200","content_hash":"26493f53c859338850ef530ce1bfecabfe511ca12f5f7ea18c92dea780f6731a","heading":null,"ordinal":12,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.200:block:12","source_url":"https://topeka.municipal.codes/TMC/18.55.200","text":"(6) Goods in storage or shipment or on display for sale, provided the goods are not operated, except for occasional testing or demonstration.","type":"paragraph","workbench_component_id":"ca481bc6-a869-542f-a428-9c9b2a38e54f"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.200","citation_url":"https://topeka.municipal.codes/TMC/18.55.200","content_hash":"7a7a70872d36ed46743bada0068b1dab3c2665c9905ced2c3c2466c3bfd65c24","heading":null,"ordinal":13,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.200:block:13","source_url":"https://topeka.municipal.codes/TMC/18.55.200","text":"“Truck stop” means a facility that provides services to the trucking industry, including but not limited to the following: dispensing of fuel, repair shops for large trucks, automated washes, restaurants, motels, overnight sleeping quarters, parking areas for large trucks, resting areas for trucks and drivers, all as part of a primary use. (Ord. 20283 § 6, 3-2-21.)","type":"paragraph","workbench_component_id":"7fab6fc2-4f1a-5905-850e-da07eb0d44af"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.200:def:tap-tasting-room"},"citation":"18.55.200","citation_url":"https://topeka.municipal.codes/TMC/18.55.200","content_hash":"63d83fffccb5d232300001e6c53f64c13c051bad5a7faf25a4cc68fb6437f1a5","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.200:definition:0","source_url":"https://topeka.municipal.codes/TMC/18.55.200","text":null,"type":"definition","workbench_component_id":"5f9831a4-8912-5e0f-abcf-d4287543ec37"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.200:def:temporary-use"},"citation":"18.55.200","citation_url":"https://topeka.municipal.codes/TMC/18.55.200","content_hash":"a8794b957e1bdaa8eb1bf131552678044307a2f83da5fe883f34d3adba48323f","heading":null,"ordinal":1,"parent_source_component_key":"ks:c