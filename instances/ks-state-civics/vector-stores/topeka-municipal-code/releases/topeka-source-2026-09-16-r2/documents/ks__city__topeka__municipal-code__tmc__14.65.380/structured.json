riod of three years following the date of registration. (Ord. 17074 § 2, 1-28-97. Code 1981 § 25-137. Code 1995 § 98-187.)","type":"paragraph","workbench_component_id":"ebec8b60-64b2-5e07-af55-997896380e98"},{"attributes":{"block_kind":"paragraph"},"citation":"14.65.380","citation_url":"https://topeka.municipal.codes/TMC/14.65.380","content_hash":"b3690706389bc36b62ec0c62b3dea31a6dd0c29e5778164c15b68f9d4f0aa5e3","heading":null,"ordinal":6,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.380:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.380:block:6","source_url":"https://topeka.municipal.codes/TMC/14.65.380","text":"Cross References: Police Department, TMC 2.20.090 .","type":"paragraph","workbench_component_id":"a5acd4c5-ef16-51cb-b07a-95d88b9f2c3a"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.380:section","schema":"exais.jurisdiction.structured_content.v1"}