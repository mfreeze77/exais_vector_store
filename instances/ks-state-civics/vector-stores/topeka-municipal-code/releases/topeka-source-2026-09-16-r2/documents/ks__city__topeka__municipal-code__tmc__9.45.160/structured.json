{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:9.45.160","page_type":"section"},"citation":"9.45.160","citation_url":"https://topeka.municipal.codes/TMC/9.45.160","content_hash":"86a83a42a04f6dcdaee313674e066993a061fe9887c28673a4a755fa2a957faf","heading":"Standards.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.45.160:section","source_url":"https://topeka.municipal.codes/TMC/9.45.160","text":"The standards which shall be considered in determining whether a violation of this article exists shall include, but shall not be limited to, the following:\n(a) The volume of the noise;\n(b) The intensity of the noise;\n(c) Whether the nature of the noise is usual or unusual;\n(d) Whether the origin of the noise is natural or unnatural;\n(e) The volume and intensity of the background noise, if any;\n(f) The proximity of the noise to residences;\n(g) The nature and zoning of the area within which the noise emanates;\n(h) The density of the inhabitation of the area within which the noise emanates;\n(i) The time of the day or night the noise occurs;\n(j) The duration of the noise;\n(k) Whether the noise is recurrent, intermittent or constant; and\n(l) Whether the noise is produced by a commercial or noncommercial activity. (Ord. 19775 § 1, 10-23-12.)","type":"section","workbench_component_id":"dc60f197-1dbc-5ae6-9e64-64d402f99a5e"},{"attributes":{"block_kind":"paragraph"},"citation":"9.45.160","citation_url":"https://topeka.municipal.codes/TMC/9.45.160","content_hash":"338290132509f65de8d9dda42f4e4a6948a12f005df61e8b023ff2ea125d8a39","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.45.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.45.160:block:0","source_url":"https://topeka.municipal.codes/TMC/9.45.160","text":"The standards which shall be considered in determining whether a violation of this article exists shall include, but shall not be limited to, the following:","type":"paragraph","workbench_component_id":"46037de3-561c-5292-a3fc-a0d7be6350a8"},{"attributes":{"block_kind":"paragraph"},"citation":"9.45.160","citation_url":"https://topeka.municipal.codes/TMC/9.45.160","content_hash":"f82a6b6b5fe2e377ec17f9c55f94d77af0369ccef087ebcc4f895a5005f09c92","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.45.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.45.160:block:1","source_url":"https://topeka.municipal.codes/TMC/9.45.160","text":"(a) The volume of the noise;","type":"paragraph","workbench_component_id":"51debb1f-26c9-58ed-b028-c74d0227fa14"},{"attributes":{"block_kind":"paragraph"},"citation":"9.45.160","citation_url":"https://topeka.municipal.codes/TMC/9.45.160","content_hash":"015f7d38c7953c1eee911397064293cedc1f4621bfe57ad7be63e2d577d586d6","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.45.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.45.160:block:2","source_url":"https://topeka.municipal.codes/TMC/9.45.160","text":"(b) The intensity of the noise;","type":"paragraph","workbench_component_id":"dfc4a819-040d-5c37-90fd-06a3c8747bae"},{"attributes":{"block_kind":"paragraph"},"citation":"9.45.160","citation_url":"https://topeka.municipal.codes/TMC/9.45.160","content_hash":"d3275c223d0941d4a8ed6f1e8f40877602347826cf0669dc56e147676a3ef52e","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.45.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.45.160:block:3","source_url":"