        },
        "quote": "The following words, terms and phrases, when used in this chapter, shall have the meanings ascribed to them in this section, except where the context clearly indicates a different meaning:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.30.010:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.30.010 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "0121e110-3bf7-576b-a6b1-f0c7fe6056d2",
          "convention": "utf8_char_offset",
          "end": 382,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.30.010:block:1",
          "start": 189
        },
        "quote": "“Arcade” means an establishment or premises in or at which 20 or more automatic amusement or musical devices are placed or kept for use or play, or on exhibition for the purpose of use or play.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.30.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.30.010 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "4a326b79-127f-5e6f-b2a6-5f12f80d36cc",
          "convention": "utf8_char_offset",
          "end": 611,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.30.010:block:2",
          "start": 383
        },
        "quote": "“Automatic amusement device” means a machine or device which, upon the insertion of a coin, slug or similar object, or by any other method, operates or may be operated or used for a game, contest or amusement of any description.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.30.010:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.30.010 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "5c113f4a-c6c6-5ca5-af6d-3f60c6139e85",
          "convention": "utf8_char_offset",
          "end": 781,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.30.010:block:3",
          "start": 612
        },
        "quote": "“Automatic musical device” means a machine or device which, upon the insertion of a coin, slug or similar object, operates or may be operated to produce music therefrom.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.30.010:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.30.010 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "207fe8c3-ea4b-5aaf-a1a1-3c6f2cb1323f",
          "convention": "utf8_char_offset",
          "end": 1043,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.30.010:block:4",
          "start": 782
        },
        "quote": "“Operator” means, when applied to automatic musical or amusement devices, any person engaged in the business of furnishing for gain automatic musical and amusement devices to any person, proprietor or arcade for use in any place, public or private, in the City.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.30.010:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.30.010 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "eaafd510-4e24-5af4-bcc8-c82e77e0b24b",
          "convention": "utf8_char_offset",
          "end": 1407,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.30.010:block:5",
          "start": 1044
        },
        "quote": "“Proprietor” means any person, firm, corporation, partnership, association or a club who, as the owner, lessee or proprietor, has under his control any establishment, place or premises in or at which an automatic amusement or musical device is placed or kept for use or play, or on exhibition for the purpose of use or play. (Code 1981 § 7-16. Code 1995 § 14-26.)",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.30.010:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.30.010 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "2fb17e7a-0b86-5502-90a6-df723dc3f901",
          "convention": "utf8_char_offset",
          "end": 1463,
