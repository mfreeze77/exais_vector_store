{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:9.15.050","page_type":"section"},"citation":"9.15.050","citation_url":"https://topeka.municipal.codes/TMC/9.15.050","content_hash":"69f74f55c5e31a1b5ccedaee854851b8206f46ac622fcf713b7e9dc9b921f647","heading":"Possession of alcoholic liquor on premises licensed to sell cereal malt beverage.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.050:section","source_url":"https://topeka.municipal.codes/TMC/9.15.050","text":"Except for beer, it shall be unlawful for any person to possess or consume any other alcoholic liquor in a licensed premises selling cereal malt beverages, unless the premises is also currently licensed by the State Director of Alcoholic Beverage Control. (Ord. 20175 § 20, 3-12-19.)\nState Law References: Similar provisions, K.S.A. 41-2704 .","type":"section","workbench_component_id":"cc0a3d20-d9a8-5828-8986-5e3acc3dce32"},{"attributes":{"block_kind":"paragraph"},"citation":"9.15.050","citation_url":"https://topeka.municipal.codes/TMC/9.15.050","content_hash":"8625c788f7d2761c433b244c8b6b62d2ee9d913c4f6a98417c44b7986eeea9e2","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.050:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.050:block:0","source_url":"https://topeka.municipal.codes/TMC/9.15.050","text":"Except for beer, it shall be unlawful for any person to possess or consume any other alcoholic liquor in a licensed premises selling cereal malt beverages, unless the premises is also currently licensed by the State Director of Alcoholic Beverage Control. (Ord. 20175 § 20, 3-12-19.)","type":"paragraph","workbench_component_id":"ce8f50f7-248c-5438-837e-1e3a07e82