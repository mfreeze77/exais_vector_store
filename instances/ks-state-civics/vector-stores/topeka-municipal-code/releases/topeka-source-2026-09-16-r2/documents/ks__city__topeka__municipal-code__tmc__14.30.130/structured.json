{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.30.130","page_type":"section"},"citation":"14.30.130","citation_url":"https://topeka.municipal.codes/TMC/14.30.130","content_hash":"5bc5b007a80e780e0d57fc7d3bfdb6dc8e6cb9afa39c903e3ebef0ed52ed7a95","heading":"Permit.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.30.130:section","source_url":"https://topeka.municipal.codes/TMC/14.30.130","text":"(a) Required. Every person, before entering upon any construction or erection of any electric light or power wiring in any new building in the City, any original installation in any building or any alteration, shall make application to the Development Services Director for a construction permit describing the proposed work before proceeding therewith.\n(b) Exception. An electrical permit is not required if the project doesn’t require a building permit and the installation meets the following requirements:\n(1) General electrical maintenance.\n(2) Replacement of existing toggle switches or receptacles.\n(3) Replacement of not more than 30 lighting fixtures.\n(4) Extension of an existing 125 volt, 15 or 20 amp branch circuit not more than four openings and 30 feet in length with the exception of locations covered by Chapters 5 through 7 of the National Electrical Code. (Ord. 19601 § 3, 7-12-11.)","type":"section","workbench_component_id":"02eeddd7-5d35-5525-b7e7-5a6a947045f0"},{"attributes":{"block_kind":"paragraph"},"citation":"14.30.130","citation_url":"https://topeka.municipal.codes/TMC/14.30.130","content_hash":"2199537e9e37c925c9a877208d4cc46a2d2eee886a0eef316ae0484dc761a4e4","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.30.130:section","schema":"exais.workbench_component.v1","source_c