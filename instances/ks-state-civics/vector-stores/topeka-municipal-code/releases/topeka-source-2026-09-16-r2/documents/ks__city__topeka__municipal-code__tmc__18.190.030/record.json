        "locator": {
          "block_index": 3,
          "component_id": "a3e4eaf5-3a66-57cc-8de3-26c48e54cd09",
          "convention": "utf8_char_offset",
          "end": 1106,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.190.030:block:3",
          "start": 782
        },
        "quote": "(3) Provided that all applicable limitations, provisions and conditions specified by use and set forth in this district are complied with, there may be use changes or relocations within each group category; provided, that the approved plan is not modified except as otherwise provided for by the procedures of this district.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.190.030:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.190.030 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "cde04091-4f98-57c1-b281-fc55618187fa",
          "convention": "utf8_char_offset",
