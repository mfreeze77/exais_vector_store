          "convention": "utf8_char_offset",
          "end": 537,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.55.380:block:2",
          "start": 526
        },
        "quote": "Exceptions:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.55.380:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
