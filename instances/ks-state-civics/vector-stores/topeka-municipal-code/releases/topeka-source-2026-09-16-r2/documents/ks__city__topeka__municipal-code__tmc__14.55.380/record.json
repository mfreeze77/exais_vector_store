          "start": 538
        },
        "quote": "1. Handrails shall be permitted to be interrupted by a newel post at the turn.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.55.380:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
