          "block_index": 1,
          "component_id": "9c623e83-ab24-5d81-9ef6-30cc9e156983",
          "convention": "utf8_char_offset",
          "end": 525,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.55.380:block:1",
          "start": 126
        },
        "quote": "Handrails for stairways shall be continuous for the full length of the flight, from a point directly above the top riser of the flight to a point directly above the lowest riser of the flight. Handrail ends shall be returned or shall terminate in newel posts or safety terminals. Handrails adjacent to a wall shall have a space of not less than 1 1/2 inch (38 mm) between the wall and the handrails.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.55.380:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 14.55.380 block 2",
        "locator": {
