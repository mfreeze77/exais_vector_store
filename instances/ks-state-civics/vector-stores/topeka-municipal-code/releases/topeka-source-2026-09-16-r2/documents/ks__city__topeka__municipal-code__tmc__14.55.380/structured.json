{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.55.380","page_type":"section"},"citation":"14.55.380","citation_url":"https://topeka.municipal.codes/TMC/14.55.380","content_hash":"39f37bdaee672bf7004d0aa12c588e38b88e1c72bdb177bfd01fd02dc7fdf037","heading":"Continuity.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.380:section","source_url":"https://topeka.municipal.codes/TMC/14.55.380","text":"Section R311.7.8.4, Continuity, is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nHandrails for stairways shall be continuous for the full length of the flight, from a point directly above the top riser of the flight to a point directly above the lowest riser of the flight. Handrail ends shall be returned or shall terminate in newel posts or safety terminals. Handrails adjacent to a wall shall have a space of not less than 1 1/2 inch (38 mm) between the wall and the handrails.\nExceptions:\n1. Handrails shall be permitted to be interrupted by a newel post at the turn.\n2. The use of a volute, turnout, starting easing or starting newel shall be allowed over the lowest tread.\n3. Where walls are non-continuous, alternative non-continuous handrails may be approved by the building official on a case-by-case basis.\n(Ord. 20467 § 21, 12-5-23.)","type":"section","workbench_component_id":"d96860b3-0c35-535f-8b77-1af1aa29f287"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.380","citation_url":"https://topeka.municipal.codes/TMC/14.55.380","content_hash":"725ee0001b0c3f1d85e2bc78cf5bb7ff8eea1111d66d982def6bfa5d879c2876","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.380:section","schema":"exais.workbench_component.v1","source_componen