        "locator": {
          "block_index": 3,
          "component_id": "11126b3f-f81c-5024-b8cf-eed3d1c83972",
          "convention": "utf8_char_offset",
          "end": 1110,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:8.60.140:block:3",
          "start": 838
        },
        "quote": "A person, corporation, partnership or group, whether or not the legal owner of record, occupying a building or portion thereof as a unit. When the occupant is not the owner, the occupant shall be considered a Tenant only when occupancy is with the permission of the owner.",
