          "start": 696
        },
        "quote": "The definition of “Tenant” as set forth in Section 202 is deleted in its entirety and the following provisions shall be substituted therefor:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:8.60.140:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
