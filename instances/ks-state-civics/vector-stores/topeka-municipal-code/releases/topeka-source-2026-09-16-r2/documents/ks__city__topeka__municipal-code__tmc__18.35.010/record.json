          "start": 1470
        },
        "quote": "(10) Real estate taxes and special assessments on the property proposed to be platted or replatted are not delinquent.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.35.010:block:10#text",
        "unavailable_reason": null
