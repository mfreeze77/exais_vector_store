{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:12.50.030","page_type":"section"},"citation":"12.50.030","citation_url":"https://topeka.municipal.codes/TMC/12.50.030","content_hash":"6dfc94b47f2df2fbbcebb2d941764114c86ca0249039e2969a3b0028c5ceb230","heading":"Widening street roadway.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.50.030:section","source_url":"https://topeka.municipal.codes/TMC/12.50.030","text":"The Council hereby reserves the right to cause the roadways of any streets of the City to be widened without incurring any liability for damages on the part of the City by reason thereof. (Code 1981 § 40-201. Code 1995 § 130-423.)\nCross References: City Council – Mayor, Chapter 2.15 TMC.","type":"section","workbench_component_id":"d351e5fd-d813-5520-9a51-07cd7dc718a2"},{"attributes":{"block_kind":"paragraph"},"citation":"12.50.030","citation_url":"https://topeka.municipal.codes/TMC/12.50.030","content_hash":"e3c108d8ff622afcb377a511284151e280c8eef8d3debc0efb0ba018cd834a3a","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:12.50.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.50.030:block:0","source_url":"https://topeka.municipal.codes/TMC/12.50.030","text":"The Council hereby reserves the right to cause the roadways of any streets of the City to be widened without incurring any liability for damages on the part of the City by reason thereof. (Code 1981 § 40-201. Code 1995 § 130-423.)","type":"paragraph","workbench_component_id":"6a38ae4d-5467-5b2c-a45b-e0a7b868552b"},{"attributes":{"block_kind":"paragraph"},"citation":"12.50.030","citation_url":"https://topeka.municipal.codes/TMC/12.50.030","content_hash":"d41ed9