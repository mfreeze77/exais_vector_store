{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.65.390","page_type":"section"},"citation":"14.65.390","citation_url":"https://topeka.municipal.codes/TMC/14.65.390","content_hash":"97158252e29ca796e89e9472ac6ee81a22e3c1a71ff2ef93daccfcb2a25a50a5","heading":"Notification of occupants of article contents.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.390:section","source_url":"https://topeka.municipal.codes/TMC/14.65.390","text":"The mobile home park management shall notify the occupants of the mobile home park of all applicable provisions of this article and inform them of their duties and responsibilities under this article. (Code 1981 § 25-138. Code 1995 § 98-188.)","type":"section","workbench_component_id":"56b1f52a-b2a1-5612-8741-5fae64b88326"},{"attributes":{"block_kind":"paragraph"},"citation":"14.65.390","citation_url":"https://topeka.municipal.codes/TMC/14.65.390","content_hash":"97158252e29ca796e89e9472ac6ee81a22e3c1a71ff2ef93daccfcb2a25a50a5","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.390:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.390:block:0","source_url":"https://topeka.municipal.codes/TMC/14.65.390","text":"The mobile home park management shall notify the occupants of the mobile home park of all applicable provisions of this article and inform them of their duties and responsibilities under this article. (Code 1981 § 25-138. Code 1995 § 98-188.)","type":"paragraph","workbench_component_id":"633dfdeb-7225-5dc5-b351-cc6f58695475"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.390:section","schema":"exais.jurisdiction.structured_content.v1"}