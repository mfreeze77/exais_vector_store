{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.35.500","page_type":"section"},"citation":"14.35.500","citation_url":"https://topeka.municipal.codes/TMC/14.35.500","content_hash":"535d897f47559f04ecc3df04cd4648f677db6341f8d33ebdba229457fb174311","heading":"Purpose.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.500:section","source_url":"https://topeka.municipal.codes/TMC/14.35.500","text":"The purpose of this article is to:\n(a) Protect the public potable water supply of the City from pollution or contamination due to cross connection in accordance with the provisions of K.S.A. 65-163a , 65-171g , and any administrative regulations thereto;\n(b) Prohibit and eliminate all cross connections within the public potable water supply system; and\n(c) Provide for the maintenance of a continuing effective cross connection control program and thus protect the public health. (Code 1981 § 10-292. Code 1995 § 26-447.)","type":"section","workbench_component_id":"de86ebb6-2eba-53f5-a999-7c6a35b0a6dd"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.500","citation_url":"https://topeka.municipal.codes/TMC/14.35.500","content_hash":"a3336b98b22f083990b4f1221b0452ae86179e3485406da765c37445adcd98e6","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.500:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.500:block:0","source_url":"https://topeka.municipal.codes/TMC/14.35.500","text":"The purpose of this article is to:","type":"paragraph","workbench_component_id":"f4bdcec1-2cb4-5ecf-bf88-0395e8a9b1fc"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.500","citation_url":"https://topeka.municipal.codes/TMC/14.35.50