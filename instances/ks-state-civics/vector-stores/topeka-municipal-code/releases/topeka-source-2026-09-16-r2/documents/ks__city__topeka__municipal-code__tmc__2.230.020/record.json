        "locator": {
          "block_index": 5,
          "component_id": "3ccad65b-9065-52bb-8107-648145d2ff93",
          "convention": "utf8_char_offset",
          "end": 834,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:2.230.020:block:5",
          "start": 730
        },
        "quote": "(e) May apply for or suggest sources of funds for preservation, acquisition, and restoration activities.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.230.020:block:5#text",
        "unavailable_reason": null
      },
      {
