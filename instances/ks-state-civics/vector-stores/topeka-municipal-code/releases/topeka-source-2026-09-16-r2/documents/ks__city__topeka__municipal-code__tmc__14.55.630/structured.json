{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.55.630","page_type":"section"},"citation":"14.55.630","citation_url":"https://topeka.municipal.codes/TMC/14.55.630","content_hash":"936f36ab0f638c8fbb7fea34b05e8833efb9a5d2cfb06524c3b97f3d1b8b5ec4","heading":"Flue area (appliance).","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.630:section","source_url":"https://topeka.municipal.codes/TMC/14.55.630","text":"Section R1003.14, Flue area (appliance), is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nChimney flues shall not be smaller in area than that of the area of the connector from the appliance [see Tables R1003.14(1) and R1003.14(2)]. The sizing of a chimney flue to which multiple appliance venting systems are connected shall be in accordance with the currently adopted edition of the Uniform Mechanical Code.\n(Ord. 19727 § 60, 4-24-12.)","type":"section","workbench_component_id":"a820438e-7d9b-5fa0-b747-c13baf09ef4e"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.630","citation_url":"https://topeka.municipal.codes/TMC/14.55.630","content_hash":"30687a4c8c0e10776297f4f25833e59ea2f65e25622c157bf4c445de52706704","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.630:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.630:block:0","source_url":"https://topeka.municipal.codes/TMC/14.55.630","text":"Section R1003.14, Flue area (appliance), is hereby deleted in its entirety and the following provisions shall be substituted therefor:","type":"paragraph","workbench_component_id":"09b776d3-f37d-5840-be3a-32cd4abae1be"},{"attributes":{"block_kind":"paragraph"},"citation"