        "locator": {
          "block_index": 6,
          "component_id": "6d92e834-03e3-59ae-8a29-cd8654bc0b97",
          "convention": "utf8_char_offset",
          "end": 1709,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.75.010:block:6",
