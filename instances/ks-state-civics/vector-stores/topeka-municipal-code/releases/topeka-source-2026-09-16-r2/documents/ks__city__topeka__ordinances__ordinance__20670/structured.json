{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"media_type":"application/octet-stream","origin":"acquisition"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"b59e094026eb207fea01051867ecc17ce068bf4742d31461d09199a7bac97be4","heading":null,"ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":null,"type":"instrument","workbench_component_id":"13ff3683-6a98-5545-838d-41659d606835"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"eb684a96fa58a4e6ef646ad92a7c23fba49224764d74e72610f611db45987e0c","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:0","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"ORDINANCE NO. 20670","type":"paragraph","workbench_component_id":"d2f5a270-7b45-5b95-9c10-f74eb31fb76f"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"968e091e1cb614e8b1832d0cea92e4728918a34dd96bea5a5a01281dded746b9","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:1","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"AN ORDINANCE introduced by Councilmember Murray McGee, Christina Valdivia-Alcala and Michelle Bradberry implementing a temporary moratorium on the acceptance, processing, and approval of applications for data center development.","type":"paragraph","workbench_component_id":"3cd51f8a-5942-53d6-860a-40638c9d4f35"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"f780e2823e44b0a3398eb9f7b34b9a97cd03e9627558233477729ab92fce17b2","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:2","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"WHEREAS, the Governing Body of the City of Topeka, Kansas possesses the authority to promulgate policies, rules, and regulations, and to enact laws that promote the general health, safety, and welfare of the community; and","type":"paragraph","workbench_component_id":"9d2ccde9-e2e6-5b62-8791-4075ce12a88c"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"d35692028ba38cfd9d8521c89ff4151c4041e752cc32abc408c39abee194e111","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:3","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"WHEREAS, pursuant to that authority and in accordance with state law, the City has adopted zoning laws and regulations and a comprehensive plan; and","type":"paragraph","workbench_component_id":"0c8ad51f-d3ff-5abd-b088-06dc717fab4c"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"3c263437f8107d2f44d0dee27c40ce3a5cf50a9f242833646ff49ebe338196c1","heading":null,"ordinal":4,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:4","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"WHEREAS, the Topeka Municipal Code does not currently address or regulate the development of data centers; and","type":"paragraph","workbench_component_id":"654ee7ee-08c9-5f51-9a5e-5affa83937a1"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"96b9a9246892fecc1af45f4575fdd1fe171c72104f0bf794f8eac0d7b30f4e85","heading":null,"ordinal":5,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:5","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"WHEREAS, concerns about the lack of regulations governing development of data centers and related activities in the incorporated limits of the City of Topeka have been raised; and","type":"paragraph","workbench_component_id":"00f9f2dd-0d28-5cf5-9693-dee8681ba1ad"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"0d37282494b065240889de888362b817519d4cab07a5b36029780225735da693","heading":null,"ordinal":6,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:6","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"WHEREAS, the City recognizes that municipal officials need adequate time to evaluate the impact that large-scale data center developments may have on the health, safety, and welfare of the community and time to draft appropriate zoning, environmental, and infrastructure regulations; and","type":"paragraph","workbench_component_id":"e46b4de4-5778-5842-abad-1ae512e3d6f7"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"d03ccadc9aa915ae2fa75657d7dfbbc9944428e00d21564b5dd84eaa5b03d60c","heading":null,"ordinal":7,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:7","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"WHEREAS, the City desires to provide adequate time for municipal officials to research the impact of data centers and draft appropriate regulations and therefore find that a twelve-month temporary moratorium on the development of data centers is both necessary and appropriate; and","type":"paragraph","workbench_component_id":"7a67809e-3c42-5a59-9af6-da7657a00e1c"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"806092703f4e41ccd3d9357c127988ec70ad46c7fe9867c79f05781fe84ce35b","heading":null,"ordinal":8,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:8","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"WHEREAS, for the purposes of this ordinance, “data center” is defined as any freestanding facility or portion of a larger structure that primarily houses electronic equipment used to process, store, or transmit digital information, requiring specialized environmental control or cooling systems, large battery systems, battery energy storage systems and similarly functioning energy systems.","type":"paragraph","workbench_component_id":"9ef7ee6b-a51a-5f66-b008-e9945c8d91fa"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"e95b1911b3ca5264ac9577a46b0f49f2e8d82b1272d59ab765d72833ab2acb57","heading":null,"ordinal":9,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:9","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"NOW, THEREFORE, BE IT ORDAINED BY THE GOVERNING BODY OF THE CITY OF TOPEKA, KANSAS, that:","type":"paragraph","workbench_component_id":"6ad2bf34-0beb-54fe-b3da-7fc47443551b"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"4c501e3be51fa230341b1e32b4e98d22d935f73523fe6a99a501ede1788a687f","heading":null,"ordinal":10,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:10","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"Section 1. The above recitals are incorporated herein by reference as if set forth in full.","type":"paragraph","workbench_component_id":"040cf0ad-7c20-53e4-9026-f67b80b1f136"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"e106a78f4117916be38e6a7591e3c2e497930a2533498f1bf8382d9094bc2cb7","heading":null,"ordinal":11,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:11","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"Section 2. The Governing Body hereby establishes and imposes, within the City limits, a twelve-month temporary moratorium on the acceptance, processing, and approval of data center applications. No City official, board, or body shall accept, process, review, approve, or issue any zoning permits, building permits, site plan approvals, or utility connections requests for the establishment or expansion of any data center located within the City limits from the effective date of this ordinance until either twelve months from the effective date of this ordinance or until the Governing Body amends or repeals this ordinance, whichever occurs earlier.","type":"paragraph","workbench_component_id":"403e55a3-3e4f-5d51-95e9-b2d525fbe022"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"f7e22f33fe541b9bf4b31171dacc8ae51721eeee1c2faf2282b3bd02b0ab4c6b","heading":null,"ordinal":12,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:12","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"Section 3. This moratorium shall not apply to any data center applications that have received final formal approval prior to the effective date of this ordinance, nor to routine maintenance, equipment upgrades or improvements of existing permitted data centers that do not increase the footprint or utility load of the facility.","type":"paragraph","workbench_component_id":"fd109d2c-e1b9-5142-96f1-da7dc2b565f9"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"9051b67a1b71e9194d94c4776be35fd5c086aab35f98b46ba29c21b1ddd9bced","heading":null,"ordinal":13,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:13","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"Section 4. If any section, sentence, clause, or phrase of this ordinance is found to be unconstitutional or is otherwise held invalid by any court of competent jurisdiction, it shall not affect the validity of any remaining parts of this ordinance.","type":"paragraph","workbench_component_id":"543c1e14-ea94-57e8-981d-30982f13275c"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"dfd3d18c95b117f7a1512e8f92ffb9355458e892cde3e46754efe82a41dd71ab","heading":null,"ordinal":14,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:14","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"Section 5. This ordinance shall take effect and be in full force and effect from and after its passage and publication by law and shall remain in full force and effect for a period of twelve months from its date of adoption, or until such times as the Governing Body amends or repeals this ordinance, whichever occurs first.","type":"paragraph","workbench_component_id":"4be34b5b-f3d1-5fee-9958-a5749e3f00cf"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"1c147b99f312b79a4f30b3adc7382a13787b10dd98fe50629f540cd8ec5b4a64","heading":null,"ordinal":15,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:15","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"PASSED AND APPROVED by the City Council on July 14, 2026.","type":"paragraph","workbench_component_id":"a1ba0fba-87b9-5e14-8fc3-b10db059df16"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"5b1298614c3018a6469afe5fcc81fa01bdf1dbf66cc614a508fd561f728cb956","heading":null,"ordinal":16,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:16","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"CITY OF TOPEKA, KANSAS","type":"paragraph","workbench_component_id":"d0130fe1-88bb-5a56-8ae7-6198a6d668a0"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"6932e98e0e68b2d26e4a832d4d7b48d6e4180ba2eb8cbb79e8e31e90fda6b319","heading":null,"ordinal":17,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:17","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"__________________________________","type":"paragraph","workbench_component_id":"6132bca9-8248-5044-9e9a-4e7cc22294ea"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"f7dcd915c3c1e2788465743fb60ebdd15a3116374944cc588b407bced3e8ba26","heading":null,"ordinal":18,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:18","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"Spencer L. Duncan, Mayor","type":"paragraph","workbench_component_id":"b455c1ff-e2d2-52a0-871e-41100bf21d2c"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"eef18d2413350ba46fa8bec58ba27bfd2b8976a236a0cb7281adc18cd3e6ca8d","heading":null,"ordinal":19,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:19","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"ATTEST:","type":"paragraph","workbench_component_id":"0abbf6db-eebf-5f74-9ef2-ee15d2d503aa"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"0ebe2fe703bb2c4235a5946026926bd4abe8ae48ad5920981ceb5d6df4bbe37a","heading":null,"ordinal":20,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:20","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"________________________________","type":"paragraph","workbench_component_id":"db2302e2-8623-5f4c-96a6-c7b714fdf6fa"},{"attributes":{"block_kind":"paragraph"},"citation":"20670","citation_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","content_hash":"229740c4aa28ae23527cc75fb54ad6d2562460e673892bc30bc64d4792bea5d4","heading":null,"ordinal":21,"parent_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:ordinances:ordinance:20670:block:21","source_url":"https://files.topeka.gov/community/ordinances/2026/Ordinance20670+.docx","text":"Brenda Younger, City Clerk","type":"paragraph","workbench_component_id":"84319dd5-fcd5-571f-80cd-48f266439a5e"}],"root_source_component_key":"ks:city:topeka:ordinances:ordinance:20670:document","schema":"exais.jurisdiction.structured_content.v1"}