{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.55.470","page_type":"section"},"citation":"14.55.470","citation_url":"https://topeka.municipal.codes/TMC/14.55.470","content_hash":"4b71c73e0a575c6a8b431ec6e82cb878a5b33fb39281ce2dac0c4146731dbc2c","heading":"Minimum depth.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.470:section","source_url":"https://topeka.municipal.codes/TMC/14.55.470","text":"Section R403.1.4, Minimum depth, is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nAll exterior footings shall be placed not less than 12 inches (305 mm) below undisturbed ground surface and at least 36 inches (915 mm) below the final grade. Where applicable, the depth of footings shall also conform to Sections R403.1.4.1 through R403.1.4.2.\nException: Floating footings for detached garages and storage sheds 24 feet x 24 feet and under when constructed per City of Topeka specifications.\n(Ord. 20467 § 25, 12-5-23.)","type":"section","workbench_component_id":"facf30f4-b752-5b55-a1ac-d1bf216e36d3"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.470","citation_url":"https://topeka.municipal.codes/TMC/14.55.470","content_hash":"e57c8f2e89c7989da927c208a9588f37606872a017996539e76833f42cf7e9e6","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.470:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.470:block:0","source_url":"https://topeka.municipal.codes/TMC/14.55.470","text":"Section R403.1.4, Minimum depth, is hereby deleted in its entirety and the following provisions shall be substituted therefor:","type":"paragraph","workbench_component_id":"d979d655-8150-5ef5-93d6-