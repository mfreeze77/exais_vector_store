{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.60.090","page_type":"section"},"citation":"10.60.090","citation_url":"https://topeka.municipal.codes/TMC/10.60.090","content_hash":"25cb0dcb8bf29ee721c0c1b06cbac96074d7cf704bd55320498a62a10d455665","heading":"All-night parking in business district limited – Night parking on certain days.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.090:section","source_url":"https://topeka.municipal.codes/TMC/10.60.090","text":"(a) No person shall park a vehicle on any street in the business district for a period of time longer than 30 minutes between the hours of 2:00 a.m. and 6:00 a.m. on any day, except physicians on emergency calls.\n(b) No person shall park any vehicle between the hours of 1:00 a.m. and 6:00 a.m. on the following named streets at places specified on the named days of the week:\n(1) On Monday, Wednesday and Friday of each week at the following locations:\n(i) Jackson Street from Fourth Street to Tenth Street.\n(ii) Kansas Avenue from the north flood control levee to Fairchild Street and from Fourth Street to 11th Street.\n(iii) Quincy Street from Fourth Street to 11th Street.\n(2) On Tuesday, Thursday and Saturday of each week at the following locations:\n(i) Fifth Street from Jackson to Quincy Street.\n(ii) Sixth Street from Van Buren to Quincy Street.\n(iii) Seventh Street from Van Buren to Quincy Street.\n(iv) Eighth Street from Van Buren to Quincy Street.\n(v) Ninth Street from Jackson to Quincy Street.\n(vi) Tenth Street from Topeka Avenue to Quincy Street.\n(vii) Sardou Street from Jackson to Quincy Street. (Code 1981 § 43-387. Code 1995 § 142-352.)","type":"section","workbench_component_id":"63566cbd-9be5-5294-b967-b46cad3f405e"},{"attributes":{"block_kind":"paragraph"},"citation":"10.60.090","citation_url":"https://topeka.municipal.codes/TMC/10.60.090","content_hash":"7313527f139db2690b297fc9e91fbf8fd0fb76463303c7c003fac613c5b743be","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.090:block:0","source_url":"https://topeka.municipal.codes/TMC/10.60.090","text":"(a) No person shall park a vehicle on any street in the business district for a period of time longer than 30 minutes between the hours of 2:00 a.m. and 6:00 a.m. on any day, except physicians on emergency calls.","type":"paragraph","workbench_component_id":"b1768443-bf2b-514c-bec2-58991a8e2705"},{"attributes":{"block_kind":"paragraph"},"citation":"10.60.090","citation_url":"https://topeka.municipal.codes/TMC/10.60.090","content_hash":"22714c0cd1945456a94c8703999c08ebc622a58b99f0a30e85d7fdbe9e40a25e","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.090:block:1","source_url":"https://topeka.municipal.codes/TMC/10.60.090","text":"(b) No person shall park any vehicle between the hours of 1:00 a.m. and 6:00 a.m. on the following named streets at places specified on the named days of the week:","type":"paragraph","workbench_component_id":"5c712250-2a35-5f30-a128-936016c1e5fc"},{"attributes":{"block_kind":"paragraph"},"citation":"10.60.090","citation_url":"https://topeka.municipal.codes/TMC/10.60.090","content_hash":"ca05410fb42f63045ba82bc9c229e078845098345259e5ae21f4a9f403798466","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.090:block:2","source_url":"https://topeka.municipal.co