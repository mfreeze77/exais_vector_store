{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.75.070","page_type":"section"},"citation":"10.75.070","citation_url":"https://topeka.municipal.codes/TMC/10.75.070","content_hash":"a3040e794637b8fb2fe8199f67c9590dea2c648b97772e86a1f941a0cc434ec7","heading":"Failure to stop or comply.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.070:section","source_url":"https://topeka.municipal.codes/TMC/10.75.070","text":"Any driver of a vehicle or combination of vehicles who fails or refuses to stop and submit such vehicle or combination of vehicles to weighing as provided in this chapter, or who fails or refuses when directed by a law enforcement officer or State Department of Revenue agent or employee to comply with the provisions of this chapter, shall be guilty of a traffic offense. (Code 1981 § 43-686. Code 1995 § 142-742.)\nCross References: Police Department, TMC 2.20.090 .\nState Law References: Similar provisions, K.S.A. 8-1910 .","type":"section","workbench_component_id":"6d82c58b-2108-55f3-8425-8f13af445adb"},{"attributes":{"block_kind":"paragraph"},"citation":"10.75.070","citation_url":"https://topeka.municipal.codes/TMC/10.75.070","content_hash":"3d7be886d733a50e6ebd61c846351355e8d5e99cd7615ba4f0d10d3b8a21425a","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.070:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.070:block:0","source_url":"https://topeka.municipal.codes/TMC/10.75.070","text":"Any driver of a vehicle or combination of vehicles who fails or refuses to stop and submit such vehicle or combination of vehicles to weighing as provided in this chapter, or who fails or refuses when directed by a law enforcement officer or State Department of Revenue agent or employee to comply with the provisions of this chapter, shall be guilty of a traffic offense. (Code 1981 § 43-686. Code 1995 § 142-742.)","type":"paragraph","workbench_component_id":"fb8d7f25-9b25-5151-81c4-c96664ffd0f7"},{"attributes":{"block_kind":"paragraph"},"citation":"10.75.070","citation_url":"https://topeka.municipal.codes/TMC/10.75.070","content_hash":"b3690706389bc36b62ec0c62b3dea31a6dd0c29e5778164c15b68f9d4f0aa5e3","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.070:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.070:block:1","source_url":"https://topeka.municipal.codes/TMC/10.75.070","text":"Cross References: Police Department, TMC 2.20.090 .","type":"paragraph","workbench_component_id":"6d9ecb7f-de81-526a-923b-1da8598e29e2"},{"attributes":{"block_kind":"paragraph"},"citation":"10.75.070","citation_url":"https://topeka.municipal.codes/TMC/10.75.070","content_hash":"31d44e74a9f4a7aa59feb741a37aa79553c3041db0df0419882112e7e0319e61","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.070:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.070:block:2","source_url":"https://topeka.municipal.codes/TMC/10.75.070","text":"State Law References: Similar provisions, K.S.A. 8-1910 .","type":"paragraph","workbench_component_id":"eab18180-9f08-5047-b7bd-86284b9667f5"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.070:section","schema":"exais.jurisdiction.structured_content.v1"}