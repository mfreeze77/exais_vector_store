        },
        "quote": "(b) The City Engineer or designee may approve requests to cut and remove curbing and guttering for the purpose of widening the street for vehicular parking purposes if all of the following requirements are satisfied:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.50.050:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
