          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.20.400:block:12",
          "start": 2839
        },
        "quote": "(2) Description of stored chemicals; and",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.400:block:12#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
