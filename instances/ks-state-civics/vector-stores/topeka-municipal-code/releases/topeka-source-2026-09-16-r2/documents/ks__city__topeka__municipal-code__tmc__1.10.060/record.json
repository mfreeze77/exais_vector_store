          "start": 1250
        },
        "quote": "(1) Organize the ordinance material into appropriate subdivisions;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:1.10.060:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
