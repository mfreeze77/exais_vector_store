{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:17.20.050","page_type":"section"},"citation":"17.20.050","citation_url":"https://topeka.municipal.codes/TMC/17.20.050","content_hash":"94df12dde0d0a05d7d057c21afc4e8f92c77af88ffd1f8de4202d9cec7622ff4","heading":"Appeal when permit refused.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:17.20.050:section","source_url":"https://topeka.municipal.codes/TMC/17.20.050","text":"Any person feeling aggrieved by the determination of the City Engineer under this article may appeal the decision in writing to the Council within 10 days from the determination, and the Council, after a public hearing, shall have authority to affirm, reverse or modify the determination. (Code 1981 § 10-439. Code 1995 § 74-104.)\nCross References: City Council – Mayor, Chapter 2.15 TMC.","type":"section","workbench_component_id":"943cb371-89f5-532c-a684-2b3d3b240f25"},{"attributes":{"block_kind":"paragraph"},"citation":"17.20.050","citation_url":"https://topeka.municipal.codes/TMC/17.20.050","content_hash":"3820a9988cd658e54e82dea9e49f871c364c95e1cb0494d85e7a9f39227c1820","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:17.20.050:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:17.20.050:block:0","source_url":"https://topeka.municipal.codes/TMC/17.20.050","text":"Any person feeling aggrieved by the determination of the City Engineer under this article may appeal the decision in writing to the Council within 10 days from the determination, and the Council, after a public hearing, shall have authority to affirm, reverse or modify the determination. (Code 1981 § 10-439. Code 1995 § 74-104.)","type":"paragraph","workbench_component_id":"3cfaa976-e8d1-5fa9-9478-160dfdd61834"},{"attributes":{"block_kind":"paragraph"},"citation":"17.20.050","citation_url":"https://topeka.municipal.codes/TMC/17.20.050","content_hash":"d41ed969f4f69b83f291afab2ee5ae1882fde020e8c715e6898622fece7de356","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:17.20.050:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:17.20.050:block:1","source_url":"https://topeka.municipal.codes/TMC/17.20.050","text":"Cross References: City Council – Mayor, Chapter 2.15 TMC.","type":"paragraph","workbench_component_id":"072c64ce-ab88-5b66-85cc-380beefa41da"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:17.20.050:section","schema":"exais.jurisdiction.structured_content.v1"}