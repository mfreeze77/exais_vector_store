{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:8.60.100","page_type":"section"},"citation":"8.60.100","citation_url":"https://topeka.municipal.codes/TMC/8.60.100","content_hash":"f4be4e81e233be7338825cca463475015a13022aafecd912e413c0cf6711c5f7","heading":"Section 108 – Stop work order.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.100:section","source_url":"https://topeka.municipal.codes/TMC/8.60.100","text":"Section 108.4, Failure to comply, is deleted in its entirety and the following provisions shall be substituted therefor:\nIt is unlawful to continue any work after being served with a stop work order, unless the work is to remove a violation or abate an unsafe condition. The person may be punished in accordance with TMC 1.10.070 .\n(Ord. 20625 § 8, 12-16-25.)","type":"section","workbench_component_id":"7f9dc1f2-98a7-578a-aceb-7f4de0ccefa8"},{"attributes":{"block_kind":"paragraph"},"citation":"8.60.100","citation_url":"https://topeka.municipal.codes/TMC/8.60.100","content_hash":"d2f58f41618d69a2c477ff9ceb1c769d5a8193f70dd0eaf5969c5d6bdbc591be","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.100:block:0","source_url":"https://topeka.municipal.codes/TMC/8.60.100","text":"Section 108.4, Failure to comply, is deleted in its entirety and the following provisions shall be substituted therefor:","type":"paragraph","workbench_component_id":"10b06505-6137-5d13-9220-e07b209839bc"},{"attributes":{"block_kind":"paragraph"},"citation":"8.60.100","citation_url":"https://topeka.municipal.codes/TMC/8.60.100","content_hash":"1d6dc6bc4b92fb4ec451c919e5a8c1b79eeed0d2ff75daf6f5