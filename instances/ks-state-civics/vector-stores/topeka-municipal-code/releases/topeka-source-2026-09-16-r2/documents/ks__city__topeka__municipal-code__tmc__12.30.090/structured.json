the proposed project and the location of all existing and proposed equipment;","type":"paragraph","workbench_component_id":"e1a04751-ba7f-5097-aac7-0aef21241aef"},{"attributes":{"block_kind":"paragraph"},"citation":"12.30.090","citation_url":"https://topeka.municipal.codes/TMC/12.30.090","content_hash":"ce4297891e2c93da5c1d1776e9d71c9630f96d216f5e8651a05558ceb978b03d","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:12.30.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.30.090:block:3","source_url":"https://topeka.municipal.codes/TMC/12.30.090","text":"(c) Payment of all money due to the City for:","type":"paragraph","workbench_component_id":"d814502f-549e-5fc4-823d-456a384d6b27"},{"attributes":{"block_kind":"paragraph"},"citation":"12.30.090","citation_url":"https://topeka.municipal.codes/TMC/12.30.090","content_hash":"1e742fea466efd0f079ee92fcc21327d19b97043338da64e268206ed49368ca7","heading":null,"ordinal":4,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:12.30.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.30.090:block:4","source_url":"https://topeka.municipal.codes/TMC/12.30.090","text":"(1) Permit fees and costs;","type":"paragraph","workbench_component_id":"9401a30c-ed08-5565-93a0-83b0ced34d55"},{"attributes":{"block_kind":"paragraph"},"citation":"12.30.090","citation_url":"https://topeka.municipal.codes/TMC/12.30.090","content_hash":"6f1d39ca0fdc3d5417bfc4f296727a10721f40bcf216080b2e15e0adaf2d860a","heading":null,"ordinal":5,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:12.30.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.30.090:block:5","source_url":"https://topeka.municipal.codes/TMC/12.30.090","text":"(2) Prior obstructions or excavations;","type":"paragraph","workbench_component_id