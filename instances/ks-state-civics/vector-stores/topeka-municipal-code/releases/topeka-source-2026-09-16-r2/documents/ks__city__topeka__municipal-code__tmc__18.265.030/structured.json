_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:14","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"1 – 3 acres","type":"paragraph","workbench_component_id":"2c9ed697-8b48-5954-9c84-c5be22246498"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"5ddb3846160775408324fb8708798b6044b645970e3df17ac083dee5cbc52ff4","heading":null,"ordinal":15,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:15","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"100 feet","type":"paragraph","workbench_component_id":"cbdd9d9c-dae0-5a95-b0b0-f82790022cdf"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"bd559338983513d9201928fbe0acc54139efcd83be4d5302cf482e7a8b474e56","heading":null,"ordinal":16,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:16","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"More than 3 acres","type":"paragraph","workbench_component_id":"c9ca743a-0487-5129-94e8-be9883976ee7"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"ada92e0b09eebb88966aa4a4b83c205f7186b07d726b750a123f430bd8423597","heading":null,"ordinal":17,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:17","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"175 feet","type":"paragraph","workbench_component_id":"9a19b82f-9227-5d67-82ea-dc969197a58c"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"b959130c1a1a50a7617c2f6ee3c5dc55913421f6f1a409a8752b0cc4620c7422","heading":null,"ordinal":18,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:18","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(2) Exceptions.","type":"paragraph","workbench_component_id":"156af826-d0e6-51bd-ab50-49b179b31a15"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"16c15e06604c84fccd2a40724df33e875ba8ad1e19bd8be2c49182632ead1a04","heading":null,"ordinal":19,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:19","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(i) The maximum height of all wind energy systems mounted on a permanent building will be determined in association with the approval of a conditional use permit within C-5 Commercial and D-1, D-2, D-3 Downtown Districts.","type":"paragraph","workbench_component_id":"79abcf48-3c66-5ea0-866a-9a2cfb883e00"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"287996ee7658cb46619f2d795253e2d526077615aba655d8a77e0b41c7203506","heading":null,"ordinal":20,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:20","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(ii) The maximum height of all wind energy systems will be determined in association with the approval of a conditional use permit within the I-1 and I-2 districts, as well as PUD districts with permitted uses designated I-1 or I-2.","type":"paragraph","workbench_component_id":"2dd6d234-82e1-5ac1-84c9-6441e828059e"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"534cadb413cf28421ead25cb63edc23ff261f5b2be824060fbce4659e6e941aa","heading":null,"ordinal":21,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:21","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(d) Rotor Diameter. Maximum rotor diameter shall not exceed manufacturer recommendations for wattage and tower specifications.","type":"paragraph","workbench_component_id":"1a423021-544c-591d-aa89-f761c942b5da"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"1ef74d01532676e1c06ea9aa3a69be7f33b627b92c8159e7a8555febeea55685","heading":null,"ordinal":22,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:22","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(e) Towers. All wind energy systems shall be mounted on monopole towers or attached to a permanent building. No lattice or guy-wired towers shall be permitted except in districts zoned industrial and PUD districts with permitted uses designated I-1 or I-2.","type":"paragraph","workbench_component_id":"a5ddb460-acb2-5703-8235-af5d18b66c38"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"3cc09365e74ac5be38f7c3d3d79323222ee2fea2688dafa2227e4c88618bfcef","heading":null,"ordinal":23,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:23","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(f) Access.","type":"paragraph","workbench_component_id":"fc967c57-c810-5bbb-b642-aba8f8792178"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"579bc29bcfc080f44382ed1f567fc7af833296a49c993c4b4a03ed7386cdf45e","heading":null,"ordinal":24,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:24","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(1) All ground-mounted electrical and control equipment shall be labeled and secured to prevent unauthorized access.","type":"paragraph","workbench_component_id":"eadd530f-9ac5-5122-88e9-924bf0932275"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"c2cab428a9c80a0e6998360130585ad725e05646197843bb9e8131d8a78906db","heading":null,"ordinal":25,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:25","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(2) The tower shall be designed and installed so as to not provide step bolts or a ladder readily accessible to the public for a minimum height of eight feet above the ground.","type":"paragraph","workbench_component_id":"0e2c0b91-2f2c-5337-a27e-0df9fcfd27ed"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"7d50f2c7399b541e6b3cff3e1c67dba9563e5f3a02f6259b824395eb0d9e70dd","heading":null,"ordinal":26,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:26","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(g) Electrical Wires. All electrical wires associated with wind energy systems shall be located underground with the following exceptions:","type":"paragraph","workbench_component_id":"5640201b-ab34-5633-b006-53d18cf1d4d8"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"45c14c75ef6e28f26c9f9a06df36dec68720d8da5ee03a24ea171db63ec0d0cb","heading":null,"ordinal":27,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:27","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(1) All wires necessary to connect the wind generator to the tower wiring.","type":"paragraph","workbench_component_id":"ae8476ca-72f2-5d04-966b-6f292aae9e02"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"5729debe24d252a47315ae7227f6ae1c199d9b3cca7d2d52ea8bd53c8aa151b1","heading":null,"ordinal":28,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:28","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(2) All wires necessary to connect the tower wiring to the disconnect junction box.","type":"paragraph","workbench_component_id":"66bfa9b9-7a89-540a-b147-265e1db300ed"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"88e90f2c2e4348462b57166db03b80ea08cd1da7dc060737a889ef907dfb397b","heading":null,"ordinal":29,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:29","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(3) All wires necessary to connect the grounding wires.","type":"paragraph","workbench_component_id":"b0c467dc-a9d9-5092-ae56-e7a2b3cfbbc2"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"d15c6f1940e4f83a28d7ec3628ccdeff873e73299f2464cea6612513f81a853d","heading":null,"ordinal":30,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:30","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(h) Color and Finish. The generator and tower shall be a nonreflective and neutral color.","type":"paragraph","workbench_component_id":"6b7c107f-79d6-5ca8-9f4b-28d56c5935d9"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"3d9e6de258cda3aea2499901f2bdd715c78ea096e2cd6e3915386911e3d01eb8","heading":null,"ordinal":31,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:31","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(i) Decibel levels for the system shall not exceed 55 decibels (dBA) measured at any property line, except during short-term events such as utility outages and severe windstorms.","type":"paragraph","workbench_component_id":"313e43c9-9a54-5081-b1d7-2c1267152831"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"36e898de68d387547909d2829d22233d581ca8a727f4874a4b710ee31ccc0cc4","heading":null,"ordinal":32,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:32","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(j) Compliance with All Applicable Codes. A wind energy system including tower shall comply with all applicable building and property codes currently in force in the City.","type":"paragraph","workbench_component_id":"8df3730f-c186-584e-9c00-8a59f2b1d38d"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"f3756c73476759bc5d6db5f39183988802ab43eeb478e520baf9def052be1304","heading":null,"ordinal":33,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:33","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(k) Utility Notification and Interconnection. All wind energy systems that connect to the facilities of an electrical utility company shall comply with all applicable local, State and Federal regulations governing such connections. The applicant or property owner must supply the Development Services Division with written consent from the applicable electric utility company to connect to the grid at the time of application for a building permit.","type":"paragraph","workbench_component_id":"e7eebca6-0703-5199-8b62-a16f8c2dbe1e"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"df24dd74f95e3e6aae23c437d2dc781523f82b27107144ae5e8448ea32f002c6","heading":null,"ordinal":34,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:34","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(l) Signage.","type":"paragraph","workbench_component_id":"2e9cdabd-4aeb-578c-b228-b357e55a04c2"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"7761489428024d36ac7b1d9bb4c92101c63b27ff4f27ba2ff62bb50243cab74c","heading":null,"ordinal":35,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:35","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(1) Brand names shall not be visible from any public right-of-way or place.","type":"paragraph","workbench_component_id":"e1ac26a0-d144-5fd1-88cf-df29ceb96a1e"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"322fd427b4da7a5e72c1e09e12738ecd91e8dd9e6d7b914c4acfded650394f25","heading":null,"ordinal":36,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:36","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(2) No advertising shall be placed on the wind generator or tower.","type":"paragraph","workbench_component_id":"209a86d0-d43b-5be7-8ee1-c5bd48fdecda"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"c51cfb9f63919844715200021b713f5abe44a7885c1c38d717ba4499d4fc10ae","heading":null,"ordinal":37,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:37","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(m) Wind generators or towers shall not be artificially lighted, except as may be required by Federal or State law.","type":"paragraph","workbench_component_id":"afef5f8b-b5c4-5633-8c2b-5165c9cfc089"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"7ef5eb57088e6a4fe917c8a04fa2fab09bcd4e45240bc2e1baac779e1b603e65","heading":null,"ordinal":38,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:38","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"(n) Removal of Abandoned Wind Energy Systems. Any wind energy system that is not operated for a period of 12 continuous months or which was operated under a conditional use permit which has expired and has not been renewed shall be considered abandoned, and the owner of such wind energy system shall remove the same within 90 days of a receipt of notice from the Planning Director notifying the owner of such required removal. If such wind energy system is not removed within said 90 days, the City Council may cause the removal of such wind energy system at the owner’s expense. If there are two or more users of a wind energy system, then this provision shall not become effective until all users have ceased using the system for a period of 12 continuous months. (Ord. 19598 § 3, 6-28-11.)","type":"paragraph","workbench_component_id":"415b644a-85bb-51cd-bbd3-167c813dc816"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"4d10e12cd037d73de403cae7dc051825784880067b4f4015a316b3122ea3933e","heading":null,"ordinal":39,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:block:39","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":"Cross References: City Council – Mayor, Chapter 2.15 TMC; Planning and Development Department, TMC 2.20.080 .","type":"paragraph","workbench_component_id":"cf03fc70-fd11-55df-9ce8-65ff3cdc4ceb"},{"attributes":{"table":{"order":0,"rows":[["Less than one acre","62 feet"],["1 – 3 acres","100 feet"],["More than 3 acres","175 feet"]]}},"citation":"18.265.030","citation_url":"https://topeka.municipal.codes/TMC/18.265.030","content_hash":"0ea69b62168a8d75c0f0aaa09f9c1a6a150818dea815fd33f72bb6cf72c14069","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:table:0","source_url":"https://topeka.municipal.codes/TMC/18.265.030","text":null,"type":"table","workbench_component_id":"1e9dfa33-4fb8-5679-9203-46a1b1405aac"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.030:section","schema":"exais.jurisdiction.structured_content.v1"}