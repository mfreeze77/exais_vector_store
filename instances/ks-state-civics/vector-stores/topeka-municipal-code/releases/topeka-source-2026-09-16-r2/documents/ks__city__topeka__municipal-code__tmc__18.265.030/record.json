          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.265.030:block:10",
          "start": 1296
        },
        "quote": "(1) Maximum tower height shall be as follows:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.265.030:block:10#text",
        "unavailable_reason": null
      },
