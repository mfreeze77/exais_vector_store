          "component_id": "b0c467dc-a9d9-5092-ae56-e7a2b3cfbbc2",
          "convention": "utf8_char_offset",
          "end": 3011,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.265.030:block:29",
          "start": 2956
        },
        "quote": "(3) All wires necessary to connect the grounding wires.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.265.030:block:29#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
