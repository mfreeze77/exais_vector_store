          "end": 995,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:2.25.070:block:7",
          "start": 970
        },
        "quote": "(1) Property acquisition.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.25.070:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
