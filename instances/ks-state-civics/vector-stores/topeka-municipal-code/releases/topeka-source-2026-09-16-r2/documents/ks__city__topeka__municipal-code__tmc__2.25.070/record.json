        "locator": {
          "block_index": 8,
          "component_id": "e0d13e1a-c2ae-541c-85be-6a9f8d0defdd",
          "convention": "utf8_char_offset",
          "end": 1039,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:2.25.070:block:8",
          "start": 996
        },
        "quote": "(2) New construction of affordable housing.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.25.070:block:8#text",
