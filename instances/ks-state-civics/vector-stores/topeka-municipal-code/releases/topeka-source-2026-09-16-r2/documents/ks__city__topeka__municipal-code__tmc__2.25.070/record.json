        },
        "quote": "(c) Eligible Uses. Eligible uses shall include, but not be limited to:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.25.070:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 2.25.070 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "6a685f18-4d2c-54c1-863f-111f55471c51",
