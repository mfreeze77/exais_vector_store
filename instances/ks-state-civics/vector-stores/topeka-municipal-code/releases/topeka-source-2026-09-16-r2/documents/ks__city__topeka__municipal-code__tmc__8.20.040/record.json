          "source_component_key": "ks:city:topeka:municipal-code:tmc:8.20.040:block:4",
          "start": 745
        },
        "quote": "(d) The smoking policy shall be communicated to all employees within four weeks of the adoption of the ordinance codified in this chapter.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:8.20.040:block:4#text",
        "unavailable_reason": null
