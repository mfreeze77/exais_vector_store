        },
        "quote": "(b) Nothing in this Code shall be deemed to affect the validity of ordinances that are not codified in the Code.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:1.05.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
