          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.35.030:block:1",
          "start": 140
        },
        "quote": "(1) Discharge stormwater runoff to an impacted water body; or",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.35.030:block:1#text",
        "unavailable_reason": null
      },
