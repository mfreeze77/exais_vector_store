          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.35.030:block:5",
          "start": 958
        },
        "quote": "(5) Discharge stormwater runoff to a water body that is identified by the State of Kansas as outstanding national resource waters (ONRW); or",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.35.030:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 13.35.030 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "6e131f24-47a2-5ea2-8f0c-77a97ddbbcf6",
          "convention": "utf8_char_offset",
