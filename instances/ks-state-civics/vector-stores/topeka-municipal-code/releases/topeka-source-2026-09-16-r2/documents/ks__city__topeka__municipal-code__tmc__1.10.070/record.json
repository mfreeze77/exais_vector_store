          "start": 604
        },
        "quote": "(1) Fine. A fine of not less than $1.00 or more than $499.00; or",
        "ref_id": "ks:city:topeka:municipal-code:tmc:1.10.070:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
