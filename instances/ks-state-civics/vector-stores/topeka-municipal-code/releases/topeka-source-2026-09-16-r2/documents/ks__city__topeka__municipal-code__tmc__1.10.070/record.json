          "source_component_key": "ks:city:topeka:municipal-code:tmc:1.10.070:block:3",
          "start": 669
        },
        "quote": "(2) Imprisonment. Imprisonment in the City jail for not more than 179 days; or",
        "ref_id": "ks:city:topeka:municipal-code:tmc:1.10.070:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
