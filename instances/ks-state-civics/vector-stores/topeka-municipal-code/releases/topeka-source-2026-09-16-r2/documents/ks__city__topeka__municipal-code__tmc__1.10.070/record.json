          "start": 421
        },
        "quote": "(b) Whenever any offense is declared by any provision of this code, absent a specific or unique punishment prescribed, the offender shall be punished in accordance with this section:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:1.10.070:block:1#text",
        "unavailable_reason": null
      },
