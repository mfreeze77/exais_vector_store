          "convention": "utf8_char_offset",
          "end": 2706,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:17.10.060:block:15",
          "start": 2649
        },
        "quote": "Cross References: Public Works Department, TMC 2.20.100 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.10.060:block:15#text",
        "unavailable_reason": null
