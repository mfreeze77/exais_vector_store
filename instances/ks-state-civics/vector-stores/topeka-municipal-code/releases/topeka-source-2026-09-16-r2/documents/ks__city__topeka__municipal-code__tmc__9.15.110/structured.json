{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:9.15.110","page_type":"section"},"citation":"9.15.110","citation_url":"https://topeka.municipal.codes/TMC/9.15.110","content_hash":"18fc60503e4eaf39a70d9d53bbe5ced6efabf180cfc14d5c95242bba759693e6","heading":"Private room prohibited – Exception.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.110:section","source_url":"https://topeka.municipal.codes/TMC/9.15.110","text":"It shall be unlawful for any person to operate a private room in a premises licensed to sell cereal malt beverages; provided, that this section shall not apply if the licensed premises are also currently licensed by the State Director of Alcoholic Beverage Control. (Code 1981 § 5-21. Code 1995 § 10-52.)\nState Law References: Similar provisions, K.S.A. 41-2704 .","type":"section","workbench_component_id":"c11d0e04-1cf3-5a77-9a5f-fa34855b1033"},{"attributes":{"block_kind":"paragraph"},"citation":"9.15.110","citation_url":"https://topeka.municipal.codes/TMC/9.15.110","content_hash":"2d482d146fcbc6adc776533b7be5fdabb269dc90f2eaa4f36553b7da9d64aa5a","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.110:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.110:block:0","source_url":"https://topeka.municipal.codes/TMC/9.15.110","text":"It shall be unlawful for any person to operate a private room in a premises licensed to sell cereal malt beverages; provided, that this section shall not apply if the licensed premises are also currently licensed by the State Director of Alcoholic Beverage Control. (Code 1981 § 5-21. Code 1995 § 10-52.)","type":"paragraph","workbench_component_id":"981aa5d8-e201-526f-b27f-4741dba7f277