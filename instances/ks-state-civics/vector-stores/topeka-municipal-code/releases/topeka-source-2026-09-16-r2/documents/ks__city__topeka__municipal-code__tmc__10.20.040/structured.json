{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.20.040","page_type":"section"},"citation":"10.20.040","citation_url":"https://topeka.municipal.codes/TMC/10.20.040","content_hash":"a182e0850d609df7c0157a76521adea7256a632ed2b0b983f4d8a5c5847ba3a1","heading":"Vehicles used for primary purpose of advertising.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.20.040:section","source_url":"https://topeka.municipal.codes/TMC/10.20.040","text":"No person shall operate or stand any vehicle on any street in the City for the primary purpose of advertising without first securing a permit from the Council which shall specify the terms and conditions of such authorization. (Code 1981 § 43-121. Code 1995 § 142-184.)\nCross References: City Council – Mayor, Chapter 2.15 TMC.","type":"section","workbench_component_id":"3686e24d-b116-5c98-8c5d-46e885b199bf"},{"attributes":{"block_kind":"paragraph"},"citation":"10.20.040","citation_url":"https://topeka.municipal.codes/TMC/10.20.040","content_hash":"61c396f8fa2b9f6f2d8932273b6b371f8bff3795ae6fbc02cdddb308a1f41c76","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.20.040:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.20.040:block:0","source_url":"https://topeka.municipal.codes/TMC/10.20.040","text":"No person shall operate or stand any vehicle on any street in the City for the primary purpose of advertising without first securing a permit from the Council which shall specify the terms and conditions of such authorization. (Code 1981 § 43-121. Code 1995 § 142-184.)","type":"paragraph","workbench_component_id":"7a3915e8-a366-5941-b892-77cf12e015db"},{"attributes":{"block_kind":"paragraph"},"cit