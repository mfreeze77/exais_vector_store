        "locator": {
          "block_index": 1,
          "component_id": "79242e28-0a86-5fd3-99f1-b0c2c89e26c3",
          "convention": "utf8_char_offset",
          "end": 548,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.160.010:block:1",
          "start": 189
        },
        "quote": "“Controlled substance” means a drug or other substance, or immediate precursor, included in Schedule I, II, III, IV, or V of Part B of 21 U.S.C. Section 812 . The term does not include distilled spirits, wine, malt beverages, or tobacco, as those terms are defined or used in Subtitle E of the Internal Revenue Code of 1954 ( 26 U.S.C. Sections 5001 et seq.).",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.160.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.160.010 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "7a716aec-9d45-5138-abb5-0c272f180d97",
          "convention": "utf8_char_offset",
          "end": 658,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.160.010:block:2",
          "start": 549
        },
        "quote": "“Person” means an individual, firm, partnership, corporation, joint venture, or other association of persons.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.160.010:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.160.010 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "2812bbb9-213c-51ca-8762-5463a9cd1140",
          "convention": "utf8_char_offset",
          "end": 988,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.160.010:block:3",
          "start": 659
        },
        "quote": "“Tobacco and/or novelty item(s)” means any items used, designed, marketed, or intended for use of controlled substances and tobacco. These items may be, but are not limited to, objects used, intended for use, or designed for use in ingesting, inhaling, or otherwise introducing controlled substances into the human body, such as:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.160.010:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.160.010 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "65d38eb2-5634-5813-ab6b-bda6cdfb2377",
          "convention": "utf8_char_offset",
          "end": 1105,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.160.010:block:4",
          "start": 989
        },
        "quote": "(1) Tobacco smoking devices of metal, wood, acrylic, glass, stone, plastic or ceramic pipes with or without screens;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.160.010:block:4#text",
        "unavailable_reason": null
      },
      {
