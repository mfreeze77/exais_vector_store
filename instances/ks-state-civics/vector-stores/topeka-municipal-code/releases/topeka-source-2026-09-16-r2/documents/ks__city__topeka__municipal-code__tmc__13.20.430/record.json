        },
        "quote": "Users seeking a wastewater discharge permit shall complete and file with the Utilities Director an application in the form prescribed by the Utilities Director and accompanied by the applicable fees. The applicant may be required to submit, in units and terms appropriate for evaluation, the following information:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.430:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
