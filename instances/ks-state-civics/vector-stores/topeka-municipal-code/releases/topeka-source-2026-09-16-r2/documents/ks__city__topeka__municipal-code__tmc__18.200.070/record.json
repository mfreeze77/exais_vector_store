          "start": 338
        },
        "quote": "(3) Retail and office uses: one space per 500 square feet of usable retail or office floor area.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.200.070:block:4#text",
        "unavailable_reason": null
      },
