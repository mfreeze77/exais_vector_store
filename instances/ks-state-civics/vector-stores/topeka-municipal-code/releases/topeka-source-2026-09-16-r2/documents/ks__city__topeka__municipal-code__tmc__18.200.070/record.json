          "end": 337,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.200.070:block:3",
          "start": 237
        },
        "quote": "(2) Private clubs, drinking establishments, and restaurants: one space per four occupants permitted.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.200.070:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
