{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:18.55.210","page_type":"section"},"citation":"18.55.210","citation_url":"https://topeka.municipal.codes/TMC/18.55.210","content_hash":"d724b31f92d64188c808e8b8ab073138c5c54aee07b5276ee60c16b0a993626b","heading":"“U” definitions.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.210:section","source_url":"https://topeka.municipal.codes/TMC/18.55.210","text":"“Urban design” means building and/or development plans prepared in a manner as to be harmonious with existing quality development found in downtown and inner areas of cities.\n“Urban fringe” means an area at the edge of an urban area usually made up of mixed agricultural and urban land uses.\n“Use” means the purpose or activity for which a piece of land or its buildings is designed, arranged, or intended, or for which it is occupied or maintained.\n“Utility services” means establishments engaged in the generation, transmission and/or distribution of electricity, communications, gas or steam, including water and irrigation systems and sanitary systems used for the collection and disposal of garbage, sewage and other wastes by means of destroying or processing materials. (Ord. 19370 § 103, 3-23-10. Code 1995 Appx. C, Art. XXXV.)","type":"section","workbench_component_id":"c7cc6927-2e5b-5fad-bcd2-2663d5a7d2f6"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.210","citation_url":"https://topeka.municipal.codes/TMC/18.55.210","content_hash":"e3fe3e5a013c19f845e8bee4d1d054ae242fa0d5487177f555bebeb3b050a567","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.210:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.210: