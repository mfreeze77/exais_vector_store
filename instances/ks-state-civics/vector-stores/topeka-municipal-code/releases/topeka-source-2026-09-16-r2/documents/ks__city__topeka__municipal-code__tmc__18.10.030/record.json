        "label": "TMC 18.10.030 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "13710fd6-42b2-5ba5-9905-4c4b426e8068",
          "convention": "utf8_char_offset",
          "end": 207,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.030:block:2",
          "start": 93
        },
        "quote": "(2) It is unlawful for any person to erect, operate, or otherwise use any sign that is prohibited by this chapter.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.030:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
