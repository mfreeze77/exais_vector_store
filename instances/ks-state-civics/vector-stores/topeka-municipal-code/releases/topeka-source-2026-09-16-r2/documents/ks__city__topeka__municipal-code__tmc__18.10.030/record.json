        },
        "quote": "(1) This chapter applies to any sign within the corporate limits of the City.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.030:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
