        },
        "quote": "(a) “Accused person” means a person, corporation or other legal entity accused by a complaint of the violation of a City ordinance.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.40.130:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
