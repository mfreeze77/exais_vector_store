        "locator": {
          "block_index": 2,
          "component_id": "a5996922-bee0-5c1f-9bf3-893feb82030e",
          "convention": "utf8_char_offset",
          "end": 293,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:2.40.130:block:2",
          "start": 157
        },
        "quote": "(b) “Agent” means any director, officer, partner, member, employee or other person who is authorized to act on behalf of a legal entity.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.40.130:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
