:13.30.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.30.060:block:9","source_url":"https://topeka.municipal.codes/TMC/13.30.060","text":"(i) Inspect and maintain control measures.","type":"paragraph","workbench_component_id":"7a1270b2-1f5f-50df-8b02-8107a7fab4fd"},{"attributes":{"block_kind":"paragraph"},"citation":"13.30.060","citation_url":"https://topeka.municipal.codes/TMC/13.30.060","content_hash":"57a99974dad01dedab3774697a4c5c4063b2dc585994f7bf79729908007863e7","heading":null,"ordinal":10,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.30.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.30.060:block:10","source_url":"https://topeka.municipal.codes/TMC/13.30.060","text":"(j) Use performance measures and outcomes.","type":"paragraph","workbench_component_id":"6aef7f4a-b86b-5487-a5af-4ef12d91fd20"},{"attributes":{"block_kind":"paragraph"},"citation":"13.30.060","citation_url":"https://topeka.municipal.codes/TMC/13.30.060","content_hash":"8a7681394187c04a76481d226c6ee9884e059ca03e81e0ae0d80f413dad601e8","heading":null,"ordinal":11,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.30.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.30.060:block:11","source_url":"https://topeka.municipal.codes/TMC/13.30.060","text":"(k) Timely employment and maintenance of all measures.","type":"paragraph","workbench_component_id":"6dd5118d-bb00-5154-ae66-8b7fe2152348"},{"attributes":{"block_kind":"paragraph"},"citation":"13.30.060","citation_url":"https://topeka.municipal.codes/TMC/13.30.060","content_hash":"54b496854b8008f845d40b9d02b3b358976a12839735dab1a7f2d5fd3830287b","heading":null,"ordinal":12,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.30.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks: