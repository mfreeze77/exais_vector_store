          "convention": "utf8_char_offset",
          "end": 308,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.30.060:block:1",
          "start": 256
        },
        "quote": "(a) Fit the development to existing site conditions.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.30.060:block:1#text",
        "unavailable_reason": null
      },
