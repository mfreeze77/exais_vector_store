          "end": 297,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.050:block:1",
          "start": 271
        },
        "quote": "(1) North point and scale.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.050:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
