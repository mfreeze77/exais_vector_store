          "end": 354,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.050:block:2",
          "start": 298
        },
        "quote": "(2) The dimensions drawn to scale of the developed area.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.050:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
