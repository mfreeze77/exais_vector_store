{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.50.030","page_type":"section"},"citation":"14.50.030","citation_url":"https://topeka.municipal.codes/TMC/14.50.030","content_hash":"6c0a5673e2bfbfb2fdb45fb16631cffec902b86ff2062eecca13cc0f6fdd1e50","heading":"Adoption of rules and regulations.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.030:section","source_url":"https://topeka.municipal.codes/TMC/14.50.030","text":"The Code Enforcement Director shall have the authority to promulgate such rules and regulations as are necessary to carry out the purposes of the mechanical code adopted by this chapter and such rules and regulations shall be effective upon their approval by the Council. (Code 1981 § 10-419. Code 1995 § 26-488.)\nCross References: City Council – Mayor, Chapter 2.15 TMC.","type":"section","workbench_component_id":"252cebc1-abee-54e8-bba1-59de5bf8416c"},{"attributes":{"block_kind":"paragraph"},"citation":"14.50.030","citation_url":"https://topeka.municipal.codes/TMC/14.50.030","content_hash":"6101ddd8b41f2125b107d0d2bb88c17d0970ccceb25e8e8c3d9a7e314dbce3bb","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.030:block:0","source_url":"https://topeka.municipal.codes/TMC/14.50.030","text":"The Code Enforcement Director shall have the authority to promulgate such rules and regulations as are necessary to carry out the purposes of the mechanical code adopted by this chapter and such rules and regulations shall be effective upon their approval by the Council. (Code 1981 § 10-419. Code 1995 § 26-488.)","type":"paragraph","workbench_component_id":"8052b24c-1e