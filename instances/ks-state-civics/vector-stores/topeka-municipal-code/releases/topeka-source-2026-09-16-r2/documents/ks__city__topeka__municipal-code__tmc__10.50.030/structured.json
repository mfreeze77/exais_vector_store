{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.50.030","page_type":"section"},"citation":"10.50.030","citation_url":"https://topeka.municipal.codes/TMC/10.50.030","content_hash":"94d5a1016a2386631e1e2113a1476a00684874aed8a985c79698bd3017e04d8e","heading":"Driving through parades.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.50.030:section","source_url":"https://topeka.municipal.codes/TMC/10.50.030","text":"No driver of a vehicle except a police car or other authorized emergency vehicle shall drive between the vehicles or persons comprising a parade when such vehicles or persons are in motion and are conspicuously designated as a parade. (Code 1981 § 43-756. Code 1995 § 142-783.)\nCross References: Police Department, TMC 2.20.090 .","type":"section","workbench_component_id":"a6690893-5769-5e97-8a13-74a8e3df9d99"},{"attributes":{"block_kind":"paragraph"},"citation":"10.50.030","citation_url":"https://topeka.municipal.codes/TMC/10.50.030","content_hash":"7c2b4f3bdf9d1cef180e349ccef20a20398852c421a6e56dadef645f16bd05d8","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.50.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.50.030:block:0","source_url":"https://topeka.municipal.codes/TMC/10.50.030","text":"No driver of a vehicle except a police car or other authorized emergency vehicle shall drive between the vehicles or persons comprising a parade when such vehicles or persons are in motion and are conspicuously designated as a parade. (Code 1981 § 43-756. Code 1995 § 142-783.)","type":"paragraph","workbench_component_id":"a5db1673-21fd-585f-bf8e-35581fe708ea"},{"attributes":{"block_kind":"paragraph"},"citation":"10.50.0