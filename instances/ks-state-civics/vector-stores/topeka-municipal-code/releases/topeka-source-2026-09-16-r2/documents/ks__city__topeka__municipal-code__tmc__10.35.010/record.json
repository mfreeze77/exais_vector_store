        },
        "quote": "(a) “Amenity zone” means that portion of the sidewalk used for street trees, landscaping, transit stops, and street lights.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.35.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
