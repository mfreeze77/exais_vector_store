          "start": 1004
        },
        "quote": "(e) “Frontage zone” means the area adjacent to the property line where transitions between public sidewalk and the space within buildings occur.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.35.010:block:5#text",
        "unavailable_reason": null
