        "locator": {
          "block_index": 2,
          "component_id": "fcc28b0c-687a-5b6a-b66e-2e874e057c7c",
          "convention": "utf8_char_offset",
          "end": 310,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.35.010:block:2",
          "start": 188
        },
        "quote": "(b) “Bicycle” means every device propelled by human power upon which a person may ride, having two or three tandem wheels.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.35.010:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 10.35.010 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "def4b90f-3611-5e68-9aed-3d36934d32f0",
          "convention": "utf8_char_offset",
          "end": 760,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.35.010:block:3",
          "start": 311
        },
        "quote": "(c) “Electric-assisted scooter” means a self-propelled vehicle that has at least two wheels in contact with the ground, an electric motor, handlebars, a brake and a deck that is designed to be stood upon when riding. Electric-assisted scooter does not include: (1) a vehicle that is powered by gasoline; or (2) a motorized skateboard, as defined by Article I of the Standard Traffic Ordinance adopted at TMC 10.15.010 , as amended by TMC 10.15.020 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.35.010:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 10.35.010 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "d7adbfc5-ceb5-54c9-8e6d-1f761275ebe3",
