          "convention": "utf8_char_offset",
          "end": 839,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.200.080:block:3",
          "start": 684
        },
        "quote": "(2) The expansion will not result in a reduction of acceptable levels of off-street parking, lot coverage ratio, landscaping by more than five percent; and",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.200.080:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.200.080 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "a67d9057-6946-5a9d-a7f3-46a9914e94d7",
          "convention": "utf8_char_offset",
