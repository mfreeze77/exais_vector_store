ka:municipal-code:tmc:10.05.060:block:2","source_url":"https://topeka.municipal.codes/TMC/10.05.060","text":"(1) Any license plate not lawfully issued to such vehicle;","type":"paragraph","workbench_component_id":"aa4f76c7-0893-59cc-894f-19e95fd0eaeb"},{"attributes":{"block_kind":"paragraph"},"citation":"10.05.060","citation_url":"https://topeka.municipal.codes/TMC/10.05.060","content_hash":"4979093a5047713fbf778e88422ccf315510f9b4b372467fc25edc967a5dd12e","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.05.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.05.060:block:3","source_url":"https://topeka.municipal.codes/TMC/10.05.060","text":"(2) Any expired license plate;","type":"paragraph","workbench_component_id":"b4070a29-a755-5cf8-aa28-1bbfe09d8160"},{"attributes":{"block_kind":"paragraph"},"citation":"10.05.060","citation_url":"https://topeka.municipal.codes/TMC/10.05.060","content_hash":"ab02b70eb8db8f508a1a3a5bb2012de0e821392e39fbde52a3c7b2385c1fbfc6","heading":null,"ordinal":4,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.05.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.05.060:block:4","source_url":"https://topeka.municipal.codes/TMC/10.05.060","text":"(3) Any suspended, revoked or canceled license plate;","type":"paragraph","workbench_component_id":"fa274a43-b052-5acf-8d97-7d4da4d69038"},{"attributes":{"block_kind":"paragraph"},"citation":"10.05.060","citation_url":"https://topeka.municipal.codes/TMC/10.05.060","content_hash":"0caf3890e7f7c16fd95aab692561ae4e3a63a6165bcf89f60a1258feb31aedff","heading":null,"ordinal":5,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.05.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.05.060:block:5","source_url":"https://topeka.municipal.codes/TMC