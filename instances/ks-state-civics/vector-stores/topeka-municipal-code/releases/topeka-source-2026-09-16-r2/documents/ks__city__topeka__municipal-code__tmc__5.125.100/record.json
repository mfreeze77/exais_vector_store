          "start": 0
        },
        "quote": "No license or any renewal thereof shall be granted under this chapter to:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "67e751cd-f08c-5c34-92f9-01d163074993",
          "convention": "utf8_char_offset",
          "end": 131,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:1",
          "start": 74
        },
        "quote": "(a) Any person who is not a citizen of the United States;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "aa92218d-04f6-5b9a-b7ab-eab191a81b31",
          "convention": "utf8_char_offset",
          "end": 269,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:2",
          "start": 132
        },
        "quote": "(b) Any person who has not been an actual resident of the State for at least two years immediately preceding the date of his application;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "f667454a-65f6-5036-b151-20994af1f487",
          "convention": "utf8_char_offset",
          "end": 587,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:3",
          "start": 270
        },
        "quote": "(c) Any person who has been convicted of or has pleaded guilty to a felony under the laws of Kansas or any other state, or of the United States, or who shall have forfeited his bond to appear in court to answer charges for any such offense within 10 years immediately prior to such person’s application for a license;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "a4195a3b-cbe7-571b-8b20-24335737186f",
          "convention": "utf8_char_offset",
          "end": 695,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:4",
          "start": 588
        },
        "quote": "(d) Any person who has had his license revoked for cause under the provisions of this chapter or State act;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "9abd030d-8d1d-5e47-baef-8165d351bfb3",
          "convention": "utf8_char_offset",
          "end": 747,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:5",
          "start": 696
        },
        "quote": "(e) Any person who is not at least 21 years of age;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "02170163-7f83-5e4e-b2be-feb9b0dd0b94",
          "convention": "utf8_char_offset",
          "end": 911,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:6",
          "start": 748
        },
        "quote": "(f) Any person who at the time of application for renewal of any license issued under this chapter would not be eligible for such license upon a first application;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "22b220c8-fc8d-557e-8305-de0c3afeacd8",
          "convention": "utf8_char_offset",
          "end": 1106,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:7",
          "start": 912
        },
        "quote": "(g) Any person who does not own the premises for which a license is sought, unless he has a written lease therefor for at least three-fourths of the period for which the license is to be issued;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 8",
        "locator": {
          "block_index": 8,
          "component_id": "17153591-8204-5783-beb5-604d513ab82a",
          "convention": "utf8_char_offset",
          "end": 1265,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:8",
          "start": 1107
        },
        "quote": "(h) Any person whose spouse would be ineligible to receive a license under this chapter for any reason other than age, citizenship and residence requirements;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 9",
        "locator": {
          "block_index": 9,
          "component_id": "3b5cb35a-e6e8-5abf-bf4b-9ecc8c626afd",
          "convention": "utf8_char_offset",
          "end": 1374,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:9",
          "start": 1266
        },
        "quote": "(i) Any partnership, unless all of the partners shall be eligible to receive a license as an individual; and",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:9#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 10",
        "locator": {
          "block_index": 10,
          "component_id": "bfbdc594-f003-5930-95f6-b86a65773753",
          "convention": "utf8_char_offset",
          "end": 1542,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:10",
          "start": 1375
        },
        "quote": "(j) A corporation, if any officer, manager, director or stockholder would be ineligible to receive a license as an individual. (Code 1981 § 37-62. Code 1995 § 30-208.)",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:10#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 5.125.100 block 11",
        "locator": {
          "block_index": 11,
          "component_id": "4d3e6fdb-aa7d-5cc0-afbf-0f242c50cf13",
          "convention": "utf8_char_offset",
          "end": 1600,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.125.100:block:11",
          "start": 1543
        },
        "quote": "State Law References: Similar provisions, K.S.A. 16-708 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.125.100:block:11#text",
