{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.125.100","page_type":"section"},"citation":"5.125.100","citation_url":"https://topeka.municipal.codes/TMC/5.125.100","content_hash":"7b26a657e6ebef2946307534e36851eddc36a53150f95e810a4ade4c3e86731e","heading":"Qualifications of applicant.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:section","source_url":"https://topeka.municipal.codes/TMC/5.125.100","text":"No license or any renewal thereof shall be granted under this chapter to:\n(a) Any person who is not a citizen of the United States;\n(b) Any person who has not been an actual resident of the State for at least two years immediately preceding the date of his application;\n(c) Any person who has been convicted of or has pleaded guilty to a felony under the laws of Kansas or any other state, or of the United States, or who shall have forfeited his bond to appear in court to answer charges for any such offense within 10 years immediately prior to such person’s application for a license;\n(d) Any person who has had his license revoked for cause under the provisions of this chapter or State act;\n(e) Any person who is not at least 21 years of age;\n(f) Any person who at the time of application for renewal of any license issued under this chapter would not be eligible for such license upon a first application;\n(g) Any person who does not own the premises for which a license is sought, unless he has a written lease therefor for at least three-fourths of the period for which the license is to be issued;\n(h) Any person whose spouse would be ineligible to receive a license under this chapter for any reason other than age, citizenship and residence requirements;\n(i) Any partnership, unless all of the partners shall be eligible to receive a license as an individual; and\n(j) A corporation, if any officer, manager, director or stockholder would be ineligible to receive a license as an individual. (Code 1981 § 37-62. Code 1995 § 30-208.)\nState Law References: Similar provisions, K.S.A. 16-708 .","type":"section","workbench_component_id":"ae485d23-83a1-5f8d-bee2-e14bb1aab961"},{"attributes":{"block_kind":"paragraph"},"citation":"5.125.100","citation_url":"https://topeka.municipal.codes/TMC/5.125.100","content_hash":"07450473e8619ff5c1083ebfcaf374824509bafd018a53e854e18bde4af0f3fc","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:block:0","source_url":"https://topeka.municipal.codes/TMC/5.125.100","text":"No license or any renewal thereof shall be granted under this chapter to:","type":"paragraph","workbench_component_id":"4b32efa5-f3e9-5c56-aa27-0145cd0bb020"},{"attributes":{"block_kind":"paragraph"},"citation":"5.125.100","citation_url":"https://topeka.municipal.codes/TMC/5.125.100","content_hash":"38fefdad4f7d0b22facfa55c74ec717e445151e9aadf9c9f98bd055987d7c505","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:block:1","source_url":"https://topeka.municipal.codes/TMC/5.125.100","text":"(a) Any person who is not a citizen of the United States;","type":"paragraph","workbench_component_id":"67e751cd-f08c-5c34-92f9-01d163074993"},{"attributes":{"block_kind":"paragraph"},"citation":"5.125.100","citation_url":"https://topeka.municipal.codes/TMC/5.125.100","content_hash":"0dd231c0a0672cb9a996b3c1007a11a78b568c8e6b6b9ccacf9ec00cf07d9fe0","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:block:2","source_url":"https://topeka.municipal.codes/TMC/5.125.100","text":"(b) Any person who has not been an actual resident of the State for at least two years immediately preceding the date of his application;","type":"paragraph","workbench_component_id":"aa92218d-04f6-5b9a-b7ab-eab191a81b31"},{"attributes":{"block_kind":"paragraph"},"citation":"5.125.100","citation_url":"https://topeka.municipal.codes/TMC/5.125.100","content_hash":"f995f6d98111bc22f6d60d26482b855f5ba057b55e4bca138bd2d90535055fab","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:block:3","source_url":"https://topeka.municipal.codes/TMC/5.125.100","text":"(c) Any person who has been convicted of or has pleaded guilty to a felony under the laws of Kansas or any other state, or of the United States, or who shall have forfeited his bond to appear in court to answer charges for any such offense within 10 years immediately prior to such person’s application for a license;","type":"paragraph","workbench_component_id":"f667454a-65f6-5036-b151-20994af1f487"},{"attributes":{"block_kind":"paragraph"},"citation":"5.125.100","citation_url":"https://topeka.municipal.codes/TMC/5.125.100","content_hash":"a6e9d04c20498c9485c32af790f509fb1227ce3bedd53da9dcb077dec1b9f136","heading":null,"ordinal":4,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.125.100:block:4","source_url":"https://topeka.municipal.codes/TMC/5.125.100","text":"(d) Any person who has had his license revoked for cause under the provisions of this chapter or State act;","type":"paragraph","workbench_component_id":"a4195a3b-cbe7-571b-8b20-24335737186f"},{