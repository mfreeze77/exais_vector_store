{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.135.110","page_type":"section"},"citation":"5.135.110","citation_url":"https://topeka.municipal.codes/TMC/5.135.110","content_hash":"39ba63363240386483ef066eb5d522a45231818c0abfdfdb1b4b710cf69dc4c0","heading":"Violations to affect secondhand dealer licensing.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.135.110:section","source_url":"https://topeka.municipal.codes/TMC/5.135.110","text":"Any person not complying with the provisions of this chapter shall be ineligible to receive a City license to conduct or carry on the business of a secondhand dealer under the provisions of Chapter 5.140 TMC. (Code 1981 § 38-105. Code 1995 § 114-160.)","type":"section","workbench_component_id":"23047e78-7ea0-55d5-a829-2ac40e38b7c1"},{"attributes":{"block_kind":"paragraph"},"citation":"5.135.110","citation_url":"https://topeka.municipal.codes/TMC/5.135.110","content_hash":"39ba63363240386483ef066eb5d522a45231818c0abfdfdb1b4b710cf69dc4c0","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.135.110:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.135.110:block:0","source_url":"https://topeka.municipal.codes/TMC/5.135.110","text":"Any person not complying with the provisions of this chapter shall be ineligible to receive a City license to conduct or carry on the business of a secondhand dealer under the provisions of Chapter 5.140 TMC. (Code 1981 § 38-105. Code 1995 § 114-160.)","type":"paragraph","workbench_component_id":"fddf6385-0916-5db3-82d5-75c60b8a81cb"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:5.135.110:section","schema":"exais.jurisdiction.structured_content.v1"}