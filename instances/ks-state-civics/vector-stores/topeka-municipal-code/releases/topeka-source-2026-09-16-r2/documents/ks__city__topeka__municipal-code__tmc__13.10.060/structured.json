{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:13.10.060","page_type":"section"},"citation":"13.10.060","citation_url":"https://topeka.municipal.codes/TMC/13.10.060","content_hash":"c504dd5be541d080a556a12cef94e7c86d052dd654223b47c76ac3b9aab3166c","heading":"Depth of water pipes – Placement near other pipes.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.10.060:section","source_url":"https://topeka.municipal.codes/TMC/13.10.060","text":"(a) All water pipes laid in public or private property shall be placed with the upper side of the pipe not less than 42 inches from the surface of the ground, not considering the thickness of a pavement.\n(b) No underground water pipe shall parallel any other pipe or conduit closer than 18 inches. (Code 1981 § 44-21. Code 1995 § 146-31.)","type":"section","workbench_component_id":"fb4eff55-d7b9-58c5-82fc-b577abcd184b"},{"attributes":{"block_kind":"paragraph"},"citation":"13.10.060","citation_url":"https://topeka.municipal.codes/TMC/13.10.060","content_hash":"0b4df30325912ccd9f7d5cbd9cfa7a9fe2074ee90f06c46a850957c3a9b85b1f","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.10.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.10.060:block:0","source_url":"https://topeka.municipal.codes/TMC/13.10.060","text":"(a) All water pipes laid in public or private property shall be placed with the upper side of the pipe not less than 42 inches from the surface of the ground, not considering the thickness of a pavement.","type":"paragraph","workbench_component_id":"d31295b3-94f2-57f3-8429-ba0789a3dbe3"},{"attributes":{"block_kind":"paragraph"},"citation":"13.10.060","citation_url":"https://topeka.municipal.codes/TMC/13.10.060","content_hash":"6b35385358e9c938517a37d4907eae62b44b7b04798ca388ee1725c859b80e1b","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.10.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.10.060:block:1","source_url":"https://topeka.municipal.codes/TMC/13.10.060","text":"(b) No underground water pipe shall parallel any other pipe or conduit closer than 18 inches. (Code 1981 § 44-21. Code 1995 § 146-31.)","type":"paragraph","workbench_component_id":"b49e984c-4f25-5c18-ab6e-ca0d026f6705"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:13.10.060:section","schema":"exais.jurisdiction.structured_content.v1"}