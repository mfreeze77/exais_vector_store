{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.35.180","page_type":"section"},"citation":"14.35.180","citation_url":"https://topeka.municipal.codes/TMC/14.35.180","content_hash":"bd3f6336324fee5cc543b5fbb111a8f7a315341165fa136b98f169e2fa6ef18f","heading":"603.5.6, Protection from Lawn Sprinklers and Irrigation Systems.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.180:section","source_url":"https://topeka.municipal.codes/TMC/14.35.180","text":"603.5.6, Protection from Lawn Sprinklers and Irrigation Systems, is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nPotable water supplies to systems having no pumps or connections for pumping equipment, and no chemical injection or provisions for chemical injection, shall be protected from backflow by one of the following devices:\n(1) Atmospheric vacuum breaker (AVB);\n(2) Pressure vacuum breaker backflow prevention assembly (PVB);\n(3) Spill-resistant pressure vacuum breaker (SVB);\n(4) Reduced pressure principle backflow prevention assembly (RP);\n(5) Valve complying with IAPO OS 72; or\n(6) Approved double-check valve backflow prevention assembly (DC).\n(Ord. 20570 § 19, 7-1-25.)","type":"section","workbench_component_id":"21dba591-b171-5163-ab12-48d0b35641ed"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.180","citation_url":"https://topeka.municipal.codes/TMC/14.35.180","content_hash":"9e0d8beb93221a77b94496a8e6dcaf2b4e69ce276203b6f302b67f59d42b3ec8","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.180:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.180:block:0","source_url":"https://topeka.municipal.codes/TMC/14.35.180","text":"603.5.6, Protection from Lawn Sprinklers and Irrigation Systems, is hereby deleted in its entirety and the following provisions shall be substituted therefor:","type":"paragraph","workbench_component_id":"7a1f2221-fb46-5ab1-94a0-8cbf8fbf1b83"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.180","citation_url":"https://topeka.municipal.codes/TMC/14.35.180","content_hash":"9ef856d9c2028b211fecc030417b481e4e31b7e84488c54531e60afce0178d85","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.180:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.180:block:1","source_url":"https://topeka.municipal.codes/TMC/14.35.180","text":"Potable water supplies to systems having no pumps or connections for pumping equipment, and no chemical injection or provisions for chemical injection, shall be protected from backflow by one of the following devices:","type":"paragraph","workbench_component_id":"e6061737-c756-54f3-94f9-2f08f7e71af7"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.180","citation_url":"https://topeka.municipal.codes/TMC/14.35.180","content_hash":"0a8112b3c7e4fe4aff98cb5739b6767ebd381b352bc6c65fd3de8fe74c0409b0","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.180:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.180:block:2","source_url":"https://topeka.municipal.codes/TMC/14.35.180","text":"(1) Atmospheric vacuum breaker (AVB);","type":"paragraph","workbench_component_id":"87fa652a-17b5-542f-ae8f-c07f9ef77bfb"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.180","citation_url":"https://topeka.municipal.codes/TMC/14.35.180","content_hash":"16f6aecb960ef15ad1820afaf662f3b71b9259885622bc0045282a61c27dda8f","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tm