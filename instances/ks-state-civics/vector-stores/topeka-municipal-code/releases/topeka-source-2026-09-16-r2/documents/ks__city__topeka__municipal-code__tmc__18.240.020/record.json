        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.240.020 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "c17936b8-2a88-5f3a-a3b4-d03e525af9f0",
          "convention": "utf8_char_offset",
          "end": 404,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.240.020:block:1",
          "start": 144
        },
        "quote": "(1) Computation. When determination of the number of off-street parking and stacking spaces results in a requirement of a fractional space, the fraction of one-half or less may be disregarded, and a fraction in excess of one-half shall be counted as one space.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.240.020:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.240.020 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "d47726c8-c172-5b7c-a9f5-987058486b0e",
          "convention": "utf8_char_offset",
          "end": 666,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.240.020:block:2",
          "start": 405
        },
