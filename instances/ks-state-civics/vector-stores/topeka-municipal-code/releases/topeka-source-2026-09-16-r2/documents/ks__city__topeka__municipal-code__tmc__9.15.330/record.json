          "start": 0
        },
        "quote": "It shall be unlawful for any licensee or holder of a temporary permit issued under the State Club and Drinking Establishment Act to:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.330:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.330 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "3d701a2b-4ceb-5588-871f-b23ed50cb2e3",
          "convention": "utf8_char_offset",
          "end": 232,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.330:block:1",
          "start": 133
        },
        "quote": "(a) Employ any person under the age of 18 years in connection with the serving of alcoholic liquor.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.330:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.330 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "36b5557b-6544-5c20-a213-b680f2fdb141",
          "convention": "utf8_char_offset",
          "end": 543,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.330:block:2",
          "start": 233
        },
        "quote": "(b) Knowingly employ or continue in employment any person in connection with the dispensing or serving of alcoholic liquor or the mixing of drinks containing alcoholic liquor who has been adjudged guilty of a felony or of any crime involving a morals charge in this or any other state, or of the United States.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.330:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.330 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "3119a11c-6751-5469-bf54-b7e3f1a47542",
          "convention": "utf8_char_offset",
          "end": 1433,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.330:block:3",
          "start": 544
        },
        "quote": "(c) Knowingly employ or continue in employment any person in connection with the serving of alcoholic liquor or the mixing of drinks containing alcoholic liquor who has been adjudged guilty of two or more violations of K.S.A. 21-5607 and amendments thereto, furnishing alcoholic liquor to minors or a similar law of any other state, or of the United States, pertaining to furnishing alcoholic liquor to minors within the immediately preceding five years, or who has been adjudged guilty of three or more violations of any intoxicating liquor law of this or any other state, or of the United States, not involving the furnishing of alcoholic liquor to minors within the immediately preceding five years. For purposes of this section, participation by a person in a diversionary program involving any such charge described in this section shall not be considered a conviction of such charge.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.330:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.330 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "b9a36de6-23ef-5fad-bd85-9d188c7a0a4c",
          "convention": "utf8_char_offset",
          "end": 1689,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.330:block:4",
          "start": 1434
        },
        "quote": "(d) In the case of a club, fail to maintain at the licensed premises a current list of all members and their residence addresses, or refuse to allow the Director, any of the Director’s authorized agents or any law enforcement officer to inspect such list.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.330:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.330 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "72f6a433-48ea-56e8-9a21-27fce6554599",
          "convention": "utf8_char_offset",
          "end": 1839,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.330:block:5",
          "start": 1690
        },
        "quote": "(e) Purchase alcoholic liquor from any person except from a person authorized by law to sell such alcoholic liquor to such licensee or permit holder.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.330:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.330 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "c064cd28-6280-5e5d-b5f9-baf0ee1cadda",
          "convention": "utf8_char_offset",
          "end": 2148,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.330:block:6",
          "start": 1840
        },
        "quote": "(f) Permit any employee of the licensee or permit holder who is under the age of 21 years to work on premises where alcoholic liquor is sold by such licensee or permit holder at any time when not under the on-premises supervision of the licensee, permit holder, or an employee who is 21 years of age or over.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.330:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.15.330 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "f031c35d-1b56-503d-8b3c-5520957c9f7e",
          "convention": "utf8_char_offset",
          "end": 2303,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.15.330:block:7",
          "start": 2149
        },
        "quote": "(g) Employ any person under 21 years of age in connection with the mixing or dispensing of drinks containing alcoholic liquor. (Ord. 20175 § 28, 3-12-19.)",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.15.330:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
