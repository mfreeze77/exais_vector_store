          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.65.450:block:7",
          "start": 1039
        },
        "quote": "(4) Certified mail, return receipt requested, to the last known address of the owner as reflected in the records of the County Appraiser.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.65.450:block:7#text",
