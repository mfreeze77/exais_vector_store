          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.65.450:block:6",
          "start": 934
        },
        "quote": "(iii) Serving the notice on any agent authorized by appointment or by law to receive service of process.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.65.450:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
