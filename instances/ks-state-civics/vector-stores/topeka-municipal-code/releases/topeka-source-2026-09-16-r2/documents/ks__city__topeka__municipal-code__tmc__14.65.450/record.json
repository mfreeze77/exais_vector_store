          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.65.450:block:4",
          "start": 732
        },
        "quote": "(i) Serving the notice on an officer, manager, partner or a resident, managing or general agent;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.65.450:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 14.65.450 block 5",
        "locator": {
