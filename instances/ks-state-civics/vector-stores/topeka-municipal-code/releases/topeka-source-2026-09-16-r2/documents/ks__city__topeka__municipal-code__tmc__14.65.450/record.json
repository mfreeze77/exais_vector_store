          "start": 829
        },
        "quote": "(ii) Leaving a copy of the notice at any business office with the person having charge of the office; or",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.65.450:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
