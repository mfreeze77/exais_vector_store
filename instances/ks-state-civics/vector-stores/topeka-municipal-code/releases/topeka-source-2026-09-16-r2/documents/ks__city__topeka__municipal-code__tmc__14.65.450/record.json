        },
        "quote": "(5) Delivery failure. If the owner or the owner’s agent has failed to accept delivery of notice or otherwise failed to effectuate receipt of notice during the preceding 24-month period, notice may be provided by other methods, including but not limited to door hangers, conspicuously posting notice on the property, personal notification, telephone communication, electronic communication, or first-class mail.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.65.450:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 14.65.450 block 9",
        "locator": {
          "block_index": 9,
          "component_id": "75762ab8-7f4d-5dde-a49f-64fac127e1de",
          "convention": "utf8_char_offset",
