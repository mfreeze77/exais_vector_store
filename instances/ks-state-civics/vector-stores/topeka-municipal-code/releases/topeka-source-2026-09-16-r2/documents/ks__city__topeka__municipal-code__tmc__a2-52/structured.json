{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:A2-52","page_type":"section"},"citation":"A2-52","citation_url":"https://topeka.municipal.codes/TMC/A2-52","content_hash":"efc7dd13544b1668394a363b32a2800fe611199f4c25adc58a0523bae249edee","heading":"Sec. A2-52. Acting City Manager.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:a2-52:section","source_url":"https://topeka.municipal.codes/TMC/A2-52","text":"The Governing Body shall designate a qualified person, including an employee to exercise the powers and perform the duties of City Manager during any temporary absence or disability of the City Manager. (C.O. 124 § 1, 6-11-24.)","type":"section","workbench_component_id":"0c6d4dec-fdf7-566f-9cfa-1671166430d0"},{"attributes":{"block_kind":"paragraph"},"citation":"A2-52","citation_url":"https://topeka.municipal.codes/TMC/A2-52","content_hash":"efc7dd13544b1668394a363b32a2800fe611199f4c25adc58a0523bae249edee","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:a2-52:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:a2-52:block:0","source_url":"https://topeka.municipal.codes/TMC/A2-52","text":"The Governing Body shall designate a qualified person, including an employee to exercise the powers and perform the duties of City Manager during any temporary absence or disability of the City Manager. (C.O. 124 § 1, 6-11-24.)","type":"paragraph","workbench_component_id":"3701cff5-6ec6-5ac0-8fd6-8644fcae5762"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:a2-52:section","schema":"exais.jurisdiction.structured_content.v1"}