{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.05.100","page_type":"section"},"citation":"5.05.100","citation_url":"https://topeka.municipal.codes/TMC/5.05.100","content_hash":"1c01e9228467f5ec19fc3df91838a99605cbe06088f3d0d0d3d013d0712ad4ae","heading":"Causes for refusal or revocation.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.05.100:section","source_url":"https://topeka.municipal.codes/TMC/5.05.100","text":"Licenses requested under this title may be refused by the City Clerk or the Council and licenses issued may be revoked by the City Clerk or the Council, at any time, for any of the following causes:\n(a) Fraud, misrepresentation or any false statement contained in the application for a license.\n(b) Fraud, misrepresentation or false statement made in the operation of a business.\n(c) Any violation of this code.\n(d) Conducting a business in an unlawful manner or in such manner as to constitute a breach of the peace or to constitute a menace to the health, morals, safety or welfare of the public.\n(e) The failure or inability of an applicant to meet and satisfy the requirements and provisions of this code. (Code 1981 § 24-10. Code 1995 § 30-35.)\nCross References: City Council – Mayor, Chapter 2.15 TMC; City Clerk, TMC 2.20.010 .","type":"section","workbench_component_id":"c0e98f48-06bc-5f52-8242-892053f1fb97"},{"attributes":{"block_kind":"paragraph"},"citation":"5.05.100","citation_url":"https://topeka.municipal.codes/TMC/5.05.100","content_hash":"f2714d31ec54a6357f251823c85670f300a81d1d1fc8d867d0a442b598c55f46","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.05.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.05.100:block:0","source_url":"https://topeka.municipal.codes/TMC/5.05.100","text":"Licenses requested under this title may be refused by the City Clerk or the Council and licenses issued may be revoked by the City Clerk or the Council, at any time, for any of the following causes:","type":"paragraph","workbench_component_id":"9865b858-fff5-536c-88ea-252a3648a8fd"},{"attributes":{"block_kind":"paragraph"},"citation":"5.05.100","citation_url":"https://topeka.municipal.codes/TMC/5.05.100","content_hash":"9e8a234f9387dcb741873acf3eda5106f815d5e520cbc374fd923f2f6ce41007","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.05.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.05.100:block:1","source_url":"https://topeka.municipal.codes/TMC/5.05.100","text":"(a) Fraud, misrepresentation or any false statement contained in the application for a license.","type":"paragraph","workbench_component_id":"e7a5430c-8682-5f08-88cf-57bb16a9eca3"},{"attributes":{"block_kind":"paragraph"},"citation":"5.05.100","citation_url":"https://topeka.municipal.codes/TMC/5.05.100","content_hash":"a2e9d9d74fb25021d3a558b3e588e87b0a87c3750ba55190b0226b3dee5c9031","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.05.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.05.100:block:2","source_url":"https://topeka.municipal.codes/TMC/5.05.100","text":"(b) Fraud, misrepresentation or false statement made in the operation of a business.","type":"paragraph","workbench_component_id":"14142268-4d54-5ce7-9b70-7cf935f94a2d"},{"attributes":{"block_kind":"paragraph"},"citation":"5.05.100","citation_url":"https://topeka.municipal.codes/TMC/5.05.100","content_hash":"334abc56dcfd21e475ab96657557e66a72ff39420c65fae8782dab7671008b3d","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:mu