    "references": [
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 1.10.020 block 0",
        "locator": {
          "block_index": 0,
          "component_id": "64b5d010-b12e-5db8-ae6a-1451c6e761e1",
