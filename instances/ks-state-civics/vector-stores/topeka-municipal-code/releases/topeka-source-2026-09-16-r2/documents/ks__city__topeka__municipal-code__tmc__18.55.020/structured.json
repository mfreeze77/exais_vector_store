c:18.55.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.020:block:14","source_url":"https://topeka.municipal.codes/TMC/18.55.020","text":"“Business” or “business use” means employment of one or more persons for the purpose of earning a livelihood, activities of persons to improve their economic conditions and desires, and generally relate to commercial and industrial engagements. (Ord. 20283 § 1, 3-2-21.)","type":"paragraph","workbench_component_id":"0d1d4812-b624-562d-9722-ecf0f88c88f2"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.020:def:basement"},"citation":"18.55.020","citation_url":"https://topeka.municipal.codes/TMC/18.55.020","content_hash":"3a30bbeb4734d341ee08182fdcfae5fd60b9105fbeb601ae525394ff60b0cbe0","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.020:definition:0","source_url":"https://topeka.municipal.codes/TMC/18.55.020","text":null,"type":"definition","workbench_component_id":"9976d69e-45c0-5e64-86ba-90e163a2a1ef"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.020:def:block"},"citation":"18.55.020","citation_url":"https://topeka.municipal.codes/TMC/18.55.020","content_hash":"57cd4d2d3e332dfcf987c0170521c563769a9490b9a88e85673686314a67054d","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.020:definition:1","source_url":"https://topeka.municipal.codes/TMC/18.55.020","text":null,"type":"definition","workbench_component_id":"b6340bbd-7b9b-5a89-aa66-376fe8174fb6"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.020:def:boarding-house"},"citation":"18.55.020","citation_url":"https://topeka.municipal.codes/TMC/18.55.020","