{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.40.110","page_type":"section"},"citation":"14.40.110","citation_url":"https://topeka.municipal.codes/TMC/14.40.110","content_hash":"3af271b83a20ee82e99d2d9a0c58e12de29e1e7b958215c4bcdf85b7f0097be9","heading":"Chapter 9, Section 903.2.1.2, Group A-2.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.40.110:section","source_url":"https://topeka.municipal.codes/TMC/14.40.110","text":"Chapter 9, Section 903.2.1.2, Group A-2, is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nAn automatic sprinkler system shall be provided throughout stories containing Group A-2 occupancies and throughout all stories from the Group A-2 occupancy to and including the levels of exit discharge serving that occupancy where one of the following conditions exists:\n1. The fire area exceeds 5,000 square feet (465 m 2 );\n2. The fire area has an occupant load of 300 or more; or\n3. The fire area is located on a floor other than the level of exit discharge serving such occupancies.\n(Ord. 20407 § 11, 2-7-23.)","type":"section","workbench_component_id":"7f1c831c-fa93-528a-8a04-95f8d5dcb931"},{"attributes":{"block_kind":"paragraph"},"citation":"14.40.110","citation_url":"https://topeka.municipal.codes/TMC/14.40.110","content_hash":"7168d770dc4abd0423db91892b9044113d4c8246cdb1cd2d5ef36b828453a8ca","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.40.110:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.40.110:block:0","source_url":"https://topeka.municipal.codes/TMC/14.40.110","text":"Chapter 9, Section 903.2.1.2, Group A-2, is hereby deleted in its entirety and the f