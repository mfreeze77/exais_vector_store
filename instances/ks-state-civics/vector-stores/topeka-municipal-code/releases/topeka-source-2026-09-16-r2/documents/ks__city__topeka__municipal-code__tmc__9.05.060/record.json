      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.060 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "de5cb129-f8b7-5423-9682-855f83811cca",
          "convention": "utf8_char_offset",
          "end": 1764,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.060:block:4",
          "start": 679
        },
        "quote": "(1) Religious Practices. The terms of this section shall not apply to any person who performs any religious or spiritual function, or a priest, minister, rector or any accredited representative of a church or religion where such priest, minister, rector or accredited representative holds a certificate of credit, commission or ordination under the ecclesiastical laws of a religious corporation, incorporated under the laws of any state or territory of the United States, or any voluntary religious organization, and who fully conforms to the rights and practices prescribed by the supreme conference, convocation, convention, assembly, association or synod of the system or faith with which such person is affiliated; provided, however, that any church or religious organization which is organized for the primary purpose of conferring certificates of commission, credit or ordination for a price, and not primarily for the purpose of teaching or practicing a religious doctrine or belief, shall not be deemed to be a church or religious organization for purposes of this subsection.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.060:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
