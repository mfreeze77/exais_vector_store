          "start": 431
        },
        "quote": "(3) The signature and identification number of the person who affixed the immobilization device to the vehicle;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.60.640:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
