          "start": 1101
        },
        "quote": "(8) The contact name, telephone number, and daytime hours of the City office where payment of the fines can be made or information regarding the procedures for contesting the immobilization can be obtained;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.60.640:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
