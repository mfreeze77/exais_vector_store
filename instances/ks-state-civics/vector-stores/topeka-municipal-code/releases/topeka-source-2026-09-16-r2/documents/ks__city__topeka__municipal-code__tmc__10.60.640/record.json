          "start": 613
        },
        "quote": "(5) The number and amount of unpaid parking tickets and fines;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.60.640:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 10.60.640 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "88eee4f0-f4a9-580f-a404-62c7510841fc",
