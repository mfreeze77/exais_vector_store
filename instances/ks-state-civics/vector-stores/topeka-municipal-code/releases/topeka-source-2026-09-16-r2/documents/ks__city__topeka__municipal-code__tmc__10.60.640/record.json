          "start": 1308
        },
        "quote": "(9) The contact name and telephone number of a City official responsible for providing after-hours assistance; and",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.60.640:block:9#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
