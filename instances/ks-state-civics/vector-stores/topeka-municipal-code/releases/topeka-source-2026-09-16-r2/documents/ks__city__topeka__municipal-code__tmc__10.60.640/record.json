          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.60.640:block:2",
          "start": 350
        },
        "quote": "(2) The date and time when the immobilization device was affixed to the vehicle;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.60.640:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
