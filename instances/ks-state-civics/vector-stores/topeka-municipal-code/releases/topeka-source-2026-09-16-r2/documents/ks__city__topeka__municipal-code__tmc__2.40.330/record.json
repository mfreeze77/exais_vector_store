          "start": 3029
        },
        "quote": "Cross References: City Council – Mayor, Chapter 2.15 TMC.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.40.330:block:10#text",
        "unavailable_reason": null
      },
