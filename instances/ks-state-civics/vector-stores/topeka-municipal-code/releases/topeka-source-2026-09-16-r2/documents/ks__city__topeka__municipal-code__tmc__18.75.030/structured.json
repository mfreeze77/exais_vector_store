{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:18.75.030","page_type":"section"},"citation":"18.75.030","citation_url":"https://topeka.municipal.codes/TMC/18.75.030","content_hash":"5b646511ec925023228bb3bcf8c7bdd23f80f1855a26bcb6fed3eecceae7a1e6","heading":"Principal, special, and conditional uses.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.75.030:section","source_url":"https://topeka.municipal.codes/TMC/18.75.030","text":"(a) Principal uses identified in the use matrix table in TMC 18.60.010 shall be allowed.\n(b) Special uses identified in the use matrix table in TMC 18.60.010 shall be allowed subject to the restrictions identified in Chapter 18.225 TMC.\n(c) Conditional uses identified in the use matrix table in TMC 18.60.010 may be allowed in accordance with Chapter 18.215 TMC if approved by the Governing Body. (Ord. 19921 § 26, 9-23-14.)\nCross References: City Council – Mayor, Chapter 2.15 TMC.","type":"section","workbench_component_id":"4cf423dd-f6ef-5aba-8dfe-0e3d744425cc"},{"attributes":{"block_kind":"paragraph"},"citation":"18.75.030","citation_url":"https://topeka.municipal.codes/TMC/18.75.030","content_hash":"bd8880ee0cf3922bcda41a64febcdc85634bcf535be392fca2faf0eaceff3d8e","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.75.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.75.030:block:0","source_url":"https://topeka.municipal.codes/TMC/18.75.030","text":"(a) Principal uses identified in the use matrix table in TMC 18.60.010 shall be allowed.","type":"paragraph","workbench_component_id":"e2d35191-5fa3-5c59-ae2a-38573fb0fed3"},{"attributes":{"block_kind":"paragraph"},"citation":"18.75.030","citation_ur