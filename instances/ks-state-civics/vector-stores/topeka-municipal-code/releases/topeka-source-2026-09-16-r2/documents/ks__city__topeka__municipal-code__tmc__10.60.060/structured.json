{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.60.060","page_type":"section"},"citation":"10.60.060","citation_url":"https://topeka.municipal.codes/TMC/10.60.060","content_hash":"fa73b8c020a7eae22e309d47e84735cb786a382046222767a5b6aa2a2398bef7","heading":"Permit restrictions.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.060:section","source_url":"https://topeka.municipal.codes/TMC/10.60.060","text":"Annual delivery vehicle permits shall be subject to the following restrictions:\n(a) Delivery vehicles displaying such permit shall be exempt from payment for parking meters, but not from the posted parking time limits.\n(b) Delivery vehicles displaying such permit shall be exempt from time-restricted parking zone ordinances, but may not remain in the same stall beyond the posted parking time limit.\n(c) Such permit shall not be valid when displayed upon a vehicle with a gross vehicle weight in excess of 5,500 pounds; and which cannot be safely accommodated by a standard parallel or angle parking stall. (Ord. 20566 § 11, 6-10-25.)","type":"section","workbench_component_id":"82047237-2fb6-59a2-9009-65879f02f446"},{"attributes":{"block_kind":"paragraph"},"citation":"10.60.060","citation_url":"https://topeka.municipal.codes/TMC/10.60.060","content_hash":"9f8fba75f8364dd4eeef6e4692443330d227aa52787bac938cfe23b8a4fd6096","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.60.060:block:0","source_url":"https://topeka.municipal.codes/TMC/10.60.060","text":"Annual delivery vehicle permits shall be subject to the following restrictions:","type":"paragraph","workbench_componen