{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.55.120","page_type":"section"},"citation":"14.55.120","citation_url":"https://topeka.municipal.codes/TMC/14.55.120","content_hash":"67cc1f87e07980d66b7ba4b61d7bc63febebee5efce083918bfcd550f0089518","heading":"Premises identification.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.120:section","source_url":"https://topeka.municipal.codes/TMC/14.55.120","text":"Section R105.10, Premises identification, is hereby created by the addition of the following provisions:\nThe approved permit number and street address number shall be displayed and be plainly visible and legible from the public street or road fronting the property on which any new building is being constructed. Use or occupancy of the building may be denied for failure to display in accordance with this section.\n(Ord. 20467 § 5, 12-5-23.)","type":"section","workbench_component_id":"a6b66241-10e5-5f75-9b4b-a29f73cecfcd"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.120","citation_url":"https://topeka.municipal.codes/TMC/14.55.120","content_hash":"2cbcf4b4bb8491d4d7a644757d3e07792d398878c38557f87aabd53b030efa38","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.120:block:0","source_url":"https://topeka.municipal.codes/TMC/14.55.120","text":"Section R105.10, Premises identification, is hereby created by the addition of the following provisions:","type":"paragraph","workbench_component_id":"75ba0e96-d408-5084-8aca-96df6f0fe5bb"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.120","citation_url":"https://topeka.municipal.codes/TMC/14.5