{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.75.120","page_type":"section"},"citation":"5.75.120","citation_url":"https://topeka.municipal.codes/TMC/5.75.120","content_hash":"707e22d10dc8ac292599ad09292818a241b2d0eb0e242fd92d8a73de1b5d9fcc","heading":"Surrender of business license upon issuance.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.120:section","source_url":"https://topeka.municipal.codes/TMC/5.75.120","text":"Upon being issued a permit under this article for a going-out-of-business sale, the permittee shall surrender to the City Clerk all other City business permits or licenses which the permittee may hold at that time applicable to the location and goods covered by the application for a permit under this article. (Code 1981 § 37-39. Code 1995 § 30-161.)\nCross References: City Clerk, TMC 2.20.010 .","type":"section","workbench_component_id":"6e8083f6-851b-5c05-b718-0d4cb8168c7e"},{"attributes":{"block_kind":"paragraph"},"citation":"5.75.120","citation_url":"https://topeka.municipal.codes/TMC/5.75.120","content_hash":"62c5c2725a0356555900256f7ee03b5f16f7238dff1cb4924c43ab2880464701","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.120:block:0","source_url":"https://topeka.municipal.codes/TMC/5.75.120","text":"Upon being issued a permit under this article for a going-out-of-business sale, the permittee shall surrender to the City Clerk all other City business permits or licenses which the permittee may hold at that time applicable to the location and goods covered by the application for a permit under this article. (Code 1981 § 37-39. Code 1995 § 30-161.)","type":"paragraph","workbench_component_id":"6f64d3bc-8111-5914-8328-628270b56fc1"},{"attributes":{"block_kind":"paragraph"},"citation":"5.75.120","citation_url":"https://topeka.municipal.codes/TMC/5.75.120","content_hash":"547b4e6a10c399a196aa412a4781d80cc47ea4b405a5933441203369ce0262c5","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.120:block:1","source_url":"https://topeka.municipal.codes/TMC/5.75.120","text":"Cross References: City Clerk, TMC 2.20.010 .","type":"paragraph","workbench_component_id":"f1689078-43d1-57a1-8e9b-b0923fab7dac"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.120:section","schema":"exais.jurisdiction.structured_content.v1"}