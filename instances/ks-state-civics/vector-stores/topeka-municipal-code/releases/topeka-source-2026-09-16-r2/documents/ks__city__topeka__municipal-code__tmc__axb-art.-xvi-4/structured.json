{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:AxB_ArtXVI_4","page_type":"section"},"citation":"AxB Art. XVI § 4","citation_url":"https://topeka.municipal.codes/TMC/AxB_ArtXVI_4","content_hash":"b2ff2e7d29c6ee176c5dfd6983ef62d3b8987e1407817addfa30f01858ffd863","heading":"Section 4. Records.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:axb-art.-xvi-4:section","source_url":"https://topeka.municipal.codes/TMC/AxB_ArtXVI_4","text":"The City shall have the right to examine, upon written notice to the Local Provider, no more than once per calendar year, those records necessary to verify the correctness of the compensation paid pursuant to this Contract Franchise Ordinance. (Ord. 18824 § 4, 3-6-07.)","type":"section","workbench_component_id":"323a26a8-2aaf-52e7-bd46-3cc84652141a"},{"attributes":{"block_kind":"paragraph"},"citation":"AxB Art. XVI § 4","citation_url":"https://topeka.municipal.codes/TMC/AxB_ArtXVI_4","content_hash":"b2ff2e7d29c6ee176c5dfd6983ef62d3b8987e1407817addfa30f01858ffd863","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:axb-art.-xvi-4:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:axb-art.-xvi-4:block:0","source_url":"https://topeka.municipal.codes/TMC/AxB_ArtXVI_4","text":"The City shall have the right to examine, upon written notice to the Local Provider, no more than once per calendar year, those records necessary to verify the correctness of the compensation paid pursuant to this Contract Franchise Ordinance. (Ord. 18824 § 4, 3-6-07.)","type":"paragraph","workbench_component_id":"235b9d12-ae7d-5735-8b43-d005da67ff29"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:axb-art.-xvi-4:section","s