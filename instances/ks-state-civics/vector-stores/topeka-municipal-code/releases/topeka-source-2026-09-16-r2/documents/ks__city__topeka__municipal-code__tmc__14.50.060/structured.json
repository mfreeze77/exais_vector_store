{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.50.060","page_type":"section"},"citation":"14.50.060","citation_url":"https://topeka.municipal.codes/TMC/14.50.060","content_hash":"950a731e474de7ae89634944654ecae3083fb111f7d1d677caa0aeb750e5b8d6","heading":"Chapter 5, Section 510.3.1.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.060:section","source_url":"https://topeka.municipal.codes/TMC/14.50.060","text":"Chapter 5, Section 510.3.1, is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nFor hoods with dampers in the supply collar, an access panel for cleaning and inspection shall be provided in the duct or the hood collar. For Type I duct system, dampers shall not be permitted in the exhaust collar or in the exhaust duct. This access panel shall be as close to the hood as possible but shall not exceed eighteen (18) inches (457.2 mm).\nException: Dampers that are accessible from under the hood.\n(Ord. 20595 § 8, 8-19-25.)","type":"section","workbench_component_id":"99bf6757-a4ee-50cb-809c-2f16119b7060"},{"attributes":{"block_kind":"paragraph"},"citation":"14.50.060","citation_url":"https://topeka.municipal.codes/TMC/14.50.060","content_hash":"396a69e85c436f98886cbbf67444f25f6a21e80d047375e6befb1222583119b3","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.060:block:0","source_url":"https://topeka.municipal.codes/TMC/14.50.060","text":"Chapter 5, Section 510.3.1, is hereby deleted in its entirety and the following provisions shall be substituted therefor:","type":"paragraph","workbench_component_id":"7669cc0f-23e8-5437-8104-7f5748677e73"},{"attributes":{"block_kind":"paragraph"},"citation":"14.50.060","citation_url":"https://topeka.municipal.codes/TMC/14.50.060","content_hash":"ac6f90ead05efd2f87ba78901d16817eb25a3b16129feaa655a464bb3ab0520f","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.060:block:1","source_url":"https://topeka.municipal.codes/TMC/14.50.060","text":"For hoods with dampers in the supply collar, an access panel for cleaning and inspection shall be provided in the duct or the hood collar. For Type I duct system, dampers shall not be permitted in the exhaust collar or in the exhaust duct. This access panel shall be as close to the hood as possible but shall not exceed eighteen (18) inches (457.2 mm).","type":"paragraph","workbench_component_id":"1ca5a420-4746-5129-a6b9-7e951be35b28"},{"attributes":{"block_kind":"paragraph"},"citation":"14.50.060","citation_url":"https://topeka.municipal.codes/TMC/14.50.060","content_hash":"ab4c3ae4895a3d21fd4c44eb9b83513cdb2dd98622264f61e957adf0367fd88e","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.060:block:2","source_url":"https://topeka.municipal.codes/TMC/14.50.060","text":"Exception: Dampers that are accessible from under the hood.","type":"paragraph","workbench_component_id":"a44cd580-a633-573e-98eb-8725b5927bf9"},{"attributes":{"block_kind":"paragraph"},"citation":"14.50.060","citation_url":"https://topeka.municipal.codes/TMC/14.50.060","content_hash":"39797a207b29c3d2e608ff037e28caaf6eb1515abed902f0dd61694d01628565","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.50.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks: