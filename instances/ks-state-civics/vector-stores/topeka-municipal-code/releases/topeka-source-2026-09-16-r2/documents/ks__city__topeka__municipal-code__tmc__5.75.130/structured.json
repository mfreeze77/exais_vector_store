{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.75.130","page_type":"section"},"citation":"5.75.130","citation_url":"https://topeka.municipal.codes/TMC/5.75.130","content_hash":"d4c9ee1f0d8d488be70352e474600899e4a34ce0ac7568116b08fafcf6d4a557","heading":"Authorized sales.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.130:section","source_url":"https://topeka.municipal.codes/TMC/5.75.130","text":"(a) Nature of Sale. The permit issued under this article shall authorize only the one type of sale described in the application at the location named therein.\n(b) Saleable Goods. The permit shall authorize only the sale of goods described in the inventory attached to the application. (Code 1981 § 37-40. Code 1995 § 30-162.)","type":"section","workbench_component_id":"225789d5-74ad-543f-bf80-28cb522b2335"},{"attributes":{"block_kind":"paragraph"},"citation":"5.75.130","citation_url":"https://topeka.municipal.codes/TMC/5.75.130","content_hash":"bfd5991f78546422e720879af982d84e02471f82fad69972019193dded2d2160","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.130:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.75.130:block:0","source_url":"https://topeka.municipal.codes/TMC/5.75.130","text":"(a) Nature of Sale. The permit issued under this article shall authorize only the one type of sale described in the application at the location named therein.","type":"paragraph","workbench_component_id":"e4476319-4c56-5ff5-8ed5-1304df814d0f"},{"attributes":{"block_kind":"paragraph"},"citation":"5.75.130","citation_url":"https://topeka.municipal.codes/TMC/5.75.130","content_hash":"79d3df936c36ef209e3bc8090dd9fcb21d23981b92c96127b0f242772dd0