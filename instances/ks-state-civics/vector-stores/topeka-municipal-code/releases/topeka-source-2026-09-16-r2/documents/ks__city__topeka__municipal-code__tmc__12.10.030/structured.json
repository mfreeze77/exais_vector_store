{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:12.10.030","page_type":"section"},"citation":"12.10.030","citation_url":"https://topeka.municipal.codes/TMC/12.10.030","content_hash":"41db3554a2bcc9e6f14b1c3571052bf79495b943a8093f35b7569020dd557c3c","heading":"Parking to sell merchandise.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.10.030:section","source_url":"https://topeka.municipal.codes/TMC/12.10.030","text":"It shall be unlawful for any person to park any vehicle for the purpose of selling or offering for sale any produce, manufactured article or merchandise of any description upon any of the streets or alleys of the City. (Code 1981 § 40-22. Code 1995 § 130-38.)\nCross References: Businesses, TMC Title 5 ; stopping, standing and parking, TMC 10.60.010 et seq.","type":"section","workbench_component_id":"0a6d73b1-3128-56a0-b19c-917568b387b1"},{"attributes":{"block_kind":"paragraph"},"citation":"12.10.030","citation_url":"https://topeka.municipal.codes/TMC/12.10.030","content_hash":"46be30a9000c948a92a94315265f17f6542948e69121d635628b54a0f880c64f","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:12.10.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.10.030:block:0","source_url":"https://topeka.municipal.codes/TMC/12.10.030","text":"It shall be unlawful for any person to park any vehicle for the purpose of selling or offering for sale any produce, manufactured article or merchandise of any description upon any of the streets or alleys of the City. (Code 1981 § 40-22. Code 1995 § 130-38.)","type":"paragraph","workbench_component_id":"fbb7ca33-f69d-58e1-807b-d75e1bada9d6"},{"attributes":{"block_kind":"paragraph"},"cita