          "start": 1194
        },
        "quote": "(1) The liquid waste is domestic generated waste or commercial/food waste with the exception of grease trap waste; and",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.570:block:11#text",
        "unavailable_reason": null
