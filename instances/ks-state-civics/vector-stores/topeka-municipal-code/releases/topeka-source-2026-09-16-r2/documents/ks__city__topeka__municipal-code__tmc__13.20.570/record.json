          "start": 1313
        },
        "quote": "(2) The liquid waste may be discharged into the WPCD disposal facility without causing pass-through or interference; and",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.570:block:12#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
