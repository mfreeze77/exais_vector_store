          "convention": "utf8_char_offset",
          "end": 2248,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:2.250.010:block:13",
          "start": 2198
        },
        "quote": "Cross References: Legal Department, TMC 2.20.070 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.250.010:block:13#text",
