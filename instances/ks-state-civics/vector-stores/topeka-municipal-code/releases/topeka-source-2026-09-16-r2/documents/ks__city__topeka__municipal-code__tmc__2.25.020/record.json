          "source_component_key": "ks:city:topeka:municipal-code:tmc:2.25.020:block:1",
          "start": 125
        },
        "quote": "(a) To administer all programs undertaken by the City pursuant to the Community Development Act of 1974, as amended.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.25.020:block:1#text",
        "unavailable_reason": null
