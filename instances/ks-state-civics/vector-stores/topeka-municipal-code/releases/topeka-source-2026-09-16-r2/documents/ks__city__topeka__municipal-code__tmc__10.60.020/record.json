        },
        "quote": "(a) Except when done at the direction of a law enforcement officer or an official traffic control device, no person shall operate, attempt to operate, stop, stand, park, occupy or ride upon or within any vehicle within the boundaries of any public or private parking lot during the hours that such parking lot is closed to the public.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.60.020:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
