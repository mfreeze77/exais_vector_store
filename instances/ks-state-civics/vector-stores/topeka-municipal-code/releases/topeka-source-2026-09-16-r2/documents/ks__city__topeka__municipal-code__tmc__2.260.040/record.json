          "start": 751
        },
        "quote": "(2) Provide an annual report to the Governing Body on or before January 31st of each year, in accordance with K.S.A. 12-5903(f) and amendments thereto.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.260.040:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
