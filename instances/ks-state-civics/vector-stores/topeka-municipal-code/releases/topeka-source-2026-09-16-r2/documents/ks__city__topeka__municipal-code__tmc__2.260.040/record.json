        "label": "TMC 2.260.040 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "e5251cfd-d75c-5f73-b46c-bc1f07e298bf",
          "convention": "utf8_char_offset",
          "end": 750,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:2.260.040:block:3",
          "start": 426
        },
        "quote": "(1) Establish annual budgets for submission to and approval by the Governing Body. The budget must be submitted to the Governing Body prior to June 1st of each year and include, at a minimum, the amounts designated for staffing, land acquisition, demolition, renovation, maintenance, upkeep and new construction development.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.260.040:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 2.260.040 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "58f2e5f7-e814-58fa-8ee2-908769792969",
          "convention": "utf8_char_offset",
