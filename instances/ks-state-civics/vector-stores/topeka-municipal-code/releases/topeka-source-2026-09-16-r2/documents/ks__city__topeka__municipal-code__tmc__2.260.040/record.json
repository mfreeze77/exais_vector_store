        },
        "quote": "(c) Operations. The duties of the Bank shall include, but are not limited to, the following:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.260.040:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
