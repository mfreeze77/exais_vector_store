          "start": 903
        },
        "quote": "(3) Comply with the Topeka Land Bank Administrative Policy Guidelines approved by the Governing Body.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.260.040:block:5#text",
        "unavailable_reason": null
      },
