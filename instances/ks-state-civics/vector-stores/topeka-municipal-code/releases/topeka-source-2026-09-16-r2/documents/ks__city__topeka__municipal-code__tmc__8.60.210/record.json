          "source_component_key": "ks:city:topeka:municipal-code:tmc:8.60.210:block:8",
          "start": 1511
        },
        "quote": "Exceptions:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:8.60.210:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 8.60.210 block 9",
        "locator": {
          "block_index": 9,
          "component_id": "2b5390bb-77bb-587f-9209-0ecad54b8c3e",
          "convention": "utf8_char_offset",
