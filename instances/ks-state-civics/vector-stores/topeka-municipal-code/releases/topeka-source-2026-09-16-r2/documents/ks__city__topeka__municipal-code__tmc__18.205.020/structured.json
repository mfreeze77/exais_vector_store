t_source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:block:13","source_url":"https://topeka.municipal.codes/TMC/18.205.020","text":"“Runway” means a defined area of an airport prepared for the landing and takeoff of aircraft along its length.","type":"paragraph","workbench_component_id":"00d9e57a-7c71-533e-8660-7c2e6d849340"},{"attributes":{"block_kind":"paragraph"},"citation":"18.205.020","citation_url":"https://topeka.municipal.codes/TMC/18.205.020","content_hash":"59f3d18aaca0a988d5ad9169475e546cfc37455206ccf504f3556308166394c4","heading":null,"ordinal":14,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:block:14","source_url":"https://topeka.municipal.codes/TMC/18.205.020","text":"“Structure” means an object constructed or installed by man, including, but without limitation, buildings, towers, smokestacks, earth formations and overhead transmission lines.","type":"paragraph","workbench_component_id":"6484a7e4-ca85-52d0-8fdb-849e7b955322"},{"attributes":{"block_kind":"paragraph"},"citation":"18.205.020","citation_url":"https://topeka.municipal.codes/TMC/18.205.020","content_hash":"e1b2f62c1befca8746fd592ef2521d9b15bb7b30dc6f24f2fda854344339f70f","heading":null,"ordinal":15,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:block:15","source_url":"https://topeka.municipal.codes/TMC/18.205.020","text":"“Tree” means any object of natural growth.","type":"paragraph","workbench_component_id":"3a538587-f5d6-5f60-851c-016318de7298"},{"attributes":{"block_kind":"paragraph"},"citation":"18.205.020","citation_url":"https://topeka.municipal.codes/TMC/18.205.020","content_hash":"c36359f9fdf01da12bd50f05963ec0d0291b785960ce2f545f4a9bab2650bd17","heading":null,"ordinal":16,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:block:16","source_url":"https://topeka.municipal.codes/TMC/18.205.020","text":"“Utility runway” means a runway that is constructed for an intended use by propeller-driven aircraft of 12,500 pounds maximum gross weight and less.","type":"paragraph","workbench_component_id":"eae0fa29-ad35-5b52-8d32-71bc95b6bb88"},{"attributes":{"block_kind":"paragraph"},"citation":"18.205.020","citation_url":"https://topeka.municipal.codes/TMC/18.205.020","content_hash":"a34d1d49d5fc327375e4d23bc8fec51b1e75ce401189930392d813e7993c9b27","heading":null,"ordinal":17,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:block:17","source_url":"https://topeka.municipal.codes/TMC/18.205.020","text":"“Visual runway” means a runway intended solely for the operation of aircraft using visual approach procedures with no straight-in instrument approach procedure and no instrument designation indicated on an FAA-approved airport layout plan, a military service’s approved military airport layout plan, or by a planning document submitted to the FAA by competent authority. (Code 1981 § 4-56. Code 1995 § 22-27.)","type":"paragraph","workbench_component_id":"c6ab658f-581e-5b83-9380-fb6e10a53e1e"},{"attributes":{"block_kind":"paragraph"},"citation":"18.205.020","citation_url":"https://topeka.municipal.codes/TMC/18.205.020","content_hash":"06e14d0ebd52300a4940f01134a36eb0aa2b67f39a58c4b905cd742a8e257e8f","heading":null,"ordinal":18,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.205.020:section","schema":"exais.workbench_component.v1","source_co