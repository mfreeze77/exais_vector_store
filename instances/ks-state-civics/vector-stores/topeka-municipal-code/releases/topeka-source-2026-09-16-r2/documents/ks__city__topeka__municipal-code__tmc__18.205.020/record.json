    "references": [
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 0",
        "locator": {
          "block_index": 0,
          "component_id": "fb0b75cc-1a5a-53b5-9cb1-e4d741f9fbb1",
          "convention": "utf8_char_offset",
          "end": 188,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:0",
          "start": 0
        },
        "quote": "The following words, terms and phrases, when used in this chapter, shall have the meanings ascribed to them in this section, except where the context clearly indicates a different meaning:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "98cfba44-131d-5e1e-b06f-a61bd491546d",
          "convention": "utf8_char_offset",
          "end": 261,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:1",
          "start": 189
        },
        "quote": "“Airport” means the Forbes Field Airport and the Philip Billard Airport.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "a7b9e80e-50df-56d1-96d0-dbdb9401ad04",
          "convention": "utf8_char_offset",
          "end": 379,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:2",
          "start": 262
        },
        "quote": "“Airport elevation” means the highest point of an airport’s usable landing area measured in feet from mean sea level.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "62dc91d3-da4b-5d29-9a44-e35778ad62d9",
          "convention": "utf8_char_offset",
          "end": 702,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:3",
          "start": 380
        },
        "quote": "“Airport hazard” means any structure or object of natural growth located on or in the vicinity of a public airport, or any use of land near such airport, which obstructs the airspace required for the flight of aircraft in landing or takeoff at such airport or is otherwise hazardous to such landing or takeoff of aircraft.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "e965b136-be8f-50e5-93fa-c5577959b42d",
          "convention": "utf8_char_offset",
          "end": 929,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:4",
          "start": 703
        },
        "quote": "Approach, Transitional, Horizontal and Conical Zones. These zones apply to the area under the approach, transitional, horizontal and conical surfaces defined in the Federal Aviation Administration regulations, 14 CFR Part 77 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "9ee6b1cf-d3a9-5a37-aef2-d2376fa14ca7",
          "convention": "utf8_char_offset",
          "end": 1067,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:5",
          "start": 930
        },
        "quote": "“Board of Zoning Appeals” means a board consisting of not less than three nor more than seven members appointed by the Mayor of the City.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "6af5f868-a929-5913-a6a2-a43dfd81876d",
          "convention": "utf8_char_offset",
          "end": 1264,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:6",
          "start": 1068
        },
        "quote": "Height. For the purpose of determining the height limits in all zones set forth in this chapter and shown on the zoning map, the datum shall be mean sea level elevation unless otherwise specified.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "4b9ec259-a916-503e-8e90-f1e1ddfe3b5d",
          "convention": "utf8_char_offset",
          "end": 1442,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:7",
          "start": 1265
        },
        "quote": "“Nonconforming use” means any preexisting structure, object of natural growth, or use of land which is inconsistent with the provisions of this chapter or any amendment thereto.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 8",
        "locator": {
          "block_index": 8,
          "component_id": "4c249776-c304-55fa-bf81-19f84ee0bfc0",
          "convention": "utf8_char_offset",
          "end": 1896,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:8",
          "start": 1443
        },
        "quote": "“Nonprecision instrument runway” means a runway having an existing instrument approach procedure utilizing air navigation facilities with only horizontal guidance, or area-type navigation equipment, for which a straight-in nonprecision instrument approach procedure has been approved or planned, and for which no precision approach facilities are planned or indicated on an FAA planning document or military service’s military airport planning document.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 9",
        "locator": {
          "block_index": 9,
          "component_id": "89b73ea4-eb53-5096-9c5d-00776c3afa5e",
          "convention": "utf8_char_offset",
          "end": 2112,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:9",
          "start": 1897
        },
        "quote": "“Person” means an individual, firm, partnership, corporation, company, association, joint stock association or governmental entity. It includes a trustee, receiver, assignee or similar representative of any of them.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:9#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 10",
        "locator": {
          "block_index": 10,
          "component_id": "05914267-04db-5599-9221-3e72fe578d43",
          "convention": "utf8_char_offset",
          "end": 2479,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:10",
          "start": 2113
        },
        "quote": "“Precision instrument runway” means a runway having an existing instrument approach procedure utilizing an instrument landing system (ILS) or a precision approach radar (PAR). It also means a runway for which a precision approach system is planned and is so indicated on an FAA-approved airport layout plan or a military service’s military airport planning document.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:10#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 11",
        "locator": {
          "block_index": 11,
          "component_id": "e16642c9-2cac-5243-aabb-0f35581140be",
          "convention": "utf8_char_offset",
          "end": 2812,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:11",
          "start": 2480
        },
        "quote": "“Primary surface” means a surface longitudinally centered on a runway. When the runway has a specially prepared hard surface, the primary surface extends 200 feet beyond each end of that runway; but when the runway has no specially prepared hard surface, or planned hard surface, the primary surface ends at each end of that runway.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:11#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 12",
        "locator": {
          "block_index": 12,
          "component_id": "213a26a7-2ce5-5a95-8fcd-5958f1e5f104",
          "convention": "utf8_char_offset",
          "end": 3163,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:12",
          "start": 2813
        },
        "quote": "The width of the primary surface of a runway will be that width prescribed in 14 CFR Part 77 of the Federal Aviation Administration regulations for the most precise approach existing or planned for either end of that runway. The elevation of any point on the primary surface is the same as the elevation of the nearest point on the runway centerline.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:12#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 13",
        "locator": {
          "block_index": 13,
          "component_id": "00d9e57a-7c71-533e-8660-7c2e6d849340",
          "convention": "utf8_char_offset",
          "end": 3274,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:13",
          "start": 3164
        },
        "quote": "“Runway” means a defined area of an airport prepared for the landing and takeoff of aircraft along its length.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:13#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 14",
        "locator": {
          "block_index": 14,
          "component_id": "6484a7e4-ca85-52d0-8fdb-849e7b955322",
          "convention": "utf8_char_offset",
          "end": 3452,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:14",
          "start": 3275
        },
        "quote": "“Structure” means an object constructed or installed by man, including, but without limitation, buildings, towers, smokestacks, earth formations and overhead transmission lines.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:14#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 15",
        "locator": {
          "block_index": 15,
          "component_id": "3a538587-f5d6-5f60-851c-016318de7298",
          "convention": "utf8_char_offset",
          "end": 3495,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:15",
          "start": 3453
        },
        "quote": "“Tree” means any object of natural growth.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:15#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 16",
        "locator": {
          "block_index": 16,
          "component_id": "eae0fa29-ad35-5b52-8d32-71bc95b6bb88",
          "convention": "utf8_char_offset",
          "end": 3644,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:16",
          "start": 3496
        },
        "quote": "“Utility runway” means a runway that is constructed for an intended use by propeller-driven aircraft of 12,500 pounds maximum gross weight and less.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:16#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 17",
        "locator": {
          "block_index": 17,
          "component_id": "c6ab658f-581e-5b83-9380-fb6e10a53e1e",
          "convention": "utf8_char_offset",
          "end": 4054,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:17",
          "start": 3645
        },
        "quote": "“Visual runway” means a runway intended solely for the operation of aircraft using visual approach procedures with no straight-in instrument approach procedure and no instrument designation indicated on an FAA-approved airport layout plan, a military service’s approved military airport layout plan, or by a planning document submitted to the FAA by competent authority. (Code 1981 § 4-56. Code 1995 § 22-27.)",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:17#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.205.020 block 18",
        "locator": {
          "block_index": 18,
          "component_id": "55c2a5d7-5a87-53d1-b9c6-704c4cf12647",
          "convention": "utf8_char_offset",
          "end": 4110,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.205.020:block:18",
          "start": 4055
        },
        "quote": "Cross References: Definitions generally, TMC 1.10.020 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.205.020:block:18#text",
        "unavailable_reason": null
      },
