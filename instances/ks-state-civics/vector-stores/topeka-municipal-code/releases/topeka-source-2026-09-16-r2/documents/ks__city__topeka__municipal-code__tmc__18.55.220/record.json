        },
        "quote": "“Variance” means a device which grants a property owner relief from certain provisions of a zoning ordinance when, because of the particular physical surroundings, shape, or topographical condition of the property, compliance would result in a particular hardship upon the owner.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.220:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.220 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "aafd7459-7ef0-564b-975c-048236f2d790",
          "convention": "utf8_char_offset",
          "end": 443,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.220:block:1",
          "start": 280
        },
        "quote": "“Vehicle, motor” means a self-propelled device used for transportation of people or goods over land, but not on rails, and licensed through a State agency as such.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.220:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.220 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "f9c04e19-50c3-5c1e-b009-21fe2d827c21",
          "convention": "utf8_char_offset",
          "end": 739,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.220:block:2",
          "start": 444
        },
        "quote": "“Vehicle, motor bicycle” means a device a person may ride upon which may be propelled by either human power or helper motor or by both and has two tandem or three wheels with a cylinder capacity of not more than 130 cubic centimeters and a maximum design speed of no more than 30 miles per hour.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.220:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.220 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "adba55c7-d9fa-5e58-a729-668c925ea027",
          "convention": "utf8_char_offset",
          "end": 1105,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.220:block:3",
          "start": 740
        },
        "quote": "“Vehicle, motor scooter” means a self-propelled device a person may ride upon having two tandem or three wheels each not greater than 12 inches in diameter and in contact with the ground, a saddle seat, handle bars, and an electric or gas motor no more than 200 cubic centimeters. A motor scooter may or may not require a State of Kansas class M motorcycle license.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.220:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.220 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "63fdce5d-dc61-5b60-a830-4610da8812d2",
          "convention": "utf8_char_offset",
          "end": 1455,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.220:block:4",
          "start": 1106
        },
        "quote": "“Vehicle, recreational” means a vehicular-type portable structure without a permanent foundation, which can be towed, hauled or driven and primarily designed as temporary living accommodation for recreational, camping and/or travel use and including but not limited to travel trailers, truck campers, camping trailers and self-propelled motor homes.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.220:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.220 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "1f432742-a6ff-5f5f-95d6-e18740bc9728",
          "convention": "utf8_char_offset",
          "end": 1695,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.220:block:5",
          "start": 1456
        },
        "quote": "“Vehicular (motor) sales area” means an open area, other than a right-of-way or public parking area, used for display, sale or rental of new or used vehicles in operable condition and where incidental minor vehicle repair work may be done.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.220:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.220 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "f1321a51-4b1b-5d83-b29a-3517ad436290",
          "convention": "utf8_char_offset",
          "end": 1941,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.220:block:6",
          "start": 1696
        },
        "quote": "Vested Right. A right is vested when it has become absolute and fixed and cannot be defeated or denied by subsequent conditions or change in regulations, unless it is taken and paid for. (Ord. 19370 § 103, 3-23-10. Code 1995 Appx. C, Art. XXXV.)",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.220:block:6#text",
        "unavailable_reason": null
      },
