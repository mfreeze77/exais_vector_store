        },
        "quote": "(c) The minimum area of lots shall be subject to the district zoning regulations in which the subdivision is located.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.40.110:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
