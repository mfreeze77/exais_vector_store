        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.40.110 block 8",
        "locator": {
          "block_index": 8,
          "component_id": "fe2e4dbd-5703-556c-99a7-c0614b77ddad",
