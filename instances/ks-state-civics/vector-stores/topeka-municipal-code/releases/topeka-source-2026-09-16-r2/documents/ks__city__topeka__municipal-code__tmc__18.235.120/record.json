        },
        "quote": "(d) Grass shall be planted in such a manner as to completely cover all exposed soil after one full growing season.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.120:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
