          "source_component_key": "ks:city:topeka:municipal-code:tmc:17.05.170:block:3",
          "start": 805
        },
        "quote": "(d) Compaction. All fills shall be compacted to a minimum of 90 percent of maximum density tested by the standard Proctor method unless specifically exempted from this requirement by the Department of Public Works.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.05.170:block:3#text",
        "unavailable_reason": null
      },
      {
