{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.70.040","page_type":"section"},"citation":"10.70.040","citation_url":"https://topeka.municipal.codes/TMC/10.70.040","content_hash":"e02c9325130c06b2152adacf19ed7d24609d594d641bda91da71b530d6ea202d","heading":"Angle parking prohibited.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.70.040:section","source_url":"https://topeka.municipal.codes/TMC/10.70.040","text":"(a) No person shall stop, stand or park a truck or truck tractor, the overall length of which is more than 18 feet, on streets legally marked for angle parking.\n(b) No person shall stop, stand or park a passenger type motor vehicle with trailer attached on streets legally marked for angle parking.\n(c) The provisions of this section shall be construed independent of all of the provisions of the traffic ordinances of the City. (Code 1981 § 43-536. Code 1995 § 142-584.)","type":"section","workbench_component_id":"f940d754-ac2f-5207-921d-3cf507580f82"},{"attributes":{"block_kind":"paragraph"},"citation":"10.70.040","citation_url":"https://topeka.municipal.codes/TMC/10.70.040","content_hash":"69e53d9f8122eb8d8c84398b821833944bb1a444d87062794004485a73717644","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.70.040:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.70.040:block:0","source_url":"https://topeka.municipal.codes/TMC/10.70.040","text":"(a) No person shall stop, stand or park a truck or truck tractor, the overall length of which is more than 18 feet, on streets legally marked for angle parking.","type":"paragraph","workbench_component_id":"a4e5f173-b37f-5f68-aa69-baad774f479b"},{"attributes":{"block_kind":"paragraph"},"citation":"10.70.040","citation_url":"https://topeka.municipal.codes/TMC/10.70.040","content_hash":"344c37b4ad9c1492d90ffbfef3a47ac92845a82f399911cd044f9d791dbf2d78","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.70.040:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.70.040:block:1","source_url":"https://topeka.municipal.codes/TMC/10.70.040","text":"(b) No person shall stop, stand or park a passenger type motor vehicle with trailer attached on streets legally marked for angle parking.","type":"paragraph","workbench_component_id":"e92b0c87-247d-58dd-a682-715dd621cc00"},{"attributes":{"block_kind":"paragraph"},"citation":"10.70.040","citation_url":"https://topeka.municipal.codes/TMC/10.70.040","content_hash":"de969bb5061126e6e62ed82a63c79e2fd1e9b88fc971517adcab77b4f7929102","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.70.040:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.70.040:block:2","source_url":"https://topeka.municipal.codes/TMC/10.70.040","text":"(c) The provisions of this section shall be construed independent of all of the provisions of the traffic ordinances of the City. (Code 1981 § 43-536. Code 1995 § 142-584.)","type":"paragraph","workbench_component_id":"34f672ce-8e5c-5e7e-9629-213f08806a96"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:10.70.040:section","schema":"exais.jurisdiction.structured_content.v1"}