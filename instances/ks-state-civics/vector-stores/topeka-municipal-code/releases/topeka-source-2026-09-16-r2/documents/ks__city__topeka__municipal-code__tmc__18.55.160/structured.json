k_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"a8b23d0e3b809e3e9b8d1b5301b1bcde914a58868904aa78a722945fbd352081","heading":null,"ordinal":16,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:16","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Porch, open” means a roof partially supported by columns or wall sections.","type":"paragraph","workbench_component_id":"475fffc4-a58e-5e05-bede-ced2c0909b42"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"131eda0f0065bb0e907d1fb6e202a23eaa37ddc1926f86cdaf7d6c995c0699ef","heading":null,"ordinal":17,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:17","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Preapplication conference” means discussions held between developers and public officials, usually members of the planning staff, before formal submission of an application for a permit or for subdivision plat approval.","type":"paragraph","workbench_component_id":"2a8ea448-94ef-5a03-80fe-99d5c6de1a94"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"d52ace85850b9dd89fea6030f25725a5ae5c34ebee9ed4dd7e3b7b74371f5273","heading":null,"ordinal":18,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:18","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Premises” means any lot or tract, or combination of contiguous lots or tracts of land held in single ownership, together with the improvements thereon; a condominium complex constitutes one premises.","type":"paragraph","workbench_component_id":"f73c6ffa-da44-5ade-96c2-cc05930bd98a"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"847c0e72a622c45e861c15007a8a8dfa2ec0935ac9fab767692b33dc26d4e3ee","heading":null,"ordinal":19,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:19","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Principal use” means the main use of land or structures as distinguished from a secondary or accessory use.","type":"paragraph","workbench_component_id":"c9d059e9-6a22-5078-83e9-2671de814ba3"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"99af00df89c87c34ef00e8991f2a51a4937ecf3d3d6786cb03bbdad4fe4ff6b2","heading":null,"ordinal":20,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:20","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Professional office” means the office of a person engaged in any occupation, vocation, or calling, not purely commercial, mechanical, or agricultural, in which a professed knowledge or skill in some department of science or learning is used by its practical application to the affairs of others, either advising or guiding them in serving their interest or welfare through the practice of an act found thereon.","type":"paragraph","workbench_component_id":"60346bd3-7ae3-509b-bff8-3b642a126cd6"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"154ff43dec3d68593a13fd0dab472946f0aef3db474dcde08c40bab9b36a90e6","heading":null,"ordinal":21,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:21","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Provisional use” means a principal use which is allowed in the zone in which listed, provided it complies with the additional regulations listed for the use and all other dimensional and special (if any) requirements of the zone in which listed.","type":"paragraph","workbench_component_id":"7bb1e145-59ad-532a-b0d3-156eab353642"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"413ae9d71ffbc1e10ee8d78d5a4e0b9e089ce17b5da69a6388d8c04b6846941f","heading":null,"ordinal":22,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:22","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Public or private educational facility” means a public elementary, secondary, or high school and private schools with curricula equivalent to that of a public elementary, secondary or high school.","type":"paragraph","workbench_component_id":"f8ab3488-499c-5cf8-ac0e-5760199da007"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"f8ca2278de779bba0de629751e61b6c9c47e844a8331d66ad595ea1018b89829","heading":null,"ordinal":23,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:23","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Public use facility” means any building, structure, utility, or land held, used, or controlled exclusively for public purposes by any department or branch of government: Federal, State, County, or municipal or subdivision thereof.","type":"paragraph","workbench_component_id":"6a73ebb3-837d-52d3-8868-4bfc757267a1"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"b08975e51727f35716b76fa0f79fbf2c35c5ee26bc01490ebb94b580cae25e77","heading":null,"ordinal":24,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:24","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Public utility” means any business or enterprise which furnishes the general public telephone, cable, electric, internet, natural gas, water, or sewer service, and is subject to supervision or regulation by an agency of the State or Federal government.","type":"paragraph","workbench_component_id":"00942ced-3735-5d27-8125-8bbff7be5e07"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"91a780128d713de57e254325c923fb508aad612247db0dff36f956ad0b732748","heading":null,"ordinal":25,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:25","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Public utility facilities, type I” means water lines, sewer lines, poles, wires, cables, conduits, vaults, laterals, pipes, mains, valves, hydrants, and small unenclosed booster or pump stations, and other similar facilities located on public rights-of-way, public property, or public easements and operated by a public utility.","type":"paragraph","workbench_component_id":"d956fb64-00ad-51dc-b277-155fa8c5b68b"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"9ee299cbd2595f8fa7e94000f7311eb023f7b8af155be24813c0825210a2a227","heading":null,"ordinal":26,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:26","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Public utility facilities, type II” means substations, medium and large booster or pump stations, distribution stations, treatment plants, transmission equipment buildings, towers or reservoirs, and similar uses facilitating utility transmission, distribution, and collection systems located on public rights-of-way, public property, or public easements and operated by a public utility.","type":"paragraph","workbench_component_id":"cd020e4f-4a29-5c5f-881b-5640cd255a47"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"dbb406df310d157bcd0f1f833b53c5d241866545cdcb8f1f48fd05b3ffb8fcd6","heading":null,"ordinal":27,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:block:27","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":"“Public way” means any sidewalk, street, alley, highway or other thoroughfare dedicated for public use. (Ord. 20062 § 13, 4-18-17.)","type":"paragraph","workbench_component_id":"1ee5f9fb-17e5-5bb9-b39d-9aecf2941a02"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.160:def:parcel"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"0926926ac726a5e953110c57e2cd965e19585ebd537ac2f80f2da1c2d5eded34","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:definition:0","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":null,"type":"definition","workbench_component_id":"6870ad39-0cfa-55bf-b2c6-7e5908dae952"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.160:def:park"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"0f64eabb14ec0dec9e3ac41b259d44a0c9aa57620c8eacdcacaad0af689e70aa","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:definition:1","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":null,"type":"definition","workbench_component_id":"b72882c9-a4a6-5d8f-9710-6583dbed277e"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.160:def:parking-aisle"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"1b44ed7fe02c672a7005ae7860753e2ecc02eaadfa8d7a6790ba71580847376c","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.160:definition:2","source_url":"https://topeka.municipal.codes/TMC/18.55.160","text":null,"type":"definition","workbench_component_id":"7a380704-576d-54d8-9952-d6dc8aeccc83"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.160:def:parking-lot"},"citation":"18.55.160","citation_url":"https://topeka.municipal.codes/TMC/18.55.160","content_hash":"366a22ccec20ae961af1dd2f9b213763ee9e3f69a