          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.70.150:block:5",
          "start": 909
        },
        "quote": "(5) Submit the name of the moving company if applicable.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.70.150:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 14.70.150 block 6",
        "locator": {
          "block_index": 6,
