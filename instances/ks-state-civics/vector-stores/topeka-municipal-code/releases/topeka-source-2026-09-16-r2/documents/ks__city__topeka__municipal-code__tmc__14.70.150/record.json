          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.70.150:block:6",
          "start": 966
        },
        "quote": "(6) Submit a fee for the moving permit in the amount as prescribed by the City’s fee schedule.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.70.150:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 14.70.150 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "16b823d0-3a3d-5dd4-bca7-9d8bae583ef0",
          "convention": "utf8_char_offset",
