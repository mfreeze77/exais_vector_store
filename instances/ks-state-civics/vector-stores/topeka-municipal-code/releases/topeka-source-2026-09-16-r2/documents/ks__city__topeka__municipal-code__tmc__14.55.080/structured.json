{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.55.080","page_type":"section"},"citation":"14.55.080","citation_url":"https://topeka.municipal.codes/TMC/14.55.080","content_hash":"7a914c181c409034d5bfc3bdc137b48fecd415ecf1f906c7d73b60b0c831bd99","heading":"Lot lines and setback lines.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.080:section","source_url":"https://topeka.municipal.codes/TMC/14.55.080","text":"Section R104.12, Lot lines and setback lines, is hereby created by the addition of the following provisions:\nNotwithstanding the authority of the building official to administer and enforce the building code, the building official shall have no duty to verify or establish lot lines or setback lines. No such duty is created by this code and none shall be implied.\n(Ord. 19727 § 5, 4-24-12.)","type":"section","workbench_component_id":"373b627f-9e79-5fd7-8426-4667924d72f3"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.080","citation_url":"https://topeka.municipal.codes/TMC/14.55.080","content_hash":"614c9dbc337bec2856d77c6cad59d1baae46417bd2ea31d3dc9a999f8acb33d0","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.080:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.080:block:0","source_url":"https://topeka.municipal.codes/TMC/14.55.080","text":"Section R104.12, Lot lines and setback lines, is hereby created by the addition of the following provisions:","type":"paragraph","workbench_component_id":"e19d3735-b946-596d-bf93-79fc9c5f9acc"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.080","citation_url":"https://topeka.municipal.codes/TMC/14.55.080","content_hash":"ceb322916f50fdb55466