        "locator": {
          "block_index": 1,
          "component_id": "c5427127-fc73-5f68-9999-40d458f49597",
          "convention": "utf8_char_offset",
          "end": 1102,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:13.20.260:block:1",
          "start": 807
        },
        "quote": "(b) If the approval is granted for the discharge of such waters referred to in subsection (a) of this section into the sanitary sewers, the user shall measure such discharges and pay the applicable wastewater service charges and meet such other conditions that may be required by the Department.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.260:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
