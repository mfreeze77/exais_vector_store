{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.15.020","page_type":"section"},"citation":"5.15.020","citation_url":"https://topeka.municipal.codes/TMC/5.15.020","content_hash":"d68121a19ca48868847d8090ee2fd67c2548f43ce63c2766c703234c486f0810","heading":"License required.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.15.020:section","source_url":"https://topeka.municipal.codes/TMC/5.15.020","text":"(a) It is unlawful for any person to engage in the operation of an alarm business within the City without having first obtained a license to operate such a business from the Chief of Police.\n(b) It is unlawful for any person to engage in altering, installing, maintaining, repairing, replacing, moving, or servicing an alarm system within the City limits, or causing the same to take place without having been certified for the particular classification of system involved. (Ord. 20292 § 1, 4-20-21.)\nCross References: Police Department, TMC 2.20.090 .","type":"section","workbench_component_id":"2308a3b3-095c-58c1-8560-68d814739303"},{"attributes":{"block_kind":"paragraph"},"citation":"5.15.020","citation_url":"https://topeka.municipal.codes/TMC/5.15.020","content_hash":"55774b5267c1fb2f85355b5052763bb2edc3a2f896aaf18a5ce6aaa7d29b00b1","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.15.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.15.020:block:0","source_url":"https://topeka.municipal.codes/TMC/5.15.020","text":"(a) It is unlawful for any person to engage in the operation of an alarm business within the City without having first obtained a license to operate such a business from the Chief of Police.","type":"paragraph","work