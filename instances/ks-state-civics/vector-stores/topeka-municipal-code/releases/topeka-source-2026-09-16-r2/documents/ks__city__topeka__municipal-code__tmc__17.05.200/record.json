        },
        "quote": "(a) General. Unless otherwise indicated on the approved grading plan, drainage facilities and terracing shall conform to the provisions of this section for cut or fill slopes steeper than three horizontal to one vertical.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.05.200:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
