{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.65.290","page_type":"section"},"citation":"14.65.290","citation_url":"https://topeka.municipal.codes/TMC/14.65.290","content_hash":"e1e2349f809bd79f2dbcc562b2f63b81798e620a7294a4c8900133851e9e9347","heading":"Refuse accumulation, storage and disposal.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.290:section","source_url":"https://topeka.municipal.codes/TMC/14.65.290","text":"(a) In all mobile home parks, refuse shall be accumulated, stored and disposed of in accordance with applicable State, County or City laws.\n(b) At least one refuse disposition area providing adequate refuse receptacles shall be provided at a location in the mobile home park approved by the Environmental Code Services Director and the Fire Chief. (Ord. 17074 § 1, 1-28-97. Code 1981 § 25-106. Code 1995 § 98-155.)\nCross References: Fire Department, TMC 2.20.030 .","type":"section","workbench_component_id":"7e7d5680-fea5-5605-8dd5-0beec47dd437"},{"attributes":{"block_kind":"paragraph"},"citation":"14.65.290","citation_url":"https://topeka.municipal.codes/TMC/14.65.290","content_hash":"94eb47efe3bf6012d4dd079a6edf4b76fe9a3c72cf57b93d1fb7dc0a1f569c70","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.290:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.290:block:0","source_url":"https://topeka.municipal.codes/TMC/14.65.290","text":"(a) In all mobile home parks, refuse shall be accumulated, stored and disposed of in accordance with applicable State, County or City laws.","type":"paragraph","workbench_component_id":"493c9d29-6409-56ff-8e1f-09191135bfed"},{"attributes":{"block_kind":"paragraph"},"ci