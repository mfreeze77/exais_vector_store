          "start": 964
        },
        "quote": "(1) Eligible employees hired prior to January 1, 2011, shall be eligible to receive severance pay according to the following schedule; provided, however, that in no event shall severance pay exceed one year of salary:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.110.070:block:8#text",
        "unavailable_reason": null
      },
      {
