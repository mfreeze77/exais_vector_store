ka.municipal.codes/TMC/2.110.070","content_hash":"11972868276855c2a3d3ceb0c74e3e85eadc37b3c079937273a47f3147007d02","heading":null,"ordinal":15,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:2.110.070:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.110.070:block:15","source_url":"https://topeka.municipal.codes/TMC/2.110.070","text":"One week’s salary for each complete year of service, as of the date of separation","type":"paragraph","workbench_component_id":"ee21f285-9c3f-58a5-bd45-e0e4160f798e"},{"attributes":{"block_kind":"paragraph"},"citation":"2.110.070","citation_url":"https://topeka.municipal.codes/TMC/2.110.070","content_hash":"2a5a254477429554352fc53985d15e51e4aa3a3225a5e246bb7a1d072e88390b","heading":null,"ordinal":16,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:2.110.070:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.110.070:block:16","source_url":"https://topeka.municipal.codes/TMC/2.110.070","text":"Over Ten Years","type":"paragraph","workbench_component_id":"d46b271a-e5c4-557d-ac51-9427c9680902"},{"attributes":{"block_kind":"paragraph"},"citation":"2.110.070","citation_url":"https://topeka.municipal.codes/TMC/2.110.070","content_hash":"c8a92052a5e5371021e8dce7c678c70b909e1b4c4a37cf3ef776e502b7d1162e","heading":null,"ordinal":17,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:2.110.070:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.110.070:block:17","source_url":"https://topeka.municipal.codes/TMC/2.110.070","text":"Two weeks’ salary for each complete year of service, as of the date of separation","type":"paragraph","workbench_component_id":"992617a4-055c-573a-a18c-8056087b1c71"},{"attributes":{"block_kind":"paragraph"},"citation":"2.110.070","citation_url":"https://topeka.municipal.codes/TMC/2.110.070","content_hash"