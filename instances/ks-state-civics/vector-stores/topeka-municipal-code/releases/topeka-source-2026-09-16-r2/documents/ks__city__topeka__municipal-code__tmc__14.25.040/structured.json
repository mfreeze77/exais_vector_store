{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.25.040","page_type":"section"},"citation":"14.25.040","citation_url":"https://topeka.municipal.codes/TMC/14.25.040","content_hash":"e931ab8c44c0002c26d1ba73652edb2bf9395d35800dc6ecc14811d05db35488","heading":"Section 103, Code Compliance Agency.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.040:section","source_url":"https://topeka.municipal.codes/TMC/14.25.040","text":"Section 103, Code Compliance Agency, is hereby deleted in its entirety and the following provision shall be substituted therefor:\nThe development services division shall be responsible for the implementation, administration and enforcement of the provisions of this code. Any reference to “Department of Building Safety” will mean the development services division. Whenever the term “code official” is used in the IEBC, it shall be construed to mean to development services division director or designee.\n(Ord. 20344 § 4, 2-15-22.)","type":"section","workbench_component_id":"68cac194-e950-5535-917f-4463b9aeb1a1"},{"attributes":{"block_kind":"paragraph"},"citation":"14.25.040","citation_url":"https://topeka.municipal.codes/TMC/14.25.040","content_hash":"39dbc3c323858a31b1b8e98b2361d4dd7043db46188c4f540caa3428d70a13ed","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.040:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.040:block:0","source_url":"https://topeka.municipal.codes/TMC/14.25.040","text":"Section 103, Code Compliance Agency, is hereby deleted in its entirety and the following provision shall be substituted therefor:","type":"paragraph","workbench_component_id":"d3474dce-278a-5cec-9f80-4daa058