        },
        "quote": "712.2, Water Test, is hereby deleted in its entirety and the following provisions shall be substituted therefor:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.35.290:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
