{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.75.100","page_type":"section"},"citation":"10.75.100","citation_url":"https://topeka.municipal.codes/TMC/10.75.100","content_hash":"c7022bc9eeff79e6272b76051f9809a0d09427875966a91dfe40a06c3e647b1d","heading":"Weight limit – Wheel and tire.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.100:section","source_url":"https://topeka.municipal.codes/TMC/10.75.100","text":"(a) The gross weight upon any wheel of a vehicle shall not exceed 10,000 pounds.\n(b) The gross weight on any tire on any wheel shall not exceed the Federal Department of Transportation or manufacturer’s weight limitation rating stamped on the sidewall of the tire. (Code 1981 § 43-677. Code 1995 § 142-745.)","type":"section","workbench_component_id":"695f1c77-948c-57e9-9579-b780090a12d8"},{"attributes":{"block_kind":"paragraph"},"citation":"10.75.100","citation_url":"https://topeka.municipal.codes/TMC/10.75.100","content_hash":"0cf1c4050e3371f024492215c9b8e91e07f9c87c995ddfcfd0386312158b9639","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.75.100:block:0","source_url":"https://topeka.municipal.codes/TMC/10.75.100","text":"(a) The gross weight upon any wheel of a vehicle shall not exceed 10,000 pounds.","type":"paragraph","workbench_component_id":"03a8b21b-5eae-5b11-8960-bef2d37a5f05"},{"attributes":{"block_kind":"paragraph"},"citation":"10.75.100","citation_url":"https://topeka.municipal.codes/TMC/10.75.100","content_hash":"6c081b81c580c26c22b9a92ea46fb83a420107fbb9ac10b3716d514c118f6f70","heading":null,"ordinal":1,"parent_source_component_key":"ks:city