          "convention": "utf8_char_offset",
          "end": 399,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:3.30.010:block:2",
          "start": 294
        },
        "quote": "(2) Governing Body approval of the contract or the subject matter is required by State or Federal law; or",
        "ref_id": "ks:city:topeka:municipal-code:tmc:3.30.010:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
