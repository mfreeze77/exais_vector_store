{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:A2-26","page_type":"section"},"citation":"A2-26","citation_url":"https://topeka.municipal.codes/TMC/A2-26","content_hash":"7cbf711828d186fbab9e848792889b884c4d828e458f78d4934022cde6300d70","heading":"Sec. A2-26. Meetings – Deputy Mayor.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:a2-26:section","source_url":"https://topeka.municipal.codes/TMC/A2-26","text":"(a) The governing body shall establish, by ordinance, a meeting schedule for each calendar year, with a minimum of two meetings each month.\n(b) The governing body shall elect a Councilmember to serve as deputy mayor in the absence or temporary disability of the mayor.\n(c) A deputy mayor shall be elected at the first governing body meeting in January to serve for a one year term. (C.O. 122 § 1, 2-8-22.)","type":"section","workbench_component_id":"4eaa42e1-e4d9-5957-9cf3-48f65be04a39"},{"attributes":{"block_kind":"paragraph"},"citation":"A2-26","citation_url":"https://topeka.municipal.codes/TMC/A2-26","content_hash":"75d707fd1ccc480f37b25caf5e02c83e6ef04142b5f59dbbd6337f923f1ae9d7","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:a2-26:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:a2-26:block:0","source_url":"https://topeka.municipal.codes/TMC/A2-26","text":"(a) The governing body shall establish, by ordinance, a meeting schedule for each calendar year, with a minimum of two meetings each month.","type":"paragraph","workbench_component_id":"e768d752-bbca-535b-bcc6-47c5d7000f4f"},{"attributes":{"block_kind":"paragraph"},"citation":"A2-26","citation_url":"https://topeka.municipal.codes/TMC/A2-26","content_hash":"7604dfd09963e2a