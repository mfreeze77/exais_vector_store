          "start": 147
        },
        "quote": "R304.1 Minimum area. Every dwelling unit shall have at least one habitable room that shall have not less than 150 square feet of floor area, excluding a bedroom.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.55.350:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 14.55.350 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "5b07a4ab-e411-595d-8703-b6d4c0f5e0f3",
          "convention": "utf8_char_offset",
          "end": 699,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.55.350:block:3",
          "start": 309
        },
        "quote": "R304.2 Other rooms. Other habitable rooms shall have a floor area of not less than 70 square feet, except bedrooms must have a minimum area of 90 square feet. Multi-bedroom dwelling units shall contain at least one (1) bedroom with 120 square feet of floor area. Every kitchen shall have not less than 50 square feet of floor area. Measurement shall be made from inside wall to inside wall.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.55.350:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 14.55.350 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "3e4488ed-a509-5a2c-8ae9-1b11e48c278e",
          "convention": "utf8_char_offset",
          "end": 811,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.55.350:block:4",
          "start": 700
        },
        "quote": "R304.3 Minimum dimensions. Habitable rooms shall not be less than 7 feet (2134 mm) in any horizontal dimension.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.55.350:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 14.55.350 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "9001f125-a7f7-5658-a4b1-150dfc879135",
