TMC/18.30.010","text":"“Lot line adjustment” means a relocation of existing lot lines.","type":"paragraph","workbench_component_id":"5dedcc84-fe32-50a0-b11e-835e786a2c99"},{"attributes":{"block_kind":"paragraph"},"citation":"18.30.010","citation_url":"https://topeka.municipal.codes/TMC/18.30.010","content_hash":"3be0d47f78d6c628ed5fff9ae87095d77d01c2958a66b4a200cac02cb5f22613","heading":null,"ordinal":14,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.30.010:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.30.010:block:14","source_url":"https://topeka.municipal.codes/TMC/18.30.010","text":"“Lot split” means a lot that is divided into two lots.","type":"paragraph","workbench_component_id":"61e3a156-a246-5dfa-ab2e-07766d3d578b"},{"attributes":{"block_kind":"paragraph"},"citation":"18.30.010","citation_url":"https://topeka.municipal.codes/TMC/18.30.010","content_hash":"a06dedd77a1ee809bc3102d1017e406403872e9da0aff67a6cbd390d5004e9d8","heading":null,"ordinal":15,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.30.010:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.30.010:block:15","source_url":"https://topeka.municipal.codes/TMC/18.30.010","text":"“Major plat approval” means a plan or map prepared in accordance with the provisions of this division and those of any other City ordinance which requires the approval of the Planning Commission and the City Council.","type":"paragraph","workbench_component_id":"455245d1-c3d6-56a4-93cc-844c3c9e4f61"},{"attributes":{"block_kind":"paragraph"},"citation":"18.30.010","citation_url":"https://topeka.municipal.codes/TMC/18.30.010","content_hash":"af3fd5043dd02bb55363b0680c8593c0a81368a81c8f095dae8d117c469453b7","heading":null,"ordinal":16,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.30.010:section","schema":"exais.workbench_component.v1","source_compon