        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.060:block:16#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.10.060 block 17",
        "locator": {
          "block_index": 17,
          "component_id": "b13a3f20-ccd8-527a-a527-d74784267b10",
