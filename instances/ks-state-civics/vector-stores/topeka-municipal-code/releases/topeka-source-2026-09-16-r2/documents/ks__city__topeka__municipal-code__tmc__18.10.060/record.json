          "end": 1377,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.060:block:7",
          "start": 1153
        },
        "quote": "(1) Except where expressly permitted, signs posted or otherwise affixed to or on any of the following, or as described below, are unlawful and in violation of this chapter and are subject to immediate removal without notice:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.060:block:7#text",
        "unavailable_reason": null
      },
      {
