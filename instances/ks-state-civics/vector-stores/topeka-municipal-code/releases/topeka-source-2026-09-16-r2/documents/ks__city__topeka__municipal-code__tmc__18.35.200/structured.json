nd":"paragraph"},"citation":"18.35.200","citation_url":"https://topeka.municipal.codes/TMC/18.35.200","content_hash":"5e1996fe86db1c812ee1ae54894adab07642315751ea7049a0918b1e0381330f","heading":null,"ordinal":15,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.35.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.35.200:block:15","source_url":"https://topeka.municipal.codes/TMC/18.35.200","text":"(o) Any stream buffer easements as required by this title.","type":"paragraph","workbench_component_id":"6a9bdab7-df3a-502f-93f2-0d2c447efadd"},{"attributes":{"block_kind":"paragraph"},"citation":"18.35.200","citation_url":"https://topeka.municipal.codes/TMC/18.35.200","content_hash":"848405082f8ed5e968e21d43e761d1fcd314d4a8dce0b14342808da07f94cc6c","heading":null,"ordinal":16,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.35.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.35.200:block:16","source_url":"https://topeka.municipal.codes/TMC/18.35.200","text":"(p) A drainage report, including a stormwater management plan if required by Chapter 13.35 TMC. (Ord. 19626 § 2, 8-23-11.)","type":"paragraph","workbench_component_id":"b3a0a347-2861-56af-9acf-664c95f95f04"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:18.35.200:section","schema":"exais.jurisdiction.structured_content.v1"}