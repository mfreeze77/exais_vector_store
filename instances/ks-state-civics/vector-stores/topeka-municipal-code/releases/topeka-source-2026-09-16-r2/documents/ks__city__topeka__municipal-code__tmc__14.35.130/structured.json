{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.35.130","page_type":"section"},"citation":"14.35.130","citation_url":"https://topeka.municipal.codes/TMC/14.35.130","content_hash":"b631c96cd887ce48b44785657b381bd20d1373c30301590cb5c8c5843239028b","heading":"414.3, Drainage Connections.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.130:section","source_url":"https://topeka.municipal.codes/TMC/14.35.130","text":"414.3, Drainage Connections, is hereby amended by the addition of the following exceptions:\nExceptions:\n1. Domestic dishwashers may be installed without an airgap fitting on the discharge side of the dishwashing machine provided the waste hose is securely fastened to the bottom side of the countertop.\n2. Commercial dishwashing machines may discharge indirectly through an air gap or direction connection in accordance with Section 704.3 with floor drain protection.\n(Ord. 20570 § 13, 7-1-25; Ord. 20257 § 21, 8-18-20. Formerly 14.35.160.)","type":"section","workbench_component_id":"9b54e039-c6c5-5bc2-a210-c0ed9759d0f6"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.130","citation_url":"https://topeka.municipal.codes/TMC/14.35.130","content_hash":"d13ef7c6480447a5c3980b53458c808b1a9f51ba734d38971cfb26a06abaddc2","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.130:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.130:block:0","source_url":"https://topeka.municipal.codes/TMC/14.35.130","text":"414.3, Drainage Connections, is hereby amended by the addition of the following exceptions:","type":"paragraph","workbench_component_id":"21694a8d-d9d0-5633-a58f-66e7360950ee"},{"attributes":{"block_kind":