{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.55.310","page_type":"section"},"citation":"14.55.310","citation_url":"https://topeka.municipal.codes/TMC/14.55.310","content_hash":"507b136baae364fb6d156efb4b30786bffba430eef79d2a0a4fbcee8adaf47b3","heading":"Exterior stairway illumination.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.310:section","source_url":"https://topeka.municipal.codes/TMC/14.55.310","text":"Section R303.8, Exterior stairway illumination, is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nExterior stairways providing access to a basement from the outside grade level shall be provided with an artificial light source located in the immediate vicinity of the bottom landing of the stairway. Artificial light source location requirements for stairways shall comply with currently adopted edition to the National Electrical Code.\n(Ord. 20467 § 15, 12-5-23.)","type":"section","workbench_component_id":"598ac20d-8ed4-5cd3-817c-1111c414ac13"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.310","citation_url":"https://topeka.municipal.codes/TMC/14.55.310","content_hash":"ec518af9ef5395142aebe74bdcbc4ac46545d87888ae75ee6f9f57616af69623","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.310:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.310:block:0","source_url":"https://topeka.municipal.codes/TMC/14.55.310","text":"Section R303.8, Exterior stairway illumination, is hereby deleted in its entirety and the following provisions shall be substituted therefor:","type":"paragraph","workbench_component_id":"b66d436a-e4a3-5c8e-9ef4-bbba53a9adf5"},{"attribu