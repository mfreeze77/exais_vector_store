          "start": 433
        },
        "quote": "(c) All procurements estimated to be $10,000 or less shall be made in accordance with rules and regulations promulgated pursuant to TMC 3.30.050 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:3.30.020:block:2#text",
        "unavailable_reason": null
      },
