          "start": 760
        },
        "quote": "(iii) Architectural style;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.255.060:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
