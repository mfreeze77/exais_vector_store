        "locator": {
          "block_index": 3,
          "component_id": "74f89af9-87da-5228-9da8-ab1ffd033c24",
          "convention": "utf8_char_offset",
          "end": 759,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.255.060:block:3",
          "start": 719
        },
        "quote": "(ii) Builder and/or architect, if known;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.255.060:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
