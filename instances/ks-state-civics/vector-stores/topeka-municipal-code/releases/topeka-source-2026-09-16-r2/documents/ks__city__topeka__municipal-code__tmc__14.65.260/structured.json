{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.65.260","page_type":"section"},"citation":"14.65.260","citation_url":"https://topeka.municipal.codes/TMC/14.65.260","content_hash":"c9173245db27b26033746dd769352e1816f11e9c6ee126f6ca4a319c20a8ac41","heading":"Drainage.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.260:section","source_url":"https://topeka.municipal.codes/TMC/14.65.260","text":"No mobile home park shall be so located that the drainage of the park area will endanger any water supply. All parks shall be well drained and located in areas free from ponds, swamps and similar places in which mosquitoes may breed. (Code 1981 § 25-103. Code 1995 § 98-152.)","type":"section","workbench_component_id":"30c677b5-fc22-5481-b152-7a9b69ff3eaa"},{"attributes":{"block_kind":"paragraph"},"citation":"14.65.260","citation_url":"https://topeka.municipal.codes/TMC/14.65.260","content_hash":"c9173245db27b26033746dd769352e1816f11e9c6ee126f6ca4a319c20a8ac41","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.260:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.260:block:0","source_url":"https://topeka.municipal.codes/TMC/14.65.260","text":"No mobile home park shall be so located that the drainage of the park area will endanger any water supply. All parks shall be well drained and located in areas free from ponds, swamps and similar places in which mosquitoes may breed. (Code 1981 § 25-103. Code 1995 § 98-152.)","type":"paragraph","workbench_component_id":"45406173-b436-5041-80ae-696a958d7858"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.260:section","schema":"exais.jurisdiction.structured_content.v