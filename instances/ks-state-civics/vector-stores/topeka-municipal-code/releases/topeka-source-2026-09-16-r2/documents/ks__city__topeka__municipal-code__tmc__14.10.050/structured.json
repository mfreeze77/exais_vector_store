{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.10.050","page_type":"section"},"citation":"14.10.050","citation_url":"https://topeka.municipal.codes/TMC/14.10.050","content_hash":"525e0d043c21934bfcde8d8dc09ea7c0d058afc12f8a4f3bc8a0bc4775c0a48d","heading":"Sewage disposal prerequisite to building permit.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.10.050:section","source_url":"https://topeka.municipal.codes/TMC/14.10.050","text":"No building permit shall be issued until the City Engineer certifies that facilities are available for the disposal of sanitary sewage or, in the case of an uncompleted developer project, approved plans and specifications or other satisfactory assurance shall be given guaranteeing completion of necessary public improvements. (Code 1981 § 10-45. Code 1995 § 26-55.)\nCross References: City Engineer, TMC 2.20.100 .","type":"section","workbench_component_id":"7865b173-bfc9-5cd3-b1ea-38ecec141a0e"},{"attributes":{"block_kind":"paragraph"},"citation":"14.10.050","citation_url":"https://topeka.municipal.codes/TMC/14.10.050","content_hash":"550c2febe81bd5fde462629aad90e9a43e65593987a9ad7543c668f41d68a13d","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.10.050:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.10.050:block:0","source_url":"https://topeka.municipal.codes/TMC/14.10.050","text":"No building permit shall be issued until the City Engineer certifies that facilities are available for the disposal of sanitary sewage or, in the case of an uncompleted developer project, approved plans and specifications or other satisfactory assurance shall be given guaranteeing completion of necessary public i