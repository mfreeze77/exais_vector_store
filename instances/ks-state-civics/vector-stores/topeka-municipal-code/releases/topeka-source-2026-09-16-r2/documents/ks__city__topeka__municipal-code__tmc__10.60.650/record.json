          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.60.650:block:11",
          "start": 2778
        },
        "quote": "(4) The Hearing Officer shall cause a record to be made of the hearing.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.60.650:block:11#text",
