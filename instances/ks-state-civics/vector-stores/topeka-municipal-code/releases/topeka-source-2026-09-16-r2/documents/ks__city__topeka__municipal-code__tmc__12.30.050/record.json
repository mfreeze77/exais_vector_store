          "convention": "utf8_char_offset",
          "end": 588,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.30.050:block:1",
          "start": 365
        },
        "quote": "(b) Registration Prior to Work. No corporation/utility may construct, install, repair, remove, relocate, or perform any work on, or use any equipment within any right-of-way without first being registered with the Director.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.30.050:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
