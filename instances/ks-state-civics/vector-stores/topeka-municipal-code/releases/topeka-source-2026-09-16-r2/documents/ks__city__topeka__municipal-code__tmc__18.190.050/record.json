          "start": 1089
        },
        "quote": "(2) Legal description of each proposed use group category with corresponding acreage.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.190.050:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
