{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.65.420","page_type":"section"},"citation":"14.65.420","citation_url":"https://topeka.municipal.codes/TMC/14.65.420","content_hash":"601c6a0ea0fbcd4dd7ebb9ac284b447a4d1d06e900ce15c4608185a93d5461a2","heading":"Tree nuisance.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.420:section","source_url":"https://topeka.municipal.codes/TMC/14.65.420","text":"(a) A tree within a mobile home park which has become dangerous to persons or property in the vicinity of the tree shall be deemed a public nuisance.\n(b) An owner shall remove any dangerous tree or prune the tree so that there is no longer a danger to persons or property in the vicinity of the tree. (Ord. 20502 § 2, 7-30-24.)","type":"section","workbench_component_id":"afc2d906-2df1-59e5-b6ce-09686cca1ae6"},{"attributes":{"block_kind":"paragraph"},"citation":"14.65.420","citation_url":"https://topeka.municipal.codes/TMC/14.65.420","content_hash":"d66522a3bab47c0487d53443dc225fcbfa9400f9fab40bbebdb8174752b64845","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.420:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.65.420:block:0","source_url":"https://topeka.municipal.codes/TMC/14.65.420","text":"(a) A tree within a mobile home park which has become dangerous to persons or property in the vicinity of the tree shall be deemed a public nuisance.","type":"paragraph","workbench_component_id":"1b16c782-4dc9-5e71-a376-29b14f6c11d5"},{"attributes":{"block_kind":"paragraph"},"citation":"14.65.420","citation_url":"https://topeka.municipal.codes/TMC/14.65.420","content_hash":"202bbfe9a432d41a75e1abfac13d5987b7e6103852cbb011a817bfa691