          "source_component_key": "ks:city:topeka:municipal-code:tmc:17.30.200:block:2",
          "start": 810
        },
        "quote": "(1) Outside of a manufactured home park or subdivision;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.30.200:block:2#text",
        "unavailable_reason": null
      },
      {
