          "start": 603
        },
        "quote": "(b) Manufactured or mobile homes that are placed or substantially improved within unnumbered or numbered A zones, AE zones, and AH zones, on the community’s FIRM shall be placed only on the following sites:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.30.200:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
