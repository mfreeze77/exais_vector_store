{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.35.330","page_type":"section"},"citation":"14.35.330","citation_url":"https://topeka.municipal.codes/TMC/14.35.330","content_hash":"0b3e39c898b940f0fd4e46f3b247e3a8575431045a61a13a896e640ff168ae67","heading":"1001.1.1, Domestic Kitchen Sink Exception.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.330:section","source_url":"https://topeka.municipal.codes/TMC/14.35.330","text":"1001.1.1, Domestic Kitchen Sink Exception, is hereby created by the addition of the following provisions:\nNot more than one (1) trap shall be permitted on a trap arm; provided, however, a separate trap may be installed on each compartment of a domestic kitchen sink with the waste discharging into a single trap arm.\n(Ord. 20570 § 37, 7-1-25; Ord. 19829 § 39, 7-9-13. Formerly 14.35.380.)","type":"section","workbench_component_id":"2b12466c-cdeb-5994-8284-55b46fd6c779"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.330","citation_url":"https://topeka.municipal.codes/TMC/14.35.330","content_hash":"0b829f54c90cd6ab7d930f5d138e768a2a5a9d6790b698af1343bd2158e4f823","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.330:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.330:block:0","source_url":"https://topeka.municipal.codes/TMC/14.35.330","text":"1001.1.1, Domestic Kitchen Sink Exception, is hereby created by the addition of the following provisions:","type":"paragraph","workbench_component_id":"1c489b46-c61b-56a7-99fd-8c6cecf1a480"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.330","citation_url":"https://topeka.municipal.codes/TMC/14.35.330","content_hash":"3a9f1df6bef5