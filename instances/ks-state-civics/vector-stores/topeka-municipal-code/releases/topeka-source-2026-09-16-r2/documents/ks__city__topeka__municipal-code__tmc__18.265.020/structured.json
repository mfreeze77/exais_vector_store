{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:18.265.020","page_type":"section"},"citation":"18.265.020","citation_url":"https://topeka.municipal.codes/TMC/18.265.020","content_hash":"1edfde715317dee9d4b50178ae30c892eeaca4db50b726bdd0f3b4b16908bbf0","heading":"Definitions.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.265.020:section","source_url":"https://topeka.municipal.codes/TMC/18.265.020","text":"“Administrator” means the City of Topeka Planning Director or designee.\n“Owner” shall mean the individual or entity that intends to own and operate the wind energy system in accordance with this chapter.\n“Rotor diameter” means the cross-sectional dimension of the circle swept by the rotating blades.\n“Total height” means the vertical distance from ground level or point of attachment to a building to the tip of a wind generator blade when the tip is at its highest point.\n“Tower” means the structure that supports a wind generator.\n“Wind energy system” means equipment that converts and then stores or transfers energy from the wind into usable forms of energy. This equipment includes any base, blade, foundation, generator, nacelle, rotor, tower, transformer, vane wire, inverter, batteries or other component used in the system.\n“Wind generator” means blades and associated mechanical and electrical conversion components mounted on top of the tower. (Ord. 19598 § 2, 6-28-11.)\nCross References: Definitions generally, TMC 1.10.020 .","type":"section","workbench_component_id":"31eba650-ce4f-548a-98ba-44f350a8d4dc"},{"attributes":{"block_kind":"paragraph"},"citation":"18.265.020","citation_url":"https://topeka.municipal.codes/TMC/18.265.020","content_hash":"407bfc11012f4b9103c2ba647664ddca05c39f5369e7de95a07ec99f1ce7fb95","heading"