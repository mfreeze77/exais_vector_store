          "start": 204
        },
        "quote": "“Rotor diameter” means the cross-sectional dimension of the circle swept by the rotating blades.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.265.020:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.265.020 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "5557e62b-32e0-5aac-82e3-18fa89cc1c5f",
