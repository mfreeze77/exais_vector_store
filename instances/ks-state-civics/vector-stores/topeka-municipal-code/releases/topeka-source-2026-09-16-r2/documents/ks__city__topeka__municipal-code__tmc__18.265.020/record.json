          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.265.020:block:4",
          "start": 474
        },
        "quote": "“Tower” means the structure that supports a wind generator.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.265.020:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.265.020 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "9499454f-805e-5f3d-939f-266920d6b866",
          "convention": "utf8_char_offset",
          "end": 833,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.265.020:block:5",
          "start": 534
        },
        "quote": "“Wind energy system” means equipment that converts and then stores or transfers energy from the wind into usable forms of energy. This equipment includes any base, blade, foundation, generator, nacelle, rotor, tower, transformer, vane wire, inverter, batteries or other component used in the system.",
