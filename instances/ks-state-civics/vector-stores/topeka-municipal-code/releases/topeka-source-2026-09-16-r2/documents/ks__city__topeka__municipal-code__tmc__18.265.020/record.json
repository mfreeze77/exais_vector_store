        },
        "quote": "“Owner” shall mean the individual or entity that intends to own and operate the wind energy system in accordance with this chapter.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.265.020:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
