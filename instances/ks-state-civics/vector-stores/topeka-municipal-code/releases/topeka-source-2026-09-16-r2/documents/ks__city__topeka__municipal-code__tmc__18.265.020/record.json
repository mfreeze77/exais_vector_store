          "end": 473,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.265.020:block:3",
          "start": 301
        },
        "quote": "“Total height” means the vertical distance from ground level or point of attachment to a building to the tip of a wind generator blade when the tip is at its highest point.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.265.020:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.265.020 block 4",
        "locator": {
          "block_index": 4,
