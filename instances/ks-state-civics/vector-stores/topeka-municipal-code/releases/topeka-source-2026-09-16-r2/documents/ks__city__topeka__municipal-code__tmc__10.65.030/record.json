          "convention": "utf8_char_offset",
          "end": 519,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.65.030:block:2",
          "start": 327
        },
        "quote": "(b) No driver of a taxicab who is on duty shall drink any intoxicating liquor or use any profane or obscene language or shout or call to prospective passengers or disturb the peace in any way.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.65.030:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 10.65.030 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "e5e96f0e-ee5d-58a8-9fdb-bc88ace2da1a",
          "convention": "utf8_char_offset",
          "end": 626,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.65.030:block:3",
          "start": 520
        },
        "quote": "(c) No person shall knowingly permit any taxicab to be used in the perpetration of a crime or misdemeanor.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.65.030:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 10.65.030 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "8b115b9f-54a8-51e4-a872-d0ce81d364f0",
          "convention": "utf8_char_offset",
