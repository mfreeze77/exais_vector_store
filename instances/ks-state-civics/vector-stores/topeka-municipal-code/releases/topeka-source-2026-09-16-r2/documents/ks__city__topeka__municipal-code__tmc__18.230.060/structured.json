{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:18.230.060","page_type":"section"},"citation":"18.230.060","citation_url":"https://topeka.municipal.codes/TMC/18.230.060","content_hash":"a27fde84d41b2beffa276b655e838bce39d4ba165e81a25d44fd4d386957fcd6","heading":"Restrictions on access.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.230.060:section","source_url":"https://topeka.municipal.codes/TMC/18.230.060","text":"The use regulations of a district shall also include and apply to the access to be provided in conjunction with such uses. No part of any lot located in a more restrictive district shall be used for vehicular access to a more intensive use. (Code 1995 § 48-27.05.)","type":"section","workbench_component_id":"af6787f4-deae-557b-a6b5-683d8c605b48"},{"attributes":{"block_kind":"paragraph"},"citation":"18.230.060","citation_url":"https://topeka.municipal.codes/TMC/18.230.060","content_hash":"a27fde84d41b2beffa276b655e838bce39d4ba165e81a25d44fd4d386957fcd6","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.230.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.230.060:block:0","source_url":"https://topeka.municipal.codes/TMC/18.230.060","text":"The use regulations of a district shall also include and apply to the access to be provided in conjunction with such uses. No part of any lot located in a more restrictive district shall be used for vehicular access to a more intensive use. (Code 1995 § 48-27.05.)","type":"paragraph","workbench_component_id":"47b44d76-55d7-5b6a-b12c-5942b465ff20"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:18.230.060:section","schema":"exais.jurisdiction.structured_conten