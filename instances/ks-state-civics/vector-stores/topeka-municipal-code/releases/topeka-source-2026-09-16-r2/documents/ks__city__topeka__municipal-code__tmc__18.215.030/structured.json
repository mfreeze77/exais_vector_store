fcd35af4ee5"},{"attributes":{"block_kind":"paragraph"},"citation":"18.215.030","citation_url":"https://topeka.municipal.codes/TMC/18.215.030","content_hash":"ff4fc7208dd7b45c81eaf5891a2450f3670e0f06b3caaafabc185eb1617c521d","heading":null,"ordinal":45,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:block:45","source_url":"https://topeka.municipal.codes/TMC/18.215.030","text":"Projects should be consistent with the Topeka Comprehensive Plan and all its elements.","type":"paragraph","workbench_component_id":"bd68b329-d9d6-5a7e-8d2d-5e55a9af8726"},{"attributes":{"block_kind":"paragraph"},"citation":"18.215.030","citation_url":"https://topeka.municipal.codes/TMC/18.215.030","content_hash":"82386a7ffd73036c423c10fbbd8a61c31b5510c282088c8e828a7cf52ec474e2","heading":null,"ordinal":46,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:block:46","source_url":"https://topeka.municipal.codes/TMC/18.215.030","text":"(e)","type":"paragraph","workbench_component_id":"af198c1e-4588-50de-8c98-01e39bc7bb15"},{"attributes":{"block_kind":"paragraph"},"citation":"18.215.030","citation_url":"https://topeka.municipal.codes/TMC/18.215.030","content_hash":"f6c9e869c3e2f19958761cc744f3988b350fd0b77f6d71fddba9b75a13a90abb","heading":null,"ordinal":47,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:block:47","source_url":"https://topeka.municipal.codes/TMC/18.215.030","text":"Additional regulations","type":"paragraph","workbench_component_id":"caa758a7-d24d-5ffd-b927-97ce7b765bec"},{"attributes":{"block_kind":"paragraph"},"citation":"18.215.030","citation_url":"https://topeka.municipal.codes/TMC/18.215.030","content_hash":"3d48c179293581d7cc5eedd008a784aac1ad60617c4183959d50648d75944fd3","heading":null,"ordinal":48,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:block:48","source_url":"https://topeka.municipal.codes/TMC/18.215.030","text":"Conditional uses shall be required to conform to any other applicable regulations specifically listed for a use as set forth in Chapter 18.225 TMC or elsewhere in the code.","type":"paragraph","workbench_component_id":"2ce62a6e-9144-506b-a299-bbf0b66bf4bd"},{"attributes":{"block_kind":"paragraph"},"citation":"18.215.030","citation_url":"https://topeka.municipal.codes/TMC/18.215.030","content_hash":"fd45d8a0d672349ddea928bc6baa8701962b313db0a419bfa0f021b0e57b5e04","heading":null,"ordinal":49,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:block:49","source_url":"https://topeka.municipal.codes/TMC/18.215.030","text":"(Ord. 19691 § 3, 1-17-12.)","type":"paragraph","workbench_component_id":"6a6259a6-606b-5fd9-a137-c1427c90c8fd"},{"attributes":{"table":{"order":0,"rows":[["Guidelines"],["(a)","Land use compatibility",""],["","(1)","Development density","Site area per unit, or intensity of use, should be similar to surrounding uses if not separated by major physical improvements or natural features."],["","(2)","Height and floor area","Development should minimize difference in height and building size from surrounding structures. Substantial differences shall be justified by urban design considerations."],["","(3)","Setbacks","Development should respect preexisting setback lines in surrounding area. Variations shall be justified by significant site features or operating characteristics."],["","(4)","Building coverage","Building coverage should be similar to that displayed in surrounding areas. Higher coverage should be mitigated by landscaping, buffering or other site amenities."],["(b)","Site development",""],["","(1)","Parking and internal circulation","Parking and circulation should serve all structures with minimal vehicular and pedestrian conflicts."],["","(2)","Stormwater management","Development design shall comply with all required stormwater runoff best management practices, as approved by the Public Works Director or designee."],["","(3)","Building design","(i) Architectural design and building materials should be compatible with surrounding properties if located adjacent to residential districts or in highly visible locations."],["","","","(ii) The adaptive reuse and restoration of historically significant structures shall be considered. “Historically significant structures” means structures listed on the National Register of Historic Places, the State Register of Historic Places, or structures having obtained local landmark status."],["(c)","Operating characteristics",""],["","(1)","Traffic capacity","Projects should not materially reduce the existing level of service on adjacent streets. Projects will be required to make street improvements and/or dedicate right-of-way to mitigate negative effects."],["","(2)","External traffic","Project design should minimize nonresidential traffic through residential neighborhoods."],["","(3)","External effects","Projects with operating hours, noises or visual distractions that impact surrounding properties may be required to mitigate these impacts."],["","(4)","Outside storage","If permitted, outside storage areas should be screened from adjacent streets and less intensive zoning districts and uses."],["(d)","Comprehensive plan","Projects should be consistent with the Topeka Comprehensive Plan and all its elements."],["(e)","Additional regulations","Conditional uses shall be required to conform to any other applicable regulations specifically listed for a use as set forth in Chapter 18.225 TMC or elsewhere in the code."]]}},"citation":"18.215.030","citation_url":"https://topeka.municipal.codes/TMC/18.215.030","content_hash":"34cf2845b283ce29abd1b03f5323edb555bb85dba8f6e69aea859aa9f8e4dc0c","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:table:0","source_url":"https://topeka.municipal.codes/TMC/18.215.030","text":null,"type":"table","workbench_component_id":"f9c9885e-2ca3-5186-92da-843be8a33dc0"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:section","schema":"exais.jurisdiction.structured_content.v1"}