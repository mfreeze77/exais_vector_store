.codes/TMC/18.215.030","text":"External effects","type":"paragraph","workbench_component_id":"706c9cf5-3bdc-5aed-8a46-47e210264dfb"},{"attributes":{"block_kind":"paragraph"},"citation":"18.215.030","citation_url":"https://topeka.municipal.codes/TMC/18.215.030","content_hash":"68ef8b31ff04682c290d50d75ac6613b5bd3467c79fb97932d4b947b289bdbfb","heading":null,"ordinal":39,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:block:39","source_url":"https://topeka.municipal.codes/TMC/18.215.030","text":"Projects with operating hours, noises or visual distractions that impact surrounding properties may be required to mitigate these impacts.","type":"paragraph","workbench_component_id":"db6e4505-fea0-50ae-9aa4-820435db0736"},{"attributes":{"block_kind":"paragraph"},"citation":"18.215.030","citation_url":"https://topeka.municipal.codes/TMC/18.215.030","content_hash":"cbe3b52ccdb46fd15e9f52b372fc95b549e6d8a1c5202fda06e4f3bf478e41ca","heading":null,"ordinal":40,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:block:40","source_url":"https://topeka.municipal.codes/TMC/18.215.030","text":"(4)","type":"paragraph","workbench_component_id":"c054457e-2981-57a2-b2b3-ae4153c19ad6"},{"attributes":{"block_kind":"paragraph"},"citation":"18.215.030","citation_url":"https://topeka.municipal.codes/TMC/18.215.030","content_hash":"5943ba354c44e0f9692beda02fa7c19ebba210390e61ee49dbf3add158c4c069","heading":null,"ordinal":41,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.215.030:block:41","source_url":"https://topeka.municipal.codes/TMC/18.215.030","text":"Outside storage","typ