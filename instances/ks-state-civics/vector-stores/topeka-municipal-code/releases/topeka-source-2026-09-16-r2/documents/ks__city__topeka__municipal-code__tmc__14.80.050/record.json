        "label": "TMC 14.80.050 block 12",
        "locator": {
          "block_index": 12,
          "component_id": "f1a79341-e5b5-58f0-9730-6cbf10db5666",
          "convention": "utf8_char_offset",
          "end": 1577,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.80.050:block:12",
          "start": 1269
        },
        "quote": "The code official or other authority having jurisdiction shall be permitted to deem a national, State or local energy efficiency program to exceed the energy efficiency required by this code. Buildings approved in writing by such an energy efficiency program shall be considered in compliance with this code.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.80.050:block:12#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
