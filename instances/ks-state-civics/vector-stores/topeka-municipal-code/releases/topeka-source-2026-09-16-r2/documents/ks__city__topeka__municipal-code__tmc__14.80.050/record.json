        "quote": "(f) 102.1.1, Above code programs, is hereby deleted in its entirety and the following provisions shall be substituted therefor:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.80.050:block:11#text",
        "unavailable_reason": null
