          "source_component_key": "ks:city:topeka:municipal-code:tmc:14.80.050:block:9",
          "start": 1032
        },
        "quote": "2. Those that do not contain conditioned space.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:14.80.050:block:9#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
