          "start": 0
        },
        "quote": "The following words, terms and phrases, when used, shall have the meaning ascribed to them herein, except when the context clearly requires otherwise:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "1cf5c927-daa6-5733-b471-12704510c82f",
          "convention": "utf8_char_offset",
          "end": 229,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:1",
          "start": 151
        },
        "quote": "“City Forester” refers to the City of Topeka Forester or designated authority.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "0d496489-7ba8-5961-964e-a71bbad3b58d",
          "convention": "utf8_char_offset",
          "end": 392,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:2",
          "start": 230
        },
        "quote": "“D.B.H.” means diameter at breast height. D.B.H. is used for trees with a diameter greater than 12 inches and is measured four and one-half feet above the ground.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "2ba1cc54-c59e-5f2f-bace-25e32a72fff7",
          "convention": "utf8_char_offset",
          "end": 542,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:3",
          "start": 393
        },
        "quote": "“Developed area” means all land area disturbed during the construction of structures, parking facilities, landscaped areas, and similar improvements.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "352d8dfc-3bdd-5610-ae09-b1f04c370ded",
          "convention": "utf8_char_offset",
          "end": 747,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:4",
          "start": 543
        },
        "quote": "“Developer” means the legal or beneficial owner of a lot or parcel or any land proposed for development and/or inclusion in a development, including the owner of an option, contract to purchase, or lease.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "31870a2d-28eb-5f03-8708-5e6fc8dbd77b",
          "convention": "utf8_char_offset",
          "end": 920,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:5",
          "start": 748
        },
        "quote": "“Development” means the construction, reconstruction, conversion, structural alteration, relocation, or enlargement of any structure or parking facility, or their environs.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "5eede78c-7db4-5fe8-b5b1-6b384a85de45",
          "convention": "utf8_char_offset",
          "end": 1184,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:6",
          "start": 921
        },
        "quote": "“Diameter caliper” means the size of a tree measured through the tree trunk. For trees less than four inches in diameter, it is measured six inches from the ground. For trees between four inches and 12 inches in diameter, it is measured 12 inches from the ground.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "a289ec0f-7e33-54ca-8822-55fd19303e56",
          "convention": "utf8_char_offset",
          "end": 1395,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:7",
          "start": 1185
        },
        "quote": "“Groundcover” means an evergreen, deciduous planting or ornamental grass, growing generally to less than 15 inches in height and generally spreads more in width than height. Turf grass is specifically excluded.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 8",
        "locator": {
          "block_index": 8,
          "component_id": "49a17bd0-7311-5567-a1f4-81585444ce99",
          "convention": "utf8_char_offset",
          "end": 1582,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:8",
          "start": 1396
        },
        "quote": "“Irrigation system” means a permanent underground piping and sprinkler head system designed using industry standard methods to provide uniform irrigation coverage over a landscaped area.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 9",
        "locator": {
          "block_index": 9,
          "component_id": "8e8953e5-ba59-55e8-8f90-c189e9465d03",
          "convention": "utf8_char_offset",
          "end": 1724,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:9",
          "start": 1583
        },
        "quote": "“Landscaped area” means any area planted with groundcover, trees, shrubs, or other plant material that meets the provisions contained herein.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:9#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 10",
        "locator": {
          "block_index": 10,
          "component_id": "0456a118-9564-52d4-a66d-6058d9c3e81b",
          "convention": "utf8_char_offset",
          "end": 1782,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:10",
          "start": 1725
        },
        "quote": "“Monoculture” means a single type of species of planting.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:10#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 11",
        "locator": {
          "block_index": 11,
          "component_id": "a6ac525f-db11-56d2-82f7-2a29a6b71c78",
          "convention": "utf8_char_offset",
          "end": 1928,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:11",
          "start": 1783
        },
        "quote": "“Mulch” means a natural planting material such as pine straw or tree bark used to control weed growth, reduce soil erosion and reduce water loss.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:11#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 12",
        "locator": {
          "block_index": 12,
          "component_id": "72262bc9-d290-55a6-989c-c21be83c5c26",
          "convention": "utf8_char_offset",
          "end": 2104,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:12",
          "start": 1929
        },
        "quote": "“Parallel planting peninsula” means a planting island that extends out into the parking area, and is bounded on at least one side by the outer edge of the asphalt or building.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:12#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 13",
        "locator": {
          "block_index": 13,
          "component_id": "3cca3067-c35f-5805-a8ac-cf10671bd1d7",
          "convention": "utf8_char_offset",
          "end": 2614,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:13",
          "start": 2105
        },
        "quote": "“Parking lot” means any off-street, unenclosed ground level facility used for the purpose of temporary storage of motor vehicles. Included within this definition are unenclosed carports associated with any or all development governed by this chapter. Enclosed parking facilities, such as single or multistory garages or parking facilities constructed within the confines of a larger building or structure, or parking facilities associated with residential development, are not included within this definition.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:13#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 14",
        "locator": {
          "block_index": 14,
          "component_id": "74a20455-3b7e-53d6-ad1c-d16970e78a8a",
          "convention": "utf8_char_offset",
          "end": 2723,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:14",
          "start": 2615
        },
        "quote": "“Parking lot island” means a planting island contained completely within the confines of a parking facility.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:14#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 15",
        "locator": {
          "block_index": 15,
          "component_id": "9f13dd7c-4549-5cc0-a68b-9eb01d7395ce",
          "convention": "utf8_char_offset",
          "end": 2827,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:15",
          "start": 2724
        },
        "quote": "“Parking lot planting” means a planting required due to the construction of noncovered surface parking.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:15#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 16",
        "locator": {
          "block_index": 16,
          "component_id": "9f779ff1-e8da-5c49-85ba-bd3cfe6916aa",
          "convention": "utf8_char_offset",
          "end": 3013,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:16",
          "start": 2828
        },
        "quote": "“Recommended tree” means any one of the trees listed in “recommended species” of this chapter (TMC 18.235.130 ). These trees are well suited for the soils and climate of Topeka, Kansas.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:16#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 17",
        "locator": {
          "block_index": 17,
          "component_id": "8bac3310-c4b0-5e4d-803b-e2c0a423a2f1",
          "convention": "utf8_char_offset",
          "end": 3096,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:17",
          "start": 3014
        },
        "quote": "“Shrub” means an evergreen or deciduous planting no less than 15 inches in height.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:17#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 18",
        "locator": {
          "block_index": 18,
          "component_id": "0c5cbc80-88cb-5490-9c16-d93462380fba",
          "convention": "utf8_char_offset",
          "end": 3253,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:18",
          "start": 3097
        },
        "quote": "“Significant tree” means any tree with a diameter caliper of six inches or greater. (Ord. 18255 § 1, 6-1-04; Ord. 17846 § 2, 6-11-02. Code 1995 § 48-38.01.)",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:18#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.235.020 block 19",
        "locator": {
          "block_index": 19,
          "component_id": "5cab3777-2de3-59c8-8869-37c8e499c171",
          "convention": "utf8_char_offset",
          "end": 3309,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.235.020:block:19",
          "start": 3254
        },
        "quote": "Cross References: Definitions generally, TMC 1.10.020 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.235.020:block:19#text",
        "unavailable_reason": null
