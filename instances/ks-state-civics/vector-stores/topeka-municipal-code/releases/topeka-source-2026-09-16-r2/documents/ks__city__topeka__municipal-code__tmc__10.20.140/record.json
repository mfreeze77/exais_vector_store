          "convention": "utf8_char_offset",
          "end": 555,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.20.140:block:1",
          "start": 189
        },
        "quote": "(a) “Adjacent school speed zone” means that portion of any street where the speed limit is normally 30 miles per hour or less located within 150 feet, or where the speed limit is normally more than 30 miles per hour located within 250 feet, of the property boundary of any public or private school building or schoolyard housing elementary or middle school students.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.20.140:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 10.20.140 block 2",
        "locator": {
          "block_index": 2,
