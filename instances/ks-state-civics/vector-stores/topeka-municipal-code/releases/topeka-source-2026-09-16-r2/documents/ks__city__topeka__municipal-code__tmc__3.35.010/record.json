        },
        "quote": "“Claim” means a claim against the City or against an employee of the City that could give rise to an action brought under the Kansas Tort Claims Act, K.S.A. 75-6101 et seq., as amended.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:3.35.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
