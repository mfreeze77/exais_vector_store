{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.40.130","page_type":"section"},"citation":"10.40.130","citation_url":"https://topeka.municipal.codes/TMC/10.40.130","content_hash":"0b31a55d24f3b4dce2032f08f78f871b17acef1100e2789a1047a76c2cfbd877","heading":"Bus stop benches.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.40.130:section","source_url":"https://topeka.municipal.codes/TMC/10.40.130","text":"The Metropolitan Transit Authority is hereby vested with jurisdiction to erect, establish, maintain, lease, contract and purchase benches for the convenience of persons waiting for buses, and derivation of all revenues from advertising thereon. (Code 1981 § 46-22. Code 1995 § 154-38.)\nCross References: Topeka Metropolitan Transit Authority, TMC 2.205.060 .","type":"section","workbench_component_id":"0bb7054d-22c1-5052-85f2-894e8fd69ba6"},{"attributes":{"block_kind":"paragraph"},"citation":"10.40.130","citation_url":"https://topeka.municipal.codes/TMC/10.40.130","content_hash":"3c2dd3d5cb449a0e4e062d20cefc3086611ec026841c00fe11398902d88c4408","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.40.130:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.40.130:block:0","source_url":"https://topeka.municipal.codes/TMC/10.40.130","text":"The Metropolitan Transit Authority is hereby vested with jurisdiction to erect, establish, maintain, lease, contract and purchase benches for the convenience of persons waiting for buses, and derivation of all revenues from advertising thereon. (Code 1981 § 46-22. Code 1995 § 154-38.)","type":"paragraph","workbench_component_id":"b79ed40b-1b6c-5a47-8ede-317012fa337a"},{"attributes":{"block_kind":"p