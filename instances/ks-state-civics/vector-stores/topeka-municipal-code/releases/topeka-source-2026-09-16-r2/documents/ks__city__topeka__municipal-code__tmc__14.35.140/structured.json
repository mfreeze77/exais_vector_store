{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.35.140","page_type":"section"},"citation":"14.35.140","citation_url":"https://topeka.municipal.codes/TMC/14.35.140","content_hash":"03ff9b1e518726212acd872ec7c5e09e93c938d6141087b7526ae471ea618e8d","heading":"418.3, Location of Floor Drains.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.140:section","source_url":"https://topeka.municipal.codes/TMC/14.35.140","text":"418.3, Location of Floor Drains, is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nFloor drains shall be installed in the following areas:\n(1) Toilet rooms containing two or more water closets or a combination of one water closet and one urinal, except in a dwelling unit.\n(2) Commercial kitchens and in accordance with Section 704.3.\n(3) Laundry rooms in commercial buildings and common laundry facilities in multi-family dwelling buildings.\n(4) Repair garages and/or service stations where oil or flammable waste may exist. Floor drains shall drain to an approved oil or flammable liquid interceptor installed in accordance with Section 1017.0.\n(5) Boiler rooms.\n(Ord. 20570 § 14, 7-1-25.)","type":"section","workbench_component_id":"bbf7d9fb-536f-56de-866b-f78e35e7f621"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.140","citation_url":"https://topeka.municipal.codes/TMC/14.35.140","content_hash":"214e0059eb37fa0b49e21309df1b8f42666f2caa1d3cc29496e0e4b0dab884d1","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.140:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.140:block:0","source_url":"https://topeka.municipal.codes/TMC/14.35.140","text":"418.3, Location of Floor Drains, is hereby deleted in its entirety and the following provisions shall be substituted therefor:","type":"paragraph","workbench_component_id":"a5a61c44-ac79-5b3c-a664-10c2c8fa1223"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.140","citation_url":"https://topeka.municipal.codes/TMC/14.35.140","content_hash":"19c40c0f892c3e0494fc02f349b0549ec9bb2eeff0f2978c30ee787f71839edd","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.140:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.140:block:1","source_url":"https://topeka.municipal.codes/TMC/14.35.140","text":"Floor drains shall be installed in the following areas:","type":"paragraph","workbench_component_id":"aa592a4a-c4de-5095-a8d9-2d0fb82b4008"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.140","citation_url":"https://topeka.municipal.codes/TMC/14.35.140","content_hash":"7669949c5a25552b3d7f19973c2a97aa3702810173b2fe177a714caa348a1643","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.140:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.140:block:2","source_url":"https://topeka.municipal.codes/TMC/14.35.140","text":"(1) Toilet rooms containing two or more water closets or a combination of one water closet and one urinal, except in a dwelling unit.","type":"paragraph","workbench_component_id":"ef2a2280-bed5-5e2c-afe4-2b363b4dfba0"},{"attributes":{"block_kind":"paragraph"},"citation":"14.35.140","citation_url":"https://topeka.municipal.codes/TMC/14.35.140","content_hash":"b484b65525e3fe2df54d10946071d2dcd2fb0eefd131f6ee077d3d4b73411d6f","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.140:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.35.