          "start": 763
        },
        "quote": "(2) The maximum amount of a loan authorized by this chapter shall not exceed $5,000 per transaction.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.110.080:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
