"paragraph","workbench_component_id":"98a2b12b-bfc9-5742-b5b6-784a919a4b71"},{"attributes":{"block_kind":"paragraph"},"citation":"12.05.090","citation_url":"https://topeka.municipal.codes/TMC/12.05.090","content_hash":"8017abdd37ecd552bb11d816dcd869f31a953067cfd52ddf526493f5eeb71ec5","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:12.05.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.05.090:block:3","source_url":"https://topeka.municipal.codes/TMC/12.05.090","text":"(2) On streets or avenues 100 feet wide and less than 130 feet wide, not to exceed four and one-half feet.","type":"paragraph","workbench_component_id":"5407d5e5-235a-556d-86b9-20146f12818b"},{"attributes":{"block_kind":"paragraph"},"citation":"12.05.090","citation_url":"https://topeka.municipal.codes/TMC/12.05.090","content_hash":"cc4440e80055b36c5ecdd265f1dc57ccfb577bd9ee4eb97652490b249916a64f","heading":null,"ordinal":4,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:12.05.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.05.090:block:4","source_url":"https://topeka.municipal.codes/TMC/12.05.090","text":"(3) On streets or avenues 80 feet wide and less than 100 feet wide, not to exceed four feet.","type":"paragraph","workbench_component_id":"05233f93-7fa3-510f-af82-cb82f0a530c3"},{"attributes":{"block_kind":"paragraph"},"citation":"12.05.090","citation_url":"https://topeka.municipal.codes/TMC/12.05.090","content_hash":"7f3716399aed7674f9e0eb8c66d049b98e52a3c46805c85b1de03fa3f0f13d30","heading":null,"ordinal":5,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:12.05.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.05.090:block:5","source_url":"https://topeka.municipal.codes/TMC/12.05.090","text":"(4) On streets or avenues 60 feet wide and less than 80 feet wide, not to exceed three and one-half feet.","type":"paragraph","workbench_component_id":"9e030406-5cb4-567d-a374-247f2b4f1158"},{"attributes":{"block_kind":"paragraph"},"citation":"12.05.090","citation_url":"https://topeka.municipal.codes/TMC/12.05.090","content_hash":"906b5eb511d5cbeca2669b000b1d5d7cd7028476eb2ee84aef4ad32433366d02","heading":null,"ordinal":6,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:12.05.090:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.05.090:block:6","source_url":"https://topeka.municipal.codes/TMC/12.05.090","text":"(5) On streets or avenues 50 feet wide and less than 60 feet wide, not to exceed three feet. (Code 1981 §§ 40-279, 40-281. Code 1995 § 130-9.)","type":"paragraph","workbench_component_id":"9cdb1362-389a-518d-92b4-4aa62105b938"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:12.05.090:section","schema":"exais.jurisdiction.structured_content.v1"}