          "start": 657
        },
        "quote": "(3) On streets or avenues 80 feet wide and less than 100 feet wide, not to exceed four feet.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.05.090:block:4#text",
        "unavailable_reason": null
