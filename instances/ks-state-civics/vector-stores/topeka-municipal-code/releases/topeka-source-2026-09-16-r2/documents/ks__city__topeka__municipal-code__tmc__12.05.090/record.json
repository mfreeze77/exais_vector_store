          "start": 550
        },
        "quote": "(2) On streets or avenues 100 feet wide and less than 130 feet wide, not to exceed four and one-half feet.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.05.090:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
