          "start": 302
        },
        "quote": "(b) All areaways shall be located adjacent to the line of the lot or piece of ground upon which the building is situated, and the width of such areaways shall not exceed as follows:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.05.090:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.05.090 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "98a2b12b-bfc9-5742-b5b6-784a919a4b71",
          "convention": "utf8_char_offset",
          "end": 549,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.05.090:block:2",
          "start": 484
        },
        "quote": "(1) On streets or avenues 130 feet wide, not to exceed five feet.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.05.090:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
