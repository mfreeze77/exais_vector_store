        "availability": "available",
        "label": "TMC 13.20.680 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "aa0ee7b2-e313-5e81-b475-e0ca0be748f1",
          "convention": "utf8_char_offset",
          "end": 572,
