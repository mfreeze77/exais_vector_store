          "source_component_key": "ks:city:topeka:municipal-code:tmc:2.40.500:block:1",
          "start": 922
        },
        "quote": "(1) The defendant’s full name;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.40.500:block:1#text",
        "unavailable_reason": null
      },
      {
