{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:9.15.280","page_type":"section"},"citation":"9.15.280","citation_url":"https://topeka.municipal.codes/TMC/9.15.280","content_hash":"a0020291bcf554f213ca835ae23b6863210127e375634ab820143da75678f8d9","heading":"Mixing drinks on licensed premises prohibited.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.280:section","source_url":"https://topeka.municipal.codes/TMC/9.15.280","text":"(a) No retailer of alcoholic liquor shall engage in or permit any person to mix drinks containing alcoholic liquor in or on the licensed premises.\n(b) The provisions of subsection (a) of this section shall not apply to the preparation or mixing of samples for the purposes of conducting wine, beer or distilled spirit tastings, or any combination thereof, as authorized by K.S.A. 41-308d and amendments thereto. (Ord. 20175 § 25, 3-12-19.)\nState Law References: Similar provisions, K.S.A. 41-713 .","type":"section","workbench_component_id":"8f87dd2f-6b20-5daf-8a25-1fccdf07ddfa"},{"attributes":{"block_kind":"paragraph"},"citation":"9.15.280","citation_url":"https://topeka.municipal.codes/TMC/9.15.280","content_hash":"17356220277754bcfb4f26dde5f2c15f7cf99db85e9ac0aeb405f5fec8b19db6","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.280:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.280:block:0","source_url":"https://topeka.municipal.codes/TMC/9.15.280","text":"(a) No retailer of alcoholic liquor shall engage in or permit any person to mix drinks containing alcoholic liquor in or on the licensed premises.","type":"paragraph","workbench_component_id":"831a9c31-bfbb-5c8b-a536-c81f05da89b9"},{"attribut