          "source_component_key": "ks:city:topeka:municipal-code:tmc:6.20.010:block:6",
          "start": 1089
        },
        "quote": "(i) Medical institutions.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:6.20.010:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 6.20.010 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "f7e2f716-1da3-5f70-a8dc-58a9ebad6f4e",
          "convention": "utf8_char_offset",
          "end": 1160,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:6.20.010:block:7",
          "start": 1115
        },
        "quote": "(ii) Post-secondary educational institutions.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:6.20.010:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 6.20.010 block 8",
        "locator": {
          "block_index": 8,
          "component_id": "496e45fa-58a0-571b-9f1a-d0dea9dade2b",
          "convention": "utf8_char_offset",
          "end": 1245,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:6.20.010:block:8",
          "start": 1161
        },
        "quote": "(iii) Veterinary clinics in possession of the animals prohibited under this section.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:6.20.010:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
