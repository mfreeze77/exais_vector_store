          "start": 315
        },
        "quote": "(b) Buying, Accepting in Trade. Except as allowed by subsection (d) of this section, it shall be unlawful for any person to knowingly buy or accept in trade any live exotic or captive wild animal within the City limits.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:6.20.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 6.20.010 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "43af5b36-4198-5297-bbea-32755a572e1d",
          "convention": "utf8_char_offset",
          "end": 784,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:6.20.010:block:2",
          "start": 535
        },
        "quote": "(c) Selling, Offering for Sale or Trade. Except as allowed by subsection (d) of this section, it shall be unlawful for any person to knowingly offer for sale or trade or to sell or trade any live exotic or captive wild animal within the City limits.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:6.20.010:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
