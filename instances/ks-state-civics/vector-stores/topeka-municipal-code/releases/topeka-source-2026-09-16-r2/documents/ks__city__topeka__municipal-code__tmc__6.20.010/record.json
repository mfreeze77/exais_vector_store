          "start": 1014
        },
        "quote": "(2) The prohibitions in subsection (a) of this section shall not apply to:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:6.20.010:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 6.20.010 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "4beaf064-0419-5e5c-a54c-6ef023a69138",
          "convention": "utf8_char_offset",
