          "component_id": "236c0a7f-89ca-5fd9-9748-bb8eb821ba5b",
          "convention": "utf8_char_offset",
          "end": 800,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:6.20.010:block:3",
          "start": 785
        },
        "quote": "(d) Exceptions.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:6.20.010:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 6.20.010 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "7dd39900-38cb-5bd6-b447-2d8d568bae4a",
          "convention": "utf8_char_offset",
          "end": 1013,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:6.20.010:block:4",
          "start": 801
        },
        "quote": "(1) The prohibitions in subsections (a) through (c) of this section shall not apply to bona fide zoos, as defined by the American Association of Zoological Parks and Association of Zoological Parks and Aquariums.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:6.20.010:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 6.20.010 block 5",
        "locator": {
          "block_index": 5,
