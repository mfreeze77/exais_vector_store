{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:13.20.180","page_type":"section"},"citation":"13.20.180","citation_url":"https://topeka.municipal.codes/TMC/13.20.180","content_hash":"9c592789606d73e557591dcca3e10d2192ebe89937f82de01ca0be68bba9077c","heading":"Rates.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.180:section","source_url":"https://topeka.municipal.codes/TMC/13.20.180","text":"(a) Rate and charges for customers outside the City operating under the terms of this chapter for sewer maintenance, sewage transportation and sewage treatment shall be as established by ordinance of the City, and such rates shall be sufficient to pay costs and expenses of the following three general classifications:\n(1) Sewage disposal and treatment.\n(2) Sewage transportation.\n(3) Sewer operation and maintenance.\n(b) All rates for customers outside the City shall be reviewed at least every five years or more frequently at the discretion of the City, except rates for sewage disposal and treatment, which rates shall be reviewed, altered or amended as other rates within the City limits. (Ord. 19496 § 39, 12-21-10; Ord. 16388 § 6.1, 11-5-91. Code 1995 § 146-252. Formerly 14.80.270.)","type":"section","workbench_component_id":"21ccaa3e-79b4-5551-8a23-cc9288be2c50"},{"attributes":{"block_kind":"paragraph"},"citation":"13.20.180","citation_url":"https://topeka.municipal.codes/TMC/13.20.180","content_hash":"efb5c60026f06f5d39ae3ca954d0cb75cb78d57303b1227bb3f5510d2ee6f15e","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.180:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.180:block:0","source_url":"https://topeka.municipal.codes/TMC/13.20.180","text":"(a) Rate and charges for customers outside the City operating under the terms of this chapter for sewer maintenance, sewage transportation and sewage treatment shall be as established by ordinance of the City, and such rates shall be sufficient to pay costs and expenses of the following three general classifications:","type":"paragraph","workbench_component_id":"310d5192-ea67-5acd-95b4-fedf0ebe0631"},{"attributes":{"block_kind":"paragraph"},"citation":"13.20.180","citation_url":"https://topeka.municipal.codes/TMC/13.20.180","content_hash":"e3ef17efc9b85e33a8663baa3e6e748c8ba0c6c5426706f7efefaba1c4de736f","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.180:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.180:block:1","source_url":"https://topeka.municipal.codes/TMC/13.20.180","text":"(1) Sewage disposal and treatment.","type":"paragraph","workbench_component_id":"c8a9518a-c04d-5332-ad03-03b363268f3e"},{"attributes":{"block_kind":"paragraph"},"citation":"13.20.180","citation_url":"https://topeka.municipal.codes/TMC/13.20.180","content_hash":"20f76bf617f1853f785f2c02346cad8ff9722f931b66e0b4614b1eacc3b78f8e","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.180:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.180:block:2","source_url":"https://topeka.municipal.codes/TMC/13.20.180","text":"(2) Sewage transportation.","type":"paragraph","workbench_component_id":"96def344-07e3-5abf-bec8-e623d0673cad"},{"attributes":{"block_kind":"paragraph"},"citation":"13.20.180","citation_url":"https://topeka.municipal.codes/TMC/13.20.180","content_hash":"1125eed14bb501cfd7a065d79b6e633535d20fcada95ae98ba9480a5aabc8b65","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.180:section","schema":"exai