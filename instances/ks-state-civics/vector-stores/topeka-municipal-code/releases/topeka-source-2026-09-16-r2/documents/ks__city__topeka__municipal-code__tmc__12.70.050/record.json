          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.050:block:9",
          "start": 1029
        },
        "quote": "(1) The type of event.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.050:block:9#text",
        "unavailable_reason": null
      },
