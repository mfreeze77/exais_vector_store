          "component_id": "822fccf5-9a7c-541f-b64d-67a2ec071b3e",
          "convention": "utf8_char_offset",
          "end": 1483,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.050:block:12",
          "start": 1350
        },
        "quote": "(4) The name and contact information for the individual who will be responsible for the conduct of, and be present during, the event.",
