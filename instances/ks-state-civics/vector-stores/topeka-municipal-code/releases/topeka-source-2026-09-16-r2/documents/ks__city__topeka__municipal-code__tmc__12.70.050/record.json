          "end": 2001,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.050:block:18",
          "start": 1965
        },
        "quote": "(ii) Location of stages and vendors.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.050:block:18#text",
        "unavailable_reason": null
      },
