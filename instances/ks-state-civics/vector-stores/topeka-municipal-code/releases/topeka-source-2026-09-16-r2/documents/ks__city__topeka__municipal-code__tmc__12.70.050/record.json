          "start": 334
        },
        "quote": "(3) If the event does not occur on a holiday, at least 30 business days before the event.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.050:block:3#text",
        "unavailable_reason": null
      },
