          "end": 1137,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.050:block:10",
          "start": 1052
        },
        "quote": "(2) The date and times of the event, including specific times for setup and teardown.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.050:block:10#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.050 block 11",
        "locator": {
          "block_index": 11,
          "component_id": "2c982f95-fbc6-5ab8-9001-53f153539d45",
          "convention": "utf8_char_offset",
          "end": 1349,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.050:block:11",
          "start": 1138
        },
        "quote": "(3) The name and contact information of the applicant and the sponsor, if not the same. If the event is sponsored by a person other than the applicant, the applicant shall provide authorization from the sponsor.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.050:block:11#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
