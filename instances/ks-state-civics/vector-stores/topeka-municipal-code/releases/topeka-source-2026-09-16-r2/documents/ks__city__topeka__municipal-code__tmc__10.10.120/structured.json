{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.10.120","page_type":"section"},"citation":"10.10.120","citation_url":"https://topeka.municipal.codes/TMC/10.10.120","content_hash":"10872cd2253eedd81927832bf065d914784ab231e17e2ca637f656f82b3a96e7","heading":"Investigation of accidents.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.10.120:section","source_url":"https://topeka.municipal.codes/TMC/10.10.120","text":"It shall be the duty of the Traffic Division, assisted by other officers of the Police Department, to investigate traffic accidents and to arrest and assist in the prosecution of those persons charged with a violation of law causing or contributing to such accidents. (Code 1981 § 43-21. Code 1995 § 142-83.)\nCross References: Police Department, TMC 2.20.090 .","type":"section","workbench_component_id":"c08d090f-dba2-59b2-aa49-6a936600d6fb"},{"attributes":{"block_kind":"paragraph"},"citation":"10.10.120","citation_url":"https://topeka.municipal.codes/TMC/10.10.120","content_hash":"d1fe9918e2ab990a53ee1a7375dc2d048db44e7fad1cd81bd7873b111e6d3e29","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.10.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.10.120:block:0","source_url":"https://topeka.municipal.codes/TMC/10.10.120","text":"It shall be the duty of the Traffic Division, assisted by other officers of the Police Department, to investigate traffic accidents and to arrest and assist in the prosecution of those persons charged with a violation of law causing or contributing to such accidents. (Code 1981 § 43-21. Code 1995 § 142-83.)","type":"paragraph","workbench_component_id":"70404555-186a-57ca-8a88-b6fd18592e