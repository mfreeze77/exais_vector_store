          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.20.010:block:1",
          "start": 289
        },
        "quote": "Riverside Motorcycle Park area, extended generally north of the Oakland wastewater treatment plant and in an area to be specifically designated and marked by appropriate signs, specifying the types of vehicles permitted and installed by the City.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.20.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 10.20.010 block 2",
        "locator": {
          "block_index": 2,
