          "convention": "utf8_char_offset",
          "end": 706,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.20.010:block:2",
          "start": 536
        },
        "quote": "(b) It shall be unlawful for any person to operate any motor vehicles not specifically described in subsection (a) of this section in the area designated in this section.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.20.010:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
