          "convention": "utf8_char_offset",
          "end": 611,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:5.115.030:block:2",
          "start": 540
        },
        "quote": "(2) The applicant’s Kansas sales tax certificate number, if applicable.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.115.030:block:2#text",
        "unavailable_reason": null
      },
      {
