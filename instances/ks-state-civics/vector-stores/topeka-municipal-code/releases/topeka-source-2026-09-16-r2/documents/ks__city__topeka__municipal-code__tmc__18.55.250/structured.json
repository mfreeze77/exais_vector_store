n the same lot as a building situated between the side lot line and a line parallel thereto and passing through the nearest point of a building, and extending from the front yard to the rear yard; or, in the case of a double frontage lot, extending from one front yard to the second front yard. (Ord. 19568 § 3, 5-24-11.)","type":"paragraph","workbench_component_id":"02e2d81a-28f8-5dbd-854e-fbd21216ae03"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.250:def:yard"},"citation":"18.55.250","citation_url":"https://topeka.municipal.codes/TMC/18.55.250","content_hash":"89474c8b9e69f4b31ffb43f49c01a7b950b45633a8a82d535e374ee45a4c42b3","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.250:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.250:definition:0","source_url":"https://topeka.municipal.codes/TMC/18.55.250","text":null,"type":"definition","workbench_component_id":"4c79ddeb-8a90-54da-bd35-cd5bdb91b473"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.250:def:yard-front"},"citation":"18.55.250","citation_url":"https://topeka.municipal.codes/TMC/18.55.250","content_hash":"a0f71fbcd0e06bf060a07a1710c17ad347ccc28e8378d385722c5677ce3736c9","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.250:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.250:definition:1","source_url":"https://topeka.municipal.codes/TMC/18.55.250","text":null,"type":"definition","workbench_component_id":"36e09358-0a4d-5fb2-9bd2-b1fbeb8bef8d"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.250:def:yard-rear"},"citation":"18.55.250","citation_url":"https://topeka.municipal.codes/TMC/18.55.250","content_hash":"b5c2671b93d24ef296f1c827b96fd8aa9805bf3515474ef3b5667c7c852fd691","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:munici