{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:18.55.250","page_type":"section"},"citation":"18.55.250","citation_url":"https://topeka.municipal.codes/TMC/18.55.250","content_hash":"ff886118254d8df653eec56d7700dae010035b90f40b52e97f4a7abcc3a780cc","heading":"“Y” definitions.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.250:section","source_url":"https://topeka.municipal.codes/TMC/18.55.250","text":"“Yard” means an open space on the same lot with a building or building group lying between the front, rear, or side wall of a building and the nearest lot line, unoccupied from the grade upward except for building projections or for accessory buildings or structures permitted by this division.\n“Yard, front” means a yard extending the full width of the lot on which a building is located and situated between the front lot line and a line parallel thereto and passing through the nearest point of a building.\n“Yard, rear” means a yard extending the full width of the lot on which a principal building is located and situated between the rear lot line and a line parallel thereto and passing through the nearest point of the principal building. On corner lots, the rear yard shall be determined pursuant to TMC 18.230.030 .\n“Yard, required” means the open space between a lot line and the buildable area within which no structure shall be located except as may be permitted under the provisions of this division.\n“Yard, side” means a yard on the same lot as a building situated between the side lot line and a line parallel thereto and passing through the nearest point of a building, and extending from the front yard to the rear yard; or, in the case of a double frontage lot, extending from one front yard to the second front yard. (Ord. 19568 § 3, 5-24-11.)","type":"section","workbench_component_id":"f96c8b93-75b5-5207-9ca0-0352a0c86774"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.250","citation_url":"https://topeka.municipal.codes/TMC/18.55.250","content_hash":"107db14d8fcea1499a7fa148bfeb497cb299fdb53db6ee2fd79137112dc6d8e1","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.250:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.250:block:0","source_url":"https://topeka.municipal.codes/TMC/18.55.250","text":"“Yard” means an open space on the same lot with a building or building group lying between the front, rear, or side wall of a building and the nearest lot line, unoccupied from the grade upward except for building projections or for accessory buildings or structures permitted by this division.","type":"paragraph","workbench_component_id":"c738dd46-88c1-52f3-be73-8fcdd5b0a15a"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.250","citation_url":"https://topeka.municipal.codes/TMC/18.55.250","content_hash":"1dfb1a2e46c98d4afb0b258d6992e05802153652c46b6bc2778e3ba8e61dcb0c","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.250:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.250:block:1","source_url":"https://topeka.municipal.codes/TMC/18.55.250","text":"“Yard, front” means a yard extending the full width of the lot on which a building is located and situated between the front lot line and a line parallel thereto and passing through the nearest point of a building.","type":"paragraph","workbench_component_id":"828d3c86-604d-5ce0-8a14-2f928f44a366"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.250","citation_url":"https://topeka.municipal.codes/TMC/18.55.250","content_hash":"0ae93b666ea0010b1620c3c31f5eab6e14ea58942f1c72b484bbfa113859985a","hea