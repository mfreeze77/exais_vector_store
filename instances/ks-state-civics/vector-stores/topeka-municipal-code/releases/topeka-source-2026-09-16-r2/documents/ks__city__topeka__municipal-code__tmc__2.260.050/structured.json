{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:2.260.050","page_type":"section"},"citation":"2.260.050","citation_url":"https://topeka.municipal.codes/TMC/2.260.050","content_hash":"f25217251b579ec491c0a97ed15ab418084a68737fb6cebcb34988a5db39077b","heading":"Property available for inclusion.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.260.050:section","source_url":"https://topeka.municipal.codes/TMC/2.260.050","text":"(a) Property available for inclusion in the Bank shall include, but not be limited to:\n(1) Property currently held in the name of the City;\n(2) Property donated by other governmental entities;\n(3) Property purchased by the Board to complement properties in the Bank; and\n(4) Property offered to and accepted by the Board.\n(b) Pursuant to K.S.A. 12-5906 and amendments thereto, any property acquired by the City may be transferred to the Bank. The Board may accept or refuse to accept any property. The transfer of any property pursuant to this section shall not be subject to any bidding requirement and shall be exempt from any provision of law requiring a public sale.\n(c) The fee simple title to any real estate that is sold to Shawnee County in accordance with K.S.A. 79-2803 and 79-2804 and amendments thereto, if accepted by the Board, may be transferred to the Bank by a good and sufficient deed by the County Clerk upon a written order from the Board of County Commissioners. (Ord. 20426 § 5, 5-16-23.)","type":"section","workbench_component_id":"bc03e91d-cf53-5819-a481-511985c38d3b"},{"attributes":{"block_kind":"paragraph"},"citation":"2.260.050","citation_url":"https://topeka.municipal.codes/TMC/2.260.050","content_hash":"a34ed1d7c92abc2b6d38b9507853dd9a16d4979e18de7c0b95350ce8c4e9b764","heading":null,"ordinal"