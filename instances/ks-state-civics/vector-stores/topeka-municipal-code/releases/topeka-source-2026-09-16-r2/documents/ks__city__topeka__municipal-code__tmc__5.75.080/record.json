          "start": 1050
        },
        "quote": "(1) All goods included in such inventory shall have been purchased by the applicant for resale on bona fide orders without cancellation privileges and shall not comprise goods purchased on consignment.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:5.75.080:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
