{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.65.050","page_type":"section"},"citation":"10.65.050","citation_url":"https://topeka.municipal.codes/TMC/10.65.050","content_hash":"0e94547ed87ba55d7dbd9d68922387834c078cc67071f20553d519fd68dc17af","heading":"Disposition of articles left in taxicabs.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.65.050:section","source_url":"https://topeka.municipal.codes/TMC/10.65.050","text":"Whenever any package, article, baggage or goods of any kind shall be left in any taxicab, the driver of such taxicab, upon discovery, shall make delivery thereof immediately to the taxicab business licensee. (Code 1981 § 46-55. Code 1995 § 154-65.)","type":"section","workbench_component_id":"b8cf36ca-6c97-5ed6-b6f8-9565c6bf6518"},{"attributes":{"block_kind":"paragraph"},"citation":"10.65.050","citation_url":"https://topeka.municipal.codes/TMC/10.65.050","content_hash":"0e94547ed87ba55d7dbd9d68922387834c078cc67071f20553d519fd68dc17af","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.65.050:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.65.050:block:0","source_url":"https://topeka.municipal.codes/TMC/10.65.050","text":"Whenever any package, article, baggage or goods of any kind shall be left in any taxicab, the driver of such taxicab, upon discovery, shall make delivery thereof immediately to the taxicab business licensee. (Code 1981 § 46-55. Code 1995 § 154-65.)","type":"paragraph","workbench_component_id":"01a9df4d-0238-5309-bf9c-7c5262fc4f57"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:10.65.050:section","schema":"exais.jurisdiction.structured_content.v1"}