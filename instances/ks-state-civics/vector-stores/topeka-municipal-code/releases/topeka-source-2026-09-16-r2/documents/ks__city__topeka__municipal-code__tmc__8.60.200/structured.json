{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:8.60.200","page_type":"section"},"citation":"8.60.200","citation_url":"https://topeka.municipal.codes/TMC/8.60.200","content_hash":"07fc2d22cb29970ed2aacf198f67c0ad0765e78f664ce09609ee54bde1e71b02","heading":"Section 404 – Occupancy Limitations.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:section","source_url":"https://topeka.municipal.codes/TMC/8.60.200","text":"Section 404.4.1, Room Area, is deleted in its entirety and the following provisions shall be substituted therefor:\nMaximum Occupancy.\nThe maximum occupancy of any dwelling unit shall not exceed the following requirements:\n(1) For the first occupant, one hundred fifty (150) square feet of floor space, and at least one hundred (100) square feet of floor space for every additional occupant thereafter. The floor space shall be calculated on the basis of total habitable room area.\n(2) The total number of persons shall not exceed two (2) times the number of its habitable rooms.\nSection 404.5, Overcrowding, is deleted in its entirety. (Ord. 20625 § 18, 12-16-25.)","type":"section","workbench_component_id":"87f96953-6b64-5c40-af0f-12aaca9d9d8d"},{"attributes":{"block_kind":"paragraph"},"citation":"8.60.200","citation_url":"https://topeka.municipal.codes/TMC/8.60.200","content_hash":"ff184494c3381db4878033c931d5874ae9c64c7757a82739cc9a09bc564f83f9","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:block:0","source_url":"https://topeka.municipal.codes/TMC/8.60.200","text":"Section 404.4.1, Room Area, is deleted in its entirety and the following provisions shall be substituted therefor:","type":"paragraph","workbench_component_id":"e789fbbc-6a64-537b-915d-0dd57adcfa73"},{"attributes":{"block_kind":"paragraph"},"citation":"8.60.200","citation_url":"https://topeka.municipal.codes/TMC/8.60.200","content_hash":"558e336f8639dc59dffcea1f4ebb6580e3ae47255e33db9db9a9fd8442746556","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:block:1","source_url":"https://topeka.municipal.codes/TMC/8.60.200","text":"Maximum Occupancy.","type":"paragraph","workbench_component_id":"9a17feb8-143a-5a0e-a4fd-6fca80221296"},{"attributes":{"block_kind":"paragraph"},"citation":"8.60.200","citation_url":"https://topeka.municipal.codes/TMC/8.60.200","content_hash":"fee891415d16eeff5ff2afe497d921a307e8f7d033a8eb9371bb4e9e1a208a0f","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:block:2","source_url":"https://topeka.municipal.codes/TMC/8.60.200","text":"The maximum occupancy of any dwelling unit shall not exceed the following requirements:","type":"paragraph","workbench_component_id":"dcf4ce50-fec1-5352-8ca5-5f0d134ccd77"},{"attributes":{"block_kind":"paragraph"},"citation":"8.60.200","citation_url":"https://topeka.municipal.codes/TMC/8.60.200","content_hash":"8cb5278aee41108663699787eccdfca0618e4aa40fcbeee3977dec15b42067cb","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:block:3","source_url":"https://topeka.municipal.codes/TMC/8.60.200","text":"(1) For the first occupant, one hundred fifty (150) square feet of floor space, and at least one hundred (100) square feet of floor space for every additional occupant thereafter. The floor space shall be calculated on the basis of total habitable room area.","type":"paragraph","workbench_component_id":"926bab24-51b7-5c4a-9b30-bbf8e400b476"},{"attributes":{"block_kind":"paragraph"},"citation":"8.60.200","citation_url":"https://topeka.municipal.codes/TMC/8.60.200","content_hash":"72f2a9eaddb86aed08c3006eb4c63d70dee83970370d9fc5ddaa05b5768c224d","heading":null,"ordinal":4,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:block:4","source_url":"https://topeka.municipal.codes/TMC/8.60.200","text":"(2) The total number of persons shall not exceed two (2) times the number of its habitable rooms.","type":"paragraph","workbench_component_id":"c4eeee99-058b-59d9-ab25-aac6cfb15c1e"},{"attributes":{"block_kind":"paragraph"},"citation":"8.60.200","citation_url":"https://topeka.municipal.codes/TMC/8.60.200","content_hash":"dab449d9b0420898a27941b459e9e755a38097e731198ccd16d71d272f137599","heading":null,"ordinal":5,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:block:5","source_url":"https://topeka.municipal.codes/TMC/8.60.200","text":"Section 404.5, Overcrowding, is deleted in its entirety. (Ord. 20625 § 18, 12-16-25.)","type":"paragraph","workbench_component_id":"ee0f1224-7b10-59b5-8192-45a51797277a"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:8.60.200:section","schema":"exais.jurisdiction.structured_content.v1"}