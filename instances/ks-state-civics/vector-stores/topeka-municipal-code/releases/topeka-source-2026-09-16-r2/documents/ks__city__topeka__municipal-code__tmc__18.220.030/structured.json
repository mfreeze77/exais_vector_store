{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:18.220.030","page_type":"section"},"citation":"18.220.030","citation_url":"https://topeka.municipal.codes/TMC/18.220.030","content_hash":"d0fc484ebfa82e1a5694e734647be4c8be9b6245c97c6050743a5d95fea0548e","heading":"Destruction of structures.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.220.030:section","source_url":"https://topeka.municipal.codes/TMC/18.220.030","text":"No building or structure which has been damaged by fire, explosion, act of God or the public enemy, to the extent of more than 50 percent of its fair market value, shall be restored except in conformity with the regulations of this title. (Code 1995 § 48-28.02.)","type":"section","workbench_component_id":"1ff089ea-6b58-55f7-b207-88d174bf7764"},{"attributes":{"block_kind":"paragraph"},"citation":"18.220.030","citation_url":"https://topeka.municipal.codes/TMC/18.220.030","content_hash":"d0fc484ebfa82e1a5694e734647be4c8be9b6245c97c6050743a5d95fea0548e","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.220.030:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.220.030:block:0","source_url":"https://topeka.municipal.codes/TMC/18.220.030","text":"No building or structure which has been damaged by fire, explosion, act of God or the public enemy, to the extent of more than 50 percent of its fair market value, shall be restored except in conformity with the regulations of this title. (Code 1995 § 48-28.02.)","type":"paragraph","workbench_component_id":"27c57477-8c70-57ea-8cbf-f7be0ff32226"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:18.220.030:section","schema":"exais.jurisdiction.structured_content