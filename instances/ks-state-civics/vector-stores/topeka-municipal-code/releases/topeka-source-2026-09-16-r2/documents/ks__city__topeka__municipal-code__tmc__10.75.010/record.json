        },
        "quote": "“Gross weight on any one axle” means the total load on all wheels whose centers are included within two parallel transverse vertical planes not more than 40 inches apart.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.75.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
