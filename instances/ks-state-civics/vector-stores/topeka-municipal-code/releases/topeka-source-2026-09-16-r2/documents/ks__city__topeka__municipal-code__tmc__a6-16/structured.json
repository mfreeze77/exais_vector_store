{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:A6-16","page_type":"section"},"citation":"A6-16","citation_url":"https://topeka.municipal.codes/TMC/A6-16","content_hash":"1993aaf0faa660a3ec9b535ccc230f831e88867ab45aa2aa3ad0e096714c00c6","heading":"Sec. A6-16. Civil service examination required.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:a6-16:section","source_url":"https://topeka.municipal.codes/TMC/A6-16","text":"Editor’s Note: This division replaced K.S.A. 13-2231(a) , which has since been repealed.\nCross References: Fire department, TMC 2.30.010 et seq.; civil service for police officers and firefighters, TMC 2.120.010 et seq.\nAll new applicants for positions in the fire department of the city shall be required to submit to a civil service examination for the position of third class fireman. (C.O. 10 § 2, 11-13-67.)","type":"section","workbench_component_id":"473774ed-b789-523b-b797-a971d1a6d6b7"},{"attributes":{"block_kind":"paragraph"},"citation":"A6-16","citation_url":"https://topeka.municipal.codes/TMC/A6-16","content_hash":"cab3975f840a4990bbd9706a44e0efa0693d333f7388777feefb313db34c41cf","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:a6-16:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:a6-16:block:0","source_url":"https://topeka.municipal.codes/TMC/A6-16","text":"Editor’s Note: This division replaced K.S.A. 13-2231(a) , which has since been repealed.","type":"paragraph","workbench_component_id":"9d0bd45e-dd8e-58a7-8949-9219f6cc5e17"},{"attributes":{"block_kind":"paragraph"},"citation":"A6-16","citation_url":"https://topeka.municipal.codes/TMC/A6-16","content_hash":"ac321f3760e7bded0760bbc7650b38f1afb15b3d870b9f86