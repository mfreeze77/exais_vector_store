          "start": 1188
        },
        "quote": "(b) Administer and enforce this chapter and all regulations and procedures adopted relating to the design, construction, maintenance, operation and alteration of the utility system including, but not limited to, the quantity, quality and/or velocity of the stormwater conveyed thereby;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.25.030:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
