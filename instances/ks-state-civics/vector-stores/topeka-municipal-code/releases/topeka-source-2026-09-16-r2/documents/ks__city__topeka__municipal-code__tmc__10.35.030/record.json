        "quote": "(b) Any person who rides a bicycle, operates an electric-assisted scooter, or uses roller skates, skateboards, roller blades, or other similar devices on a public sidewalk shall:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.35.030:block:9#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
