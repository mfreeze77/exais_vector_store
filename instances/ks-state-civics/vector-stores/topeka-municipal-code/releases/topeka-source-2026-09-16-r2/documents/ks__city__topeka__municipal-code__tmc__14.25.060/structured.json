{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.25.060","page_type":"section"},"citation":"14.25.060","citation_url":"https://topeka.municipal.codes/TMC/14.25.060","content_hash":"d6a3f1bc2b4505afacaae01d028d146e037f81a72e168a6f8696ab10c0d8d2f5","heading":"Section 104.10.1, Flood hazard areas.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.060:section","source_url":"https://topeka.municipal.codes/TMC/14.25.060","text":"Section 104.10.1, Flood hazard areas, is hereby deleted in its entirety and the following provision shall be substituted therefor:\nFor existing buildings located in flood hazard areas for which repairs, alterations and additions constitute substantial improvement, the code official shall not grant modifications to provisions related to flood resistance, except as provided in TMC Chapters 14.20 (building code) and 17.30 (floodplain management).\n(Ord. 20344 § 6, 2-15-22.)","type":"section","workbench_component_id":"d54acc11-29d1-57aa-b773-a8e41e270d58"},{"attributes":{"block_kind":"paragraph"},"citation":"14.25.060","citation_url":"https://topeka.municipal.codes/TMC/14.25.060","content_hash":"321e828ccde226f86fbdf05bdd80693765daa81c206d140129b4f5995e34aeda","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.060:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.060:block:0","source_url":"https://topeka.municipal.codes/TMC/14.25.060","text":"Section 104.10.1, Flood hazard areas, is hereby deleted in its entirety and the following provision shall be substituted therefor:","type":"paragraph","workbench_component_id":"c945dbe0-f6b1-5273-b224-ab5d9db485a8"},{"attributes":{"block_kind":"paragraph"},"citati