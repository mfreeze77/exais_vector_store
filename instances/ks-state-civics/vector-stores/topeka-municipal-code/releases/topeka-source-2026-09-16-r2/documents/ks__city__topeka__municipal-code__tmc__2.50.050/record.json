        },
        "quote": "(a) Reasons. A domestic partnership registered with the City shall be removed from the registry for the following reasons:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:2.50.050:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
