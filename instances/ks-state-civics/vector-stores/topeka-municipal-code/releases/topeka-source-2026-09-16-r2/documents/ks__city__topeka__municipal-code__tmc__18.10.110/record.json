        "label": "TMC 18.10.110 block 9",
        "locator": {
          "block_index": 9,
          "component_id": "5aa28c3d-f8dd-5d9b-bc1a-6d8bbaad10ca",
          "convention": "utf8_char_offset",
          "end": 1885,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.110:block:9",
          "start": 1612
        },
        "quote": "(e) The Planning and Development Director may allow alterations to a sign determined to be a historic sign in accordance with TMC 18.10.150 without requiring conformance with this chapter, provided the sign is safe and properly maintained in accordance with TMC 18.10.090 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.110:block:9#text",
        "unavailable_reason": null
      },
      {
