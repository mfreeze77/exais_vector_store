120","content_hash":"a9735e6fc85b16badfc750d07f720e26f2471cdda2c57a5728ad39cf881666a6","heading":null,"ordinal":14,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:14","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot” means an area of land delineated on a subdivision plat as a separate and distinct parcel of land intended for the purpose of transfer of ownership and for an individual building or use.","type":"paragraph","workbench_component_id":"79b52ad9-7297-5757-862f-02a586dcf600"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"eabece715c012515ac9d9c4d16e9982e52d4249f6a0a263a3356e33866d51bb0","heading":null,"ordinal":15,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:15","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot area” means the total horizontal area within the lot lines of a lot.","type":"paragraph","workbench_component_id":"74fdd7a7-740e-58bb-a496-5afb82282db8"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"0f63c06fd678a40f3ad11be055184250073e1a654e659b6f163c450f5c8c1be4","heading":null,"ordinal":16,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:16","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot-by-lot development” means the conventional approach to development in which each lot is treated as a separate development unit conforming to all land use, density, and bulk requirements.","type":"paragraph","workbench_component_id":"974b1558-66ed-5de0-9085-777a38009b53"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"b774a3a272c31bf097772513b4b0fe2aed74eac6926926e95b6600f5b67b6e75","heading":null,"ordinal":17,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:17","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot, corner” means a lot abutting upon two or more streets at their intersection.","type":"paragraph","workbench_component_id":"7791feb2-b2e2-554f-94fa-d1a1bbd1f6f0"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"ac390f77dbbf71c99fdf0a7baade1a10bcee7c646bc40bba3c4edda03c89f208","heading":null,"ordinal":18,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:18","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot coverage” means the percentage of a lot covered by parking lots, paved areas used for storing equipment or materials, loading/unloading areas, and buildings excluding their projecting roof eaves. Lot coverage does not include sidewalks, courtyards, landscaped areas, water bodies, and outdoor recreational areas such as pools and tennis courts.","type":"paragraph","workbench_component_id":"c76117da-79a0-55d3-95ad-a2dc8180f49c"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"72453bf14448953b3032dafec120b7e163daff24d40417465126be6eb0c5b5d8","heading":null,"ordinal":19,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:19","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot depth” means the mean horizontal distance between the front and rear lot lines, measured in the general direction of the side lot lines.","type":"paragraph","workbench_component_id":"f4658910-31b6-5697-91dd-be851ee67008"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"decef3d9fd29ee3543b54cb5726490c13e3e8000995bad2f876804c10a2dec21","heading":null,"ordinal":20,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:20","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot, double frontage” means a lot having a frontage on two nonintersecting streets, as distinguished from a corner lot.","type":"paragraph","workbench_component_id":"73c70b91-5eb8-56cc-ab5d-b843e4156b53"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"78923813b1741c17498b8d96cb635e19aea1bdd302ffe26106a3109091981436","heading":null,"ordinal":21,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:21","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot frontage” means the length of the front lot line measured at the street right-of-way line.","type":"paragraph","workbench_component_id":"fd991639-d22b-51f3-9112-ad2d4310c691"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"38d15c6db9b606f5bc9dbd7ee2b0168c9f4b30233c492bafd8db0a717d71b321","heading":null,"ordinal":22,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:22","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot, interior” means any lot other than a corner lot or a double-frontage lot.","type":"paragraph","workbench_component_id":"e332b396-7812-5d02-b695-89e8aebf6433"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"548faa2645435baa74672ee5adc9cd99d35ef1802ca605df0542802849f89e8f","heading":null,"ordinal":23,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:23","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot line, front” means the line separating the lot from the street.","type":"paragraph","workbench_component_id":"9f952122-2022-5d9e-ac9f-aae2734803c3"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"e95b1daf1e30034eef5dba62d7822e44aca656cd8a04dc43c164463d1e433ae0","heading":null,"ordinal":24,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:24","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot line, rear” means the line that is opposite from the front lot line; or in the case of a corner lot it shall be the line opposite from one of the two front lot lines as determined pursuant to TMC 18.230.030 and shall be indicated on the site plan submitted by the property owner or general contractor for a building permit. Where the lot is irregularly shaped, the rear lot line shall be a line perpendicular to the mean direction of the side lot lines.","type":"paragraph","workbench_component_id":"b5407567-38aa-562e-8aab-8c2999fb30d7"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"1127a8238bc0b7fb9115e10b155a6fa89b415d74ad73db8dbd30531b69a157a2","heading":null,"ordinal":25,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:25","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot line, side” means any lot line other than a front lot line or a rear lot line.","type":"paragraph","workbench_component_id":"d0e24096-4fe4-5565-b4ca-ef05c777c5d1"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"ee0d370096dae3b59b622c80dbabd8aca4f596a6339ca3e1d788a11122a0fa0e","heading":null,"ordinal":26,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:26","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot lines” means the lines bounding a lot.","type":"paragraph","workbench_component_id":"45244c94-b0f8-51c3-877d-ec49ff871507"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"a9898b1ff25eca3bf3ce1e4f94a860e5d2c8c98c2d54eb543c9946ffcadcdebf","heading":null,"ordinal":27,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:27","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot of record” means a lot which is part of a recorded subdivision plat or a parcel of land which has been recorded in the office of the Shawnee County Register of Deeds in accordance with the City of Topeka subdivision regulations in effect at the time of the lot’s creation.","type":"paragraph","workbench_component_id":"9a1c5054-6668-572f-b8ab-2f8eaf326f14"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"d6dfb304ee14b46b1c4e110ce8c0c79d9f8b0935b6c18504715312afe5612895","heading":null,"ordinal":28,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:28","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot, reversed corner” means a corner lot, the rear of which abuts the side of another lot.","type":"paragraph","workbench_component_id":"11e463b5-f780-5325-9208-a77ffd226a98"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"429ef8ebce4d32bcf2cc81e19c996409d6489f82a097a3dafdaa1640fe5b8feb","heading":null,"ordinal":29,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:block:29","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":"“Lot width” means the distance between the side lot lines, measured along the setback line as established by this division or, if no setback line is established, the distance between the side lot lines measured along the street line. (Ord. 20062 § 11, 4-18-17.)","type":"paragraph","workbench_component_id":"b5667768-584a-5c21-948f-805a5cd23d59"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.120:def:laboratory"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"27f87b62bf203255691ec29bb8b81a8a90217795e8350b50494caf041ad3418e","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:definition:0","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":null,"type":"definition","workbench_component_id":"ca0442f2-9b63-5a16-baa7-4a93662efdd7"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.120:def:laboratory-medical"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"068899d5f59792b22aaf1e545afd15a2400189f425b2ee646e96b72785ffad59","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:definition:1","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":null,"type":"definition","workbench_component_id":"5e74ce75-0146-5907-8612-f593828e01a2"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.120:def:labor-pool"},"citation":"18.55.120","citation_url":"https://topeka.municipal.codes/TMC/18.55.120","content_hash":"8f4210ef244817bd887885d12e26e9ccc733a286a8ca9678e32978c10c6cc277","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.120:definition:2","source_url":"https://topeka.municipal.codes/TMC/18.55.120","text":null,"type":"definition","workbench_component_id":"ebe28f2f-444b-5b9c-8ce7-5451ec728e12"},{"attributes":{"legacy_definition_id":"ks-topeka:tmc:18.55.120:def:landfill-demolition"},"citation":"18.55.120","citation_url":"