    "references": [
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 0",
        "locator": {
          "block_index": 0,
          "component_id": "1ffaaf41-44bc-5c2f-9ee3-6c6be5724070",
          "convention": "utf8_char_offset",
          "end": 207,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:0",
          "start": 0
        },
        "quote": "“Laboratory” means an establishment devoted to the testing and analysis of any product or animal (including humans). No manufacturing is conducted on the premises except for experimental or testing purposes.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "b439a4be-dc28-53a6-a8bc-2407f2cbf019",
          "convention": "utf8_char_offset",
          "end": 495,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:1",
          "start": 208
        },
        "quote": "“Laboratory, medical” means an establishment which provides bacteriological, biological, medical, X-ray, pathological and other similar analytical or diagnostic services. Fabrication is limited to the custom fabrication of dentures, optical lenses, braces or other orthopedic appliances.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "bc142f88-fc34-5493-aeac-6c281801228e",
          "convention": "utf8_char_offset",
          "end": 591,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:2",
          "start": 496
        },
        "quote": "“Labor pool” means an agency that provides manual laborers who work by the day for daily wages.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "f48409d3-9e3e-5f8e-ab78-6e96810cdae5",
          "convention": "utf8_char_offset",
          "end": 921,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:3",
          "start": 592
        },
        "quote": "“Landfill, demolition” means a facility for the disposition of construction/demolition wastes, including yard and wood waste recycling, which are transported to a permitted disposal area from an off-site source, and disposing of said wastes without creating nuisances or hazards to the public health or safety of the environment.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "1fce78ad-2665-5717-96b4-3f13a8a44d66",
          "convention": "utf8_char_offset",
          "end": 1209,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:4",
          "start": 922
        },
        "quote": "“Landfill, sanitary” means a method of disposing of refuse/solid wastes on land without creating nuisances or hazards to the public health or safety of the environment at a permitted solid waste disposal area which meets the standards prescribed by the State or local unit of government.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "01478a29-54f6-566c-bf2c-8b1ed6d45024",
          "convention": "utf8_char_offset",
          "end": 1356,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:5",
          "start": 1210
        },
        "quote": "“Landscaped area” means an area that is permanently devoted and maintained for the growing of trees, shrubbery, grass and/or other plant material.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "25ce5220-adea-55b5-a658-e69e80cca3eb",
          "convention": "utf8_char_offset",
          "end": 1864,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:6",
          "start": 1357
        },
        "quote": "“Landscaping” means the improvement of land by planting or installing living materials such as trees, shrubs, and ground cover; nonliving materials such as rocks, pebbles, bark, mulches, brick pavers, and earthen mounds (excluding pavement); and items of a decorative or embellishment nature such as fountains, pools, fencing, park benches, and sculptures. Landscaping provides screening between adjoining land uses and shade, softens building lines, and produces a visually pleasing effect of the premises.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "43602242-ab6f-587f-a363-59b90ce96de3",
          "convention": "utf8_char_offset",
          "end": 2100,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:7",
          "start": 1865
        },
        "quote": "“Land use plan” means a basic element of a comprehensive plan; it designates the future use or reuse of the land within a given jurisdiction’s planning area, and the policies and reasoning used in arriving at the decisions in the plan.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 8",
        "locator": {
          "block_index": 8,
          "component_id": "9a1b7e6b-720e-536a-b5df-827e7ff6b5a1",
          "convention": "utf8_char_offset",
          "end": 2245,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:8",
          "start": 2101
        },
        "quote": "“Lattice tower” means a guyed or self-supporting three- or four-sided, open, steel frame structure used to support telecommunications equipment.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 9",
        "locator": {
          "block_index": 9,
          "component_id": "e31cd319-c3e2-592b-b85f-c7cdb91c377d",
          "convention": "utf8_char_offset",
          "end": 2452,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:9",
          "start": 2246
        },
        "quote": "“Laundromat (self-service)” means an establishment providing washing, drying and/or dry cleaning machines on the premises for rental use to the general public for family laundering or dry cleaning purposes.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:9#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 10",
        "locator": {
          "block_index": 10,
          "component_id": "9448f82b-c4c4-593e-b187-71a80492a9fa",
          "convention": "utf8_char_offset",
          "end": 2563,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:10",
          "start": 2453
        },
        "quote": "“Laundry (commercial)” means an establishment where commercial laundry and/or dry cleaning work is undertaken.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:10#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 11",
        "locator": {
          "block_index": 11,
          "component_id": "df715d06-7e93-5c1a-acca-e265362f3e08",
          "convention": "utf8_char_offset",
          "end": 2721,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:11",
          "start": 2564
        },
        "quote": "“Library” means a place in which books, manuscripts, musical scores or other literary and artistic materials are kept for use and only incidentally for sale.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:11#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 12",
        "locator": {
          "block_index": 12,
          "component_id": "e9721863-7ac9-5e8a-844e-cbd1d21180e7",
          "convention": "utf8_char_offset",
          "end": 2976,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:12",
          "start": 2722
        },
        "quote": "“Little free libraries” are structures for the storage of books or other nonperishable items made available to the general public for no remuneration, and which may be located on private property in a structure or receptacle of a limited size and volume.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:12#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 13",
        "locator": {
          "block_index": 13,
          "component_id": "8da05337-0f08-54e7-96c0-b211e78e8519",
          "convention": "utf8_char_offset",
          "end": 3121,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:13",
          "start": 2977
        },
        "quote": "“Loading space” means an off-street space for the temporary parking of a commercial vehicle while loading or unloading merchandise or materials.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:13#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 14",
        "locator": {
          "block_index": 14,
          "component_id": "79b52ad9-7297-5757-862f-02a586dcf600",
          "convention": "utf8_char_offset",
          "end": 3313,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:14",
          "start": 3122
        },
        "quote": "“Lot” means an area of land delineated on a subdivision plat as a separate and distinct parcel of land intended for the purpose of transfer of ownership and for an individual building or use.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:14#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 15",
        "locator": {
          "block_index": 15,
          "component_id": "74fdd7a7-740e-58bb-a496-5afb82282db8",
          "convention": "utf8_char_offset",
          "end": 3387,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:15",
          "start": 3314
        },
        "quote": "“Lot area” means the total horizontal area within the lot lines of a lot.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:15#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 16",
        "locator": {
          "block_index": 16,
          "component_id": "974b1558-66ed-5de0-9085-777a38009b53",
          "convention": "utf8_char_offset",
          "end": 3579,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:16",
          "start": 3388
        },
        "quote": "“Lot-by-lot development” means the conventional approach to development in which each lot is treated as a separate development unit conforming to all land use, density, and bulk requirements.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:16#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 17",
        "locator": {
          "block_index": 17,
          "component_id": "7791feb2-b2e2-554f-94fa-d1a1bbd1f6f0",
          "convention": "utf8_char_offset",
          "end": 3662,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:17",
          "start": 3580
        },
        "quote": "“Lot, corner” means a lot abutting upon two or more streets at their intersection.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:17#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 18",
        "locator": {
          "block_index": 18,
          "component_id": "c76117da-79a0-55d3-95ad-a2dc8180f49c",
          "convention": "utf8_char_offset",
          "end": 4012,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:18",
          "start": 3663
        },
        "quote": "“Lot coverage” means the percentage of a lot covered by parking lots, paved areas used for storing equipment or materials, loading/unloading areas, and buildings excluding their projecting roof eaves. Lot coverage does not include sidewalks, courtyards, landscaped areas, water bodies, and outdoor recreational areas such as pools and tennis courts.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:18#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 19",
        "locator": {
          "block_index": 19,
          "component_id": "f4658910-31b6-5697-91dd-be851ee67008",
          "convention": "utf8_char_offset",
          "end": 4154,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:19",
          "start": 4013
        },
        "quote": "“Lot depth” means the mean horizontal distance between the front and rear lot lines, measured in the general direction of the side lot lines.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:19#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 20",
        "locator": {
          "block_index": 20,
          "component_id": "73c70b91-5eb8-56cc-ab5d-b843e4156b53",
          "convention": "utf8_char_offset",
          "end": 4275,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:20",
          "start": 4155
        },
        "quote": "“Lot, double frontage” means a lot having a frontage on two nonintersecting streets, as distinguished from a corner lot.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:20#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 21",
        "locator": {
          "block_index": 21,
          "component_id": "fd991639-d22b-51f3-9112-ad2d4310c691",
          "convention": "utf8_char_offset",
          "end": 4371,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:21",
          "start": 4276
        },
        "quote": "“Lot frontage” means the length of the front lot line measured at the street right-of-way line.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:21#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 22",
        "locator": {
          "block_index": 22,
          "component_id": "e332b396-7812-5d02-b695-89e8aebf6433",
          "convention": "utf8_char_offset",
          "end": 4451,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:22",
          "start": 4372
        },
        "quote": "“Lot, interior” means any lot other than a corner lot or a double-frontage lot.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:22#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 23",
        "locator": {
          "block_index": 23,
          "component_id": "9f952122-2022-5d9e-ac9f-aae2734803c3",
          "convention": "utf8_char_offset",
          "end": 4520,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:23",
          "start": 4452
        },
        "quote": "“Lot line, front” means the line separating the lot from the street.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:23#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 24",
        "locator": {
          "block_index": 24,
          "component_id": "b5407567-38aa-562e-8aab-8c2999fb30d7",
          "convention": "utf8_char_offset",
          "end": 4979,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:24",
          "start": 4521
        },
        "quote": "“Lot line, rear” means the line that is opposite from the front lot line; or in the case of a corner lot it shall be the line opposite from one of the two front lot lines as determined pursuant to TMC 18.230.030 and shall be indicated on the site plan submitted by the property owner or general contractor for a building permit. Where the lot is irregularly shaped, the rear lot line shall be a line perpendicular to the mean direction of the side lot lines.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:24#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 25",
        "locator": {
          "block_index": 25,
          "component_id": "d0e24096-4fe4-5565-b4ca-ef05c777c5d1",
          "convention": "utf8_char_offset",
          "end": 5063,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:25",
          "start": 4980
        },
        "quote": "“Lot line, side” means any lot line other than a front lot line or a rear lot line.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:25#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 26",
        "locator": {
          "block_index": 26,
          "component_id": "45244c94-b0f8-51c3-877d-ec49ff871507",
          "convention": "utf8_char_offset",
          "end": 5107,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:26",
          "start": 5064
        },
        "quote": "“Lot lines” means the lines bounding a lot.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:26#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.55.120 block 27",
        "locator": {
          "block_index": 27,
          "component_id": "9a1c5054-6668-572f-b8ab-2f8eaf326f14",
          "convention": "utf8_char_offset",
          "end": 5385,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.55.120:block:27",
          "start": 5108
        },
        "quote": "“Lot of record” means a lot which is part of a recorded subdivision plat or a parcel of land which has been recorded in the office of the Shawnee County Register of Deeds in accordance with the City of Topeka subdivision regulations in effect at the time of the lot’s creation.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.55.120:block:27#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
