{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:12.65.100","page_type":"section"},"citation":"12.65.100","citation_url":"https://topeka.municipal.codes/TMC/12.65.100","content_hash":"653dd8cc5bff49fa3b8469fc848eb89adf3977c38fdd89495624561d6e89f018","heading":"Notice to abate – Contents.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.65.100:section","source_url":"https://topeka.municipal.codes/TMC/12.65.100","text":"The notice to abate shall contain:\n(a) An order to abate the hazard or to appeal the order pursuant to Chapter 2.45 TMC;\n(b) The location of the hazard;\n(c) A description of the hazard;\n(d) A statement of acts necessary to abate; and\n(e) A statement that if the hazard is not abated as directed and no appeal is filed within the prescribed time, the City will seek the remedy of prosecution and enforcement under TMC 1.10.070 and/or abate the hazard and assess the cost thereof against the owner. (Ord. 19699 § 11, 2-7-12.)","type":"section","workbench_component_id":"5699bc1b-9eac-5450-8076-2bf95ce958f5"},{"attributes":{"block_kind":"paragraph"},"citation":"12.65.100","citation_url":"https://topeka.municipal.codes/TMC/12.65.100","content_hash":"febdedee4f52e2d0e5aaad90ecd5ffe764b1686ed3fb3e85c6bbb8f174ae2283","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:12.65.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:12.65.100:block:0","source_url":"https://topeka.municipal.codes/TMC/12.65.100","text":"The notice to abate shall contain:","type":"paragraph","workbench_component_id":"c0133ad9-57f4-5ad6-b7d7-a2ec1db2db76"},{"attributes":{"block_kind":"paragraph"},"citation":"12.65.100","citation_url":"https://topeka.municip