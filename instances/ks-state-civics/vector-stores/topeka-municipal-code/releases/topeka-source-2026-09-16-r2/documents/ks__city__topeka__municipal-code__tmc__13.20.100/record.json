          "start": 853
        },
        "quote": "(4) Within five years of the construction of the public main or lateral sanitary sewer, such time not starting any sooner than the effective date of this chapter.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:13.20.100:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
