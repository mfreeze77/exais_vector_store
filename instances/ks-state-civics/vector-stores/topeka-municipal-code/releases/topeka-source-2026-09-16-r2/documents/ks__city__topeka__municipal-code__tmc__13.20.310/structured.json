{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:13.20.310","page_type":"section"},"citation":"13.20.310","citation_url":"https://topeka.municipal.codes/TMC/13.20.310","content_hash":"760de08627dfabcf64fc86b32d178b8fffea69fbf0679298bdb1d541b0be61ec","heading":"Limitations – Radioactive wastes.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.310:section","source_url":"https://topeka.municipal.codes/TMC/13.20.310","text":"No person shall discharge or cause to be discharged any radioactive waste into a sanitary sewer except:\n(a) When the person is authorized to use radioactive materials by the State Department of Health and Environment or other governmental agency empowered to regulate the use of radioactive materials;\n(b) When the waste is discharged in strict conformity with current State radiation control regulations and recommendations for safe disposal; and\n(c) Is in compliance with all rules and regulations of local regulatory agencies. (Ord. 19496 § 52, 12-21-10; Ord. 16388 § 7.9, 11-5-91. Code 1995 § 146-280. Formerly 14.80.400.)","type":"section","workbench_component_id":"69719147-64d8-5bb1-b78a-952462584cd8"},{"attributes":{"block_kind":"paragraph"},"citation":"13.20.310","citation_url":"https://topeka.municipal.codes/TMC/13.20.310","content_hash":"f0023bbd9e168def32890ddd4df38d45d3953c92946e66948435093996232be5","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.310:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.310:block:0","source_url":"https://topeka.municipal.codes/TMC/13.20.310","text":"No person shall discharge or cause to be discharged any radioactive waste into a sanitary sewer except:","type":"pa