{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:2.125.040","page_type":"section"},"citation":"2.125.040","citation_url":"https://topeka.municipal.codes/TMC/2.125.040","content_hash":"671e558beb36492791be83221fb9b9faa5b74255d7d06e130f40ab1faaca575d","heading":"Contribution by City.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.125.040:section","source_url":"https://topeka.municipal.codes/TMC/2.125.040","text":"(a) The City hereby agrees to pay to the Internal Revenue Service (IRS), at such time or times and in such manner as prescribed by the Internal Revenue Code.\n(b) Amounts deducted from any remuneration paid to an employee subject to the provisions of this plan shall be remitted to the IRS as prescribed by the Internal Revenue Code. (Ord. 20206 §§ 53, 86, 9-10-19.)","type":"section","workbench_component_id":"df3d4781-a9f2-5000-9074-0bb515225726"},{"attributes":{"block_kind":"paragraph"},"citation":"2.125.040","citation_url":"https://topeka.municipal.codes/TMC/2.125.040","content_hash":"7141ea9721aaa6727c7a1c05e36049a9ca526881eb6c4bb1f114ef5865ecb775","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:2.125.040:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:2.125.040:block:0","source_url":"https://topeka.municipal.codes/TMC/2.125.040","text":"(a) The City hereby agrees to pay to the Internal Revenue Service (IRS), at such time or times and in such manner as prescribed by the Internal Revenue Code.","type":"paragraph","workbench_component_id":"50c3a13a-9a84-5ea0-8c3e-bcb45f3e9d24"},{"attributes":{"block_kind":"paragraph"},"citation":"2.125.040","citation_url":"https://topeka.municipal.codes/TMC/2.125.040","content_hash":"9a29e