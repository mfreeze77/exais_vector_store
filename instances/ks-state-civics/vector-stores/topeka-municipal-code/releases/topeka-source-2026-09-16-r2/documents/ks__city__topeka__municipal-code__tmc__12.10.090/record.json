          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.10.090:block:2",
          "start": 271
        },
        "quote": "“Sidewalk” means any portion of a street between the curbline and the adjacent property line intended for the use of pedestrians.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.10.090:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
