{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.25.250","page_type":"section"},"citation":"14.25.250","citation_url":"https://topeka.municipal.codes/TMC/14.25.250","content_hash":"8fe9b2e41816fb800501959c6acb32d42ff9062c7dd14f76dd6b3e85e4dc6307","heading":"Section 1301.4.1, Structural analysis.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.250:section","source_url":"https://topeka.municipal.codes/TMC/14.25.250","text":"Section 1301.4.1, Structural analysis, is hereby deleted in its entirety and the following provision shall be substituted therefor:\nThe owner shall have a structural analysis of the existing building made to determine adequacy of structural systems for the proposed alteration, addition or change of occupancy. The analysis shall demonstrate that the building with the work completed meets the structural provisions of IEBC Chapters 4, 6-12, and 14.\n(Ord. 20344 § 25, 2-15-22.)","type":"section","workbench_component_id":"59276bcd-030f-59dc-b770-c580811a1c3c"},{"attributes":{"block_kind":"paragraph"},"citation":"14.25.250","citation_url":"https://topeka.municipal.codes/TMC/14.25.250","content_hash":"58d4469b20238b5c5670316e0c41772ade31a6a0e1d2f8c9a26cceb61844210e","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.250:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.250:block:0","source_url":"https://topeka.municipal.codes/TMC/14.25.250","text":"Section 1301.4.1, Structural analysis, is hereby deleted in its entirety and the following provision shall be substituted therefor:","type":"paragraph","workbench_component_id":"a258ab29-4cfd-5987-a2b0-ee3e5e0542b9"},{"attributes":{"block_kind":"paragraph"},"citation":"14.25.250","citation_url":"https://topeka.municipal.codes/TMC/14.25.250","content_hash":"6959c6b6d5e9b1f8d417318d73c2807766701a72cc5922e2b597811a35db690f","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.250:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.250:block:1","source_url":"https://topeka.municipal.codes/TMC/14.25.250","text":"The owner shall have a structural analysis of the existing building made to determine adequacy of structural systems for the proposed alteration, addition or change of occupancy. The analysis shall demonstrate that the building with the work completed meets the structural provisions of IEBC Chapters 4, 6-12, and 14.","type":"paragraph","workbench_component_id":"15980d1a-1dc4-58ac-b72f-dcbf2dcc5ab7"},{"attributes":{"block_kind":"paragraph"},"citation":"14.25.250","citation_url":"https://topeka.municipal.codes/TMC/14.25.250","content_hash":"32aa917b90a1f049c3cecda13d72497da9d871eb74e2490179960944ec2346e6","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.250:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.250:block:2","source_url":"https://topeka.municipal.codes/TMC/14.25.250","text":"(Ord. 20344 § 25, 2-15-22.)","type":"paragraph","workbench_component_id":"dcdd06ee-8676-5893-b9c8-3f4005328a36"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.250:section","schema":"exais.jurisdiction.structured_content.v1"}