{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:9.15.270","page_type":"section"},"citation":"9.15.270","citation_url":"https://topeka.municipal.codes/TMC/9.15.270","content_hash":"ae47cee409a9c63bfd7666a2053a2041b71b784e9746309d26c1b952df48cebe","heading":"Employment of certain persons prohibited.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.270:section","source_url":"https://topeka.municipal.codes/TMC/9.15.270","text":"It shall be unlawful for a retailer of alcoholic liquor to employ any person:\n(a) Under the age of 21 years in connection with the operation of such retail establishment; or\n(b) In connection with the operation of such retail establishment who has been adjudged guilty of a felony. (Code 1981 § 5-85. Code 1995 § 10-119.)\nState Law References: Similar provisions, K.S.A. 41-713 .","type":"section","workbench_component_id":"a49d89da-cddb-5f1f-91cf-650a1b909410"},{"attributes":{"block_kind":"paragraph"},"citation":"9.15.270","citation_url":"https://topeka.municipal.codes/TMC/9.15.270","content_hash":"21bdd8c39a605c7ea4d7fdcaa52fe8dfea6c3d30ada4f7c21c1d03559977b016","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.270:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:9.15.270:block:0","source_url":"https://topeka.municipal.codes/TMC/9.15.270","text":"It shall be unlawful for a retailer of alcoholic liquor to employ any person:","type":"paragraph","workbench_component_id":"4dd74787-9d43-565f-8c2d-c931572eae46"},{"attributes":{"block_kind":"paragraph"},"citation":"9.15.270","citation_url":"https://topeka.municipal.codes/TMC/9.15.270","content_hash":"d950b9ef840e9be47f42089dabffdf10c5f0d24f7ee345b2004991ee0c784