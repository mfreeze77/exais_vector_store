          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.70.030:block:2",
          "start": 1249
        },
        "quote": "(c) For any purpose whatsoever, including the loading or unloading of merchandise or inventory within a time period other than between the hours of 10:00 a.m. and 6:00 p.m. of any day, no permit shall be required.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.70.030:block:2#text",
