          "source_component_key": "ks:city:topeka:municipal-code:tmc:10.70.030:block:1",
          "start": 927
        },
        "quote": "(b) For purposes other than loading or unloading merchandise or inventory, it shall be unlawful for the driver or the owner of any semitrailer or truck tractor to stop or stand or to cause or permit the same to be stopped or to stand in any alley in the core area between the hours of 10:00 a.m. and 6:00 p.m. of any day.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:10.70.030:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
