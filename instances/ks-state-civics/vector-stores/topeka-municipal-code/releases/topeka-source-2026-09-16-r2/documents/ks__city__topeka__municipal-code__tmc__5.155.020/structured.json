{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:5.155.020","page_type":"section"},"citation":"5.155.020","citation_url":"https://topeka.municipal.codes/TMC/5.155.020","content_hash":"2d5b0fca7c3c8f95126801257750c04880fed6b8ac34655f36c99e46667d1c69","heading":"Application.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.155.020:section","source_url":"https://topeka.municipal.codes/TMC/5.155.020","text":"No taxicab business license shall be issued until the person applying therefor shall file with the City Clerk an application stating:\n(a) The number of cars to be operated by the applicant, which in no instance shall be less than eight in number;\n(b) The location of its central office in the City, which shall have a telephone therein installed, operated and maintained on a 24-hour-a-day service. (Code 1981 § 46-64. Code 1995 § 154-87.)\nCross References: City Clerk, TMC 2.20.010 .","type":"section","workbench_component_id":"eb11919c-a054-5bb0-b8c2-aab1b96c618e"},{"attributes":{"block_kind":"paragraph"},"citation":"5.155.020","citation_url":"https://topeka.municipal.codes/TMC/5.155.020","content_hash":"756531e660b93dbab139822254c7a1f49d043bcd09cc92eb7f26d905492e5346","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.155.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.155.020:block:0","source_url":"https://topeka.municipal.codes/TMC/5.155.020","text":"No taxicab business license shall be issued until the person applying therefor shall file with the City Clerk an application stating:","type":"paragraph","workbench_component_id":"3cfd7370-1e60-555f-ba16-de1744c94d00"},{"attributes":{"block_kind":"paragraph"},"citation":"5.155.020","citation_url":"https://topeka.municipal.codes/TMC/5.155.020","content_hash":"b218b5010f2f3f56874a279ae7ca29910eaca2f5c78ab46380f432cfb6a721ff","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.155.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.155.020:block:1","source_url":"https://topeka.municipal.codes/TMC/5.155.020","text":"(a) The number of cars to be operated by the applicant, which in no instance shall be less than eight in number;","type":"paragraph","workbench_component_id":"a6eff778-0a64-55a9-8146-bbb760e2d793"},{"attributes":{"block_kind":"paragraph"},"citation":"5.155.020","citation_url":"https://topeka.municipal.codes/TMC/5.155.020","content_hash":"8fabd67b47530edc8bb92b0b1e398f75cd8affba6dec038914dbb60f0c828b25","heading":null,"ordinal":2,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.155.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.155.020:block:2","source_url":"https://topeka.municipal.codes/TMC/5.155.020","text":"(b) The location of its central office in the City, which shall have a telephone therein installed, operated and maintained on a 24-hour-a-day service. (Code 1981 § 46-64. Code 1995 § 154-87.)","type":"paragraph","workbench_component_id":"d39c22bb-23c0-5daa-a18e-1755eae52604"},{"attributes":{"block_kind":"paragraph"},"citation":"5.155.020","citation_url":"https://topeka.municipal.codes/TMC/5.155.020","content_hash":"547b4e6a10c399a196aa412a4781d80cc47ea4b405a5933441203369ce0262c5","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:5.155.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:5.155.020:block:3","source_url":"https://topeka.municipal.codes/TMC/5.155.020","text":"Cross References: City Clerk, TMC 2.20.010 .","type":"paragraph","workb