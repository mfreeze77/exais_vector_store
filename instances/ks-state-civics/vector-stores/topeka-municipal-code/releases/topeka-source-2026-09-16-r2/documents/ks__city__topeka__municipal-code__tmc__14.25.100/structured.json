{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.25.100","page_type":"section"},"citation":"14.25.100","citation_url":"https://topeka.municipal.codes/TMC/14.25.100","content_hash":"d3be5d864b53f33cd6d84a24b2e4b99562f46168eaea3979f86c2cc87301f466","heading":"Section 113.4, Violation penalties.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.100:section","source_url":"https://topeka.municipal.codes/TMC/14.25.100","text":"Section 113.4, Violation penalties, is hereby deleted in its entirety and the following provision shall be substituted therefor:\nViolation of any provision of TMC 14.25.010 shall constitute a misdemeanor. Any person who violates any provision of TMC 14.25.010 or fails to comply with any of its requirements shall, upon conviction thereof, be fined not to exceed $499.00. Each day such violation continues shall be considered a separate offense.\n(Ord. 20344 § 10, 2-15-22.)","type":"section","workbench_component_id":"48dd8156-07ca-5631-99ff-29bf52cbacac"},{"attributes":{"block_kind":"paragraph"},"citation":"14.25.100","citation_url":"https://topeka.municipal.codes/TMC/14.25.100","content_hash":"448935e3f99cb3fd191feb69267ce82cd56604ba9df9549dbd965b52772b00d3","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.100:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.100:block:0","source_url":"https://topeka.municipal.codes/TMC/14.25.100","text":"Section 113.4, Violation penalties, is hereby deleted in its entirety and the following provision shall be substituted therefor:","type":"paragraph","workbench_component_id":"a6ebc974-c7b7-51db-bf99-5b88931e278c"},{"attributes":{"block_kind":"paragraph"},"citation":"