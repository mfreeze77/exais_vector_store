          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:30",
          "start": 4334
        },
        "quote": "“Stolen property” means property over which control has been obtained by theft.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:30#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 31",
        "locator": {
          "block_index": 31,
          "component_id": "d73c5444-ffb1-5dea-a98c-75f6f7ef1098",
