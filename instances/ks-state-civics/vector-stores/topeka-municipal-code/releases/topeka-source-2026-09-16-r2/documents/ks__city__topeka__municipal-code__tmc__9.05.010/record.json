          "start": 4218
        },
        "quote": "“Solicit” or “solicitation” means to command, authorize, urge, incite, request or advise another to commit a crime.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:29#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 30",
        "locator": {
          "block_index": 30,
          "component_id": "72b309e9-e5c3-546e-956a-37e5881b230b",
          "convention": "utf8_char_offset",
