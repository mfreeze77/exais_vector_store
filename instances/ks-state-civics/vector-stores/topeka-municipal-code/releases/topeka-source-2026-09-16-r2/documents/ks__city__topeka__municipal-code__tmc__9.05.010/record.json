          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:31",
          "start": 4414
        },
        "quote": "“Threat” means a communicated intent to inflict physical or other harm on any person or on property.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:31#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
