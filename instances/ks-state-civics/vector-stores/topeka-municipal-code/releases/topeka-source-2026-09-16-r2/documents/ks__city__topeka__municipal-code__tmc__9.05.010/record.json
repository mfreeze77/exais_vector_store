    "references": [
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 0",
        "locator": {
          "block_index": 0,
          "component_id": "dc47ba7c-93fc-53b4-a92f-54e798975f37",
          "convention": "utf8_char_offset",
          "end": 186,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:0",
          "start": 0
        },
        "quote": "The following words, terms and phrases, when used in this title, shall have the meanings ascribed to them in this section, except where the context clearly indicates a different meaning:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "8c50e163-35d2-50c9-9697-97e6ad13f5f1",
          "convention": "utf8_char_offset",
          "end": 239,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:1",
          "start": 187
        },
        "quote": "“Act” includes a failure or omission to take action.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "6fa93117-87ba-5c69-abce-927cba9c1d51",
          "convention": "utf8_char_offset",
          "end": 323,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:2",
          "start": 240
        },
        "quote": "“Another” means a person other than the person whose act is claimed to be criminal.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "a262aeee-1d90-5d41-9a2e-efa58bc8ac09",
          "convention": "utf8_char_offset",
          "end": 400,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:3",
          "start": 324
        },
        "quote": "“Conduct” means an act or series of acts, and the accompanying mental state.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "21267a46-6b64-5ae4-8b8f-7cdf89e8a11c",
          "convention": "utf8_char_offset",
          "end": 473,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:4",
          "start": 401
        },
        "quote": "“Conviction” includes a judgment of guilt entered upon a plea of guilty.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "52f40647-efd4-5278-ab1f-69eb638ac570",
          "convention": "utf8_char_offset",
          "end": 626,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:5",
          "start": 474
        },
        "quote": "“Deception” means knowingly and willfully making a false statement or representation, express or implied, pertaining to a present or past existing fact.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "2083dbe4-4c17-5974-b1ad-28819d1d6405",
          "convention": "utf8_char_offset",
          "end": 658,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:6",
          "start": 627
        },
        "quote": "“Deprive permanently” means to:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "5f6e7abc-51f8-50be-a5c7-3c97c2f0855d",
          "convention": "utf8_char_offset",
          "end": 774,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:7",
          "start": 659
        },
        "quote": "(1) Take from the owner the possession, use or benefit of his property, without an intent to restore such property;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 8",
        "locator": {
          "block_index": 8,
          "component_id": "e76330d6-c173-5053-a878-ba082e61302d",
          "convention": "utf8_char_offset",
          "end": 992,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:8",
          "start": 775
        },
        "quote": "(2) Retain property without intent to restore such property or with intent to restore such property to the owner only if the owner purchases or leases it back, or pays a reward or other compensation for its return; or",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 9",
        "locator": {
          "block_index": 9,
          "component_id": "4bbe410b-35c5-5a91-a2ee-eaf603ed2d24",
          "convention": "utf8_char_offset",
          "end": 1125,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:9",
          "start": 993
        },
        "quote": "(3) Sell, give, pledge or otherwise dispose of any interest in property or subject it to the claim of a person other than the owner.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:9#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 10",
        "locator": {
          "block_index": 10,
          "component_id": "ed8651e7-8f09-58e3-bcf6-7d10d0932e65",
          "convention": "utf8_char_offset",
          "end": 1292,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:10",
          "start": 1126
        },
        "quote": "“Dwelling” means a building or portion thereof, a tent, a vehicle, or other enclosed space which is used or intended for use as a human habitation, home or residence.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:10#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 11",
        "locator": {
          "block_index": 11,
          "component_id": "7a785e3e-c190-528c-9b80-f8a596b15808",
          "convention": "utf8_char_offset",
          "end": 1560,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:11",
          "start": 1293
        },
        "quote": "“Forcible felony” means and includes any treason, murder, voluntary manslaughter, rape, robbery, burglary, arson, kidnapping, aggravated battery, aggravated sodomy and any other felony which involves the use or threat of physical force or violence against any person.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:11#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 12",
        "locator": {
          "block_index": 12,
          "component_id": "a0154a6a-b4e5-5be9-aeab-a1a5be549e9a",
          "convention": "utf8_char_offset",
          "end": 1797,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:12",
          "start": 1561
        },
        "quote": "“Intent to defraud” means an intention to deceive another person, and to induce such other person, in reliance upon such deception, to assume, create, transfer, alter or terminate a right, obligation or power with reference to property.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:12#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 13",
        "locator": {
          "block_index": 13,
          "component_id": "1487ac2c-0000-5aad-993a-e71b8ef9133e",
          "convention": "utf8_char_offset",
          "end": 2113,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:13",
          "start": 1798
        },
        "quote": "“Law enforcement officer” means any person who by virtue of such person’s office or public employment is vested by law with a duty to maintain public order or to make arrests for crimes, whether that duty extends to all crimes or is limited to specific crimes, or any officer of the State Department of Corrections.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:13#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 14",
        "locator": {
          "block_index": 14,
          "component_id": "730547e3-46d7-55a4-b700-18e8053de385",
          "convention": "utf8_char_offset",
          "end": 2235,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:14",
          "start": 2114
        },
        "quote": "“Obtain” means to bring about a transfer of interest in or possession of property, whether to the offender or to another.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:14#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 15",
        "locator": {
          "block_index": 15,
          "component_id": "854f611a-44ed-549d-b18c-f9b394685eb5",
          "convention": "utf8_char_offset",
          "end": 2426,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:15",
          "start": 2236
        },
        "quote": "“Obtains or exerts control over property” includes, but is not limited to, the taking, carrying away, or the sale, conveyance or transfer of title to, interest in, or possession of property.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:15#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 16",
        "locator": {
          "block_index": 16,
          "component_id": "7394e4fc-7e91-5a58-842a-e047260c7ea5",
          "convention": "utf8_char_offset",
          "end": 2483,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:16",
          "start": 2427
        },
        "quote": "“Owner” means a person who has any interest in property.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:16#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 17",
        "locator": {
          "block_index": 17,
          "component_id": "753f4695-8f52-579c-80e0-1304df1f37d8",
          "convention": "utf8_char_offset",
          "end": 2783,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:17",
          "start": 2484
        },
        "quote": "“Personal property” means goods, chattels, effects, evidences of rights in action, and all written instruments by which any pecuniary obligation, or any right or title to property, real or personal, shall be created, acknowledged, assigned, transferred, increased, defeated, discharged or dismissed.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:17#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 18",
        "locator": {
          "block_index": 18,
          "component_id": "fcab08cd-c319-531c-a2d2-113ef1b5a329",
          "convention": "utf8_char_offset",
          "end": 2861,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:18",
          "start": 2784
        },
        "quote": "“Property” means anything of value, tangible or intangible, real or personal.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:18#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 19",
        "locator": {
          "block_index": 19,
          "component_id": "c72f5ee3-3258-5591-bc90-eba968ed2742",
          "convention": "utf8_char_offset",
          "end": 2960,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:19",
          "start": 2862
        },
        "quote": "“Prosecution” means all legal proceedings by which a person’s liability for a crime is determined.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:19#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 20",
        "locator": {
          "block_index": 20,
          "component_id": "9dc7d5b4-15c8-5d8c-b308-8e310c1e1919",
          "convention": "utf8_char_offset",
          "end": 3258,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:20",
          "start": 2961
        },
        "quote": "“Public employee” means a person employed by or acting for the State or by or for a county, municipality or other subdivision or governmental instrumentality of the State for the purpose of exercising their respective powers and performing their respective duties, and who is not a public officer.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:20#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 21",
        "locator": {
          "block_index": 21,
          "component_id": "35420162-2f0f-52db-9224-4d0a22d0bc8c",
          "convention": "utf8_char_offset",
          "end": 3339,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:21",
          "start": 3259
        },
        "quote": "“Public officer” means and includes the following, whether elected or appointed:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:21#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 22",
        "locator": {
          "block_index": 22,
          "component_id": "6794e88d-b41a-50d8-aab3-a8fba065f213",
          "convention": "utf8_char_offset",
          "end": 3499,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:22",
          "start": 3340
        },
        "quote": "(1) An executive or administrative officer of the State, or a county, municipality or other subdivision or governmental instrumentality of or within the state;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:22#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 23",
        "locator": {
          "block_index": 23,
          "component_id": "869122a4-595f-51dd-b1e8-def4319f1e58",
          "convention": "utf8_char_offset",
          "end": 3627,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:23",
          "start": 3500
        },
        "quote": "(2) A member of the legislature or of a governing board of a county, municipality, or other subdivision of or within the state;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:23#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 24",
        "locator": {
          "block_index": 24,
          "component_id": "5efbbc78-864d-5f54-a8bb-097a38bd8c4a",
          "convention": "utf8_char_offset",
          "end": 3811,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:24",
          "start": 3628
        },
        "quote": "(3) A judicial officer, which shall include a judge of the district court, juror, master or any other person appointed by a judge or court to hear or determine a cause or controversy;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:24#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 25",
        "locator": {
          "block_index": 25,
          "component_id": "2738b9fd-3ac4-5260-965f-0774d9d673b8",
          "convention": "utf8_char_offset",
          "end": 3983,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:25",
          "start": 3812
        },
        "quote": "(4) A hearing officer, which shall include any person authorized by law or private agreement to hear or determine a cause or controversy and who is not a judicial officer;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:25#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 26",
        "locator": {
          "block_index": 26,
          "component_id": "ca4a3e5a-ff6d-5c95-9c22-602fbd0c3dbe",
          "convention": "utf8_char_offset",
          "end": 4018,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:26",
          "start": 3984
        },
        "quote": "(5) A law enforcement officer; and",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:26#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 27",
        "locator": {
          "block_index": 27,
          "component_id": "7ad607c8-4c11-5945-a8df-ae14aa51bde6",
          "convention": "utf8_char_offset",
          "end": 4106,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:27",
          "start": 4019
        },
        "quote": "(6) Any other person exercising the functions of a public officer under color of right.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:27#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 28",
        "locator": {
          "block_index": 28,
          "component_id": "445c32c1-9395-5a58-9e83-1a2cc5d01a0b",
          "convention": "utf8_char_offset",
          "end": 4217,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:9.05.010:block:28",
          "start": 4107
        },
        "quote": "“Real property” or “real estate” means every estate, interest and right in lands, tenements and hereditaments.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:9.05.010:block:28#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 9.05.010 block 29",
        "locator": {
          "block_index": 29,
