        "locator": {
          "block_index": 2,
          "component_id": "d3a5f31c-714c-5037-9390-6732d4975654",
          "convention": "utf8_char_offset",
          "end": 394,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:17.05.060:block:2",
          "start": 237
        },
        "quote": "(2) The extraction of any earth, rock or other natural materials occurs in conjunction with a special permit issued pursuant to applicable zoning ordinances.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.05.060:block:2#text",
