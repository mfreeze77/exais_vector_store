          "source_component_key": "ks:city:topeka:municipal-code:tmc:3.25.100:block:5",
          "start": 855
        },
        "quote": "Disbursement of funds for projects identified in subsections (b)(2) and (b)(3) of this section shall not exceed 15 percent of the total amount of historic preservation funds allocated for each calendar year.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:3.25.100:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
