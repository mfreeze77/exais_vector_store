          "source_component_key": "ks:city:topeka:municipal-code:tmc:3.25.100:block:4",
          "start": 744
        },
        "quote": "(3) Providing financial commitments associated with securing grant funding from government or private sources.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:3.25.100:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 3.25.100 block 5",
        "locator": {
          "block_index": 5,
