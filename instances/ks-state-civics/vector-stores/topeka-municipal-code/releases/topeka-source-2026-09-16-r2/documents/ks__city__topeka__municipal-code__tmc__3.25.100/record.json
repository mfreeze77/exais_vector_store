          "start": 1063
        },
        "quote": "(c) The Historic Tourism Committee shall:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:3.25.100:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
