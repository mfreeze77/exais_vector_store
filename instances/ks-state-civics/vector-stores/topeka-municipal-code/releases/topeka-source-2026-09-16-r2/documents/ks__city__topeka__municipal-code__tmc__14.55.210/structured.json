{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.55.210","page_type":"section"},"citation":"14.55.210","citation_url":"https://topeka.municipal.codes/TMC/14.55.210","content_hash":"eed60e0bf217641f14fa813fe11af0562ed628d5549429d4dcd1d99a8e8e5794","heading":"Failure to comply.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.210:section","source_url":"https://topeka.municipal.codes/TMC/14.55.210","text":"Section R114.4, Failure to comply, is hereby deleted in its entirety and the following provisions shall be substituted therefor:\nIt shall be unlawful for any person to continue to work after having been served with a stop work order, except such work as that person is directed to perform to remove a violation or unsafe condition. Failure to abide by this provision may result in penalties prescribed in TMC 1.10.070 .\n(Ord. 20467 § 8, 12-5-23.)","type":"section","workbench_component_id":"4ec85746-6165-5a9c-961b-f5faecdd9ff9"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.210","citation_url":"https://topeka.municipal.codes/TMC/14.55.210","content_hash":"f828426c42d089fd97d4c715c56a388c9514d34a22ec2b615f82c391178bd50b","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.210:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.55.210:block:0","source_url":"https://topeka.municipal.codes/TMC/14.55.210","text":"Section R114.4, Failure to comply, is hereby deleted in its entirety and the following provisions shall be substituted therefor:","type":"paragraph","workbench_component_id":"ab256d9b-8b64-5fd5-8011-9dce9a26120b"},{"attributes":{"block_kind":"paragraph"},"citation":"14.55.210","citation_url":"https://topeka.mu