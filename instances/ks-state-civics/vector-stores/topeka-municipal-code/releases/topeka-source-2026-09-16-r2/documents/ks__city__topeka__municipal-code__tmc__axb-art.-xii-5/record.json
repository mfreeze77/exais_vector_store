        },
        "quote": "Consideration for the rights, privileges, and immunities granted to EMS includes the benefits to be derived by the citizens of the City of Topeka from the maintenance and operation of an ambulance service under the terms and conditions of this franchise ordinance.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:axb-art.-xii-5:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
