{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:10.20.050","page_type":"section"},"citation":"10.20.050","citation_url":"https://topeka.municipal.codes/TMC/10.20.050","content_hash":"62649f7124cc8c8d48ffe22c263986307697e8ce31f30377649247054a7550b0","heading":"Vehicles on levee unlawful.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.20.050:section","source_url":"https://topeka.municipal.codes/TMC/10.20.050","text":"(a) It shall be unlawful for any person to drive any motor-driven vehicle upon or over any flood control levee within the City without specific authorization from the Flood Control Supervisor.\n(b) The Flood Control Supervisor shall cause signs to be posted on all levees within the City to inform all persons of the provisions of this section. (Code 1981 § 43-166. Code 1995 § 142-185.)","type":"section","workbench_component_id":"c4923c8e-fa84-55a5-bf8b-c1177ae41889"},{"attributes":{"block_kind":"paragraph"},"citation":"10.20.050","citation_url":"https://topeka.municipal.codes/TMC/10.20.050","content_hash":"cc3397b6868fcfa8f2d1bd7a78c245722a6cc71fe19f715aefc1aad9dbd5b022","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.20.050:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.20.050:block:0","source_url":"https://topeka.municipal.codes/TMC/10.20.050","text":"(a) It shall be unlawful for any person to drive any motor-driven vehicle upon or over any flood control levee within the City without specific authorization from the Flood Control Supervisor.","type":"paragraph","workbench_component_id":"d180bfac-e6e4-5573-b8f7-75c9447fcc8b"},{"attributes":{"block_kind":"paragraph"},"citation":"10.20.050","citation_url":"https://topeka.municipal.codes/TMC/10.20.050","content_hash":"d543d16cbdfeec4e8543e2793035b9ab0aabd54721e77d27e0159c16fbaa0bc8","heading":null,"ordinal":1,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:10.20.050:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:10.20.050:block:1","source_url":"https://topeka.municipal.codes/TMC/10.20.050","text":"(b) The Flood Control Supervisor shall cause signs to be posted on all levees within the City to inform all persons of the provisions of this section. (Code 1981 § 43-166. Code 1995 § 142-185.)","type":"paragraph","workbench_component_id":"1008f0c6-3ba7-5ab9-979d-29485946d8b5"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:10.20.050:section","schema":"exais.jurisdiction.structured_content.v1"}