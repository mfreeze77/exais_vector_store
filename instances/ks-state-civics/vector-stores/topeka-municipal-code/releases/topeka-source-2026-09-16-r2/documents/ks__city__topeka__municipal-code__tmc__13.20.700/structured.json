citation":"13.20.700","citation_url":"https://topeka.municipal.codes/TMC/13.20.700","content_hash":"3a0bbb88dece13b0cc89cb8c5ae29b9f44f325e52d2f9f15a3032543869ce5af","heading":null,"ordinal":3,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.700:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.700:block:3","source_url":"https://topeka.municipal.codes/TMC/13.20.700","text":"Three hundred mg/l biochemical oxygen demand (BOD);","type":"paragraph","workbench_component_id":"987c3280-e21e-56c0-a196-9f626160f730"},{"attributes":{"block_kind":"paragraph"},"citation":"13.20.700","citation_url":"https://topeka.municipal.codes/TMC/13.20.700","content_hash":"bb1a1216257c68fbe48131baa55f95f403bb6aa27be3b00045e3a9a8344fa912","heading":null,"ordinal":4,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.700:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.700:block:4","source_url":"https://topeka.municipal.codes/TMC/13.20.700","text":"Fifty mg/l oil and grease (O&G) (animal or vegetable origin);","type":"paragraph","workbench_component_id":"e53658d2-4003-5713-bb38-be1d45ffa28c"},{"attributes":{"block_kind":"paragraph"},"citation":"13.20.700","citation_url":"https://topeka.municipal.codes/TMC/13.20.700","content_hash":"1b4fc046507a0ca807a3b333d558a2cd6e2061b90e0da2dc38a079bd9d693055","heading":null,"ordinal":5,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.700:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:13.20.700:block:5","source_url":"https://topeka.municipal.codes/TMC/13.20.700","text":"Ten mg/l phosphorus (P);","type":"paragraph","workbench_component_id":"20c551df-1cfc-526c-9210-6ed0edc38c5d"},{"attributes":{"block_kind":"paragraph"},"citation":"13.20.700","citation_url":"https://topeka.municipal.codes/TMC/13.20.700","content_h