          "start": 349
        },
        "quote": "(c) Susceptibility of the proposed facility and its contents to flood damage and the effect of such damage on the individual owner;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.30.250:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
