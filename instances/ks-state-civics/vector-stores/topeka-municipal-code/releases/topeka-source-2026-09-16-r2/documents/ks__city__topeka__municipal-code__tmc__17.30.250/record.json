          "end": 267,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:17.30.250:block:1",
          "start": 215
        },
        "quote": "(a) Danger to life and property due to flood damage;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.30.250:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
