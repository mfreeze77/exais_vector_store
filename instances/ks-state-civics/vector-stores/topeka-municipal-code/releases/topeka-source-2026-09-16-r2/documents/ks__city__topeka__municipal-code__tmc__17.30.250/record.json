          "source_component_key": "ks:city:topeka:municipal-code:tmc:17.30.250:block:2",
          "start": 268
        },
        "quote": "(b) Danger that materials may be swept onto other lands to the injury of others;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.30.250:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
