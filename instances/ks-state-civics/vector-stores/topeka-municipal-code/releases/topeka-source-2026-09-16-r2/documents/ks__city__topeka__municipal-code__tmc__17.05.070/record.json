          "source_component_key": "ks:city:topeka:municipal-code:tmc:17.05.070:block:1",
          "start": 427
        },
        "quote": "(1) Required Items. The application shall contain:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.05.070:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
