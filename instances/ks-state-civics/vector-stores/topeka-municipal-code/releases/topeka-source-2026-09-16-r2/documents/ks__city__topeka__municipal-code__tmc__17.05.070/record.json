          "convention": "utf8_char_offset",
          "end": 504,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:17.05.070:block:2",
          "start": 478
        },
        "quote": "(i) Name of the applicant.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.05.070:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 17.05.070 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "7cba7c81-231e-5191-94aa-639f7332d2d0",
          "convention": "utf8_char_offset",
          "end": 627,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:17.05.070:block:3",
          "start": 505
        },
        "quote": "(ii) Name of the property owner, and legal description and address of property where grading application is to take place.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.05.070:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 17.05.070 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "0a2a1cf9-8701-506e-9932-bf6f06ea2bda",
          "convention": "utf8_char_offset",
          "end": 785,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:17.05.070:block:4",
          "start": 628
        },
        "quote": "(iii) Quantity of earth to be removed or added, the total area of the site and the area that is expected to undergo excavation during the life of the permit.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:17.05.070:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
