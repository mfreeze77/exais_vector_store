    "references": [
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 0",
        "locator": {
          "block_index": 0,
          "component_id": "0a13802f-5297-5d5d-b520-8446ad14123c",
          "convention": "utf8_char_offset",
          "end": 171,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:0",
          "start": 0
        },
        "quote": "“Block party” means a temporary gathering of area residents held on a blockaded portion of local residential streets that may or may not include a neighborhood procession.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:0#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 1",
        "locator": {
          "block_index": 1,
          "component_id": "6a64a4ac-05ea-5021-a654-6bf1ffb41545",
          "convention": "utf8_char_offset",
          "end": 387,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:1",
          "start": 172
        },
        "quote": "“Exigent circumstances” means a situation that could not have been anticipated, including an unexpected loss of venue for an event. “Exigent circumstances” shall not include situations caused by inadequate planning.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "90284ea7-7a71-5c23-a75f-6abe6b2e166e",
          "convention": "utf8_char_offset",
          "end": 613,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:2",
          "start": 388
        },
        "quote": "“Holiday” includes New Year’s Day, Dr. Martin Luther King Jr.’s birthday, Juneteenth, Memorial Day, Independence Day, Labor Day, Veterans Day, Thanksgiving Day, the day after Thanksgiving Day, Christmas Eve and Christmas Day.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 3",
        "locator": {
          "block_index": 3,
          "component_id": "ca37309d-f030-539c-bccc-544c5612fd26",
          "convention": "utf8_char_offset",
          "end": 1242,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:3",
          "start": 614
        },
        "quote": "“Neighborhood procession” means an organized procession of people, motor vehicles, bicycles, floats, animals or any combination traveling in unison for a period of time that does not exceed two hours in length (from start through teardown) along or upon a sidewalk or streets; provided, however, that at least 75 percent of the streets being traveled upon are classified in the Federal Highway Administration (FHWA) and Metropolitan Planning Organization (MPO) Approved Functional Classification Map for Topeka and Shawnee County, as amended, as being local residential streets (as opposed to arterial and/or collector streets).",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 4",
        "locator": {
          "block_index": 4,
          "component_id": "318948d1-63f6-5a8b-be76-0e4546b3b219",
          "convention": "utf8_char_offset",
          "end": 1675,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:4",
          "start": 1243
        },
        "quote": "“Parade” means an organized procession of people, motor vehicles, bicycles, floats, animals or any combination traveling in unison along or upon a sidewalk or any classification of street that may require closure of streets and the regulation of vehicular traffic by law enforcement to prevent a conflict with the normal or regular flow of traffic. “Parade” shall not include a neighborhood procession associated with a block party.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "736427cd-c453-5fb1-aee0-dcae8d824e39",
          "convention": "utf8_char_offset",
          "end": 1839,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:5",
          "start": 1676
        },
        "quote": "“Person” means a natural person or legal entity such as but not limited to an individual, firm, corporation, association, partnership or limited liability company.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 6",
        "locator": {
          "block_index": 6,
          "component_id": "307445cc-68c7-5f6a-a6f7-4ac867159dd0",
          "convention": "utf8_char_offset",
          "end": 2048,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:6",
          "start": 1840
        },
        "quote": "“Police escort” means the assignment of law enforcement officers to provide a visibly authorized presence for public safety, traffic control, or to facilitate the movement of specific vehicles or individuals.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 7",
        "locator": {
          "block_index": 7,
          "component_id": "67f242e0-8c60-5a75-890e-1b249afd7c9c",
          "convention": "utf8_char_offset",
          "end": 2145,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:7",
          "start": 2049
        },
        "quote": "“Public property” means any street, alley, sidewalk, right-of-way or property owned by the City.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 8",
        "locator": {
          "block_index": 8,
          "component_id": "9c010a85-6f8f-5f85-8cfb-a799c6a055b5",
          "convention": "utf8_char_offset",
          "end": 2437,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:8",
          "start": 2146
        },
        "quote": "“Special event” means an outdoor event held on public property organized for a particular and limited purpose and time. Special events shall include, but not be limited to, the following: parades, block parties, running/walking/bicycling events, motor vehicle events, festivals and concerts.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:8#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 9",
        "locator": {
          "block_index": 9,
          "component_id": "9b8d8a5c-5206-5b72-84da-0fd6af458825",
          "convention": "utf8_char_offset",
          "end": 2606,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:9",
          "start": 2438
        },
        "quote": "“Sufficient application” means that the application: (1) contains all of the information and documents required in TMC 12.70.050 ; and (2) includes the application fee.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:9#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 10",
        "locator": {
          "block_index": 10,
          "component_id": "e13049c5-7db9-5efc-84bb-1c1aa52e1ccd",
          "convention": "utf8_char_offset",
          "end": 2738,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:10",
          "start": 2607
        },
        "quote": "“Vendor” means a transient vendor, sidewalk vendor, or a mobile food vendor as defined at TMC 5.115.010 . (Ord. 20662 § 1, 6-2-26.)",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:10#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 12.70.010 block 11",
        "locator": {
          "block_index": 11,
          "component_id": "995b5c73-53e4-539d-a966-18755d7ee0df",
          "convention": "utf8_char_offset",
          "end": 2794,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.70.010:block:11",
          "start": 2739
        },
        "quote": "Cross References: Definitions generally, TMC 1.10.020 .",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.70.010:block:11#text",
        "unavailable_reason": null
