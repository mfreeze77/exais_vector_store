{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:14.25.230","page_type":"section"},"citation":"14.25.230","citation_url":"https://topeka.municipal.codes/TMC/14.25.230","content_hash":"d85dd6215f1a7ce5fa6379519e3de0f3a9f35332a76966b67c326cfd0ab35f20","heading":"Section 1201.4, Flood hazard areas.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.230:section","source_url":"https://topeka.municipal.codes/TMC/14.25.230","text":"Section 1201.4, Flood hazard areas, except for the provision marked “Exception,” is hereby deleted in its entirety and the following provision shall be substituted therefor:\nIn flood hazard areas, if all proposed work, including repairs, work required because of a change of occupancy, and alterations, constitutes substantial improvement, then the existing building shall comply with the requirements provided in the TMC Chapters 14.20 (building code) and 17.30 (floodplain management).\n(Ord. 20344 § 23, 2-15-22.)","type":"section","workbench_component_id":"9d63b66a-92f0-54ec-ae6f-e63300f770c3"},{"attributes":{"block_kind":"paragraph"},"citation":"14.25.230","citation_url":"https://topeka.municipal.codes/TMC/14.25.230","content_hash":"7bbbc9337831d8a78a4ea1fd3448d32452b4db9866e79c73a9eaccc6a818cb7a","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.230:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:14.25.230:block:0","source_url":"https://topeka.municipal.codes/TMC/14.25.230","text":"Section 1201.4, Flood hazard areas, except for the provision marked “Exception,” is hereby deleted in its entirety and the following provision shall be substituted therefor:","type":"paragraph","workbench_component_id":"f4752