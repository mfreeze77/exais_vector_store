          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.275.020:block:3",
          "start": 436
        },
        "quote": "(3) Institutional uses in any zoning district and all developments constructed under the provisions of a conditional use permit, in any zoning district.",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.275.020:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
