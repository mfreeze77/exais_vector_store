          "source_component_key": "ks:city:topeka:municipal-code:tmc:12.30.160:block:2",
          "start": 168
        },
        "quote": "(2) To any person required by TMC 12.30.070 to file an annual report but has failed to do so;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:12.30.160:block:2#text",
        "unavailable_reason": null
