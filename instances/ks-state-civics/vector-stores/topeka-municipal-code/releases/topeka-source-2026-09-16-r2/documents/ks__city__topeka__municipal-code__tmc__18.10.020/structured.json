nent_id":"f9ad284a-1023-5bbe-b970-b436d1193133"},{"attributes":{"block_kind":"paragraph"},"citation":"18.10.020","citation_url":"https://topeka.municipal.codes/TMC/18.10.020","content_hash":"fa33fc111a0e66b9b8a94a5bf55676f70041c2755e1b38c4f144e8fffb789609","heading":null,"ordinal":11,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.10.020:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.10.020:block:11","source_url":"https://topeka.municipal.codes/TMC/18.10.020","text":"(d) Any reference in this chapter to “Planning and Development Director” shall also mean staff designated by the Planning and Development Director to administer the regulations in this chapter. (Ord. 20207 § 3, 9-10-19.)","type":"paragraph","workbench_component_id":"dcdb4149-bd0e-597e-859b-6583c0ad324f"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:18.10.020:section","schema":"exais.jurisdiction.structured_content.v1"}