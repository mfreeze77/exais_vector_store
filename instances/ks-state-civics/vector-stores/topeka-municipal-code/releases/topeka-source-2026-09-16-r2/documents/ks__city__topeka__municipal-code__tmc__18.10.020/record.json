          "convention": "utf8_char_offset",
          "end": 400,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.020:block:4",
          "start": 336
        },
        "quote": "(3) Preserve and enhance the visual appearance of the community;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.020:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.10.020 block 5",
        "locator": {
          "block_index": 5,
          "component_id": "b07b6bde-3e4b-5804-a44c-fa09264c2fc6",
          "convention": "utf8_char_offset",
          "end": 508,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.020:block:5",
          "start": 401
        },
        "quote": "(4) Preserve and enhance the safety and physical appearance of the City’s primary transportation corridors;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.020:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
