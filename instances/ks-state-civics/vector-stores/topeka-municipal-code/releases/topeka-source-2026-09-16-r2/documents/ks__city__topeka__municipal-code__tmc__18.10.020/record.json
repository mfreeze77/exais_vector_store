          "convention": "utf8_char_offset",
          "end": 335,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.020:block:3",
          "start": 308
        },
        "quote": "(2) Enhance traffic safety;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.020:block:3#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.10.020 block 4",
        "locator": {
          "block_index": 4,
