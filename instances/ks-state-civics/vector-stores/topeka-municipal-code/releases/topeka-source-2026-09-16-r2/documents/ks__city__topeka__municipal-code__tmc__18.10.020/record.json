          "convention": "utf8_char_offset",
          "end": 570,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.020:block:7",
          "start": 542
        },
        "quote": "(6) Protect property values;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.020:block:7#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
