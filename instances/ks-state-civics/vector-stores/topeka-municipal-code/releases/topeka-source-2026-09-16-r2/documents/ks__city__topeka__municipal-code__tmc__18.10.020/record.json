        },
        "quote": "(b) The purpose of this chapter is to:",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.020:block:1#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
        "label": "TMC 18.10.020 block 2",
        "locator": {
          "block_index": 2,
          "component_id": "7db3633a-622d-5245-a377-5dd6a3afa171",
          "convention": "utf8_char_offset",
          "end": 307,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.020:block:2",
          "start": 226
        },
        "quote": "(1) Provide for effective communications by businesses, institutions, and others;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.020:block:2#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
