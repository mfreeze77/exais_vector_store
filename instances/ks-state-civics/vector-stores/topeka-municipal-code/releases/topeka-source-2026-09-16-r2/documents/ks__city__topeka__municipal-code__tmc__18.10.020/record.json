          "end": 541,
          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.10.020:block:6",
          "start": 509
        },
        "quote": "(5) Prevent visual distractions;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.10.020:block:6#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
        "availability": "available",
