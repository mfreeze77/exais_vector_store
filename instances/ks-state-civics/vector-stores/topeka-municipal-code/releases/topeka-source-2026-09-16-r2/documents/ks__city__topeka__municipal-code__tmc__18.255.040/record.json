          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.255.040:block:5",
          "start": 548
        },
        "quote": "(ii) Is associated with a significant person or group of persons in the history of the City, County, State or nation;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.255.040:block:5#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
