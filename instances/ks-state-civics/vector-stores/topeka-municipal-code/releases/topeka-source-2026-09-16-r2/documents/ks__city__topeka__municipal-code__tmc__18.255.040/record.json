          "source_component_key": "ks:city:topeka:municipal-code:tmc:18.255.040:block:4",
          "start": 406
        },
        "quote": "(i) Is associated with events that have made a significant contribution to the broad pattern of history of the City, County, State or nation;",
        "ref_id": "ks:city:topeka:municipal-code:tmc:18.255.040:block:4#text",
        "unavailable_reason": null
      },
      {
        "artifact": "normalized_text",
