040","citation_url":"https://topeka.municipal.codes/TMC/18.255.040","content_hash":"64983538d85bc54448b25e53a184a9eb3ce77d56b01c34d6bfbf9c7f2263c504","heading":null,"ordinal":8,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.255.040:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.255.040:block:8","source_url":"https://topeka.municipal.codes/TMC/18.255.040","text":"(b) Local Historic District. The Governing Body may designate an area as a local historic district if at least 75 percent of the structures within the district boundaries are of architectural, historical, or cultural importance or value and are classified as contributing features. (Ord. 19901 § 5, 5-6-14.)","type":"paragraph","workbench_component_id":"bc731539-7acd-527c-a764-768cb0e8c135"},{"attributes":{"block_kind":"paragraph"},"citation":"18.255.040","citation_url":"https://topeka.municipal.codes/TMC/18.255.040","content_hash":"d41ed969f4f69b83f291afab2ee5ae1882fde020e8c715e6898622fece7de356","heading":null,"ordinal":9,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:18.255.040:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.255.040:block:9","source_url":"https://topeka.municipal.codes/TMC/18.255.040","text":"Cross References: City Council – Mayor, Chapter 2.15 TMC.","type":"paragraph","workbench_component_id":"b812477e-6050-5023-951b-128ecd252a97"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:18.255.040:section","schema":"exais.jurisdiction.structured_content.v1"}