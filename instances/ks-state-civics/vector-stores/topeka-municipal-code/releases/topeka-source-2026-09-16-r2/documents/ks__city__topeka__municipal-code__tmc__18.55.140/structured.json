{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:18.55.140","page_type":"section"},"citation":"18.55.140","citation_url":"https://topeka.municipal.codes/TMC/18.55.140","content_hash":"bb606bd51f75891ac5ff7b0654b61c26433f4d6bb013b2d6ad9cc9a3935beefc","heading":"“N” definitions.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:18.55.140:section","source_url":"https://topeka.municipal.codes/TMC/18.55.140","text":"“Neighborhood” means the smallest subarea in planning, defined as a residential area whose residents have public facilities and social institutions in common, generally within walking distance of their homes.\n“Non-owner-occupied” means any dwelling in which the owner of record does not reside in the dwelling or resides in the dwelling fewer than 182 days per calendar year.\n“Nonconforming lot” means a lot which was lawful prior to the adoption of or amendment to a zoning ordinance but which fails by reason of such adoption or amendment to conform to the present requirements for lots of its zoning district.\n“Nonconforming structure or building” means a structure or building, the size, dimension or location of which was lawful prior to the adoption of or amendment to a zoning ordinance but which fails, by reason of such adoption or amendment, to conform to the present requirements of the zoning district.\n“Nonconforming use” means a use or activity which was lawful prior to the adoption or amendment of a zoning ordinance but which fails, by reason of such adoption or amendment, to conform to the present requirements of the zoning district. (Ord. 20283 § 3, 3-2-21.)","type":"section","workbench_component_id":"2440639f-7529-5f12-9b70-33e924de43c7"},{"attributes":{"block_kind":"paragraph"},"citation":"18.55.140","citation_url":"ht