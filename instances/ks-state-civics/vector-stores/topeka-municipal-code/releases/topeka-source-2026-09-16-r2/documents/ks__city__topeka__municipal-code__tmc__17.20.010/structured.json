{"component_id_namespace":"ec077a53-0b40-5f21-b1fe-a62094d2476b","component_schema":"exais.workbench_component.v1","components":[{"attributes":{"code":"TMC","legacy_node_id":"ks-topeka:tmc:17.20.010","page_type":"section"},"citation":"17.20.010","citation_url":"https://topeka.municipal.codes/TMC/17.20.010","content_hash":"4417208155cf0f810a69434fb2390869bc370cbdb7fda395490c3bee850e2360","heading":"Penalty for violation of chapter.","ordinal":0,"parent_source_component_key":null,"schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:17.20.010:section","source_url":"https://topeka.municipal.codes/TMC/17.20.010","text":"Any person found guilty of a violation of this chapter shall be punished as set forth in TMC 1.10.070 and, in addition thereto, shall restore to original condition any area involved in the violation. (Code 1981 § 10-440. Code 1995 § 74-91.)","type":"section","workbench_component_id":"03755dec-2bee-59fd-858c-2972fc08459b"},{"attributes":{"block_kind":"paragraph"},"citation":"17.20.010","citation_url":"https://topeka.municipal.codes/TMC/17.20.010","content_hash":"4417208155cf0f810a69434fb2390869bc370cbdb7fda395490c3bee850e2360","heading":null,"ordinal":0,"parent_source_component_key":"ks:city:topeka:municipal-code:tmc:17.20.010:section","schema":"exais.workbench_component.v1","source_component_key":"ks:city:topeka:municipal-code:tmc:17.20.010:block:0","source_url":"https://topeka.municipal.codes/TMC/17.20.010","text":"Any person found guilty of a violation of this chapter shall be punished as set forth in TMC 1.10.070 and, in addition thereto, shall restore to original condition any area involved in the violation. (Code 1981 § 10-440. Code 1995 § 74-91.)","type":"paragraph","workbench_component_id":"17077359-deae-5911-8e86-c6ded0320cc1"}],"root_source_component_key":"ks:city:topeka:municipal-code:tmc:17.20.010:section","schema":"exais.jurisdiction.structured_content.v1"}