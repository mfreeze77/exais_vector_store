{
  "blocks": [
    {
      "kind": "paragraph",
      "order": 0,
      "style": "BodyText",
      "text": "RESOLUTION NO. 9818"
    },
    {
      "kind": "paragraph",
      "order": 1,
      "style": "ListParagraph",
      "text": "A RESOLUTION introduced by Councilmember Karen Hiller granting Randy Wheat"
    },
    {
      "kind": "paragraph",
      "order": 2,
      "style": "ListParagraph",
      "text": "an exception to the provisions of City of Topeka Code Section"
    },
    {
      "kind": "paragraph",
      "order": 3,
      "style": "ListParagraph",
      "text": "9.45.150, et seq. concerning noise prohibitions. 6"
    },
    {
      "kind": "paragraph",
      "order": 4,
      "style": "ListParagraph",
      "text": "WHEREAS, City of Topeka Code Section 9.45.150, et seq. makes it"
    },
    {
      "kind": "paragraph",
      "order": 5,
      "style": "ListParagraph",
      "text": "unlawful for any person to make, continue or cause to be made or continued any"
    },
    {
      "kind": "paragraph",
      "order": 6,
      "style": "ListParagraph",
      "text": "loud, unnecessary or unusual noise or any noise which either annoys, disturbs,"
    },
    {
      "kind": "paragraph",
      "order": 7,
      "style": "ListParagraph",
      "text": "injures or endangers the comfort, repose, health or safety or others within the"
    },
    {
      "kind": "paragraph",
      "order": 8,
      "style": "ListParagraph",
      "text": "limits of the city; and"
    },
    {
      "kind": "paragraph",
      "order": 9,
      "style": "ListParagraph",
      "text": "WHEREAS, City of Topeka Code Section 9.45.170, et seq. authorizes the"
    },
    {
      "kind": "paragraph",
      "order": 10,
      "style": "ListParagraph",
      "text": "City Council to grant exceptions to the prohibitions of this code section upon"
    },
    {
      "kind": "paragraph",
      "order": 11,
      "style": "ListParagraph",
      "text": "request and a showing that the proposed activity does not offend the spirit of the"
    },
    {
      "kind": "paragraph",
      "order": 12,
      "style": "ListParagraph",
      "text": "findings of City of Topeka Code Section 9.45.150, et seq.; and"
    },
    {
      "kind": "paragraph",
      "order": 13,
      "style": "ListParagraph",
      "text": "WHEREAS, Randy Wheat has requested that they be granted an"
    },
    {
      "kind": "paragraph",
      "order": 14,
      "style": "ListParagraph",
      "text": "exception to the provisions of City of Topeka Code Section 9.45.150, et seq. for"
    },
    {
      "kind": "paragraph",
      "order": 15,
      "style": "ListParagraph",
      "text": "the purposes, dates and times described herein, and"
    },
    {
      "kind": "paragraph",
      "order": 16,
      "style": "ListParagraph",
      "text": "WHEREAS, upon review of the application of Randy Wheat the"
    },
    {
      "kind": "paragraph",
      "order": 17,
      "style": "ListParagraph",
      "text": "Governing Body of the City of Topeka does hereby find that the requested"
    },
    {
      "kind": "paragraph",
      "order": 18,
      "style": "ListParagraph",
      "text": "activity does not offend the spirit of the findings of City of Topeka Code Section 22 9.45.150, et seq."
    },
    {
      "kind": "paragraph",
      "order": 19,
      "style": "ListParagraph",
      "text": "NOW, THEREFORE, BE IT RESOLVED by the Governing Body of the"
    },
    {
      "kind": "paragraph",
      "order": 20,
      "style": "ListParagraph",
      "text": "City of Topeka Randy Wheat is hereby granted an exception from the provisions"
    },
    {
      "kind": "paragraph",
      "order": 21,
      "style": "ListParagraph",
      "text": "of City of Topeka Code Section 9.45.150, et seq. for the Midwest Demo Kings"
    },
    {
      "kind": "paragraph",
      "order": 22,
      "style": "ListParagraph",
      "text": "Juneteenth located at 301 SW 10th Avenue, during the hours of 11:00 a.m. and"
    },
    {
      "kind": "paragraph",
      "order": 23,
      "style": "BodyText",
      "text": "27 4:00 p.m. on June 19, 2026."
    },
    {
      "kind": "paragraph",
      "order": 24,
      "style": "BodyText",
      "text": "28"
    },
    {
      "kind": "paragraph",
      "order": 25,
      "style": "BodyText",
      "text": "29"
    },
    {
      "kind": "paragraph",
      "order": 26,
      "style": "BodyText",
      "text": "30 ADOPTED and APPROVED by the Governing Body June 16, 2026."
    },
    {
