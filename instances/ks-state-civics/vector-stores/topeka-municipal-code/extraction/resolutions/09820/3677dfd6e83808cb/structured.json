    {
      "kind": "paragraph",
      "order": 0,
      "style": "BodyText",
      "text": "RESOLUTION NO. 9820"
    },
    {
      "kind": "paragraph",
      "order": 1,
      "style": "BodyText",
      "text": "A RESOLUTION introduced by City Manager Dr. Robert M. Perez, authorizing the City Attorney’s Office to initiate litigation."
    },
    {
      "kind": "paragraph",
      "order": 2,
      "style": "BodyText",
      "text": "NOW, THEREFORE, BE IT RESOLVED BY THE GOVERNING BODY OF THE"
    },
    {
      "kind": "paragraph",
      "order": 3,
      "style": "BodyText",
      "text": "CITY OF TOPEKA, KANSAS, that the City Attorney’s Office is hereby authorized to initiate a lawsuit, seeking a judgment for damages resulting from a breach of contract created by Ordinance 20252, in the Shawnee County District Court."
    },
    {
      "kind": "paragraph",
      "order": 4,
      "style": "BodyText",
      "text": "ADOPTED and APPROVED by the Governing Body on June 16, 2026."
    },
    {
      "kind": "paragraph",
      "order": 5,
      "style": "BodyText",
      "text": "CITY OF TOPEKA, KANSAS"
    },
    {
      "kind": "paragraph",
      "order": 6,
      "style": "BodyText",
      "text": "Spencer L. Duncan, Mayor"
    },
    {
      "kind": "paragraph",
      "order": 7,
      "style": "BodyText",
      "text": "ATTEST:"
    },
    {
      "kind": "paragraph",
      "order": 8,
      "style": "BodyText",
      "text": "Brenda Younger, City Clerk"
    },
    {
      "kind": "paragraph",
      "order": 9,
      "style": null,
      "text": "RES/Initiating Lawsuit"
    }
  ],
  "tables": []
}
